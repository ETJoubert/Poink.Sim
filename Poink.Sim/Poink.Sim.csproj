<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Split out of Poink.ML: this is trader-simulation playback (data replay +
         heuristic/rule-based brains), not the training pipeline. It still carries
         its own TorchSharp/Microsoft.ML for a future trained ISimulationBrain (see
         Brain/ISimulationBrain.cs and README.md's "Trained ML brain" entry), kept
         as this project's own copy rather than a ProjectReference to Poink.ML. -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
    <PackageReference Include="Dapper" Version="2.1.66" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
    <!-- CPU/GPU counters for the MainLayout performance toggle (Diagnostics/SystemPerformanceMonitor.cs). -->
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="9.0.0" />
    <PackageReference Include="Microsoft.ML" Version="5.0.0" />
    <PackageReference Include="TorchSharp" Version="0.107.0" />
    <!-- CUDA backend targeting the RTX 3060, matching Poink.ML's choice. This package
         bundles both CUDA and CPU kernels, so code still runs fine on machines without
         a GPU. Swap back to TorchSharp-cpu for a much smaller download if needed. -->
    <PackageReference Include="TorchSharp-cuda-windows" Version="0.107.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Used for the ViewDatatable/Icon/PageNav shared components and CSS/theme
         static assets served under "serve", plus CTraderBarRow for the
         MarketChart component. -->
    <ProjectReference Include="..\Poink.Shared.Client\Poink.Shared.Client.csproj" />
  </ItemGroup>
</Project>
