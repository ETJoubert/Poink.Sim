<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Split out of Poink.ML: this is trader-simulation playback (data replay +
         heuristic/rule-based brains), not model training, so it carries none of
         Poink.ML's TorchSharp/Microsoft.ML weight, just Postgres access
         (Npgsql) and the shared Blazor terminal UI (Poink.Shared.Client). -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Npgsql" Version="10.0.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Used for the ViewDatatable/Icon/PageNav shared components and CSS/theme
         static assets served under "serve", plus CTraderBarRow/PredictedBar for
         the OhlcvChart component. -->
    <ProjectReference Include="..\Poink.Shared.Client\Poink.Shared.Client.csproj" />
  </ItemGroup>
</Project>
