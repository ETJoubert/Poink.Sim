@using Poink.Sim.Components.Shared.RangeCalendar
@using Poink.Sim.Components.Shared.WeekRangeGrid

<div class="drs @(Disabled ? "drs-disabled" : "")">
    @if (_calendarOpen)
    {
        <div class="drs-calendar-backdrop" @onclick="CloseCalendar" title="Close the calendar"></div>
    }
    <div class="drs-main">
        <button type="button" class="drs-label drs-label-from" @onclick="() => OpenCalendar(RangeEdge.Start)" disabled="@Disabled"
                title="Range start -- click to pick the start date and time on the calendar">
            @From.ToString("yyyy-MM-dd HH:mm")
        </button>

        <WeekRangeGrid Min="Min" Max="Max" From="From" To="To" RangeChanged="OnRangeChanged" MinWeeks="MinWeeks" Disabled="Disabled" />

        <button type="button" class="drs-label drs-label-to" @onclick="() => OpenCalendar(RangeEdge.End)" disabled="@Disabled"
                title="Range end -- click to pick the end date and time on the calendar">
            @To.ToString("yyyy-MM-dd HH:mm")
        </button>

        <span class="drs-span-badge" title="Length of the selected range">@SpanLabel</span>

        @if (_calendarOpen)
        {
            <div class="drs-calendar-dropdown">
                <RangeCalendar @key="_calendarEdge" Start="From" End="To" Min="Min" Max="Max" InitialEdge="_calendarEdge"
                               RangeChanged="OnRangeChanged" />
            </div>
        }
    </div>
</div>
