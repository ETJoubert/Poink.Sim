@* Dual-handle range slider replacing two datetime-local inputs for picking a
   From/To span within [Min, Max]. Two overlapping native <input type=range>
   thumbs (pointer-events trick, see .razor.css) so dragging is fully native --
   no JS interop needed. Week gridlines along the rail are a visual reference
   only (not independently clickable). The "full range" reset lives on
   TickDataSource's toolbar row now, not here -- see TickDataSource.razor.
   From/To labels double as buttons that open a Calendar popover (date only --
   the slider thumbs still own time-of-day precision). *@
@using Poink.Sim.Components.Shared.Calendar

<div class="drs @(Disabled ? "drs-disabled" : "")">
    @if (_showFromCalendar || _showToCalendar)
    {
        <div class="drs-calendar-backdrop" @onclick="CloseCalendars"></div>
    }
    <div class="drs-main">
        <div class="drs-label-wrap drs-label-wrap-from">
            <button type="button" class="drs-label drs-label-from" @onclick="ToggleFromCalendar" disabled="@Disabled">
                @From.ToString("yyyy-MM-dd HH:mm")
            </button>
            @if (_showFromCalendar)
            {
                <div class="drs-calendar-dropdown">
                    <Calendar Value="From" ValueChanged="OnFromDateSelected" Min="Min" Max="To" />
                </div>
            }
        </div>

        <div class="drs-track-wrap">
            <div class="drs-rail">
                <div class="drs-rail-fill" style="left: @Pct(FromPercent)%; right: @Pct(100 - ToPercent)%;"></div>
                @foreach (var tick in WeekTicks)
                {
                    <div class="drs-tick" style="left: @Pct(tick.Percent)%" title="@tick.Title">
                        @if (tick.ShowLabel)
                        {
                            <span class="drs-tick-label">@tick.Label</span>
                        }
                    </div>
                }
            </div>
            <input type="range" class="drs-thumb drs-thumb-from" min="0" max="@_spanMinutes" value="@_fromMinutes"
                   @onchange="OnFromChanged" disabled="@Disabled" />
            <input type="range" class="drs-thumb drs-thumb-to" min="0" max="@_spanMinutes" value="@_toMinutes"
                   @onchange="OnToChanged" disabled="@Disabled" />

        </div>

        <div class="drs-label-wrap drs-label-wrap-to">
            <button type="button" class="drs-label drs-label-to" @onclick="ToggleToCalendar" disabled="@Disabled">
                @To.ToString("yyyy-MM-dd HH:mm")
            </button>
            @if (_showToCalendar)
            {
                <div class="drs-calendar-dropdown">
                    <Calendar Value="To" ValueChanged="OnToDateSelected" Min="From" Max="Max" />
                </div>
            }
        </div>

        <span class="drs-span-badge">@SpanLabel</span>
    </div>
    @* <div class="drs-bounds">
        <span>@Min.ToString("yyyy-MM-dd")</span>
        <span>@Max.ToString("yyyy-MM-dd")</span>
    </div> *@


</div>
