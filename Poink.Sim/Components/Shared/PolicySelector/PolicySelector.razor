@namespace Poink.Sim.Components.Shared.PolicySelector

<div class="policy-selector">
    <div class="policy-selector-header">
        <button type="button" class="policy-selector-btn" @onclick="ToggleOpen"
                title="@(Disabled ? "View the risk policies (read-only while a run is loaded)" : "Show the risk policies table to enable, disable and order them")">
            Set Policies (@Selected.Count)
            <span class="policy-selector-caret">@(_open ? "▲" : "▼")</span>
        </button>
        @Actions
    </div>

    @if (_open)
    {
        <div class="policy-cards">
            @foreach (var policy in OrderedRows)
            {
                var enabled = Selected.Contains(policy.Name);
                var order = ExecutionOrder(policy.Name);
                var name = policy.Name;
                <div class="policy-card @(enabled ? "policy-card-on" : "policy-card-off") @(Disabled ? "policy-card-locked" : null)"
                     role="button"
                     tabindex="@(Disabled ? -1 : 0)"
                     aria-pressed="@enabled"
                     @onclick="() => SetEnabled(name, !enabled)"
                     @onkeydown="e => OnCardKey(e, name, enabled)"
                     title="@(enabled ? "Remove this policy from the run" : "Add this policy to the run")">
                    <div class="policy-card-order" @onclick:stopPropagation="true">
                        @if (enabled)
                        {
                            <span class="policy-card-index" title="Execution order">@(order + 1)</span>
                            <button type="button" class="policy-card-order-btn" @onclick="() => MoveEarlier(name)"
                                    disabled="@(Disabled || order == 0)" title="Run earlier">&#9650;</button>
                            <button type="button" class="policy-card-order-btn" @onclick="() => MoveLater(name)"
                                    disabled="@(Disabled || order == Selected.Count - 1)" title="Run later">&#9660;</button>
                        }
                        else
                        {
                            <span class="policy-card-order-none" title="Not in the run">&mdash;</span>
                        }
                    </div>
                    <span class="policy-card-indicator" title="@(enabled ? "In the run" : "Not in the run")"></span>
                    <div class="policy-card-body">
                        <div class="policy-card-head">
                            <span class="policy-card-name">@policy.Name</span>
                            <span class="policy-card-state">@(enabled ? "on" : "off")</span>
                        </div>
                        <span class="policy-card-desc">@policy.Description</span>
                    </div>
                </div>
            }
        </div>
    }
</div>
