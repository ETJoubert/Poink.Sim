@namespace Poink.Sim.Components.Shared.BrainIoPanel
@using Poink.Sim.Components.Charts

<div class="brain-io-section">
    <div class="brain-io-title">
        OUTPUTS <span class="brain-io-badge" title="Number of possible choices across every decision the network makes">@(Outputs?.Count ?? 0)</span>
    </div>
    @if (Outputs is null)
    {
        <span class="reward-chart-empty">no data yet</span>
    }
    else
    {
        @foreach (var group in OutputGroups)
        {
            <div class="action-dist-group">
                @if (group.Key != "Direction")
                {
                    <div class="action-dist-group-label">@group.Key</div>
                }
                <div class="action-dist">
                    @foreach (var o in group)
                    {
                        <div class="action-dist-row @(o.IsChosen ? "action-dist-row-chosen" : "")"
                             title="@(o.IsChosen ? "What the network actually decided" : "")">
                            <span class="action-dist-label action-dist-@(ActionCssSuffix(o))">@ActionShortLabel(o)</span>
                            <div class="action-dist-track">
                                <div class="action-dist-fill action-dist-fill-@(ActionCssSuffix(o))"
                                     style="width: @(Pct(o.Probability * 100))%"></div>
                            </div>
                            <span class="action-dist-pct">@(FormatProbabilityPct(o.Probability))%</span>
                            <span class="action-dist-raw @(IsBlockedLogit(o.Logit) ? "action-dist-raw-blocked" : "")"
                                  title="@(IsBlockedLogit(o.Logit) ? "Blocked by Action Masking -- illegal in the current state" : "Raw network output before softmax (logit) -- for evaluating decision methods other than softmax sampling")">@(FormatLogit(o.Logit))</span>
                        </div>
                    }
                </div>
            </div>
        }
    }
</div>

@if (ShowInputs)
{
    <div class="brain-io-section">
        <div class="brain-io-title brain-io-title-row">
            <span>
                INPUTS <span class="brain-io-badge" title="Number of input features fed to the network">@(Inputs?.Count ?? 0)</span>
            </span>
            <label class="brain-io-denorm-toggle"
                   title="Show actual price/currency values instead of the network's normalized (bounded ratio) inputs">
                <input type="checkbox" @bind="_showDenormalizedInputs" />
                De-normalized
            </label>
        </div>
        @if (Inputs is null)
        {
            <span class="reward-chart-empty">no data yet</span>
        }
        else
        {
            <div class="input-cards">
                @if (XGridFeatures.Count > 0)
                {
                    <div class="input-card input-card-xgrid">
                        <div class="input-card-label">XGRID</div>
                        <div class="input-card-body">
                            <XGridSignalOutputTable Keys="XGridFeatureKeys" ValueOf="XGridFeatureValue" />
                        </div>
                    </div>
                }

                @if (PriceWindowFeatures.Count > 0)
                {
                    <div class="input-card input-card-price-window">
                        <div class="input-card-label">PRICE WINDOW</div>
                        <div class="input-card-body">
                            <div class="input-scalars">
                                @foreach (var f in PriceWindowFeatures)
                                {
                                    <div class="input-scalar">
                                        <span class="input-badge-label">@f.Label</span>
                                        <span
                                            class="input-badge-value @(f.Value switch { > 0 => "input-positive", < 0 => "input-negative", _ => "" })">
                                            @FormatInputValue(f)
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }

                @if (VolumeProfilePriceFeatures.Count > 0 || VolumeProfileVolumeFeatures.Count > 0)
                {
                    <div class="input-card input-card-volume-profile">
                    <div class="input-card-label">VOLUME PROFILE</div>
                    <div class="input-card-body">
                        @if (VolumeProfilePriceFeatures.Count > 0)
                        {
                            <div class="input-card-shade input-card-shade-a">
                                <div class="input-shade-label">PRICE</div>
                                <div class="input-scalars">
                                    @foreach (var f in VolumeProfilePriceFeatures)
                                    {
                                        <div class="input-scalar">
                                            <span class="input-scalar-label">@f.Label</span>
                                            <span
                                                class="input-scalar-value @(f.Value switch { > 0 => "input-positive", < 0 => "input-negative", _ => "" })">
                                                @FormatInputValue(f, "N3")
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        @if (VolumeProfileVolumeFeatures.Count > 0)
                        {
                            <div class="input-card-shade input-card-shade-b">
                                <div class="input-shade-label">VOLUME</div>
                                <div class="input-scalars">
                                    @foreach (var f in VolumeProfileVolumeFeatures)
                                    {
                                        <div class="input-scalar">
                                            <span class="input-scalar-label">@f.Label</span>
                                            <span
                                                class="input-scalar-value @(f.Value switch { > 0 => "input-positive", < 0 => "input-negative", _ => "" })">
                                                @FormatInputValue(f, "N3")
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    </div>
                }

                @if (TimeProfilePriceFeatures.Count > 0 || TimeProfileTimeFeatures.Count > 0)
                {
                    <div class="input-card input-card-time-profile">
                    <div class="input-card-label">TIME PROFILE</div>
                    <div class="input-card-body">
                        @if (TimeProfilePriceFeatures.Count > 0)
                        {
                            <div class="input-card-shade input-card-shade-a">
                                <div class="input-shade-label">PRICE</div>
                                <div class="input-scalars">
                                    @foreach (var f in TimeProfilePriceFeatures)
                                    {
                                        <div class="input-scalar">
                                            <span class="input-scalar-label">@f.Label</span>
                                            <span
                                                class="input-scalar-value @(f.Value switch { > 0 => "input-positive", < 0 => "input-negative", _ => "" })">
                                                @FormatInputValue(f, "N3")
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                        @if (TimeProfileTimeFeatures.Count > 0)
                        {
                            <div class="input-card-shade input-card-shade-b">
                                <div class="input-shade-label">TIME</div>
                                <div class="input-scalars">
                                    @foreach (var f in TimeProfileTimeFeatures)
                                    {
                                        <div class="input-scalar">
                                            <span class="input-scalar-label">@f.Label</span>
                                            <span
                                                class="input-scalar-value @(f.Value switch { > 0 => "input-positive", < 0 => "input-negative", _ => "" })">
                                                @FormatInputValue(f, "N3")
                                            </span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    </div>
                }

                @if (TraderStateFeatures.Count > 0)
                {
                    <div class="input-card input-card-trader-state">
                        <div class="input-card-label">TRADER STATE</div>
                        <div class="input-card-body">
                            <div class="input-scalars">
                                @foreach (var f in TraderStateFeatures)
                                {
                                    <div class="input-scalar">
                                        <span class="input-scalar-label">@f.Label</span>
                                        <span
                                            class="input-scalar-value @(f.Value switch { > 0 => "input-positive", < 0 => "input-negative", _ => "" })">
                                            @FormatInputValue(f, "N3")
                                        </span>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
}
