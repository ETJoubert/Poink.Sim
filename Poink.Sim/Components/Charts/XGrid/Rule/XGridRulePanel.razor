@namespace Poink.Sim.Components.Charts

<div class="xgrid-rule-panel" title="Above/In/Below mask over every XGrid signal, its live state, and whether they match. Each signal can only be in one state at a time, so a row is a 3-way choice">
    <div class="xgrid-rule-toolbar">
        <button type="button" class="xgrid-rule-copy" @onclick="CopyLiveToSelector" disabled="@(Grid is null)"
                title="Copy the live grid's current Above/In/Below state into the selector for every row">Copy Live</button>
        <label class="xgrid-rule-percent" title="Top-percent cutoff used by the Top % Total/Up/Down rows">
            Top %
            <input type="number" min="0" max="100" step="1" @bind="_percent" />
        </label>
    </div>

    <div class="xgrid-rule-body">
        <div class="xgrid-rule-col xgrid-rule-col-input">
            <span class="xgrid-rule-col-title">Select</span>
            <XGridSignalInputTable @bind-EnabledKeys="EnabledKeys" Mode="XGridSignalInputMode.Exclusive" />
        </div>
        <div class="xgrid-rule-col xgrid-rule-col-output">
            <span class="xgrid-rule-col-title">Live</span>
            <XGridSignalOutputTable ValueOf="LiveValue" />
        </div>
        <div class="xgrid-rule-col xgrid-rule-col-match">
            <span class="xgrid-rule-col-title @(IsMatching ? "matching" : "")"
                  title="Whether the selected constraint currently matches the live grid -- lights up when every selected row matches">Match</span>
            <table class="xgrid-rule-match-table">
                <thead>
                    <tr>
                        <th class="xgrid-rule-match-head"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in XGridRuleCatalog.Rows)
                    {
                        <tr>
                            <td class="xgrid-rule-match-cell">
                                <span class="xgrid-rule-match-dot @MatchStatus(row)"></span>
                            </td>
                        </tr>
                    }
                </tbody>
                <tfoot>
                    <tr>
                        <td class="xgrid-rule-foot-count" title="Rows currently matching the live grid, out of rows with a selection">
                            @MatchedCount/@SelectedCount
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <div class="xgrid-rule-log" title="Timestamp of the bar each time every enabled signal matched at once">
        <div class="xgrid-rule-log-headrow">
            <span class="xgrid-rule-log-header">Match Log</span>
            <span class="xgrid-rule-log-total" title="Total number of times every enabled signal has matched at once">Total: @_totalMatches</span>
        </div>
        @if (_matchLog.Count == 0)
        {
            <span class="xgrid-rule-log-empty">No matches yet</span>
        }
        else
        {
            <ul class="xgrid-rule-log-list">
                @foreach (var timestamp in _matchLog)
                {
                    <li class="xgrid-rule-log-item">@timestamp.ToString("yyyy-MM-dd HH:mm:ss")</li>
                }
            </ul>
        }
    </div>
</div>
