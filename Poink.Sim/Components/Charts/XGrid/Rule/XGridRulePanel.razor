@namespace Poink.Sim.Components.Charts

<div class="xgrid-rule-panel" title="Above/In/Below mask over every XGrid signal, its live state, and whether they match. Each signal can only be in one state at a time, so a row is a 3-way choice">
    <div class="xgrid-rule-toolbar">
        <span class="xgrid-rule-toolbar-status @(IsMatching ? "matching" : "")">@(IsMatching ? "MATCH" : "NO MATCH")</span>
        <span class="xgrid-rule-toolbar-count" title="Rows currently matching the live grid, out of rows with a selection">@MatchedCount/@SelectedCount</span>
        <button type="button" class="xgrid-rule-copy" @onclick="CopyLiveToSelector" disabled="@(Grid is null)"
                title="Copy the live grid's current Above/In/Below state into the selector for every row">Copy Live</button>
        <label class="xgrid-rule-percent" title="Top-percent cutoff used by the Top % Total/Up/Down rows">
            Top %
            <input type="number" min="0" max="100" step="1" @bind="_percent" />
        </label>
    </div>
    <table class="xgrid-rule-table">
        <thead>
            <tr>
                <th class="xgrid-rule-head-signal" rowspan="2">Signal</th>
                <th class="xgrid-rule-head-group" colspan="3">Select</th>
                <th class="xgrid-rule-head-group xgrid-rule-divider" colspan="3">Live</th>
                <th class="xgrid-rule-divider" rowspan="2" title="Whether the selected constraint currently matches the live grid">Match</th>
            </tr>
            <tr>
                <th title="Select this row's constraint as the subject being above its reference price">&#9650;</th>
                <th title="Select this row's constraint as the subject's row matching its reference's row">In</th>
                <th title="Select this row's constraint as the subject being below its reference price">&#9660;</th>
                <th class="xgrid-rule-divider" title="Live: the subject is currently above its reference price">&#9650;</th>
                <th title="Live: the subject's row currently matches its reference's row">In</th>
                <th title="Live: the subject is currently below its reference price">&#9660;</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Rows)
            {
                <tr class="xgrid-rule-row" style="--sig-color: var(@row.ColorVar)">
                    <td class="xgrid-rule-label">@row.Label</td>
                    <td class="xgrid-rule-cell">
                        @if (row.AboveKey is { } aboveKey)
                        {
                            <button type="button" class="xgrid-rule-arrow @(IsSelected(aboveKey) ? "active" : "")"
                                    @onclick="() => Select(row, aboveKey)" title="@Tooltip(aboveKey)">&#9650;</button>
                        }
                    </td>
                    <td class="xgrid-rule-cell">
                        @if (row.InKey is { } inKey)
                        {
                            <button type="button" class="xgrid-rule-radio @(IsSelected(inKey) ? "active" : "")"
                                    @onclick="() => Select(row, inKey)" title="@Tooltip(inKey)"></button>
                        }
                    </td>
                    <td class="xgrid-rule-cell">
                        @if (row.BelowKey is { } belowKey)
                        {
                            <button type="button" class="xgrid-rule-arrow @(IsSelected(belowKey) ? "active" : "")"
                                    @onclick="() => Select(row, belowKey)" title="@Tooltip(belowKey)">&#9660;</button>
                        }
                    </td>
                    <td class="xgrid-rule-cell xgrid-rule-divider">
                        @if (row.AboveKey is { } liveAbove)
                        {
                            <span class="xgrid-rule-live-arrow @(LiveValue(liveAbove) ? "on" : "")">&#9650;</span>
                        }
                    </td>
                    <td class="xgrid-rule-cell">
                        @if (row.InKey is { } liveIn)
                        {
                            <span class="xgrid-rule-live-dot @(LiveValue(liveIn) ? "on" : "")"></span>
                        }
                    </td>
                    <td class="xgrid-rule-cell">
                        @if (row.BelowKey is { } liveBelow)
                        {
                            <span class="xgrid-rule-live-arrow @(LiveValue(liveBelow) ? "on" : "")">&#9660;</span>
                        }
                    </td>
                    <td class="xgrid-rule-cell xgrid-rule-divider">
                        <span class="xgrid-rule-match-dot @MatchStatus(row)"></span>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <div class="xgrid-rule-log" title="Timestamp of the bar each time every enabled signal matched at once">
        <span class="xgrid-rule-log-header">Match Log</span>
        @if (_matchLog.Count == 0)
        {
            <span class="xgrid-rule-log-empty">No matches yet</span>
        }
        else
        {
            <ul class="xgrid-rule-log-list">
                @foreach (var timestamp in _matchLog)
                {
                    <li class="xgrid-rule-log-item">@timestamp.ToString("yyyy-MM-dd HH:mm:ss")</li>
                }
            </ul>
        }
    </div>
</div>
