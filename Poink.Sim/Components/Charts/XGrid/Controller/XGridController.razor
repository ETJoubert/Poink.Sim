@namespace Poink.Sim.Components.Charts
@using Poink.Sim.Components.Shared.Differentials
@using Poink.Sim.Components.Shared.Measurements

<div class="xgrid-controller-wrapper">
    <div class="xgrid-controller-row">
        <XGrid @ref="_xGrid" Grid="Grid" PipCount="PipCount" PipCountChanged="SetPipCount"
               ColCount="ColCount" ColCountChanged="SetColCount" ProfileBarCount="ProfileBarCount" Display="EffectiveDisplay" DisplayChanged="SetDisplay"
               ShowOverlayRow="Indicators is null" Spectrum="_spectrum" SpectrumChanged="SetSpectrum"
               LowPointOverlay="_lowPointOverlay" LowPointOverlayChanged="SetLowPointOverlay"
               HighPointOverlay="_highPointOverlay" HighPointOverlayChanged="SetHighPointOverlay"
               ExpandedControls="ExpandedControls" Lines="Lines" OnLineDrawn="OnLineDrawn"
               Positions="Positions" OnOrderPlaced="OnOrderPlaced" Pending="Pending"
               OnPendingModified="OnPendingModified" OnPendingCancelled="OnPendingCancelled"
               OnPositionClosed="OnPositionClosed" ExternalDraft="ExternalDraft" PipSize="PipSize"
               SelectionChanged="SetSelections" />
        @if (_selections.Count > 0)
        {
            <div class="xgrid-controller-side">
                <MeasurementsPanel Title="@XGridMeasurementHelper.Title(_selections)" Columns="MeasurementColumns" OnRemove="RemoveSelection" />
                <DifferentialsPanel Pairs="DifferentialPairs" PipSize="PipSize" />
            </div>
        }
    </div>
</div>
