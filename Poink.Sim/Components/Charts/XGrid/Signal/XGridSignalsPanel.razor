@namespace Poink.Sim.Components.Charts

<div class="xgrid-signals-wrapper" title="Whether the current cell/price matches each signal's Above/In/Below state">
    <table class="xgrid-signals-table">
        <thead>
            <tr>
                <th class="xgrid-signals-head-signal">Signal</th>
                <th title="Above">&#9650;</th>
                <th title="In">In</th>
                <th title="Below">&#9660;</th>
            </tr>
        </thead>
        <tbody>
            <tr class="xgrid-signals-row" style="--sig-color: var(--color-secondary)">
                <td class="xgrid-signals-label">TOTAL</td>
                <td class="xgrid-signals-cell"></td>
                <td class="xgrid-signals-cell" title="Current cell in the top @Spectrum.TotalPercent% by total tick count">
                    <span class="xgrid-signals-dot @(CurrentSignal(XGridSpectrumMetric.Total) ? "on" : "")"></span>
                </td>
                <td class="xgrid-signals-cell"></td>
            </tr>
            <tr class="xgrid-signals-row" style="--sig-color: var(--color-success)">
                <td class="xgrid-signals-label">UP</td>
                <td class="xgrid-signals-cell"></td>
                <td class="xgrid-signals-cell" title="Current cell in the top @Spectrum.UpPercent% by up-tick count">
                    <span class="xgrid-signals-dot @(CurrentSignal(XGridSpectrumMetric.Up) ? "on" : "")"></span>
                </td>
                <td class="xgrid-signals-cell"></td>
            </tr>
            <tr class="xgrid-signals-row" style="--sig-color: var(--color-error)">
                <td class="xgrid-signals-label">DOWN</td>
                <td class="xgrid-signals-cell"></td>
                <td class="xgrid-signals-cell" title="Current cell in the top @Spectrum.DownPercent% by down-tick count">
                    <span class="xgrid-signals-dot @(CurrentSignal(XGridSpectrumMetric.Down) ? "on" : "")"></span>
                </td>
                <td class="xgrid-signals-cell"></td>
            </tr>
            <tr class="xgrid-signals-row">
                <td class="xgrid-signals-label">&Delta;</td>
                <td class="xgrid-signals-cell" style="--sig-color: var(--color-badge-1)" title="Current price's cell is in the top @Spectrum.DeltaPosPercent% most buy-heavy cells by up-minus-down delta">
                    <span class="xgrid-signals-arrow @(CurrentDeltaSignal(true) ? "on" : "")">&#9650;</span>
                </td>
                <td class="xgrid-signals-cell"></td>
                <td class="xgrid-signals-cell" style="--sig-color: var(--color-badge-3)" title="Current price's cell is in the top @Spectrum.DeltaNegPercent% most sell-heavy cells by down-minus-up delta">
                    <span class="xgrid-signals-arrow @(CurrentDeltaSignal(false) ? "on" : "")">&#9660;</span>
                </td>
            </tr>
            <tr class="xgrid-signals-row" style="--sig-color: var(--color-badge-1)">
                <td class="xgrid-signals-label">REG</td>
                <td class="xgrid-signals-cell" title="Current price is above the linear regression line fitted over the trailing window">
                    <span class="xgrid-signals-arrow @(CurrentAboveRegressionSignal ? "on" : "")">&#9650;</span>
                </td>
                <td class="xgrid-signals-cell"></td>
                <td class="xgrid-signals-cell" title="Current price is below the linear regression line fitted over the trailing window">
                    <span class="xgrid-signals-arrow @(CurrentBelowRegressionSignal ? "on" : "")">&#9660;</span>
                </td>
            </tr>
            @foreach (var row in PositionRows)
            {
                <tr class="xgrid-signals-row" style="--sig-color: var(@row.ColorVar)">
                    <td class="xgrid-signals-label">@row.Label</td>
                    <td class="xgrid-signals-cell" title="@row.AboveTooltip">
                        <span class="xgrid-signals-arrow @(row.Above ? "on" : "")">&#9650;</span>
                    </td>
                    <td class="xgrid-signals-cell" title="@row.InTooltip">
                        <span class="xgrid-signals-dot @(row.In ? "on" : "")"></span>
                    </td>
                    <td class="xgrid-signals-cell" title="@row.BelowTooltip">
                        <span class="xgrid-signals-arrow @(row.Below ? "on" : "")">&#9660;</span>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
