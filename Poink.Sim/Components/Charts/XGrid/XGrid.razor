@namespace Poink.Sim.Components.Charts
@using System.Globalization

<div class="xgrid-wrapper @(_expanded ? "expanded" : "")">
    <div class="xgrid-header">
        <span class="xgrid-title">X GRID</span>
        <div class="xgrid-header-actions">
            <label class="xgrid-control" title="Pips per row -- multiplied by the instrument's pip size for each row's fixed price height. Rows snap to an absolute price grid, so the row count is derived from the range rather than fixed">
                <span>Pips</span>
                <input type="number" min="1" max="200" @bind:get="PipCount" @bind:set="SetPipCount" @bind:event="oninput" />
                @if (Grid is { } rowGrid)
                {
                    <span class="xgrid-control-readout" title="Fixed price height of one row">@RowHeightLabel(rowGrid)</span>
                }
            </label>
            <label class="xgrid-control" title="Number of bar groups (columns) -- bars are merged evenly when the selection holds more than this">
                <span>Cols</span>
                <input type="number" min="1" max="500" @bind:get="ColCount" @bind:set="SetColCount" @bind:event="oninput" />
                @if (Grid is { } colGrid)
                {
                    <span class="xgrid-control-readout" title="Average time span of one column">@ColumnWidthLabel(colGrid)</span>
                }
            </label>
            <button class="xgrid-expand-btn" @onclick="ToggleExpanded"
                    title="@(_expanded ? "Shrink the X Grid back into its panel" : "Expand the X Grid to a large overlay")">
                @(_expanded ? "✕" : "⤢")
            </button>
        </div>
    </div>
    @if (_expanded && ExpandedControls is not null)
    {
        <div class="xgrid-expanded-bar">
            @ExpandedControls
        </div>
    }
    <div class="xgrid-overlay-row">
        <span class="xgrid-overlay-label" title="Shades each price row by how many times it was the POC while dragging the Volume Range's near border across every bar position. L->R pins the far border at the range's right edge; R->L pins it at the left edge; Sum combines both.">Sweep</span>
        <div class="xgrid-sweep-toggle">
            <button class="@(_sweepMode == SweepMode.None ? "active" : "")" @onclick="() => _sweepMode = SweepMode.None"
                    title="Don't shade the grid by sweep occurrences">None</button>
            <button class="@(_sweepMode == SweepMode.LeftToRight ? "active" : "")" @onclick="() => _sweepMode = SweepMode.LeftToRight"
                    title="Shade by POC occurrences while sweeping the Volume Range's left border rightward, right border pinned">L-&gt;R</button>
            <button class="@(_sweepMode == SweepMode.RightToLeft ? "active" : "")" @onclick="() => _sweepMode = SweepMode.RightToLeft"
                    title="Shade by POC occurrences while sweeping the Volume Range's right border leftward, left border pinned">R-&gt;L</button>
            <button class="@(_sweepMode == SweepMode.Sum ? "active" : "")" @onclick="() => _sweepMode = SweepMode.Sum"
                    title="Shade by the combined L->R and R->L occurrence counts">Sum</button>
        </div>
        <span class="xgrid-delta-label" title="Shade each block by its up-minus-down tick balance instead of its raw tick count.">Delta</span>
        <button class="xgrid-delta-toggle @(_shadeDelta ? "active" : "")" @onclick="() => _shadeDelta = !_shadeDelta"
                title="Shade each block green when up ticks lead, red when down ticks lead, brighter with a larger imbalance. Replaces the tick-count shading while active.">Up/Dn</button>
        <button class="xgrid-delta-toggle @(_distanceWeighted ? "active" : "")" @onclick="() => _distanceWeighted = !_distanceWeighted"
                title="Weight each tick by the price distance it moved instead of counting it as one. Applies to whichever shading mode is active.">&times;Dist</button>
    </div>
    <div class="xgrid-spectrum-row">
        <span class="xgrid-delta-label" title="Percent of highest-volume cells to highlight, ranked by total tick count">Total %</span>
        <label class="xgrid-control" title="Percent of highest-volume cells to highlight, ranked by total tick count -- 10 highlights the top 10%">
            <input type="number" min="0" max="100" step="1" @bind="_spectrum.Percent" @bind:event="oninput" />
            <span>%</span>
        </label>
        <button class="xgrid-delta-toggle @(_spectrum.ShowHighlight ? "active" : "")" @onclick="() => _spectrum.ShowHighlight = !_spectrum.ShowHighlight"
                title="Highlight the border of the top @_spectrum.Percent% of cells by total tick count, and mark that cutoff on the Spectrum graph">Highlight</button>

        <span class="xgrid-delta-label xgrid-delta-label-up" title="Percent of highest up-tick cells to highlight, ranked by up-tick count">Up %</span>
        <label class="xgrid-control" title="Percent of highest up-tick cells to highlight, ranked by up-tick count -- 10 highlights the top 10%">
            <input type="number" min="0" max="100" step="1" @bind="_upSpectrum.Percent" @bind:event="oninput" />
            <span>%</span>
        </label>
        <button class="xgrid-delta-toggle xgrid-delta-toggle-up @(_upSpectrum.ShowHighlight ? "active" : "")" @onclick="() => _upSpectrum.ShowHighlight = !_upSpectrum.ShowHighlight"
                title="Highlight the border of the top @_upSpectrum.Percent% of cells by up-tick count, and mark that cutoff on the Up Spectrum graph">Highlight</button>

        <span class="xgrid-delta-label xgrid-delta-label-down" title="Percent of highest down-tick cells to highlight, ranked by down-tick count">Down %</span>
        <label class="xgrid-control" title="Percent of highest down-tick cells to highlight, ranked by down-tick count -- 10 highlights the top 10%">
            <input type="number" min="0" max="100" step="1" @bind="_downSpectrum.Percent" @bind:event="oninput" />
            <span>%</span>
        </label>
        <button class="xgrid-delta-toggle xgrid-delta-toggle-down @(_downSpectrum.ShowHighlight ? "active" : "")" @onclick="() => _downSpectrum.ShowHighlight = !_downSpectrum.ShowHighlight"
                title="Highlight the border of the top @_downSpectrum.Percent% of cells by down-tick count, and mark that cutoff on the Down Spectrum graph">Highlight</button>
    </div>
    <div class="xgrid-levels-row">
        <label class="xgrid-level-toggle xgrid-level-toggle-poc" title="Highlight the Point of Control row -- the price with the most volume in the range">
            <input type="checkbox" @bind="_showPoc" /><span>POC</span>
        </label>
        <label class="xgrid-level-toggle xgrid-level-toggle-vah" title="Highlight the row containing Value Area High">
            <input type="checkbox" @bind="_showVah" /><span>VAH</span>
        </label>
        <label class="xgrid-level-toggle xgrid-level-toggle-val" title="Highlight the row containing Value Area Low">
            <input type="checkbox" @bind="_showVal" /><span>VAL</span>
        </label>
        <label class="xgrid-level-toggle xgrid-level-toggle-vwap" title="Highlight the row containing the range's volume-weighted average price">
            <input type="checkbox" @bind="_showVwap" /><span>VWAP</span>
        </label>
        <label class="xgrid-level-toggle xgrid-level-toggle-avg" title="Highlight the row containing the range's mean price">
            <input type="checkbox" @bind="_showAverage" /><span>AVG</span>
        </label>
        <label class="xgrid-level-toggle xgrid-level-toggle-med" title="Highlight the row containing the range's median price">
            <input type="checkbox" @bind="_showMedian" /><span>MED</span>
        </label>
    </div>
    <div class="xgrid-draw-row">
        <span class="xgrid-draw-label" title="Draw lines over the grid. In Line mode, click a start cell then an end cell to place a segment; the endpoints' borders highlight. Click a bottom-margin cell for a vertical line, a left-margin cell for a horizontal line. Hover a line for its start/end time and price. Right-click a line to remove it.">Draw</span>
        <button class="xgrid-draw-toggle @(_lineMode ? "active" : "")" @onclick="ToggleLineMode"
                title="@(_lineMode ? "Exit the line tool -- return to plain hovering" : "Line tool -- click a start cell then an end cell to place a segment")">Line</button>
        <button class="xgrid-draw-clear" @onclick="ClearLines"
                title="Remove every line you have drawn -- host-supplied lines are left intact">Clear</button>
    </div>
    @if (Grid is not { } grid)
    {
        <div class="xgrid-empty">select a Volume Range to build the grid</div>
    }
    else
    {
        <div class="xgrid-totals-row">
            <span class="xgrid-total xgrid-total-up" title="SBuy -- sum of the price before every up tick across the range">SBuy @grid.SBuy.ToString("F5", CultureInfo.InvariantCulture)</span>
            <span class="xgrid-total xgrid-total-down" title="SSell -- sum of the price before every down tick across the range">SSell @grid.SSell.ToString("F5", CultureInfo.InvariantCulture)</span>
            <span class="xgrid-total xgrid-total-net" title="Net = SBuy minus SSell">Net @((grid.SBuy - grid.SSell).ToString("F5", CultureInfo.InvariantCulture))</span>
            <button class="xgrid-total-toggle @(_showNetGraph ? "active" : "")" @onclick="() => _showNetGraph = !_showNetGraph"
                    title="Plot cumulative Net (SBuy - SSell) across the range as a line graph">Graph</button>
            <button class="xgrid-total-toggle @(_spectrum.ShowGraph ? "active" : "")" @onclick="() => _spectrum.ShowGraph = !_spectrum.ShowGraph"
                    title="Plot every cell's total tick count ordered least to most, with a marker showing where the current cell (the cell the price is at) falls on that range">Spectrum</button>
            <button class="xgrid-total-toggle @(_upSpectrum.ShowGraph ? "active" : "")" @onclick="() => _upSpectrum.ShowGraph = !_upSpectrum.ShowGraph"
                    title="Plot every cell's up-tick count ordered least to most, with a marker showing where the current cell falls on that range">Up Spectrum</button>
            <button class="xgrid-total-toggle @(_downSpectrum.ShowGraph ? "active" : "")" @onclick="() => _downSpectrum.ShowGraph = !_downSpectrum.ShowGraph"
                    title="Plot every cell's down-tick count ordered least to most, with a marker showing where the current cell falls on that range">Down Spectrum</button>
        </div>
        @if (_showNetGraph)
        {
            <div class="xgrid-netgraph" title="Cumulative Net per column as bars, one bar per grid column; green above zero, red below; solid line marks zero, vertical lines mark where Net crosses zero">
                <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                    @foreach (var bar in NetGraphBars(grid))
                    {
                        <rect class="@(bar.Positive ? "xgrid-netgraph-bar-up" : "xgrid-netgraph-bar-down")"
                              x="@bar.X" y="@bar.Y" width="@bar.Width" height="@bar.Height" />
                    }
                    <line class="xgrid-netgraph-zero" x1="0" y1="@NetGraphZeroY(grid)" x2="100" y2="@NetGraphZeroY(grid)" />
                    @foreach (var x in NetGraphZeroCrossings(grid))
                    {
                        <line class="xgrid-netgraph-cross" x1="@x" y1="0" x2="@x" y2="100" />
                    }
                </svg>
            </div>
        }
        @if (_spectrum.ShowGraph)
        {
            <div class="xgrid-spectrum" title="Every cell's total tick count across the range, ordered least to most; the guide line marks where the current cell (the cell the price is at) falls on that range, the dashed line the top-percent highlight cutoff">
                <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                    <polygon class="xgrid-spectrum-area" points="@SpectrumAreaPoints(grid, XGridSpectrumMetric.Total)" />
                    <polyline class="xgrid-spectrum-curve" points="@SpectrumCurvePoints(grid, XGridSpectrumMetric.Total)" />
                    @if (SpectrumThresholdX(grid, XGridSpectrumMetric.Total) is { } totalThresholdX)
                    {
                        <line class="xgrid-spectrum-threshold" x1="@totalThresholdX" y1="0" x2="@totalThresholdX" y2="100" />
                    }
                    @if (SpectrumMarkerX(grid, XGridSpectrumMetric.Total) is { } totalMarkerX)
                    {
                        <line class="xgrid-spectrum-guide" x1="@totalMarkerX" y1="0" x2="@totalMarkerX" y2="100" />
                    }
                </svg>
            </div>
        }
        @if (_upSpectrum.ShowGraph)
        {
            <div class="xgrid-spectrum" title="Every cell's up-tick count across the range, ordered least to most; the guide line marks where the current cell falls on that range, the dashed line the top-percent highlight cutoff">
                <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                    <polygon class="xgrid-spectrum-area xgrid-spectrum-area-up" points="@SpectrumAreaPoints(grid, XGridSpectrumMetric.Up)" />
                    <polyline class="xgrid-spectrum-curve xgrid-spectrum-curve-up" points="@SpectrumCurvePoints(grid, XGridSpectrumMetric.Up)" />
                    @if (SpectrumThresholdX(grid, XGridSpectrumMetric.Up) is { } upThresholdX)
                    {
                        <line class="xgrid-spectrum-threshold" x1="@upThresholdX" y1="0" x2="@upThresholdX" y2="100" />
                    }
                    @if (SpectrumMarkerX(grid, XGridSpectrumMetric.Up) is { } upMarkerX)
                    {
                        <line class="xgrid-spectrum-guide" x1="@upMarkerX" y1="0" x2="@upMarkerX" y2="100" />
                    }
                </svg>
            </div>
        }
        @if (_downSpectrum.ShowGraph)
        {
            <div class="xgrid-spectrum" title="Every cell's down-tick count across the range, ordered least to most; the guide line marks where the current cell falls on that range, the dashed line the top-percent highlight cutoff">
                <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                    <polygon class="xgrid-spectrum-area xgrid-spectrum-area-down" points="@SpectrumAreaPoints(grid, XGridSpectrumMetric.Down)" />
                    <polyline class="xgrid-spectrum-curve xgrid-spectrum-curve-down" points="@SpectrumCurvePoints(grid, XGridSpectrumMetric.Down)" />
                    @if (SpectrumThresholdX(grid, XGridSpectrumMetric.Down) is { } downThresholdX)
                    {
                        <line class="xgrid-spectrum-threshold" x1="@downThresholdX" y1="0" x2="@downThresholdX" y2="100" />
                    }
                    @if (SpectrumMarkerX(grid, XGridSpectrumMetric.Down) is { } downMarkerX)
                    {
                        <line class="xgrid-spectrum-guide" x1="@downMarkerX" y1="0" x2="@downMarkerX" y2="100" />
                    }
                </svg>
            </div>
        }
        <div class="xgrid-scroll">
            <div class="xgrid-canvas-wrap">
                <canvas class="xgrid-canvas" @ref="_canvasRef"></canvas>
                <div class="xgrid-cell-tip"></div>
            </div>
            <div class="xgrid-price-axis">
                <span class="xgrid-price xgrid-price-high" title="Highest price in the grid range">@(grid.RowHigh.Count > 0 ? grid.RowHigh[0].ToString("F5", CultureInfo.InvariantCulture) : "--")</span>
                <span class="xgrid-price xgrid-price-current" title="Current price -- the range's latest bar close">@(grid.Current is { } cur ? cur.Price.ToString("F5", CultureInfo.InvariantCulture) : "--")</span>
                <span class="xgrid-price xgrid-price-low" title="Lowest price in the grid range">@(grid.RowLow.Count > 0 ? grid.RowLow[^1].ToString("F5", CultureInfo.InvariantCulture) : "--")</span>
                @if (_order is { } order)
                {
                    <div class="xgrid-order-panel" style="--xgrid-order-top: @OrderPanelTopPercent(grid).ToString("0.##", CultureInfo.InvariantCulture)%">
                        <div class="xgrid-order-head">
                            <span class="xgrid-order-tag">@PanelTag</span>
                            <button class="xgrid-order-close" @onclick="CancelOrder" title="Dismiss this panel without changing the order">&times;</button>
                        </div>
                        <span class="xgrid-order-price" title="@(_panelMode == OrderPanelMode.New ? "Entry price -- the middle price of the clicked cell" : _panelMode == OrderPanelMode.Pending ? "Trigger price of the resting order" : "Entry price of the open position")">@order.EntryPrice.ToString("F5", CultureInfo.InvariantCulture)</span>

                        @if (_panelMode == OrderPanelMode.New)
                        {
                            <button class="xgrid-order-dir @(order.IsLong ? "long" : "short")" @onclick="ToggleOrderDirection"
                                    title="Toggle the order direction between long and short">@(order.IsLong ? "LONG" : "SHORT")</button>
                        }
                        else
                        {
                            <span class="xgrid-order-dir static @(order.IsLong ? "long" : "short")" title="Order direction">@(order.IsLong ? "LONG" : "SHORT")</span>
                        }

                        @if (_panelMode != OrderPanelMode.Open)
                        {
                            <label class="xgrid-order-vol" title="Order volume">
                                <span>Vol</span>
                                <input type="number" min="0" step="0.01" @bind="order.Volume" @bind:event="oninput" />
                            </label>
                            <div class="xgrid-order-sltp">
                                <div class="xgrid-order-lvl">
                                    <button class="xgrid-order-sl @(_orderArm == OrderArm.StopLoss ? "arming" : "") @(order.StopLoss is not null ? "set" : "")" @onclick="ArmStopLoss"
                                            title="@(order.StopLoss is { } s ? $"Stop loss at {s.ToString("F5", CultureInfo.InvariantCulture)} -- click SL then a right-margin cell to move it" : "Arm stop loss -- then click a right-margin cell to set its price")">SL</button>
                                    @if (order.StopLoss is not null)
                                    {
                                        <button class="xgrid-order-clear" @onclick="ClearStopLoss" title="Clear the stop loss">&times;</button>
                                    }
                                </div>
                                <div class="xgrid-order-lvl">
                                    <button class="xgrid-order-tp @(_orderArm == OrderArm.TakeProfit ? "arming" : "") @(order.TakeProfit is not null ? "set" : "")" @onclick="ArmTakeProfit"
                                            title="@(order.TakeProfit is { } t ? $"Take profit at {t.ToString("F5", CultureInfo.InvariantCulture)} -- click TP then a right-margin cell to move it" : "Arm take profit -- then click a right-margin cell to set its price")">TP</button>
                                    @if (order.TakeProfit is not null)
                                    {
                                        <button class="xgrid-order-clear" @onclick="ClearTakeProfit" title="Clear the take profit">&times;</button>
                                    }
                                </div>
                            </div>
                        }

                        @if (_panelMode == OrderPanelMode.New)
                        {
                            <button class="xgrid-order-place" @onclick="PlaceOrder"
                                    title="Place the order with the current direction, volume, and any stop loss / take profit set">PLACE</button>
                        }
                        else if (_panelMode == OrderPanelMode.Pending)
                        {
                            <button class="xgrid-order-place" @onclick="ApplyModification"
                                    title="Apply the changes -- cancels the resting order and re-places it with the new volume and stop loss / take profit">APPLY</button>
                            <button class="xgrid-order-cancel" @onclick="CancelPending"
                                    title="Cancel this resting order">CANCEL</button>
                        }
                        else
                        {
                            <button class="xgrid-order-cancel" @onclick="ClosePosition"
                                    title="Close this open position at market">CLOSE</button>
                        }
                    </div>
                }
            </div>
            <div class="xgrid-signals" title="Whether the current cell (the cell the price is at right now) ranks in that metric's own top-percent cutoff">
                <div class="xgrid-signal @(CurrentSignal(grid, XGridSpectrumMetric.Total) ? "on" : "")" title="Current cell in the top @_spectrum.Percent% by total tick count">
                    <span class="xgrid-signal-dot"></span>
                    <span>TOTAL</span>
                </div>
                <div class="xgrid-signal xgrid-signal-up @(CurrentSignal(grid, XGridSpectrumMetric.Up) ? "on" : "")" title="Current cell in the top @_upSpectrum.Percent% by up-tick count">
                    <span class="xgrid-signal-dot"></span>
                    <span>UP</span>
                </div>
                <div class="xgrid-signal xgrid-signal-down @(CurrentSignal(grid, XGridSpectrumMetric.Down) ? "on" : "")" title="Current cell in the top @_downSpectrum.Percent% by down-tick count">
                    <span class="xgrid-signal-dot"></span>
                    <span>DOWN</span>
                </div>
                <div class="xgrid-signal-pos xgrid-signal-poc" title="Current price relative to the Point of Control">
                    <span class="xgrid-signal-dot @(XGridStats.IsCurrentAtPoc(grid) ? "on" : "")" title="Current cell is at the POC row"></span>
                    <span>POC</span>
                    <span class="xgrid-signal-arrow @(XGridStats.IsCurrentAbovePoc(grid) ? "on" : "")" title="Current price is above POC">&#9650;</span>
                    <span class="xgrid-signal-arrow @(XGridStats.IsCurrentBelowPoc(grid) ? "on" : "")" title="Current price is below POC">&#9660;</span>
                </div>
                <div class="xgrid-signal-pos xgrid-signal-vah" title="Current price relative to Value Area High">
                    <span class="xgrid-signal-dot @(XGridStats.IsCurrentAtVah(grid) ? "on" : "")" title="Current cell is at the VAH row"></span>
                    <span>VAH</span>
                    <span class="xgrid-signal-arrow @(XGridStats.IsCurrentAboveVah(grid) ? "on" : "")" title="Current price is above VAH">&#9650;</span>
                    <span class="xgrid-signal-arrow @(XGridStats.IsCurrentBelowVah(grid) ? "on" : "")" title="Current price is below VAH">&#9660;</span>
                </div>
                <div class="xgrid-signal-pos xgrid-signal-val" title="Current price relative to Value Area Low">
                    <span class="xgrid-signal-dot @(XGridStats.IsCurrentAtVal(grid) ? "on" : "")" title="Current cell is at the VAL row"></span>
                    <span>VAL</span>
                    <span class="xgrid-signal-arrow @(XGridStats.IsCurrentAboveVal(grid) ? "on" : "")" title="Current price is above VAL">&#9650;</span>
                    <span class="xgrid-signal-arrow @(XGridStats.IsCurrentBelowVal(grid) ? "on" : "")" title="Current price is below VAL">&#9660;</span>
                </div>
                <div class="xgrid-signal-pos xgrid-signal-vwap" title="Current price relative to VWAP">
                    <span class="xgrid-signal-dot @(XGridStats.IsCurrentAtVwap(grid) ? "on" : "")" title="Current cell is at the VWAP row"></span>
                    <span>VWAP</span>
                    <span class="xgrid-signal-arrow @(XGridStats.IsCurrentAboveVwap(grid) ? "on" : "")" title="Current price is above VWAP">&#9650;</span>
                    <span class="xgrid-signal-arrow @(XGridStats.IsCurrentBelowVwap(grid) ? "on" : "")" title="Current price is below VWAP">&#9660;</span>
                </div>
                <div class="xgrid-signal-pos xgrid-signal-vwap-poc" title="VWAP relative to the Point of Control">
                    <span class="xgrid-signal-dot @(XGridStats.IsVwapAtPoc(grid) ? "on" : "")" title="VWAP's row matches the POC row"></span>
                    <span>VWAP/POC</span>
                    <span class="xgrid-signal-arrow @(XGridStats.IsVwapAbovePoc(grid) ? "on" : "")" title="VWAP is above POC">&#9650;</span>
                    <span class="xgrid-signal-arrow @(XGridStats.IsVwapBelowPoc(grid) ? "on" : "")" title="VWAP is below POC">&#9660;</span>
                </div>
                <div class="xgrid-signal-pos xgrid-signal-total-poc" title="This grid's own total tick-count peak row relative to the Point of Control">
                    <span class="xgrid-signal-dot @(XGridStats.IsTotalAtPoc(grid) ? "on" : "")" title="Total peak row matches the POC row"></span>
                    <span>TOTAL/POC</span>
                    <span class="xgrid-signal-arrow @(XGridStats.IsTotalAbovePoc(grid) ? "on" : "")" title="Total peak row is above POC">&#9650;</span>
                    <span class="xgrid-signal-arrow @(XGridStats.IsTotalBelowPoc(grid) ? "on" : "")" title="Total peak row is below POC">&#9660;</span>
                </div>
                <div class="xgrid-signal-pos xgrid-signal-up-poc" title="This grid's own up-tick peak row relative to the Point of Control">
                    <span class="xgrid-signal-dot @(XGridStats.IsUpAtPoc(grid) ? "on" : "")" title="Up peak row matches the POC row"></span>
                    <span>UP/POC</span>
                    <span class="xgrid-signal-arrow @(XGridStats.IsUpAbovePoc(grid) ? "on" : "")" title="Up peak row is above POC">&#9650;</span>
                    <span class="xgrid-signal-arrow @(XGridStats.IsUpBelowPoc(grid) ? "on" : "")" title="Up peak row is below POC">&#9660;</span>
                </div>
                <div class="xgrid-signal-pos xgrid-signal-down-poc" title="This grid's own down-tick peak row relative to the Point of Control">
                    <span class="xgrid-signal-dot @(XGridStats.IsDownAtPoc(grid) ? "on" : "")" title="Down peak row matches the POC row"></span>
                    <span>DOWN/POC</span>
                    <span class="xgrid-signal-arrow @(XGridStats.IsDownAbovePoc(grid) ? "on" : "")" title="Down peak row is above POC">&#9650;</span>
                    <span class="xgrid-signal-arrow @(XGridStats.IsDownBelowPoc(grid) ? "on" : "")" title="Down peak row is below POC">&#9660;</span>
                </div>
            </div>
        </div>
        <div class="xgrid-footer">
            <span class="xgrid-footer-time" title="Oldest bar in the grid range">@(grid.Columns.Count > 0 ? grid.Columns[0].OpenTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) : "--")</span>
            <span class="xgrid-footer-span" title="Time span from the oldest to the latest bar in the grid">@GridTimeSpan(grid) &middot; @GridTickCount(grid).ToString("N0", CultureInfo.InvariantCulture) ticks</span>
            <span class="xgrid-footer-time" title="Latest bar in the grid range">@(grid.Columns.Count > 0 ? grid.Columns[^1].OpenTime.ToString("yyyy-MM-dd HH:mm", CultureInfo.InvariantCulture) : "--")</span>
        </div>
    }
</div>
