@namespace Poink.Sim.Components.Charts
@using System.Globalization

<div class="xgrid-wrapper @(Collapsed ? "xgrid-wrapper-collapsed" : "") @(_expanded ? "expanded" : "")">
    <div class="xgrid-header @(Collapsed ? "xgrid-header-collapsed" : "")">
        @if (!Collapsed)
        {
            <span class="xgrid-title">X GRID</span>
        }
        <div class="xgrid-header-actions">
            @if (!Collapsed)
            {
                <label class="xgrid-control" title="Number of price buckets (rows)">
                    <span>Rows</span>
                    <input type="number" min="1" max="200" @bind:get="RowCount" @bind:set="SetRowCount" @bind:event="oninput" />
                </label>
                <label class="xgrid-control" title="Number of bar groups (columns) -- bars are merged evenly when the selection holds more than this">
                    <span>Cols</span>
                    <input type="number" min="1" max="500" @bind:get="ColCount" @bind:set="SetColCount" @bind:event="oninput" />
                </label>
            }
            @if (!Collapsed)
            {
                <button class="xgrid-expand-btn" @onclick="ToggleExpanded"
                        title="@(_expanded ? "Shrink the X Grid back into its panel" : "Expand the X Grid to a large overlay")">
                    @(_expanded ? "✕" : "⤢")
                </button>
            }
            <button class="xgrid-collapse-btn" @onclick="ToggleCollapsed"
                    title="@(Collapsed ? "Expand the X Grid panel" : "Collapse the X Grid panel to a thin column")">
                @(Collapsed ? "◂" : "▸")
            </button>
        </div>
    </div>
    @if (_expanded && ExpandedControls is not null)
    {
        <div class="xgrid-expanded-bar">
            @ExpandedControls
        </div>
    }
    @if (!Collapsed)
    {
    <div class="xgrid-overlay-row">
        <span class="xgrid-overlay-label" title="Shades each price row by how many times it was the POC while dragging the Volume Range's near border across every bar position. L->R pins the far border at the range's right edge; R->L pins it at the left edge; Sum combines both.">Sweep</span>
        <div class="xgrid-sweep-toggle">
            <button class="@(_sweepMode == SweepMode.None ? "active" : "")" @onclick="() => _sweepMode = SweepMode.None"
                    title="Don't shade the grid by sweep occurrences">None</button>
            <button class="@(_sweepMode == SweepMode.LeftToRight ? "active" : "")" @onclick="() => _sweepMode = SweepMode.LeftToRight"
                    title="Shade by POC occurrences while sweeping the Volume Range's left border rightward, right border pinned">L-&gt;R</button>
            <button class="@(_sweepMode == SweepMode.RightToLeft ? "active" : "")" @onclick="() => _sweepMode = SweepMode.RightToLeft"
                    title="Shade by POC occurrences while sweeping the Volume Range's right border leftward, left border pinned">R-&gt;L</button>
            <button class="@(_sweepMode == SweepMode.Sum ? "active" : "")" @onclick="() => _sweepMode = SweepMode.Sum"
                    title="Shade by the combined L->R and R->L occurrence counts">Sum</button>
        </div>
        <span class="xgrid-delta-label" title="Shade each block by its up-minus-down tick balance instead of its raw tick count.">Delta</span>
        <button class="xgrid-delta-toggle @(_shadeDelta ? "active" : "")" @onclick="() => _shadeDelta = !_shadeDelta"
                title="Shade each block green when up ticks lead, red when down ticks lead, brighter with a larger imbalance. Replaces the tick-count shading while active.">Up/Dn</button>
        <button class="xgrid-delta-toggle @(_distanceWeighted ? "active" : "")" @onclick="() => _distanceWeighted = !_distanceWeighted"
                title="Weight each tick by the price distance it moved instead of counting it as one. Applies to whichever shading mode is active.">&times;Dist</button>
    </div>
    <div class="xgrid-levels-row">
        <label class="xgrid-level-toggle xgrid-level-toggle-poc" title="Highlight the Point of Control row -- the price with the most volume in the range">
            <input type="checkbox" @bind="_showPoc" /><span>POC</span>
        </label>
        <label class="xgrid-level-toggle xgrid-level-toggle-vah" title="Highlight the row containing Value Area High">
            <input type="checkbox" @bind="_showVah" /><span>VAH</span>
        </label>
        <label class="xgrid-level-toggle xgrid-level-toggle-val" title="Highlight the row containing Value Area Low">
            <input type="checkbox" @bind="_showVal" /><span>VAL</span>
        </label>
        <label class="xgrid-level-toggle xgrid-level-toggle-vwap" title="Highlight the row containing the range's volume-weighted average price">
            <input type="checkbox" @bind="_showVwap" /><span>VWAP</span>
        </label>
        <label class="xgrid-level-toggle xgrid-level-toggle-avg" title="Highlight the row containing the range's mean price">
            <input type="checkbox" @bind="_showAverage" /><span>AVG</span>
        </label>
        <label class="xgrid-level-toggle xgrid-level-toggle-med" title="Highlight the row containing the range's median price">
            <input type="checkbox" @bind="_showMedian" /><span>MED</span>
        </label>
    </div>
    @if (Grid is not { } grid)
    {
        <div class="xgrid-empty">select a Volume Range to build the grid</div>
    }
    else
    {
        <div class="xgrid-totals-row">
            <span class="xgrid-total xgrid-total-up" title="SBuy -- sum of the price before every up tick across the range">SBuy @grid.SBuy.ToString("F5", CultureInfo.InvariantCulture)</span>
            <span class="xgrid-total xgrid-total-down" title="SSell -- sum of the price before every down tick across the range">SSell @grid.SSell.ToString("F5", CultureInfo.InvariantCulture)</span>
            <span class="xgrid-total xgrid-total-net" title="Net = SBuy minus SSell">Net @((grid.SBuy - grid.SSell).ToString("F5", CultureInfo.InvariantCulture))</span>
            <button class="xgrid-total-toggle @(_showNetGraph ? "active" : "")" @onclick="() => _showNetGraph = !_showNetGraph"
                    title="Plot cumulative Net (SBuy - SSell) across the range as a line graph">Graph</button>
        </div>
        @if (_showNetGraph)
        {
            <div class="xgrid-netgraph" title="Cumulative Net per column as bars, one bar per grid column; green above zero, red below; solid line marks zero, vertical lines mark where Net crosses zero">
                <svg viewBox="0 0 100 100" preserveAspectRatio="none">
                    @foreach (var bar in NetGraphBars(grid))
                    {
                        <rect class="@(bar.Positive ? "xgrid-netgraph-bar-up" : "xgrid-netgraph-bar-down")"
                              x="@bar.X" y="@bar.Y" width="@bar.Width" height="@bar.Height" />
                    }
                    <line class="xgrid-netgraph-zero" x1="0" y1="@NetGraphZeroY(grid)" x2="100" y2="@NetGraphZeroY(grid)" />
                    @foreach (var x in NetGraphZeroCrossings(grid))
                    {
                        <line class="xgrid-netgraph-cross" x1="@x" y1="0" x2="@x" y2="100" />
                    }
                </svg>
            </div>
        }
        <div class="xgrid-scroll">
            <canvas class="xgrid-canvas" @ref="_canvasRef"></canvas>
            <div class="xgrid-cell-tip"></div>
        </div>
    }
    }
</div>
