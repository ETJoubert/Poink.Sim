@namespace Poink.Sim.Components.Charts
@using Poink.Sim.Models

<div class="tf-snapshot-wrapper">
    <div class="tf-snapshot-header">
        <div class="tf-snapshot-row">
            <span class="tf-snapshot-title">SNAPSHOT</span>
            <div class="tf-snapshot-toggle-group" title="Choose how each snapshot bar is aggregated">
                <button type="button" class="tf-snapshot-toggle @(_barKind == BarAggregationKind.Ohlc ? "active" : "")"
                        @onclick="() => SetBarKind(BarAggregationKind.Ohlc)"
                        title="Draw each bar's real Open/High/Low/Close">OHLC</button>
                <button type="button" class="tf-snapshot-toggle @(_barKind == BarAggregationKind.Quartile ? "active" : "")"
                        @onclick="() => SetBarKind(BarAggregationKind.Quartile)"
                        title="Draw each bar as a box plot of Min/Q1/Median/Q3/Max">Quartile</button>
                <button type="button" class="tf-snapshot-toggle @(_barKind == BarAggregationKind.Decile ? "active" : "")"
                        @onclick="() => SetBarKind(BarAggregationKind.Decile)"
                        title="Draw each bar as a box plot of Min/D1/D9/Max -- a wider 10/90 percentile band than Quartile's 25/75">Decile</button>
                <button type="button" class="tf-snapshot-toggle @(_barKind == BarAggregationKind.MeanStdDev ? "active" : "")"
                        @onclick="() => SetBarKind(BarAggregationKind.MeanStdDev)"
                        title="Draw each bar as a volatility band -- Open/Close at the mean price, High/Low one standard deviation above/below it">Mean&plusmn;SD</button>
            </div>
        </div>
        <div class="tf-snapshot-row tf-snapshot-timeframe-row"
             title="Pick which trailing windows to show -- one bar per selection, all ending at the same anchor time">
            @foreach (var option in SnapshotTimeframeOptions.All)
            {
                @if (SnapshotTimeframeOptions.UnitStarts.Contains(option.Seconds))
                {
                    <span class="tf-snapshot-divider"></span>
                }
                <button type="button" class="tf-snapshot-toggle @(_selectedSeconds.Contains(option.Seconds) ? "active" : "")"
                        @onclick="() => ToggleTimeframe(option.Seconds)"
                        title="@($"Show a {option.Label} trailing window bar ending at the anchor time")">@option.Label</button>
            }
        </div>
    </div>
    <div class="tf-snapshot-chart">
        @if (_error is not null)
        {
            <p class="tf-snapshot-empty">@_error</p>
        }
        else if (_loading && _bars.Count == 0)
        {
            <p class="tf-snapshot-empty">Loading...</p>
        }
        else if (_bars.Count == 0)
        {
            <p class="tf-snapshot-empty">Select at least one timeframe to view its snapshot bar.</p>
        }
        else
        {
            <canvas class="tf-snapshot-canvas" @ref="_canvasRef"></canvas>
        }
    </div>
</div>
