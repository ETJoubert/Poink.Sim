@namespace Poink.Sim.Components.Charts
@using Poink.Sim.Components.Charts

<section class="scmp-set">
    <header class="scmp-header">
        <span class="scmp-title" title="@Description">COMPARE</span>
        <label class="scmp-field" title="What each symbol's % change is measured from">
            Mode
            <select class="scmp-select" value="@Mode" @onchange="OnModeSelected"
                    title="% change: from the first bar in view, re-basing as you pan. Window: from the Lookback Window edge picked under Anchor">
                <option value="@CompareSetMode.PercentChange">% change</option>
                <option value="@CompareSetMode.WindowAnchored">Window</option>
            </select>
        </label>
        <label class="scmp-field" title="Which Lookback Window edge Window mode and the XGrid panel measure % from">
            Anchor
            <select class="scmp-select" value="@Anchor" @onchange="OnAnchorSelected" disabled="@(!AnchorApplies)"
                    title="@(!AnchorApplies
                               ? "Only applies in Window mode or while the XGrid panel is open"
                               : "Start: 0% at the window's left edge. End: 0% at the window's right edge, the same point TxFold anchors at. Also sets the XGrid panel's 0% row")">
                <option value="@CompareSetAnchor.WindowStart">Start</option>
                <option value="@CompareSetAnchor.WindowEnd">End</option>
            </select>
        </label>
        <label class="scmp-field" title="Draw each symbol as a line, or as candles in its own colour">
            Style
            <select class="scmp-select" value="@Style" @onchange="OnStyleSelected"
                    title="Lines: one close line per symbol. Bars: candles in each symbol's colour (up filled, down hollow), semi-transparent so overlaps stay readable">
                <option value="@CompareChartSeriesStyle.Lines">Lines</option>
                <option value="@CompareChartSeriesStyle.Bars">Bars</option>
            </select>
        </label>
        <label class="scmp-field" title="@($"Divides the {PrimaryRole} symbol by a {SecondaryRole} symbol, shown in a lower pane")">
            Ratio @Primary?.Table ÷
            <select class="scmp-select" value="@(HasRatio ? RatioTable : "")" @onchange="OnRatioSelected" disabled="@(Symbols.Count < 2)"
                    title="@(Symbols.Count < 2 ? $"Add a {SecondaryRole} symbol to chart a ratio" : $"Pick the {SecondaryRole} symbol the {PrimaryRole} symbol is divided by, or None to hide the ratio pane")">
                <option value="">None</option>
                @foreach (var symbol in Symbols.Skip(1))
                {
                    <option value="@symbol.Table">@symbol.Table</option>
                }
            </select>
        </label>
        <span class="scmp-note" title="What the % axis is measured from">@ModeNote()</span>
        <div class="scmp-toggles">
            <button type="button" class="scmp-toggle @(TxFold.Show ? "active" : "")"
                    @onclick="() => SetTxFold(TxFold with { Show = !TxFold.Show })"
                    title="Show or hide a TxFold panel comparing every symbol's trailing-window bars at the Lookback Window's right edge">TxFold</button>
            <button type="button" class="scmp-toggle @(XGrid.Show ? "active" : "")"
                    @onclick="() => SetXGrid(XGrid with { Show = !XGrid.Show })"
                    title="Show or hide an XGrid panel overlaying every symbol's tick footprint inside the Lookback Window, on % rows from the Anchor edge">XGrid</button>
        </div>
    </header>
    <div class="scmp-body @(SidePanels.Count > 0 ? "scmp-body-split" : "")" style="@BodyStyle">
        <div @key="CompareSetPanel.Chart" class="@PanelClass(CompareSetPanel.Chart)" style="@PanelStyle(CompareSetPanel.Chart)">
            @if (!IsMain(CompareSetPanel.Chart))
            {
                <div class="scmp-panel-bar">
                    <span class="scmp-panel-label" title="Every symbol on one shared time axis as % change">% CHART</span>
                    <button type="button" class="scmp-make-main" @onclick="() => SetMainPanel(CompareSetPanel.Chart)"
                            title="Move the % chart back to the main area">Make main</button>
                </div>
            }
            <div class="scmp-panel-content">
                <CompareChart Series="_series" ScaleMode="ScaleMode" Style="Style" WindowStart="WindowStart" WindowEnd="WindowEnd"
                              Zones="TxFoldZones()" Markers="TxFoldMarkers()" Tooltip="@ChartTooltip()" />
                <div class="scmp-legend" title="Line colour per symbol">
                    @foreach (var symbol in Symbols)
                    {
                        <span class="scmp-legend-item" style="color: var(@symbol.ColorVar)"
                              title="@($"{symbol.Table} -- {(symbol == Primary ? PrimaryRole : SecondaryRole)}, {symbol.Bars.Count:N0} bars")">@symbol.Table</span>
                    }
                    @if (HasRatio)
                    {
                        <span class="scmp-legend-item" style="color: var(@CompareSetHelper.RatioColorVar)"
                              title="@($"The {PrimaryRole} symbol's close divided by the ratio symbol's close at the same bar time")">
                            @CompareSetHelper.RatioLabel(Primary!.Table, RatioTable!)
                        </span>
                    }
                </div>
            </div>
        </div>
        @if (TxFold.Show)
        {
            <div @key="CompareSetPanel.TxFold" class="@PanelClass(CompareSetPanel.TxFold)" style="@PanelStyle(CompareSetPanel.TxFold)">
                @if (!IsMain(CompareSetPanel.TxFold))
                {
                    <div class="scmp-panel-bar">
                        <span class="scmp-panel-label" title="Every symbol's trailing-window bars at the Lookback Window's right edge">TXFOLD</span>
                        <button type="button" class="scmp-make-main" @onclick="() => SetMainPanel(CompareSetPanel.TxFold)"
                                title="Move TxFold to the main area and the % chart to this side column">Make main</button>
                    </div>
                }
                <div class="scmp-panel-content">
                    <CompareTxFold Symbols="TxFoldSymbols()" AnchorEnd="TxFoldAnchor" RangeStart="RangeStart" HistoryBeforeUtc="HistoryBeforeUtc" TickSource="TxFoldTickSource"
                                   NoAnchorMessage="No bars in the Lookback Window yet -- its right edge anchors every symbol's trailing windows."
                                   SelectedSeconds="TxFoldSeconds" SelectedSecondsChanged="seconds => SetTxFold(TxFold with { Seconds = seconds.Order().ToList() })"
                                   BarKind="TxFold.BarKind" BarKindChanged="kind => SetTxFold(TxFold with { BarKind = kind })"
                                   Layout="TxFold.Layout" LayoutChanged="layout => SetTxFold(TxFold with { Layout = layout })"
                                   ShowVolumeProfile="TxFold.ShowVolumeProfile" ShowVolumeProfileChanged="show => SetTxFold(TxFold with { ShowVolumeProfile = show })" />
                </div>
            </div>
        }
        @if (XGrid.Show)
        {
            <div @key="CompareSetPanel.XGrid" class="@PanelClass(CompareSetPanel.XGrid)" style="@PanelStyle(CompareSetPanel.XGrid)">
                @if (!IsMain(CompareSetPanel.XGrid))
                {
                    <div class="scmp-panel-bar">
                        <span class="scmp-panel-label" title="Every symbol's tick footprint inside the Lookback Window">XGRID</span>
                        <button type="button" class="scmp-make-main" @onclick="() => SetMainPanel(CompareSetPanel.XGrid)"
                                title="Move XGrid to the main area and the % chart to this side column">Make main</button>
                    </div>
                }
                <div class="scmp-panel-content">
                    <CompareXGrid Result="XGridResult" NoDataMessage="@XGridNoDataMessage()"
                                  Mode="XGrid.Mode" ModeChanged="mode => SetXGrid(XGrid with { Mode = mode })"
                                  DifferenceLabel="@XGrid.DifferenceTable" DifferenceLabelChanged="table => SetXGrid(XGrid with { DifferenceTable = table })"
                                  RowPercent="XGrid.RowPercent" RowPercentChanged="rowPercent => SetXGrid(XGrid with { RowPercent = rowPercent })"
                                  ColCount="XGrid.ColCount" ColCountChanged="colCount => SetXGrid(XGrid with { ColCount = colCount })"
                                  ShowProfile="XGrid.ShowProfile" ShowProfileChanged="show => SetXGrid(XGrid with { ShowProfile = show })"
                                  TopCellsPercent="XGrid.TopCellsPercent" TopCellsPercentChanged="percent => SetXGrid(XGrid with { TopCellsPercent = percent })"
                                  LowCellsPercent="XGrid.LowCellsPercent" LowCellsPercentChanged="percent => SetXGrid(XGrid with { LowCellsPercent = percent })" />
                </div>
            </div>
        }
    </div>
</section>
