@namespace Poink.Sim.Components.Charts
@using Poink.Sim.Models

<div class="txf-wrapper">
    <div class="txf-toolbar">
        <div class="txf-row">
            <span class="txf-title">TXFOLD</span>
            <div class="txf-tool-group" title="Choose how each snapshot bar is aggregated">
                <button type="button" class="txf-tool-btn txf-tool-btn-kind @(BarKind == BarAggregationKind.Ohlc ? "active" : "")"
                        @onclick="() => SetBarKind(BarAggregationKind.Ohlc)"
                        title="Draw each bar's real Open/High/Low/Close">OHLC</button>
                <button type="button" class="txf-tool-btn txf-tool-btn-kind @(BarKind == BarAggregationKind.Quartile ? "active" : "")"
                        @onclick="() => SetBarKind(BarAggregationKind.Quartile)"
                        title="Draw each bar as a box plot of Min/Q1/Median/Q3/Max">Quartile</button>
                <button type="button" class="txf-tool-btn txf-tool-btn-kind @(BarKind == BarAggregationKind.Decile ? "active" : "")"
                        @onclick="() => SetBarKind(BarAggregationKind.Decile)"
                        title="Draw each bar as a box plot of Min/D1/D9/Max -- a wider 10/90 percentile band than Quartile's 25/75">Decile</button>
                <button type="button" class="txf-tool-btn txf-tool-btn-kind @(BarKind == BarAggregationKind.MeanStdDev ? "active" : "")"
                        @onclick="() => SetBarKind(BarAggregationKind.MeanStdDev)"
                        title="Draw each bar as a volatility band -- Open/Close at the mean price, High/Low one standard deviation above/below it">Mean&plusmn;SD</button>
            </div>
            <span class="txf-divider"></span>
            <button type="button" class="txf-tool-btn txf-tool-btn-coverage @(ShowHighLowLines ? "active" : "")"
                    @onclick="ToggleHighLowLines"
                    title="Project every bar's High and Low as dashed lines across the whole chart, and show a right-margin histogram of how many bars cover each price -- also adds each bar's true High/Low as two extra network inputs when selected on the Features tab">H/L</button>
            <button type="button" class="txf-tool-btn txf-tool-btn-volume @(ShowVolumeProfile ? "active" : "")"
                    @onclick="ToggleVolumeProfile"
                    title="Overlay a real tick-volume profile in the right margin -- the same price-bucketed tick-count histogram as the Volume profile panel, built from every tick behind the displayed bars -- also adds it as network inputs when selected on the Features tab">Vol Profile</button>
            <button type="button" class="txf-tool-btn txf-tool-btn-normalize @(Normalize ? "active" : "")"
                    @onclick="ToggleNormalize"
                    title="Show every bar as a percentage deviation from the largest selected timeframe's midpoint instead of its real price, with zero centered on the chart -- also normalizes the network inputs the same way when selected on the Features tab">%</button>
            @if (ShowLevelToggles)
            {
                <span class="txf-divider"></span>
                @foreach (var option in TxFoldLevelOptions.All)
                {
                    <button type="button" class="txf-tool-btn txf-tool-btn-level-@(option.Kind.ToString().ToLowerInvariant()) @(ShownLevels.Contains(option.Kind) ? "active" : "")"
                            @onclick="() => ToggleLevel(option.Kind)"
                            title="@option.Tooltip">@option.Label</button>
                }
            }
        </div>
        <div class="txf-row txf-timeframe-row"
             title="Pick which trailing windows to show -- one bar per selection, all ending at the same anchor time">
            @foreach (var option in SnapshotTimeframeOptions.All)
            {
                @if (SnapshotTimeframeOptions.UnitStarts.Contains(option.Seconds))
                {
                    <span class="txf-divider"></span>
                }
                <button type="button" class="txf-tool-btn txf-tool-btn-timeframe @(SelectedSeconds.Contains(option.Seconds) ? "active" : "")"
                        @onclick="() => ToggleTimeframe(option.Seconds)"
                        title="@($"Show a {option.Label} trailing window bar ending at the anchor time")">@option.Label</button>
            }
        </div>
    </div>
    <div class="txf-chart">
        @if (_error is not null)
        {
            <p class="txf-empty">@_error</p>
        }
        else if (_loading && _bars.Count == 0)
        {
            <p class="txf-empty">Loading...</p>
        }
        else if (_bars.Count == 0)
        {
            <p class="txf-empty">Select at least one timeframe to view its snapshot bar.</p>
        }
        else
        {
            <canvas class="txf-canvas" @ref="_canvasRef"></canvas>
        }
    </div>
</div>
