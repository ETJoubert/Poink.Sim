@page "/emulator"
@namespace Poink.Sim.Components.Pages
@using Poink.Sim.Components.Emulator
@using Poink.Sim.Components.Shared.Icon
@using Poink.Sim.Emulator

<div class="emu-page">
    <header class="emu-header">
        <span class="emu-title" title="Brokerage emulator: bots buy and sell a synthetic asset through a broker, and fills move the price">EMULATOR</span>
        <span class="emu-symbol" title="The synthetic asset being emulated">@Snapshot.Symbol</span>
        <span class="emu-stat" title="Last traded price of @Snapshot.Symbol">
            <span class="emu-stat-label">PRICE</span>@FormatPrice(Snapshot.Price)
        </span>
        <span class="emu-stat" title="Best bid and best ask -- the highest buy and lowest sell resting in the book">
            <span class="emu-stat-label">BID / ASK</span>@FormatPrice(Snapshot.Book.BestBid) / @FormatPrice(Snapshot.Book.BestAsk)
        </span>
        <span class="emu-stat" title="Gap between the best ask and the best bid">
            <span class="emu-stat-label">SPREAD</span>@FormatPrice(Snapshot.Book.Spread)
        </span>
        <span class="emu-stat" title="Steps taken since the last reset">
            <span class="emu-stat-label">STEP</span>@Snapshot.Step.ToString("N0")
        </span>
        <span class="emu-stat" title="Market steps actually run per second -- below the chosen speed when the CPU cannot keep up">
            <span class="emu-stat-label">STEPS/S</span>@Emulator.StepsPerSecond.ToString("N0")
        </span>
        <span class="emu-state @(Emulator.IsRunning ? "running" : "")" title="Whether the emulator is stepping on its timer right now, and at what speed">
            @(Emulator.IsRunning ? "RUNNING" : "STOPPED")
        </span>

        <div class="emu-actions">
            @if (Emulator.IsRunning)
            {
                <button type="button" class="emu-btn emu-btn-stop" @onclick="Emulator.Stop"
                        title="Stop stepping the emulator -- the price, book and history are kept">Stop</button>
            }
            else
            {
                <button type="button" class="emu-btn emu-btn-go" @onclick="Emulator.Start"
                        title="Run @Emulator.Settings.SpeedMultiplier.ToString("N0") market step(s) every @Emulator.Settings.TickInterval.TotalMilliseconds.ToString("N0") ms">Start</button>
            }
            <button type="button" class="emu-btn" @onclick="Emulator.Step" disabled="@Emulator.IsRunning"
                    title="Advance the emulator by one step">Step</button>
            <div class="emu-speed" title="Playback speed: market steps per tick, in orders of ten -- changes take effect immediately">
                @foreach (var speed in EmulatorSettings.SpeedMultipliers)
                {
                    <button type="button" class="emu-speed-option @(speed == Emulator.Settings.SpeedMultiplier ? "selected" : "")"
                            @onclick="() => Emulator.SetSpeed(speed)"
                            title="Play at ×@speed.ToString("N0"): @speed.ToString("N0") market step@(speed == 1 ? "" : "s") every @Emulator.Settings.TickInterval.TotalMilliseconds.ToString("N0") ms, or as many as fit in the tick">×@speed.ToString("N0")</button>
                }
            </div>
            <button type="button" class="emu-btn" @onclick="Emulator.Reset"
                    title="Restart the market: fresh bots and broker fund, an empty book and a new warm-up history from the start price">Reset</button>
            <button type="button" class="emu-btn emu-btn-icon" @onclick="OpenSettings" title="Emulator settings: leverage and population size">
                <Icon Name="gear-fill" Class="emu-btn-icon-img" />
            </button>
        </div>
    </header>

    <div class="emu-body">
        <section class="emu-panel emu-market-panel" title="Price history and order book of @Snapshot.Symbol on one shared price scale">
            <EmulatorMarketComponent Snapshot="Snapshot" TickSize="Emulator.Settings.TickSize" />
        </section>

        <section class="emu-panel emu-bots-panel" title="Every bot's account at the broker: position, balance and equity">
            <div class="emu-panel-heading">BOTS</div>
            <EmulatorBotListComponent Bots="Snapshot.Bots" />
        </section>
    </div>

    <div class="emu-lower">
        <section class="emu-panel" title="The bot populations trading through the broker -- each bot sees only the market and its own account">
            <div class="emu-panel-heading">POPULATIONS</div>
            <EmulatorPopulationsComponent Populations="Snapshot.Populations" />
        </section>

        <section class="emu-panel" title="The broker that fills the bots' orders and funds their leverage">
            <div class="emu-panel-heading">BROKER</div>
            <EmulatorBrokerComponent Broker="Snapshot.Broker" />
        </section>
    </div>
</div>

@if (_settingsOpen)
{
    <EmulatorSettingsComponent Settings="Emulator.Settings" OnApply="ApplySettings" OnClose="CloseSettings" />
}
