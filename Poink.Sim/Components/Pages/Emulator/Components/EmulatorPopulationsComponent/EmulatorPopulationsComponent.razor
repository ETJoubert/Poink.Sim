@namespace Poink.Sim.Components.Emulator
@using Poink.Sim.Helpers

<table class="emu-pop-table" title="Each population's bots, their combined account and their trading so far">
    <thead>
        <tr>
            <th title="Population name">POPULATION</th>
            <th title="Bots still trading / bots in the population -- a bot is out once its equity is gone">BOTS</th>
            <th title="Points paid in, in total: starting capital plus every replenish">CAPITAL</th>
            <th title="Cash plus open positions valued at the last price, in total">EQUITY</th>
            <th title="Equity minus capital paid in">P/L</th>
            <th title="Cash in total -- negative cash is points borrowed from the broker for leveraged buys">CASH</th>
            <th title="Units held long in total">LONG</th>
            <th title="Units sold short in total -- borrowed from the broker">SHORT</th>
            <th title="Orders resting on the book">ORDERS</th>
            <th title="Fills received, as buyer or seller">FILLS</th>
            <th title="Times a bot was stopped out for falling below the stop-out margin level">STOP-OUTS</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var population in Populations)
        {
            <tr title="@population.Name population">
                <td class="emu-pop-name" title="Population name">@population.Name</td>
                <td title="@population.ActiveBots of @population.BotCount bots still trading">@population.ActiveBots / @population.BotCount</td>
                <td title="@Amount(population.Capital) points paid in">@EmulatorChartHelper.CompactAmount(population.Capital)</td>
                <td title="@Amount(population.Equity) equity">@EmulatorChartHelper.CompactAmount(population.Equity)</td>
                <td class="@SignClass(population.ProfitLoss)" title="@Amount(population.ProfitLoss) profit/loss">@EmulatorChartHelper.CompactAmount(population.ProfitLoss)</td>
                <td class="@SignClass(population.Cash)" title="@Amount(population.Cash) cash">@EmulatorChartHelper.CompactAmount(population.Cash)</td>
                <td title="@population.LongUnits.ToString("N0") units long">@population.LongUnits.ToString("N0")</td>
                <td title="@population.ShortUnits.ToString("N0") units short">@population.ShortUnits.ToString("N0")</td>
                <td title="@population.OpenOrders.ToString("N0") orders resting">@population.OpenOrders.ToString("N0")</td>
                <td title="@population.Fills.ToString("N0") fills">@population.Fills.ToString("N0")</td>
                <td title="@population.StopOuts.ToString("N0") stop-outs">@population.StopOuts.ToString("N0")</td>
            </tr>
        }
    </tbody>
</table>
