@namespace Poink.Sim.Components.Emulator
@using Poink.Sim.Helpers

<div class="emu-ladder" title="Order book as a price ladder level with the chart: asks (sell orders) above the last price, bids (buy orders) below it, and on the right the bots whose positions were entered at each level">
    <div class="emu-ladder-head" title="Bid volume, price, ask volume and the bots positioned at each price level">
        <span class="emu-ladder-bid">BID</span>
        <span class="emu-ladder-price">PRICE</span>
        <span class="emu-ladder-ask">ASK</span>
        <span class="emu-ladder-pop" title="Positions: bots holding a position entered at the level (their average entry) and the equity they hold between them -- each bot counted once">
            <span class="emu-ladder-bots">POS</span>
            <span class="emu-ladder-equity">EQUITY</span>
        </span>
    </div>
    <div class="emu-ladder-rows" style="grid-template-rows: repeat(@_rows.Count, minmax(0, 1fr))">
        @foreach (var row in _rows)
        {
            <div class="emu-ladder-row @RowClass(row)" title="@RowTooltip(row)">
                <span class="emu-ladder-cell emu-ladder-bid">
                    @if (row.BidVolume is { } bid)
                    {
                        <span class="emu-ladder-depth" style="width: @DepthWidth(bid)%"></span>
                        <span class="emu-ladder-volume">@FormatVolume(bid)</span>
                    }
                </span>
                <span class="emu-ladder-cell emu-ladder-price">@FormatPrice(row.Price)</span>
                <span class="emu-ladder-cell emu-ladder-ask">
                    @if (row.AskVolume is { } ask)
                    {
                        <span class="emu-ladder-depth" style="width: @DepthWidth(ask)%"></span>
                        <span class="emu-ladder-volume">@FormatVolume(ask)</span>
                    }
                </span>
                <span class="emu-ladder-cell emu-ladder-pop" title="@PositionsTooltip(row)">
                    @if (row.Positions is { } positions)
                    {
                        <span class="emu-ladder-bots">@positions.BotCount.ToString("N0")</span>
                        <span class="emu-ladder-equity">@EmulatorChartHelper.CompactAmount(positions.Equity)</span>
                    }
                </span>
            </div>
        }
    </div>
</div>
