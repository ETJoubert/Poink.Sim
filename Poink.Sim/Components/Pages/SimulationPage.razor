@page "/"
@page "/simulation"
@namespace Poink.Sim.Components.Pages
@using Poink.Sim.Components.Charts
@using Poink.Shared.Client.Components.Shared.ViewDatatable

<div class="sim-page">

    @if (_snapshot is null)
    {
        <div class="sim-topbar">
            <header class="sim-header">
                <div class="sim-header-title">
                    <span class="sim-header-symbol">TRADER SIMULATION</span>
                    <span class="sim-header-state sim-state-setup">@(_isLoading ? "LOADING" : "SETUP")</span>
                </div>
            </header>
        </div>

        <div class="sim-setup">
            <p class="sim-help">
                <strong>What this does.</strong> Replays historical ticks for a chosen symbol and date
                range under your control (play/pause/step/speed). A Brain observes the stream — either
                raw ticks or aggregated HLOC/AVDT bars, your choice — plus live Capital/Position, and
                decides trades; the Trader executes them with simple cash P&amp;L (no leverage).
            </p>

            <div class="sim-setup-grid">
                <div class="sim-group">
                    <div class="sim-group-title">Data</div>
                    <div class="sim-row">
                        <label>
                            Symbol
                            @if (_loadingTables)
                            {
                                <span>loading tables...</span>
                            }
                            else if (_availableTables.Count > 0)
                            {
                                <select class="terminal-input" @bind="SelectedTable">
                                    @foreach (var t in _availableTables)
                                    {
                                        <option value="@t.Table">@t.Table (@t.Rows.ToString("N0") rows)</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <button class="terminal-btn-action" @onclick="InitTables"
                                        title="Connects to Postgres and lists ticks_* tables -- not needed for Load Dummy Data">
                                    @(_tableListFailed ? "RETRY" : "INIT DATA")
                                </button>
                            }
                        </label>
                        <label>
                            From
                            <input class="terminal-input" type="datetime-local" @bind="_from" />
                        </label>
                        <label>
                            To
                            <input class="terminal-input" type="datetime-local" @bind="_to" />
                        </label>
                    </div>
                </div>

                <div class="sim-group">
                    <div class="sim-group-title">What the Brain sees</div>
                    <div class="sim-row">
                        <label>
                            <input type="checkbox" @bind="_aggregate" />
                            Aggregate into HLOC/AVDT bars
                        </label>
                        @if (_aggregate)
                        {
                            <label>
                                Bar minutes
                                <input class="terminal-input" type="number" min="1" @bind="_barMinutesText" />
                            </label>
                        }
                    </div>
                </div>

                <div class="sim-group">
                    <div class="sim-group-title">Brain &amp; Account</div>
                    <div class="sim-row">
                        <label>
                            Brain
                            <select class="terminal-input" @bind="_brainName">
                                @foreach (var name in BrainNames)
                                {
                                    <option value="@name">@name</option>
                                }
                            </select>
                        </label>
                        <label>
                            Starting cash
                            <input class="terminal-input" type="number" min="1" step="100" @bind="_startingCash" />
                        </label>
                    </div>
                </div>
            </div>

            <div class="sim-setup-actions">
                <button class="terminal-btn-action" @onclick="LoadSimulation" disabled="@_isLoading">
                    @(_isLoading ? "LOADING..." : "LOAD SIMULATION")
                </button>
                <button class="terminal-btn-action" @onclick="LoadDummySimulation" disabled="@_isLoading"
                        title="Synthetic random-walk ticks -- no Postgres required">
                    LOAD DUMMY DATA
                </button>
            </div>

            @if (_tableListFailed)
            {
                <p class="sim-note">Tick table list unavailable (Postgres down?).</p>
            }
            @if (_loadError is not null)
            {
                <p class="sim-error">@_loadError</p>
            }
            @if (_error is not null)
            {
                <p class="sim-error">@_error</p>
            }
        </div>
    }
    else
    {
        var s = _snapshot;
        <div class="sim-topbar">
            <header class="sim-header">
                <div class="sim-header-title">
                    <span class="sim-header-symbol">@s.Config.Table</span>
                    <span class="sim-header-mode">@(s.Config.Aggregate ? $"{s.Config.BarSize.TotalMinutes:0}m bars" : "raw ticks")</span>
                    <span class="sim-header-state @StateClass(s)">
                        @(s.IsFinished ? "FINISHED" : s.IsPlaying ? "PLAYING" : "PAUSED")
                    </span>
                </div>
                <div class="sim-stats">
                    <div class="sim-stat">
                        <span class="sim-stat-label">price</span>
                        <span class="sim-stat-value">@PriceStr(s.CurrentPrice)</span>
                    </div>
                    <div class="sim-stat">
                        <span class="sim-stat-label">cash</span>
                        <span class="sim-stat-value">@Money(s.Capital.Cash)</span>
                    </div>
                    <div class="sim-stat">
                        <span class="sim-stat-label">realized</span>
                        <span class="sim-stat-value @PnlClass(s.Capital.RealizedPnl)">@Money(s.Capital.RealizedPnl)</span>
                    </div>
                    <div class="sim-stat">
                        <span class="sim-stat-label">unrealized</span>
                        <span class="sim-stat-value @PnlClass(s.Capital.UnrealizedPnl)">@Money(s.Capital.UnrealizedPnl)</span>
                    </div>
                    <div class="sim-stat sim-stat-highlight">
                        <span class="sim-stat-label">equity</span>
                        <span class="sim-stat-value">@Money(s.Capital.Equity)</span>
                    </div>
                    <div class="sim-stat">
                        <span class="sim-stat-label">positions</span>
                        <span class="sim-stat-value">@(s.Position is not null ? 1 : 0)</span>
                    </div>
                    <div class="sim-stat">
                        <span class="sim-stat-label">trades</span>
                        <span class="sim-stat-value">@s.TradeCount</span>
                    </div>
                </div>
            </header>

            <div class="sim-toolbar">
                <div class="sim-controls">
                    <button class="terminal-btn-action" @onclick="TogglePlayPause" disabled="@s.IsFinished">
                        @(s.IsPlaying ? "PAUSE" : "PLAY")
                    </button>
                    <button class="terminal-btn-action" @onclick="StepOnce" disabled="@(s.IsPlaying || s.IsFinished)">STEP</button>
                    @foreach (var speed in new[] { 0.1,1.0, 10.0, 100.0, 1000.0, 10000.0 })
                    {
                        <button class="terminal-btn-action @(!s.IsUncapped && Math.Abs(s.SpeedMultiplier - speed) < 0.001 ? "active" : "")"
                                @onclick="() => SetSpeed(speed)">@speed.ToString("0")x</button>
                    }
                    <button class="terminal-btn-action @(s.IsUncapped && !_hideChart ? "active" : "")"
                            @onclick="SetMax" title="Uncapped backend speed; chart/tick table keep rendering">MAX</button>
                    <button class="terminal-btn-action @(s.IsUncapped && _hideChart ? "active" : "")"
                            @onclick="SetTurbo" title="Uncapped backend speed; chart/tick table hidden, only stats + log render">TURBO</button>
                    <span class="sim-toolbar-divider"></span>
                    <button class="terminal-btn-action" @onclick="ResetSim">RESET</button>
                    <button class="terminal-btn-action" @onclick="UnloadSim">NEW SIMULATION</button>
                    <button class="terminal-btn-action @(_hideChart ? "active" : "")" @onclick="ToggleHideChart">
                        @(_hideChart ? "SHOW CHART" : "HIDE CHART")
                    </button>
                </div>

                <div class="sim-progress">
                    <div class="sim-progress-bar">
                        <div class="sim-progress-fill" style="width: @(ProgressPercent)%"></div>
                    </div>
                    <span class="sim-progress-text">
                        @s.CursorIndex.ToString("N0") / @s.TotalCount.ToString("N0") ticks (@ProgressPercent%)
                        @(s.CurrentTimestampUtc is not null ? $" — {s.CurrentTimestampUtc:yyyy-MM-dd HH:mm:ss}" : "")
                    </span>
                </div>
            </div>
        </div>

        @if (!_hideChart)
        {
            <div class="sim-chart">
                <div class="sim-chart-main">
                    @if (s.Config.Aggregate)
                    {
                        <OhlcvChart Bars="ToBarRows(s.RecentBars)" />
                    }
                    else
                    {
                        <ViewDatatable Items="TickRows" Title="RECENT TICKS" />
                    }
                </div>
                <div class="sim-chart-side">
                    <TickVolumeProfileChart Prices="ToMidPrices(s.RecentTicks)" CurrentPrice="s.CurrentPrice" />
                </div>
            </div>
        }

        <div class="sim-tables-row">
            <div class="sim-log">
                <ViewDatatable Items="LogRows" Title="TRADE / DECISION LOG" />
            </div>
            <div class="sim-positions">
                <ViewDatatable Items="OpenPositionRows" Title="OPEN POSITIONS" EmptyMessage="flat" />
            </div>
        </div>

        @if (_error is not null)
        {
            <p class="sim-error">@_error</p>
        }
    }
</div>
