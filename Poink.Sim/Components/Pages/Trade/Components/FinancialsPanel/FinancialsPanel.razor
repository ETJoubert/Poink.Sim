@namespace Poink.Sim.Components.Pages.Trade
@using Poink.Sim.Components.Shared.Icon
@using Poink.Sim.Components.Shared.StatisticsPanel
@using Poink.Sim.Services.CTrader

<div class="fp-panel">
    <div class="fp-tabs">
        @if (_tableCollapsed)
        {
            <button type="button" class="fp-tab-icon @(_activeTab == FinancialsTab.Positions ? "active" : "")"
                    @onclick="() => SelectTabAndExpand(FinancialsTab.Positions)"
                    title="Currently open positions">
                <Icon Name="list-ul" Class="fp-tab-icon-svg" />
            </button>
            <button type="button" class="fp-tab-icon @(_activeTab == FinancialsTab.History ? "active" : "")"
                    @onclick="() => SelectTabAndExpand(FinancialsTab.History)"
                    title="Closed trades from the last 30 days">
                <Icon Name="file-earmark-fill" Class="fp-tab-icon-svg" />
            </button>
            <button type="button" class="fp-tab-icon @(_activeTab == FinancialsTab.Statistics ? "active" : "")"
                    @onclick="() => SelectTabAndExpand(FinancialsTab.Statistics)"
                    title="Trade outcome statistics derived from closed-deal history">
                <Icon Name="bar-chart-steps" Class="fp-tab-icon-svg" />
            </button>
        }
        else
        {
            <button type="button" class="fp-tab @(_activeTab == FinancialsTab.Positions ? "active" : "")"
                    @onclick="() => SelectTab(FinancialsTab.Positions)"
                    title="Currently open positions">
                POSITIONS <span class="trade-section-count">@Positions.Count</span>
            </button>
            <button type="button" class="fp-tab @(_activeTab == FinancialsTab.History ? "active" : "")"
                    @onclick="() => SelectTab(FinancialsTab.History)"
                    title="Closed trades from the last 30 days">
                HISTORY <span class="trade-section-count">@_closedDeals.Count</span>
            </button>
            <button type="button" class="fp-tab @(_activeTab == FinancialsTab.Statistics ? "active" : "")"
                    @onclick="() => SelectTab(FinancialsTab.Statistics)"
                    title="Trade outcome statistics derived from closed-deal history">
                STATISTICS
            </button>
        }
        <button type="button" class="fp-collapse-toggle" @onclick="ToggleTableCollapsed"
                title="@(_tableCollapsed ? "Expand positions/history" : "Collapse positions/history")">
            <Icon Name="@(_tableCollapsed ? "chevron-right" : "chevron-down")" Class="fp-collapse-toggle-icon" />
        </button>
    </div>

    @if (!_tableCollapsed)
    {
        @if (_activeTab == FinancialsTab.Positions)
        {
            <PositionTable Positions="Positions" Quotes="Quotes" SymbolMetadata="SymbolMetadata" Balance="Balance" OnSelect="OnSelectPosition" OnClose="OnClosePosition" />
        }
        else if (_activeTab == FinancialsTab.History)
        {
            <div class="fp-history">
                @if (_historyLoading)
                {
                    <p class="fp-history-message">Loading closed trades...</p>
                }
                else if (_historyError is not null)
                {
                    <p class="fp-history-message fp-value-negative">Failed to load history: @_historyError</p>
                }
                else if (_closedDeals.Count == 0)
                {
                    <p class="fp-history-message">No closed trades in the last 30 days.</p>
                }
                else
                {
                    <table class="fp-history-table">
                        <thead>
                            <tr>
                                <th>Closed</th>
                                <th>Symbol</th>
                                <th>Side</th>
                                <th>Volume</th>
                                <th>Price</th>
                                <th title="Commission charged on the closing deal">Commission</th>
                                <th title="Swap/rollover charged on the closing deal">Swap</th>
                                <th>P/L</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var deal in _closedDeals)
                            {
                                <tr>
                                    <td>@deal.ExecutionTimeUtc.ToLocalTime().ToString("MM-dd HH:mm:ss")</td>
                                    <td>@deal.SymbolName</td>
                                    <td class="@(deal.IsLong ? "fp-side-long" : "fp-side-short")">@(deal.IsLong ? "LONG" : "SHORT")</td>
                                    <td>@deal.Volume.ToString("N2")</td>
                                    <td>@deal.ExecutionPrice.ToString("N5")</td>
                                    <td>@Money(deal.Commission)</td>
                                    <td>@Money(deal.Swap)</td>
                                    <td class="@PnlCssClass(deal.RealizedPnl)">@SignedMoney(deal.RealizedPnl)</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>
        }
        else
        {
            <div class="fp-history" title="Derived from the same closed-deal history as the History tab, over the last 30 days">
                @if (_historyLoading)
                {
                    <p class="fp-history-message">Loading closed trades...</p>
                }
                else if (_historyError is not null)
                {
                    <p class="fp-history-message fp-value-negative">Failed to load history: @_historyError</p>
                }
                else
                {
                    <StatisticsPanel Groups="StatGroups" EmptyMessage="No closed trades yet." />
                }
            </div>
        }
    }

    <div class="fp-financials"
         title="Balance updates live from cTrader; Margin Used sums open positions; every open position's symbol streams its own live quote regardless of the watchlist">
        <div class="fp-card" title="Live account balance and equity">
            <div class="fp-item" title="Live account balance">
                <span class="fp-label">Balance</span>
                <span class="fp-value">@Money(Balance)</span>
            </div>
            <div class="fp-item" title="Derived as Balance + Unrealized P/L">
                <span class="fp-label">Equity</span>
                <span class="fp-value">@Money(Equity)</span>
            </div>
        </div>

        <div class="fp-card" title="Margin figures across every open position">
            <div class="fp-item" title="Sum of used margin across every open position">
                <span class="fp-label">Margin Used</span>
                <span class="fp-value">@Money(MarginUsed)</span>
            </div>
            <div class="fp-item" title="Derived as Equity / Margin Used">
                <span class="fp-label">Margin Level</span>
                <span class="fp-value">@Money(MarginLevel)</span>
            </div>
            <div class="fp-item" title="Derived as Equity - Margin Used">
                <span class="fp-label">Free Margin</span>
                <span class="fp-value">@Money(FreeMargin)</span>
            </div>
        </div>

        <div class="fp-card" title="Realized and unrealized profit/loss">
            <div class="fp-item-group">
                <button type="button" class="fp-item fp-item-button" @onclick="ToggleRealizedPicker"
                        title="Net P/L, commission and swap from closed deals over the selected window -- click to change it">
                    <span class="fp-label">Realized (@RealizedWindowLabel(_realizedWindow))</span>
                    <span class="fp-value @PnlCssClass(_realizedPnl)">@(_realizedLoading ? "..." : SignedMoney(_realizedPnl))</span>
                </button>
                @if (_realizedPickerOpen)
                {
                    <div class="fp-window-picker" role="group">
                        <button type="button" class="fp-window-toggle @(_realizedWindow == RealizedWindow.Hour ? "active" : "")"
                                @onclick="() => SelectRealizedWindow(RealizedWindow.Hour)" title="Realized P/L over the last hour">1H</button>
                        <button type="button" class="fp-window-toggle @(_realizedWindow == RealizedWindow.Day ? "active" : "")"
                                @onclick="() => SelectRealizedWindow(RealizedWindow.Day)" title="Realized P/L over the last day">1D</button>
                        <button type="button" class="fp-window-toggle @(_realizedWindow == RealizedWindow.Week ? "active" : "")"
                                @onclick="() => SelectRealizedWindow(RealizedWindow.Week)" title="Realized P/L over the last week">1W</button>
                        <button type="button" class="fp-window-toggle @(_realizedWindow == RealizedWindow.Month ? "active" : "")"
                                @onclick="() => SelectRealizedWindow(RealizedWindow.Month)" title="Realized P/L over the last month">1M</button>
                    </div>
                }
            </div>
            <div class="fp-item" title="Sum of each open position's pip difference from its live quote times its volume">
                <span class="fp-label">Unrealized</span>
                <span class="fp-value">@Money(UnrealizedPnl)</span>
            </div>
        </div>
    </div>
</div>
