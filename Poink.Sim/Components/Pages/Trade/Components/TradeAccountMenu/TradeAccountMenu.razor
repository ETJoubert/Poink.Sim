@namespace Poink.Sim.Components.Pages.Trade
@using Poink.Sim.Services.CTrader
@using Poink.Sim.Components.Shared.Icon

<div class="trade-header-account">
    @if (IsConnected)
    {
        <div class="trade-account-menu">
            <button type="button" class="trade-account-btn @(_accountMenuOpen ? "open" : "")"
                    @onclick="ToggleAccountMenu" title="View connected accounts and log out">
                <span class="trade-header-mode">@(SelectedAccount?.IsLive == true ? "LIVE" : "DEMO")</span>
                <span class="trade-account-number">@(SelectedAccount?.Login.ToString() ?? "—")</span>
                <span class="trade-header-state @StateClass" title="Current cTrader connection state">
                    <span class="trade-state-dot"></span>@StateLabel
                </span>
                <Icon Name="chevron-down" Class="trade-account-caret" />
            </button>

            @if (_accountMenuOpen)
            {
                <div class="trade-account-backdrop" @onclick="CloseAccountMenu"></div>
                <div class="trade-account-dropdown">
                    <span class="trade-account-dropdown-title">Accounts</span>
                    <ul class="trade-account-list">
                        @foreach (var account in Session.Accounts)
                        {
                            var isCurrent = account.AccountId == Session.SelectedAccountId;
                            <li class="trade-account-row @(isCurrent ? "trade-account-row-current" : "")">
                                <button type="button" class="trade-account-row-btn"
                                        disabled="@(isCurrent || _switchingAccount)"
                                        @onclick="() => SelectAccountAsync(account.AccountId)"
                                        title="@(isCurrent ? $"Active account {account.Login}" : $"Switch to {(account.IsLive ? "live" : "demo")} account {account.Login}")">
                                    <span class="trade-account-row-type">@(account.IsLive ? "LIVE" : "DEMO")</span>
                                    <span class="trade-account-row-number">@account.Login</span>
                                    @if (isCurrent)
                                    {
                                        <Icon Name="check2" Class="trade-account-row-check" />
                                    }
                                </button>
                            </li>
                        }
                    </ul>
                    <button class="trade-ctrl-btn trade-ctrl-btn-warn trade-account-logout-btn" @onclick="LogOutAsync"
                            title="Disconnect the current cTrader account">
                        <Icon Name="x-lg" Class="trade-ctrl-icon" />
                        LOG OUT
                    </button>
                </div>
            }
        </div>
    }
    else if (!Session.IsConfigured)
    {
        <span class="trade-login-status trade-login-status-warn"
              title="Set CTrader:ClientId, CTrader:ClientSecret and CTrader:RedirectUri (via appsettings.Secrets.json or env vars) then restart">
            cTrader is not configured.
        </span>
    }
    else
    {
        <span class="trade-login-status" title="Latest cTrader connection status">@Session.StatusMessage</span>
        <span class="trade-header-state @StateClass" title="Current cTrader connection state">
            @StateLabel
        </span>
        <button class="trade-ctrl-btn trade-ctrl-btn-play" @onclick="LogIn"
                disabled="@(Session.State == CTraderConnectionState.Connecting)"
                title="Open the cTrader login flow and connect an account">
            <Icon Name="key-fill" Class="trade-ctrl-icon" />
            @(Session.State == CTraderConnectionState.Connecting ? "CONNECTING..." : "LOG IN")
        </button>
    }
</div>
