@namespace Poink.Sim.Components.Pages.Trade
@using Poink.Sim.Components.Shared.Icon
@using Poink.Sim.Models
@using Poink.Sim.Components.Pages.Trade.Helpers

<aside class="trade-sidepanel @(Collapsed ? "trade-sidepanel-collapsed" : "")">
    <button type="button" class="trade-sidepanel-toggle" @onclick="ToggleCollapsed"
            title="@(Collapsed ? "Expand the symbols panel" : "Collapse the symbols panel")">
        <Icon Name="@(Collapsed ? "chevron-right" : "chevron-left")" Class="trade-sidepanel-toggle-icon" />
    </button>
    @if (Collapsed)
    {
        @if (IsConnected)
        {
            <div class="trade-sidepanel-collapsed-icons">
                <button type="button" class="trade-sidepanel-collapsed-icon @(_sidepanelTab == SidepanelTab.Symbols ? "active" : "")"
                        @onclick="() => SelectTabAndExpand(SidepanelTab.Symbols)"
                        title="Search the account's symbols and add them to your watchlist">
                    <Icon Name="search" Class="trade-sidepanel-collapsed-icon-svg" />
                </button>
                <button type="button" class="trade-sidepanel-collapsed-icon @(_sidepanelTab == SidepanelTab.Watchlist ? "active" : "")"
                        @onclick="() => SelectTabAndExpand(SidepanelTab.Watchlist)"
                        title="Symbols you are streaming -- live bid/ask update in real time">
                    <Icon Name="eye-fill" Class="trade-sidepanel-collapsed-icon-svg" />
                </button>
            </div>
        }
    }
    else if (!IsConnected)
    {
        <p class="trade-sidepanel-empty">Log in to load the account's symbols and stream live prices.</p>
    }
    else
    {
        <div class="trade-sidepanel-tabs">
            <button type="button" class="trade-sidepanel-tab @(_sidepanelTab == SidepanelTab.Symbols ? "active" : "")"
                    @onclick="() => SelectTab(SidepanelTab.Symbols)"
                    title="Search the account's symbols and add them to your watchlist">
                SYMBOLS <span class="trade-section-count">@TotalSymbolMatchCount</span>
            </button>
            <button type="button" class="trade-sidepanel-tab @(_sidepanelTab == SidepanelTab.Watchlist ? "active" : "")"
                    @onclick="() => SelectTab(SidepanelTab.Watchlist)"
                    title="Symbols you are streaming -- live bid/ask update in real time">
                WATCHING <span class="trade-section-count">@Session.Watchlist.Count</span>
            </button>
        </div>

        @if (_sidepanelTab == SidepanelTab.Symbols)
        {
            <section class="trade-symbols-picker">
                <div class="trade-symbols-dropdown">
                    <input type="text" class="trade-symbol-search" placeholder="Search symbols..."
                           value="@_symbolFilter" @oninput="e => _symbolFilter = e.Value?.ToString() ?? string.Empty"
                           title="Filter the account's symbols by name" />
                    <div class="trade-panel-toggles" title="Filter by category -- select one or more, none selected shows everything">
                        @foreach (var (bucket, label, fullName) in CategoryToggleDefs)
                        {
                            <button type="button" class="trade-panel-toggle-btn @(_selectedCategoryBuckets.Contains(bucket) ? "active" : "")"
                                    @onclick="() => ToggleCategoryBucket(bucket)" title="@fullName">@label</button>
                        }
                        <button type="button" class="trade-panel-toggle-btn @(_showDisabledSymbols ? "active" : "")"
                                @onclick="ToggleShowDisabledSymbols" title="Show symbols currently disabled for trading">Disabled</button>
                        <button type="button" class="trade-panel-toggle-btn @(_onlyWithData ? "active" : "")"
                                @onclick="ToggleOnlyWithData"
                                title="Show only symbols with stored tick history in the database (from the Data page import) -- their charts need no API calls before today">DB</button>
                    </div>
                    @if (_selectedCategoryBuckets.Contains(SymbolCategoryBucket.Forex))
                    {
                        <div class="trade-panel-toggles" title="Quick-filter Forex pairs containing a currency -- select one or more">
                            @foreach (var currency in FxQuickCurrencies)
                            {
                                <button type="button" class="trade-panel-toggle-btn @(_selectedFxCurrencies.Contains(currency) ? "active" : "")"
                                        @onclick="() => ToggleFxCurrency(currency)" title="Show FX pairs containing @currency">@currency</button>
                            }
                        </div>
                    }
                    @if (_coverageFailed)
                    {
                        <p class="trade-symbol-more" title="The tick_table_stats registry could not be read, so stored-data markers and the DB filter are unavailable">Stored-data coverage unavailable (database down?).</p>
                    }
                    <ul class="trade-symbol-list">
                        @foreach (var symbol in FilteredSymbols)
                        {
                            var watched = Session.IsSymbolWatched(symbol.SymbolId);
                            <li>
                                <button class="trade-symbol-row @(watched ? "trade-symbol-row-watched" : "")"
                                        @onclick="() => (watched ? UnwatchAsync(symbol.SymbolId) : WatchAsync(symbol.SymbolId))"
                                        title="@(watched ? $"Stop streaming {symbol.SymbolName}" : $"Stream live bid/ask for {symbol.SymbolName}")">
                                    <span class="trade-symbol-dot @(symbol.Enabled ? "trade-symbol-dot-active" : "trade-symbol-dot-inactive")"
                                          title="@(symbol.Enabled ? "Enabled" : "Disabled")"></span>
                                    <Icon Name="@(watched ? "eye-fill" : "plus-lg")" Class="trade-symbol-row-icon" />
                                    <span class="trade-symbol-row-name" title="@SymbolInfoTooltip(symbol)">@symbol.SymbolName</span>
                                    <SymbolCoverageBadge Coverage="CoverageFor(symbol.SymbolName)" />
                                </button>
                            </li>
                        }
                    </ul>
                    @if (TotalSymbolMatchCount > FilteredSymbols.Count)
                    {
                        <p class="trade-symbol-more">Showing @FilteredSymbols.Count of @TotalSymbolMatchCount — refine your search.</p>
                    }
                </div>
            </section>
        }
        else
        {
            <section class="trade-watchlist" title="Watched symbols -- each streams live bid/ask; its colour marks it across the Trade page's charts">
                <div class="trade-watch-header">
                    <span class="trade-watch-label" title="Symbols streaming live prices">WATCHED</span>
                    @if (Session.Watchlist.Count > 0)
                    {
                        <button type="button" class="trade-watch-link-btn" @onclick="UnwatchAllAsync"
                                title="Stop streaming every watched symbol -- open positions keep their own price subscriptions">CLEAR</button>
                    }
                </div>
                @if (Session.Watchlist.Count == 0)
                {
                    <p class="trade-sidepanel-empty">Pick a symbol from the Symbols tab to stream its bid/ask.</p>
                }
                else
                {
                    <ul class="trade-quote-list">
                        @foreach (var quote in Session.Watchlist)
                        {
                            var selected = quote.SymbolId == ActiveSymbolId;
                            var coverage = CoverageFor(quote.SymbolName);
                            <li class="trade-watch-item @(selected ? "trade-watch-item-active" : "")" style="@SymbolColorStyle(quote.SymbolName)"
                                @onclick="() => SelectAsync(quote.SymbolId, quote.SymbolName)"
                                title="@QuoteRowTitle(quote, selected)">
                                <div class="trade-watch-text">
                                    <span class="trade-watch-name">@quote.SymbolName</span>
                                    <span class="trade-watch-meta" title="@SymbolCoverageHelper.Describe(coverage)">@SymbolCoverageHelper.ShortLabel(coverage)</span>
                                </div>
                                <span class="trade-quote-prices">
                                    <span class="trade-quote-bid" title="Bid">@Price(quote.Bid)</span>
                                    <span class="trade-quote-ask" title="Ask">@Price(quote.Ask)</span>
                                </span>
                                <SymbolCoverageBadge Coverage="coverage" />
                                @if (selected)
                                {
                                    <span class="trade-watch-badge" title="This symbol is on the chart">CHART</span>
                                }
                                <button type="button" class="trade-watch-icon-btn" @onclick="() => UnwatchAsync(quote.SymbolId)"
                                        @onclick:stopPropagation="true" title="Stop streaming @quote.SymbolName">
                                    <Icon Name="x-lg" Class="trade-quote-remove-icon" />
                                </button>
                            </li>
                        }
                    </ul>
                }
            </section>
        }
    }
</aside>
