@namespace Poink.Sim.Components.Pages.Trade
@using Poink.Sim.Models

<div class="tc-panel">
    <div class="tc-field" title="Market fills immediately; Limit/Stop queue a pending order until price crosses the trigger">
        Order type
        <div class="tc-toggle-group" role="group">
            <button type="button" class="tc-toggle @(_orderType == OrderType.Market ? "active" : "")"
                    @onclick="() => _orderType = OrderType.Market"
                    title="Fill immediately at the current market price">Market</button>
            <button type="button" class="tc-toggle @(_orderType == OrderType.Limit ? "active" : "")"
                    @onclick="() => _orderType = OrderType.Limit"
                    title="Queue a pending order until price reaches the trigger from the favourable side">Limit</button>
            <button type="button" class="tc-toggle @(_orderType == OrderType.Stop ? "active" : "")"
                    @onclick="() => _orderType = OrderType.Stop"
                    title="Queue a pending order until price breaks through the trigger">Stop</button>
        </div>
    </div>

    @if (_orderType != OrderType.Market)
    {
        <label class="tc-field" title="Price level the pending order triggers at">
            Trigger price
            <input class="tc-input" type="number" step="0.00001" @bind="_triggerPrice" @bind:event="oninput" />
        </label>
    }

    <div class="tc-field" title="Direction the Place button submits">
        Direction
        <div class="tc-toggle-group" role="group">
            <button type="button" class="tc-toggle tc-toggle-buy @(_isLong ? "active" : "")"
                    @onclick="() => _isLong = true" title="Buy on Place">BUY</button>
            <button type="button" class="tc-toggle tc-toggle-sell @(!_isLong ? "active" : "")"
                    @onclick="() => _isLong = false" title="Sell on Place">SELL</button>
        </div>
    </div>

    <label class="tc-field" title="Position size in units">
        Volume
        <input class="tc-input" type="number" min="0" step="0.01" @bind="_volumeUnits" @bind:event="oninput"
               disabled="@_busy" />
    </label>

    <div class="tc-field" title="Optional stop loss -- entered as a pip distance or as a percent of balance lost if it is hit">
        <div class="tc-field-head">
            <span>Stop loss</span>
            <div class="tc-toggle-group tc-toggle-group-sm" role="group">
                <button type="button" class="tc-toggle @(_stopLossMode == SizingMode.Pips ? "active" : "")"
                        @onclick="() => _stopLossMode = SizingMode.Pips"
                        title="Enter the stop as a distance in pips">PIPS</button>
                <button type="button" class="tc-toggle @(_stopLossMode == SizingMode.PercentBalance ? "active" : "")"
                        @onclick="() => _stopLossMode = SizingMode.PercentBalance"
                        title="Enter the stop as a percent of account balance lost if it is hit">% BALANCE</button>
            </div>
        </div>
        <div class="tc-input-row">
            @if (_stopLossMode == SizingMode.Pips)
            {
                <input class="tc-input" type="number" min="0" step="1" @bind="_stopLossPips" @bind:event="oninput"
                       title="Distance in pips from the entry to the stop, on the losing side" />
                <button type="button" class="tc-clear" @onclick="() => _stopLossPips = null"
                        disabled="@(_stopLossPips is null)" title="Clear the stop loss">×</button>
            }
            else
            {
                <input class="tc-input" type="number" min="0" step="0.1" @bind="_stopLossPercent" @bind:event="oninput"
                       title="Percent of account balance lost if the stop is hit" />
                <button type="button" class="tc-clear" @onclick="() => _stopLossPercent = null"
                        disabled="@(_stopLossPercent is null)" title="Clear the stop loss">×</button>
            }
        </div>
    </div>

    <div class="tc-field" title="Optional take profit -- entered as a pip distance or as a percent of balance gained if it is hit">
        <div class="tc-field-head">
            <span>Take profit</span>
            <div class="tc-toggle-group tc-toggle-group-sm" role="group">
                <button type="button" class="tc-toggle @(_takeProfitMode == SizingMode.Pips ? "active" : "")"
                        @onclick="() => _takeProfitMode = SizingMode.Pips"
                        title="Enter the target as a distance in pips">PIPS</button>
                <button type="button" class="tc-toggle @(_takeProfitMode == SizingMode.PercentBalance ? "active" : "")"
                        @onclick="() => _takeProfitMode = SizingMode.PercentBalance"
                        title="Enter the target as a percent of account balance gained if it is hit">% BALANCE</button>
            </div>
        </div>
        <div class="tc-input-row">
            @if (_takeProfitMode == SizingMode.Pips)
            {
                <input class="tc-input" type="number" min="0" step="1" @bind="_takeProfitPips" @bind:event="oninput"
                       title="Distance in pips from the entry to the target, on the winning side" />
                <button type="button" class="tc-clear" @onclick="() => _takeProfitPips = null"
                        disabled="@(_takeProfitPips is null)" title="Clear the take profit">×</button>
            }
            else
            {
                <input class="tc-input" type="number" min="0" step="0.1" @bind="_takeProfitPercent" @bind:event="oninput"
                       title="Percent of account balance gained if the target is hit" />
                <button type="button" class="tc-clear" @onclick="() => _takeProfitPercent = null"
                        disabled="@(_takeProfitPercent is null)" title="Clear the take profit">×</button>
            }
        </div>
    </div>

    <div class="tc-preview">
        <div class="tc-preview-row" title="Market price at the time of entry, or the Limit/Stop trigger price">
            <span class="tc-preview-label">Entry</span>
            <span class="tc-preview-value">@(EntryReferencePrice is { } e ? e.ToString("N5") : "--")</span>
        </div>
        <div class="tc-preview-row">
            <span class="tc-preview-label">Stop loss</span>
            <span class="tc-preview-value">@(StopLossPrice is { } sl ? sl.ToString("N5") : "--")</span>
        </div>
        <div class="tc-preview-row">
            <span class="tc-preview-label">Take profit</span>
            <span class="tc-preview-value">@(TakeProfitPrice is { } tp ? tp.ToString("N5") : "--")</span>
        </div>

        @if (ProjectedLoss is { } loss)
        {
            <div class="tc-preview-row @(loss > 0 ? "loss" : "gain")"
                 title="Money lost if the stop loss is hit, for this volume from the entry price">
                <span class="tc-preview-label">Projected loss</span>
                <span class="tc-preview-value">
                    @($"{(loss > 0 ? "-" : "+")}{Math.Abs(loss):N2}")
                    @if (ProjectedLossPercent is { } pct)
                    {
                        <span class="tc-preview-pct">(@($"{Math.Abs(pct):P1}") of balance)</span>
                    }
                </span>
            </div>
        }
        else if (HasStopLoss)
        {
            <div class="tc-preview-row loss"
                 title="An entry price is needed to project the stop loss -- enter a trigger price, or wait for a market quote">
                <span class="tc-preview-label">Projected loss</span>
                <span class="tc-preview-value">--</span>
            </div>
        }
        else
        {
            <div class="tc-preview-row loss" title="No stop loss set -- this position has unlimited downside">
                <span class="tc-preview-label">Projected loss</span>
                <span class="tc-preview-value">no stop set</span>
            </div>
        }

        @if (ProjectedProfit is { } profit)
        {
            <div class="tc-preview-row gain"
                 title="Money gained if the take profit is hit, for this volume from the entry price">
                <span class="tc-preview-label">Projected profit</span>
                <span class="tc-preview-value">
                    @($"+{Math.Abs(profit):N2}")
                    @if (ProjectedProfitPercent is { } pct)
                    {
                        <span class="tc-preview-pct">(@($"{Math.Abs(pct):P1}") of balance)</span>
                    }
                </span>
            </div>
        }

        @if (RewardToRisk is { } ratio)
        {
            <div class="tc-preview-row" title="Reward-to-risk ratio -- projected take-profit gain divided by the stop-loss loss">
                <span class="tc-preview-label">Reward : risk</span>
                <span class="tc-preview-value">@($"{ratio:N2} : 1")</span>
            </div>
        }
    </div>

    <div class="tc-actions">
        <button class="tc-btn @(_isLong ? "tc-buy" : "tc-sell")" @onclick="() => SubmitEntry(_isLong)"
                disabled="@_busy" title="Submit this entry to cTrader using the selected direction, order type, size, SL and TP">
            @(_busy ? "PLACING..." : "PLACE")
        </button>
        <button class="tc-btn tc-btn-warn" @onclick="ResetDraft" disabled="@_busy"
                title="Clear this draft and reset it back to its defaults">
            CANCEL
        </button>
    </div>

    @if (_status is not null)
    {
        <span class="tc-status @(_statusIsError ? "tc-status-error" : "")">@_status</span>
    }
</div>
