@namespace Poink.Sim.Components.Pages.Trade
@using Poink.Sim.Components.Shared.Icon
@using Poink.Sim.Services.CTrader

<div class="pt-wrapper">
    @if (Positions.Count == 0)
    {
        <p class="pt-empty">No open positions.</p>
    }
    else
    {
        <table class="pt-table">
            <thead>
                <tr class="pt-group-row">
                    @foreach (var group in ColumnGroups)
                    {
                        <th class="pt-group-header pt-group-@Slug(group.Name) pt-group-start" colspan="@group.Columns.Count">@group.Name</th>
                    }
                    <th class="pt-group-header pt-group-actions pt-group-start">Actions</th>
                </tr>
                <tr>
                    @foreach (var column in Columns)
                    {
                        <th class="@HeaderCellClass(column)">@column.Header</th>
                    }
                    <th class="pt-group-actions pt-group-start"></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Rows)
                {
                    <tr class="pt-row" @onclick="() => SelectAsync(row)" title="View @row.SymbolName's chart">
                        @foreach (var column in Columns)
                        {
                            <td class="@BodyCellClass(column, row)" title="@column.Title?.Invoke(row)">@column.Value(row)</td>
                        }
                        <td class="pt-group-actions pt-group-start pt-close-cell">
                            <button class="pt-close-btn" @onclick="() => CloseAsync(row)" @onclick:stopPropagation="true"
                                    title="Close this position">
                                <Icon Name="x-lg" Class="pt-close-icon" />
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
