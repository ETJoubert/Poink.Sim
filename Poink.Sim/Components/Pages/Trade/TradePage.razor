@page "/trade"
@namespace Poink.Sim.Components.Pages.Trade
@using Poink.Sim.Services.CTrader
@using Poink.Sim.Components.Charts
@using Poink.Sim.Components.Shared.Icon
@using Poink.Sim.Components.Shared.BarSizeSelect
@using System.Globalization

<div class="trade-page">

    <div class="trade-topbar">
        <header class="trade-header">
            <div class="trade-header-title">
                <span class="trade-header-symbol">TRADE</span>
                @if (IsConnected)
                {
                    <span class="trade-header-mode" title="cTrader environment this session is connected to">
                        @(Session.UseLiveEnvironment ? "LIVE" : "DEMO")
                    </span>
                    <span class="trade-header-mode" title="Trading accounts available on the connected cTrader login">
                        @Session.Accounts.Count account(s)
                    </span>
                }
                <span class="trade-header-state @StateClass" title="Current cTrader connection state">
                    @StateLabel
                </span>
            </div>

            <div class="trade-header-login">
                @if (!Session.IsConfigured)
                {
                    <span class="trade-login-status trade-login-status-warn"
                          title="Set CTrader:ClientId, CTrader:ClientSecret and CTrader:RedirectUri (via appsettings.Secrets.json or env vars) then restart">
                        cTrader is not configured.
                    </span>
                }
                else
                {
                    <span class="trade-login-status" title="Latest cTrader connection status">@Session.StatusMessage</span>

                    @if (IsConnected)
                    {
                        <button class="trade-ctrl-btn trade-ctrl-btn-warn" @onclick="LogOutAsync"
                                title="Disconnect the current cTrader account">
                            <Icon Name="x-lg" Class="trade-ctrl-icon" />
                            LOG OUT
                        </button>
                    }
                    else
                    {
                        <button class="trade-ctrl-btn trade-ctrl-btn-play" @onclick="LogIn"
                                disabled="@(Session.State == CTraderConnectionState.Connecting)"
                                title="Open the cTrader login flow and connect an account">
                            <Icon Name="key-fill" Class="trade-ctrl-icon" />
                            @(Session.State == CTraderConnectionState.Connecting ? "CONNECTING..." : "LOG IN")
                        </button>
                    }
                }
            </div>
        </header>
    </div>

    <div class="trade-body">
        <aside class="trade-sidepanel">
            @if (!IsConnected)
            {
                <p class="trade-sidepanel-empty">Log in to load the account's symbols and stream live prices.</p>
            }
            else
            {
                <section class="trade-watchlist" title="Symbols you are streaming -- live bid/ask update in real time">
                    <div class="trade-section-header">
                        <span class="trade-section-title">WATCHING</span>
                        <span class="trade-section-count">@Session.Watchlist.Count</span>
                    </div>
                    @if (Session.Watchlist.Count == 0)
                    {
                        <p class="trade-sidepanel-empty">Pick a symbol below to stream its bid/ask.</p>
                    }
                    else
                    {
                        <ul class="trade-quote-list">
                            @foreach (var quote in Session.Watchlist)
                            {
                                var selected = quote.SymbolId == _chartSymbolId;
                                <li class="trade-quote-row @(selected ? "trade-quote-row-selected" : "")"
                                    @onclick="() => OpenChartAsync(quote.SymbolId, quote.SymbolName)"
                                    title="@QuoteRowTitle(quote, selected)">
                                    <span class="trade-quote-selected-indicator">
                                        @if (selected)
                                        {
                                            <Icon Name="eye-fill" Class="trade-quote-selected-icon" />
                                        }
                                    </span>
                                    <span class="trade-quote-name">@quote.SymbolName</span>
                                    <span class="trade-quote-prices">
                                        <span class="trade-quote-bid" title="Bid">@Price(quote.Bid)</span>
                                        <span class="trade-quote-ask" title="Ask">@Price(quote.Ask)</span>
                                    </span>
                                    <button class="trade-quote-remove" @onclick="() => UnwatchAsync(quote.SymbolId)"
                                            @onclick:stopPropagation="true" title="Stop streaming @quote.SymbolName">
                                        <Icon Name="x-lg" Class="trade-quote-remove-icon" />
                                    </button>
                                </li>
                            }
                        </ul>
                    }
                </section>

                <section class="trade-symbols">
                    <div class="trade-section-header">
                        <span class="trade-section-title">SYMBOLS</span>
                        <span class="trade-section-count">@TotalSymbolMatchCount</span>
                    </div>
                    <input type="text" class="trade-symbol-search" placeholder="Search symbols..."
                           value="@_symbolFilter" @oninput="e => _symbolFilter = e.Value?.ToString() ?? string.Empty"
                           title="Filter the account's symbols by name" />
                    <ul class="trade-symbol-list">
                        @foreach (var symbol in FilteredSymbols)
                        {
                            var watched = Session.IsSymbolWatched(symbol.SymbolId);
                            <li>
                                <button class="trade-symbol-row @(watched ? "trade-symbol-row-watched" : "")"
                                        @onclick="() => (watched ? UnwatchAsync(symbol.SymbolId) : WatchAsync(symbol.SymbolId))"
                                        title="@(watched ? $"Stop streaming {symbol.SymbolName}" : $"Stream live bid/ask for {symbol.SymbolName}")">
                                    <Icon Name="@(watched ? "eye-fill" : "plus-lg")" Class="trade-symbol-row-icon" />
                                    <span class="trade-symbol-row-name">@symbol.SymbolName</span>
                                </button>
                            </li>
                        }
                    </ul>
                    @if (TotalSymbolMatchCount > FilteredSymbols.Count)
                    {
                        <p class="trade-symbol-more">Showing @FilteredSymbols.Count of @TotalSymbolMatchCount — refine your search.</p>
                    }
                </section>
            }
        </aside>

        <main class="trade-main">
            @if (_chartSymbolId is not null)
            {
                <div class="trade-chart-panel">
                    <div class="trade-chart-header">
                        <span class="trade-chart-title">@_chartSymbolName</span>
                        @if (ChartQuote is { } q)
                        {
                            <span class="trade-chart-prices">
                                <span class="trade-chart-bid" title="Live bid">@Price(q.Bid)</span>
                                <span class="trade-chart-ask" title="Live ask">@Price(q.Ask)</span>
                            </span>
                        }
                        <BarSizeSelect @bind-Value="_barSizeSeconds" @bind-Value:after="OnBarSizeChangedAsync"
                                       Disabled="_chartLoading" Label="Aggregation"
                                       Title="Bar size the chart's live history and tick stream are aggregated into" />
                        <button class="trade-chart-close" @onclick="CloseChart" title="Close this chart">
                            <Icon Name="x-lg" Class="trade-chart-close-icon" />
                            CLOSE
                        </button>
                    </div>
                    <div class="trade-chart-toolbar">
                        <div class="trade-overlay-toggles" title="Toggle the computed chart overlays -- Point of Control/Value Area and a cumulative VWAP line">
                            <span class="trade-overlay-toggles-label">Indicators</span>
                            <button type="button" class="trade-overlay-toggle-btn trade-overlay-toggle-btn-lines @(_showProfileChartLines ? "active" : "")"
                                    @onclick="() => _showProfileChartLines = !_showProfileChartLines"
                                    title="Project the Point of Control/Value Area High/Low as three dashed lines on the chart">POC/VAH/VAL</button>
                            <button type="button" class="trade-overlay-toggle-btn trade-overlay-toggle-btn-vwap @(_showVwap ? "active" : "")"
                                    @onclick="() => _showVwap = !_showVwap"
                                    title="Show a cumulative volume-weighted average price line on the chart, over the same bar window as the lookback slider">VWAP</button>
                        </div>
                        <div class="trade-panel-toggles" title="Show or hide chart panels">
                            <span class="trade-panel-toggles-label">Panels</span>
                            <button type="button" class="trade-panel-toggle-btn @(_showMainChart ? "active" : "")"
                                    @onclick="() => _showMainChart = !_showMainChart"
                                    title="Show or hide the main price chart">Chart</button>
                            <button type="button" class="trade-panel-toggle-btn @(_showXGrid ? "active" : "")"
                                    @onclick="() => _showXGrid = !_showXGrid"
                                    title="Show or hide the XGrid footprint panel">XGrid</button>
                            <button type="button" class="trade-panel-toggle-btn @(_showVolumeProfile ? "active" : "")"
                                    @onclick="() => _showVolumeProfile = !_showVolumeProfile"
                                    title="Volume-at-price histogram over the lookback window">Volume profile</button>
                            <button type="button" class="trade-panel-toggle-btn @(_showTimeProfile ? "active" : "")"
                                    @onclick="() => _showTimeProfile = !_showTimeProfile"
                                    title="Time-at-price histogram over the lookback window">Time profile</button>
                            <button type="button" class="trade-panel-toggle-btn @(_showTraderControls ? "active" : "")"
                                    @onclick="() => _showTraderControls = !_showTraderControls"
                                    title="Manual order entry for this symbol -- places real orders on the connected cTrader account">Trader controls</button>
                        </div>
                    </div>
                    <div class="trade-window-bar">
                        <span class="trade-window-title">LOOKBACK WINDOW</span>
                        <div class="trade-window-rail"
                             title="The highlighted segment is the window itself -- its right edge is Offset bars back from now, its left edge Offset+Width bars back">
                            <div class="trade-window-track"></div>
                            <div class="trade-window-fill"
                                 style="right: @(BarWindowOffsetFillPercent.ToString("0.##", CultureInfo.InvariantCulture))%; width: @(Math.Min(BarWindowFillPercent, 100 - BarWindowOffsetFillPercent).ToString("0.##", CultureInfo.InvariantCulture))%"></div>
                            <input type="range" class="trade-window-slider" min="1" max="@MaxBarWindow" step="1"
                                   @bind="_barWindowSize" @bind:event="oninput"
                                   title="Number of bars the window spans -- drives the chart's window-start marker, the indicator overlays and the XGrid footprint" />
                        </div>
                        <input class="trade-window-input" type="number" min="1" max="@MaxBarWindow" @bind="_barWindowSize"
                               @bind:event="oninput" title="Number of bars the window spans" />
                        <span class="trade-window-title"
                              title="Bars back from the most recent bar to the end of the window -- 0 keeps the window anchored to now">OFFSET</span>
                        <input class="trade-window-input" type="number" min="0" max="@(MaxBarWindow - 1)"
                               @bind="_barWindowOffset" @bind:event="oninput"
                               title="Bars back from the most recent bar to the end of the window" />
                    </div>
                    @if (_chartLoading)
                    {
                        <p class="trade-chart-status">Loading history...</p>
                    }
                    else if (_chartError is not null)
                    {
                        <p class="trade-chart-status trade-chart-status-error">@_chartError</p>
                    }
                    else
                    {
                        <div class="trade-chart" @ref="_chartRowRef">
                            @if (_showMainChart)
                            {
                                <div class="trade-chart-main">
                                    <MarketChartContainer Bars="_chartBars" CurrentBid="ChartQuote?.Bid" CurrentAsk="ChartQuote?.Ask"
                                                 KeepView="_chartKeepView" ShowAnnotationTools="false"
                                                 WindowStartUtc="WindowStartUtc()" WindowEndUtc="WindowEndUtc()"
                                                 HorizontalLines="ProfileLevelLines()" VwapLine="VwapPoints()" />
                                </div>
                            }
                            @if (_showXGrid)
                            {
                                @if (ShowXGridDivider)
                                {
                                    <div class="trade-chart-divider" @ref="_chartDividerRef" data-min-width="160" title="Drag to resize"></div>
                                }
                                <div class="trade-chart-side">
                                    <XGridController Grid="ComputeXGrid()" @bind-PipCount="_xgridPipCount"
                                                      @bind-ColCount="_xgridColCount" ProfileBarCount="ClampedBarWindow" />
                                </div>
                            }
                            @if (_showVolumeProfile)
                            {
                                @if (ShowVolumeProfileDivider)
                                {
                                    <div class="trade-chart-divider" @ref="_chartDividerRefVolume" data-min-width="160" title="Drag to resize"></div>
                                }
                                <div class="trade-chart-side">
                                    <TickVolumeProfileChart WeightedSamples="MergedBarSamples()" CurrentPrice="ChartQuote?.Bid" />
                                </div>
                            }
                            @if (_showTimeProfile)
                            {
                                @if (ShowTimeProfileDivider)
                                {
                                    <div class="trade-chart-divider" @ref="_chartDividerRefTime" data-min-width="160" title="Drag to resize"></div>
                                }
                                <div class="trade-chart-side">
                                    <TickTimeProfileChart WeightedSamples="MergedBarTimeSamples()" CurrentPrice="ChartQuote?.Bid" />
                                </div>
                            }
                            @if (_showTraderControls)
                            {
                                @if (ShowTraderControlsDivider)
                                {
                                    <div class="trade-chart-divider" @ref="_chartDividerRefTrader" data-min-width="160" title="Drag to resize"></div>
                                }
                                <div class="trade-chart-side trade-chart-side-scroll">
                                    <TradeControlsPanel SymbolId="_chartSymbolId" SymbolName="_chartSymbolName"
                                                         CurrentBid="ChartQuote?.Bid" CurrentAsk="ChartQuote?.Ask" />
                                </div>
                            }
                            @if (!_showMainChart && !_showXGrid && !_showVolumeProfile && !_showTimeProfile && !_showTraderControls)
                            {
                                <p class="trade-chart-status">No panels selected -- turn a panel back on above.</p>
                            }
                        </div>
                    }
                </div>
            }
            else if (IsConnected)
            {
                <p class="trade-main-placeholder">Select symbols on the left to build a live watchlist, then select a watchlist row to view its price chart. Order placement comes next.</p>
            }
        </main>
    </div>

</div>
