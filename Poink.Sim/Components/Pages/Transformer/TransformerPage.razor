@page "/transformer"
@namespace Poink.Sim.Components.Pages
@using Poink.Sim.Components.Charts
@using Poink.Sim.Components.Shared.BarMinutesSelect
@using Poink.Sim.Components.Shared.TickDataSource
@using Poink.Sim.Transformer
@using Poink.Shared.Client.Components.Pages.CTrader

<div class="trf-page">

    <div class="trf-topbar">
        <header class="trf-header">
            <div class="trf-header-title">
                <span class="trf-header-symbol">TRANSFORMER</span>
                @if (_config is not null)
                {
                    <span class="trf-header-mode">@_config.Table</span>
                    <span class="trf-header-mode">@($"{_config.BarSize.TotalMinutes:0}m bars")</span>
                    <span class="trf-header-mode">
                        @_bars.Count.ToString("N0") bars / @_tickCount.ToString("N0") ticks
                        @(_reachedStart ? " (full range loaded)" : " (more history available)")
                    </span>
                }
                <span class="trf-header-state @StateClass()" title="Current transformer state">
                    @(_isLoading ? "LOADING" : HasData ? "READY" : "SETUP")
                </span>
            </div>
        </header>

        <div class="trf-datarow">
            <div class="trf-datarow-field trf-datarow-data">
                <TickDataSource @bind-Table="_table" @bind-From="_from" @bind-To="_to" Disabled="_isLoading" />
            </div>
            <BarMinutesSelect @bind-Value="_barMinutes" Disabled="@_isLoading" />
            <div class="trf-datarow-actions">
                <button class="trf-ctrl-btn trf-ctrl-btn-play" @onclick="Load"
                        disabled="@(_isLoading || _isLoadingMore)"
                        title="Load a recent slice of the selected range -- older history backfills automatically as you pan the chart">
                    @(_isLoading ? "LOADING..." : "LOAD")
                </button>
                @if (HasData && !_reachedStart)
                {
                    <button class="trf-ctrl-btn" @onclick="LoadMore" disabled="@(_isLoading || _isLoadingMore)"
                            title="Fetch the next older chunk of history -- same as panning the chart back to its earliest bar">
                        @(_isLoadingMore ? "LOADING OLDER..." : "LOAD OLDER")
                    </button>
                }
                @if (_error is not null)
                {
                    <span class="trf-error-inline" title="@_error">@_error</span>
                }
            </div>
        </div>
    </div>

    @if (HasData)
    {
        <div class="trf-overlay-toggles"
             title="Toggle the computed chart overlays driven by the Volume Range tool below -- POC/Value Area and VWAP">
            <span class="trf-overlay-toggles-label">CHART OVERLAYS</span>
            <label class="trf-overlay-toggle"
                   title="Highlight the Point of Control (most-traded price) and Value Area rows inside the volume profile panel">
                <input type="checkbox" @bind="_showProfilePanelLevels" />
                <span>POC/VA in profile</span>
            </label>
            <label class="trf-overlay-toggle"
                   title="Project the Point of Control/Value Area High/Low as three dashed lines on the main chart">
                <input type="checkbox" @bind="_showProfileChartLines" />
                <span>POC/VAH/VAL lines</span>
            </label>
            <label class="trf-overlay-toggle"
                   title="Show a cumulative volume-weighted average price line on the main chart, narrowed to the Volume Range selection if one is active">
                <input type="checkbox" @bind="_showVwap" />
                <span>VWAP line</span>
            </label>
        </div>
        <div class="trf-chart">
            <div class="trf-chart-main"
                 title="OHLC bar chart -- pan left to backfill older history, or use the toolbar's VOLUME RANGE tool to select the window the profile panels/overlays are built from">
                <DrawableOhlcvChart Bars="ToBarRows()" KeepView="_keepView" OnNearStart="LoadMore"
                                    ShowAnnotationTools="false" HorizontalLines="ProfileLevelLines()"
                                    RangeFills="VolumeRangeFill()" VwapLine="VwapPoints()"
                                    OnVolumeRangeDrawn="SetVolumeRange" HasVolumeRange="_volumeRangeStart is not null"
                                    OnVolumeRangeCleared="ClearVolumeRange" />
            </div>
            <div class="trf-chart-divider" @ref="_chartDividerRef" data-min-width="200" data-max-width="320"
                 title="Drag to resize"></div>
            <div class="trf-chart-side">
                <div class="trf-vp"
                     title="@((VolumeRangeLabel() is { } label
                                                     ? $"Volume profile for the selected Volume Range ({label}) -- use the toolbar's CLEAR VOLUME RANGE button to go back to every loaded bar"
                                                     : "Volume profile across every bar loaded so far -- use the toolbar's VOLUME RANGE tool to narrow it to a specific time window")
                                                     + ". POC/Value Area are highlighted below and projected onto the main chart as POC/VAH/VAL lines")">
                    <TickVolumeProfileChart WeightedSamples="MergedSamples()" CurrentPrice="LastClose"
                                            ShowLevels="_showProfilePanelLevels" />
                </div>
            </div>
            <div class="trf-chart-divider" @ref="_chartDividerRef2" data-min-width="200" data-max-width="320"
                 title="Drag to resize"></div>
            <div class="trf-chart-side">
                <div class="trf-vp"
                     title="@((VolumeRangeLabel() is { } timeLabel
                                                     ? $"Time profile for the selected Volume Range ({timeLabel}) -- use the toolbar's CLEAR VOLUME RANGE button to go back to every loaded bar"
                                                     : "Time profile across every bar loaded so far -- use the toolbar's VOLUME RANGE tool to narrow it to a specific time window")
                                                     + ". Measures dwell time (seconds) per price level instead of tick count")">
                    <TickTimeProfileChart WeightedSamples="MergedTimeSamples()" CurrentPrice="LastClose" />
                </div>
            </div>
        </div>

        @if (HasDeltaData)
        {
            <div class="trf-chart-hdivider" @ref="_chartHDividerRef" data-min-height="200" data-max-height-vh="80"
                 title="Drag to resize"></div>

            <div class="trf-log-panel">
                <div class="trf-log-tabs">
                    <button class="trf-tab-btn @(_activeDataTab == DataTab.TickDelta ? "active" : "")"
                            @onclick="() => _activeDataTab = DataTab.TickDelta">TICK DELTA CHART</button>
                    <button class="trf-tab-btn @(_activeDataTab == DataTab.LocalZScore ? "active" : "")"
                            @onclick="() => _activeDataTab = DataTab.LocalZScore">LOCAL Z-SCORE CHART</button>
                    <button class="trf-tab-btn @(_activeDataTab == DataTab.GlobalZScore ? "active" : "")"
                            @onclick="() => _activeDataTab = DataTab.GlobalZScore">GLOBAL Z-SCORE CHART</button>
                    <button class="trf-tab-btn @(_activeDataTab == DataTab.Drift ? "active" : "")"
                            @onclick="() => _activeDataTab = DataTab.Drift">DRIFT CHART</button>
                </div>
                <div class="trf-log-content">
                    @if (_activeDataTab == DataTab.TickDelta)
                    {
                        <div class="trf-delta-header">
                            <label class="trf-delta-control"
                                   title="How many synthetic ticks (in tick-count order, not wall-clock time) are grouped into each bar below">
                                <span>Ticks per bar</span>
                                <input type="number" min="1" max="1000" @bind="_deltaTicksPerBar" @bind:event="oninput" />
                            </label>
                            <span class="trf-header-mode">
                                @_deltaTicks.Count.ToString("N0") ticks
                                @(_volumeRangeStart is not null ? "from the selected Volume Range" : "from the latest loaded")@(":")
                                each differenced against the last tick in that window
                            </span>
                        </div>
                        <div class="trf-delta-chart"
                             title="@("Every earlier tick's difference from the latest tick (price(tick) - price(latest)) " +
                                      (_volumeRangeStart is not null
                                          ? "within the selected Volume Range"
                                          : "across the latest loaded ticks") +
                                      ", re-indexed by tick count instead of wall-clock time so real time gaps don't distort the aggregation, then bucketed into OHLC bars -- use the main chart's VOLUME RANGE tool to change which ticks this is built from")">
                            <DrawableOhlcvChart Bars="DeltaBarRows()" ShowAnnotationTools="false" HorizontalLines="ZeroLine()" />
                        </div>
                    }
                    else if (_activeDataTab == DataTab.LocalZScore)
                    {
                        <div class="trf-delta-header">
                            <label class="trf-delta-control"
                                   title="How many consecutive ticks each local mean/standard-deviation (and each resulting bar) is computed over">
                                <span>Window size</span>
                                <input type="number" min="1" max="1000" @bind="_zScoreWindowSize" @bind:event="oninput" />
                            </label>
                            <span class="trf-header-mode">
                                @_deltaTicks.Count.ToString("N0") ticks
                                @(_volumeRangeStart is not null ? "from the selected Volume Range" : "from the latest loaded")@(":")
                                partitioned into independent windows, each normalized against its own mean/standard deviation
                            </span>
                        </div>
                        <div class="trf-delta-chart"
                             title="@("Every tick re-expressed as (price - window mean) / window standard deviation, computed independently per "
                                      + _zScoreWindowSize + "-tick sub-window "
                                      + (_volumeRangeStart is not null ? "within the selected Volume Range" : "across the latest loaded ticks")
                                      + " -- zero-mean/unit-variance per sub-window, so geometric shape reads independently of macro trend or price level. Contrast with GLOBAL Z-SCORE, which normalizes the whole selection as one window")">
                            <DrawableOhlcvChart Bars="ZScoreBarRows()" ShowAnnotationTools="false" />
                        </div>
                    }
                    else if (_activeDataTab == DataTab.GlobalZScore)
                    {
                        <div class="trf-delta-header">
                            <label class="trf-delta-control"
                                   title="How many synthetic ticks (in tick-count order, not wall-clock time) are grouped into each bar below -- purely a charting bucket size, unrelated to the normalization itself">
                                <span>Ticks per bar</span>
                                <input type="number" min="1" max="1000" @bind="_globalZScoreTicksPerBar" @bind:event="oninput" />
                            </label>
                            <span class="trf-header-mode">
                                @_deltaTicks.Count.ToString("N0") ticks
                                @(_volumeRangeStart is not null ? "from the selected Volume Range" : "from the latest loaded")@(":")
                                all normalized against one shared mean/standard deviation
                            </span>
                        </div>
                        <div class="trf-delta-chart"
                             title="@("Every tick re-expressed as (price - mean) / standard deviation, computed once over the entire selection "
                                      + "(" + (_volumeRangeStart is not null ? "the selected Volume Range" : "the latest loaded ticks") + ") "
                                      + "rather than per sub-window -- zero-mean/unit-variance across the whole lookback. Contrast with LOCAL Z-SCORE, which re-normalizes every window-size chunk independently")">
                            <DrawableOhlcvChart Bars="GlobalZScoreBarRows()" ShowAnnotationTools="false" />
                        </div>
                    }
                    else
                    {
                        <div class="trf-delta-header">
                            <div class="trf-delta-control" title="Whether drift is expressed as a fraction of the anchor price or as a log ratio -- log makes an equal-magnitude rally and selloff symmetric, plain percentage does not">
                                <span>Mode</span>
                                <label title="d = (price - anchor) / anchor">
                                    <input type="radio" name="driftMode" checked="@(_driftMode == DriftMode.Percentage)"
                                           @onchange="() => _driftMode = DriftMode.Percentage" />
                                    Percentage
                                </label>
                                <label title="d = ln(price / anchor)">
                                    <input type="radio" name="driftMode" checked="@(_driftMode == DriftMode.Log)"
                                           @onchange="() => _driftMode = DriftMode.Log" />
                                    Log
                                </label>
                            </div>
                            <label class="trf-delta-control"
                                   title="How many synthetic ticks (in tick-count order, not wall-clock time) are grouped into each bar below">
                                <span>Ticks per bar</span>
                                <input type="number" min="1" max="1000" @bind="_driftTicksPerBar" @bind:event="oninput" />
                            </label>
                            <span class="trf-header-mode">
                                @_deltaTicks.Count.ToString("N0") ticks
                                @(_volumeRangeStart is not null ? "from the selected Volume Range" : "from the latest loaded")@(":")
                                each expressed as drift from the anchor (latest) price
                            </span>
                        </div>
                        <div class="trf-delta-chart"
                             title="@("Every earlier tick's " + (_driftMode == DriftMode.Log ? "log ratio to" : "fractional drift from") +
                                      " the latest (anchor) price, re-indexed by tick count instead of wall-clock time "
                                      + (_volumeRangeStart is not null ? "within the selected Volume Range" : "across the latest loaded ticks")
                                      + ", then bucketed into OHLC bars -- a 2% move reads the same regardless of the asset's absolute price level")">
                            <DrawableOhlcvChart Bars="DriftBarRows()" ShowAnnotationTools="false" HorizontalLines="ZeroLine()" />
                        </div>
                    }
                </div>
            </div>
        }
    }
    else if (!_isLoading)
    {
        <p class="trf-empty">Pick a symbol and date range above, then LOAD to view its bar chart and profiles.</p>
    }

</div>
