@namespace Poink.Sim.Components.Training
@using Poink.Sim.Components.Shared.DataTable
@using Poink.Sim.Models
@using Poink.Sim.Components.Shared.Icon

@if (Service.TotalEpisodes == 0)
{
    <p class="train-help">No training run yet — fill in the controls above and hit Start Training.</p>
}
else
{



    <div class="train-live-toggle">
        <button class="train-live-toggle-btn @(_liveFeedbackPaused ? "paused" : "")" @onclick="ToggleLiveFeedback"
                title="@(_liveFeedbackPaused
                                                                                           ? "Resume live updates for the charts, current-episode panel, inputs/outputs and stats tables below -- training keeps running in the background either way"
                                                                                           : "Freeze the charts, current-episode panel, inputs/outputs and stats tables below at their current values -- Episodes and the stat tiles above keep updating live")">
            <Icon Name="@(_liveFeedbackPaused ? "play-fill" : "pause-fill")" Class="train-live-toggle-icon" />
            @(_liveFeedbackPaused ? "RESUME LIVE VIEW" : "PAUSE LIVE VIEW")
        </button>
        @if (_liveFeedbackPaused)
        {
            <span class="train-live-toggle-hint">frozen -- charts below are not updating</span>
        }
    </div>

    <div class="train-live-grid">

        <div class="train-live-panel train-live-panel-wide">
            <div class="train-panel-title train-panel-title-row">
                <span>CURRENT EPISODE <span class="train-panel-subtitle">(bars, volume profile and price profile of
                    the most recently completed episode)</span></span>
                @if (EpisodeBarRows.Count > 0)
                {
                    <div class="train-episode-panel-toggles" title="Show or hide each chart panel below">
                        <label class="train-episode-panel-toggle">
                            <input type="checkbox" @bind="_showMarketChart" />
                            <span>Chart</span>
                        </label>
                        <label class="train-episode-panel-toggle">
                            <input type="checkbox" @bind="_showVolumeProfile" />
                            <span>Volume profile</span>
                        </label>
                        <label class="train-episode-panel-toggle">
                            <input type="checkbox" @bind="_showTimeProfile" />
                            <span>Time profile</span>
                        </label>
                        <label class="train-episode-panel-toggle"
                               title="Footprint grid of the same trailing bar window XGrid Signals inputs (when this brain includes them) are computed over">
                            <input type="checkbox" @bind="_showXGrid" />
                            <span>XGrid</span>
                        </label>
                        @if (_showXGrid)
                        {
                            <button type="button" class="train-episode-btn" @onclick="MatchXGridToBrainConfig"
                                    title="Set the XGrid panel's Pips/Cols to this brain's own XGrid Signals encoder settings (Row/Col in Build), so it shows exactly the grid the network decides from">
                                MATCH BRAIN CONFIG
                            </button>
                        }
                    </div>
                }
            </div>
            @if (EpisodeBarRows.Count == 0)
            {
                <span class="train-episode-empty">no episode data yet</span>
            }
            else
            {
                <div class="train-episode-controls">
                    @if (_isReplaying)
                    {
                        <button class="train-episode-btn train-episode-btn-play" @onclick="PauseEpisode" title="Pause the replay">
                            <Icon Name="pause-fill" Class="train-episode-icon" />
                            PAUSE
                        </button>
                    }
                    else
                    {
                        <button class="train-episode-btn train-episode-btn-play" @onclick="PlayEpisode" disabled="@(!CanReplay)"
                                title="@(ReplayHasPausedProgress
                                                                                                                                                                           ? "Resume watching the trader trade through this episode, bar by bar"
                                                                                                                                                                           : "Replay this episode from the start, bar by bar, so you can watch the trader trade")">
                            <Icon Name="play-fill" Class="train-episode-icon" />
                            @(ReplayHasPausedProgress ? "RESUME" : "PLAY")
                        </button>
                    }
                    <div class="train-episode-speed" title="Replay speed -- how many bars reveal per second">
                        <button class="train-episode-btn train-episode-speed-step" @onclick="DecreaseReplaySpeed"
                                disabled="@(_replaySpeedIndex == 0)" title="Slower">-</button>
                        <span class="train-episode-speed-value">@FormatReplaySpeed(ReplaySpeed)</span>
                        <button class="train-episode-btn train-episode-speed-step" @onclick="IncreaseReplaySpeed"
                                disabled="@(_replaySpeedIndex == ReplaySpeedOptions.Length - 1)" title="Faster">+</button>
                    </div>
                    @if (_replayBars is not null)
                    {
                        <span class="train-episode-progress">bar @_revealedBarCount / @_replayBars.Count</span>
                    }
                    <span class="train-episode-decision"
                          title="Bar steps a decision on each bar's close. Cell steps on a fixed-width price band instead -- this is how the currently displayed episode was actually run">
                        STEP: @(DisplayedSteppingMode == SimulationSteppingMode.Cell ? $"CELL ({DisplayedCellWidth:0.#####})" : "BAR")
                    </span>
                    <span class="train-episode-decision @DecisionClass(DisplayedBarAction?.Action)"
                          title="The action taken on the currently displayed bar (live, or wherever the replay is currently revealed)">
                        DECISION: @DecisionLabel(DisplayedBarAction?.Action)
                    </span>
                    <div class="train-episode-live-stats"
                         title="Trader stats for the trades revealed so far (live, or up to wherever the replay is currently revealed)">
                        <div class="train-stat">
                            <span class="train-stat-label">won</span>
                            <span class="train-stat-value">@DisplayedTraderStats.WinCount</span>
                        </div>
                        <div class="train-stat">
                            <span class="train-stat-label">lost</span>
                            <span class="train-stat-value">@DisplayedTraderStats.LossCount</span>
                        </div>
                        <div class="train-stat">
                            <span class="train-stat-label">buys</span>
                            <span class="train-stat-value">@DisplayedTraderStats.BuyCount</span>
                        </div>
                        <div class="train-stat">
                            <span class="train-stat-label">sells</span>
                            <span class="train-stat-value">@DisplayedTraderStats.SellCount</span>
                        </div>
                        <div class="train-stat">
                            <span class="train-stat-label">equity</span>
                            <span class="train-stat-value">@(DisplayedEquity?.ToString("N2") ?? "—")</span>
                        </div>
                        <div class="train-stat"
                             title="@($"Decisions blocked because they couldn't execute -- {DisplayedBlockedCounts.Longs} enter-long (already in a position), {DisplayedBlockedCounts.Shorts} enter-short (already in a position), {DisplayedBlockedCounts.Closes} close (no position open) -- see the ✗L/✗S/✗C chart markers")">
                            <span class="train-stat-label">blocked</span>
                            <span class="train-stat-value">@(DisplayedBlockedCounts.Longs + DisplayedBlockedCounts.Shorts +
                                                                                                                                                        DisplayedBlockedCounts.Closes)</span>
                            </div>
                        </div>
                    </div>

                    <div class="train-episode-row">
                        @if (_showMarketChart)
                        {
                            <div class="train-episode-chart-panel">
                                <MarketChart Bars="DisplayedEpisodeBars" DiagonalLines="DisplayedTradeLines"
                                                    RangeFills="DisplayedWindowRange" VerticalLines="DisplayedWarmupBoundary"
                                                    Markers="DisplayedActionMarkers" EntryPrice="DisplayedEntryPrice"
                                                    PositionIsLong="DisplayedPositionIsLong" StopLossPrice="DisplayedStopLossPrice"
                                                    TakeProfitPrice="DisplayedTakeProfitPrice" Interactive="false" />
                            </div>
                        }
                        @if (_showVolumeProfile)
                        {
                            <div class="train-episode-chart-panel">
                                <TickVolumeProfileChart WeightedSamples="EpisodeVolumeProfileSamples" CurrentPrice="EpisodeLastPrice" />
                            </div>
                        }
                        @if (_showTimeProfile)
                        {
                            <div class="train-episode-chart-panel">
                                <TickTimeProfileChart WeightedSamples="EpisodeTimeProfileSamples" CurrentPrice="EpisodeLastPrice" />
                            </div>
                        }
                        @if (_showXGrid)
                        {
                            <div class="train-episode-chart-panel">
                                <XGrid Grid="EpisodeXGrid" Positions="DisplayedXGridPositions" Lines="DisplayedCellBandLines"
                                       @bind-PipCount="_xgridPipCount" @bind-ColCount="_xgridColCount" />
                            </div>
                        }
                    </div>
                    <div class="train-episode-hdivider" @ref="_episodeChartHDividerRef" data-min-height="200" data-max-height-vh="80"
                         title="Drag to resize"></div>
                }
            </div>

        </div>

        <div class="train-live-panel train-live-panel-wide">
            <div class="train-panel-title">
                NETWORK INPUTS <span class="train-panel-subtitle">(exact values the network received for its decision on the
                    currently displayed bar -- tracks the replay position)</span>
            </div>
            @if (DisplayedInputGroups.Count == 0)
            {
                <span class="train-episode-empty">@NetworkInputsEmptyReason</span>
            }
            else
            {
                <div class="train-inputs-groups">
                    @foreach (var group in DisplayedInputGroups)
                    {
                        <div class="train-inputs-card @group.ColorClass"
                             title="@($"{group.Source}: {group.Values.Count} inputs")">
                            <div class="train-inputs-card-title">@group.Source</div>
                            <div class="train-inputs-card-values">
                                @foreach (var v in group.Values)
                                {
                                    <span class="train-inputs-value" title="@v.Label">@v.Value</span>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="train-stats-panel">
            <div class="train-stats-tabs">
                <button class="train-tab-btn @(_activeStatsTab == StatsTab.Session ? "active" : "")"
                        @onclick="() => _activeStatsTab = StatsTab.Session"
                        title="Trader statistics pooled across every retained episode this training run">SESSION</button>
                <button class="train-tab-btn @(_activeStatsTab == StatsTab.Trader ? "active" : "")"
                        @onclick="() => _activeStatsTab = StatsTab.Trader"
                        title="Full trader statistics (wins/losses, streaks, time in market) for each completed episode">TRADER</button>

            </div>
            <div class="train-stats-content">
                @if (_activeStatsTab == StatsTab.Trader)
                {
                    <DataTable TItem="TraderStatsRow" Items="EpisodeTraderStatsRows" ShowRowNumbers="false" ShowActions="false"
                               CellClass="TraderStatsCellClass" EmptyMessage="no trades yet" />
                }
                else
                {
                    <DataTable TItem="TraderStatsRow" Items="SessionTraderStatsRows" ShowRowNumbers="false" ShowActions="false"
                               CellClass="TraderStatsCellClass" EmptyMessage="no trades yet" />
                }
            </div>
        </div>
    }
