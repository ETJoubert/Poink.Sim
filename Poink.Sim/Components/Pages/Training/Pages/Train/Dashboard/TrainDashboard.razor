@namespace Poink.Sim.Components.Training

@if (Service.TotalEpisodes == 0)
{
    <p class="train-help">No training run yet — fill in the controls above and hit Start Training.</p>
}
else
{
    <div class="train-dash">
        <div class="dash-panel dash-area-kpis" title="Run status and headline reward/equity metrics for this training run">
            <span class="dash-state dash-state-@(StateLabel.ToLowerInvariant())">@StateLabel</span>
            <div class="dash-kpi" title="Completed episodes out of the total requested for this run">
                <span class="dash-kpi-label">episodes</span>
                <span class="dash-kpi-value">@Service.EpisodesCompleted / @Service.TotalEpisodes</span>
            </div>
            <div class="dash-kpi" title="Mean reward over the recent-episode rolling window">
                <span class="dash-kpi-label">avg reward</span>
                <span class="dash-kpi-value @SignClass(Service.RecentAverageReward)">@Service.RecentAverageReward.ToString("N2")</span>
            </div>
            <div class="dash-kpi" title="Highest single-episode reward this run">
                <span class="dash-kpi-label">best</span>
                <span class="dash-kpi-value @SignClass(Service.BestReward)">@Service.BestReward.ToString("N2")</span>
            </div>
            <div class="dash-kpi" title="Lowest single-episode reward this run">
                <span class="dash-kpi-label">worst</span>
                <span class="dash-kpi-value @SignClass(Service.WorstReward)">@Service.WorstReward.ToString("N2")</span>
            </div>
            <div class="dash-kpi" title="Median reward across the retained episode window">
                <span class="dash-kpi-label">median</span>
                <span class="dash-kpi-value @SignClass(RewardDistribution.Median)">@RewardDistribution.Median.ToString("N2")</span>
            </div>
            <div class="dash-kpi" title="Population standard deviation of reward -- falling means training is stabilizing">
                <span class="dash-kpi-label">std dev</span>
                <span class="dash-kpi-value">@RewardDistribution.StdDev.ToString("N2")</span>
            </div>
            <div class="dash-kpi" title="Best reward minus worst reward this run">
                <span class="dash-kpi-label">spread</span>
                <span class="dash-kpi-value">@RewardSpread.ToString("N2")</span>
            </div>
            @if (LastEquity is { } lastEquity)
            {
                <div class="dash-kpi" title="Final equity of the most recently completed episode">
                    <span class="dash-kpi-label">last equity</span>
                    <span class="dash-kpi-value">@lastEquity.ToString("N0")</span>
                </div>
            }
        </div>

        <div class="dash-panel dash-area-gauges" title="Run progress and win-rate ratios">
            <RadialGauge Value="ProgressPercent" Min="0" Max="100" Label="PROGRESS" ValueSuffix="%" ColorVariant="secondary"
                         Title="Run progress -- completed episodes out of the total requested" />
            <RadialGauge Value="WinRatePercent" Min="0" Max="100" Label="WIN RATE" ValueSuffix="%" ColorVariant="primary"
                         Title="Percent of recent-window episodes with positive reward" />
        </div>

        <div class="dash-panel dash-area-reward" title="Reward per episode, raw or candle-aggregated">
            <div class="dash-panel-title">REWARD</div>
            <RewardChart Episodes="Service.RecentEpisodes" IsRunning="Service.IsRunning" />
        </div>

        <div class="dash-panel dash-area-trends" title="Rolling-window median reward and win rate trends">
            <div class="dash-trend-cell">
                <div class="dash-panel-title">MEDIAN REWARD</div>
                <TrendLineChart Episodes="Service.RecentEpisodes" IsRunning="Service.IsRunning" Aggregate="@MedianReward"
                                 ColorVariant="median" />
            </div>
            <div class="dash-trend-cell">
                <div class="dash-panel-title">REWARD STD DEV</div>
                <TrendLineChart Episodes="Service.RecentEpisodes" IsRunning="Service.IsRunning" Aggregate="@RewardStdDev"
                                 ColorVariant="stddev" />
            </div>
        </div>

        <div class="dash-panel dash-area-episodes" title="Heatmap of every retained episode's reward this run">
            <div class="dash-panel-title">EPISODES</div>
            <div class="dash-scroll">
                <EpisodeGrid Episodes="Service.RecentEpisodes" IsRunning="Service.IsRunning" />
            </div>
        </div>

        <div class="dash-panel dash-area-actions" title="Share of decisions taken this run, by action type">
            <div class="dash-panel-title">ACTION DISTRIBUTION</div>
            <div class="action-dist">
                <div class="action-dist-row">
                    <span class="action-dist-label action-dist-hold">HOLD</span>
                    <div class="action-dist-track">
                        <div class="action-dist-fill action-dist-fill-hold" style="width: @(Pct(ActionPercents.Hold))%"></div>
                    </div>
                    <span class="action-dist-pct">@ActionPercents.Hold.ToString("N0")%</span>
                </div>
                <div class="action-dist-row">
                    <span class="action-dist-label action-dist-long">LONG</span>
                    <div class="action-dist-track">
                        <div class="action-dist-fill action-dist-fill-long" style="width: @(Pct(ActionPercents.EnterLong))%"></div>
                    </div>
                    <span class="action-dist-pct">@ActionPercents.EnterLong.ToString("N0")%</span>
                </div>
                <div class="action-dist-row">
                    <span class="action-dist-label action-dist-short">SHORT</span>
                    <div class="action-dist-track">
                        <div class="action-dist-fill action-dist-fill-short" style="width: @(Pct(ActionPercents.EnterShort))%"></div>
                    </div>
                    <span class="action-dist-pct">@ActionPercents.EnterShort.ToString("N0")%</span>
                </div>
                <div class="action-dist-row">
                    <span class="action-dist-label action-dist-close">CLOSE</span>
                    <div class="action-dist-track">
                        <div class="action-dist-fill action-dist-fill-close" style="width: @(Pct(ActionPercents.Close))%"></div>
                    </div>
                    <span class="action-dist-pct">@ActionPercents.Close.ToString("N0")%</span>
                </div>
            </div>
        </div>

        @{ var spark = EquitySparkline; }
        <div class="dash-panel dash-area-equity" title="Equity curve, bar by bar, for the most recently completed episode">
            <div class="dash-panel-title">
                EQUITY (CURRENT EPISODE)
                @if (spark.HasData)
                {
                    <span class="train-panel-subtitle">@spark.FinalEquity.ToString("N0") final</span>
                }
            </div>
            @if (!spark.HasData)
            {
                <span class="dash-empty">no episode data yet</span>
            }
            else
            {
                <svg viewBox="0 0 600 80" preserveAspectRatio="none" class="dash-spark-svg">
                    <title>final equity @spark.FinalEquity.ToString("N0")</title>
                    <line x1="0" y1="@spark.BaselineY" x2="600" y2="@spark.BaselineY" class="dash-spark-baseline" />
                    <polyline points="@spark.PolylinePoints" class="dash-spark-line" />
                </svg>
            }
        </div>

        @{ var logRows = LogRows; }
        <div class="dash-panel dash-area-log" title="Chronological log of training run events -- most recent first">
            <div class="dash-panel-title">TRAINING LOG</div>
            <div class="dash-scroll dash-log">
                @if (logRows.Count == 0)
                {
                    <span class="dash-empty">no log entries yet</span>
                }
                else
                {
                    @foreach (var entry in logRows)
                    {
                        <div class="dash-log-row">
                            <span class="dash-log-time">@FormatLogTime(entry.TimestampUtc)</span>
                            <span class="dash-log-level dash-log-@entry.Level">@entry.Level</span>
                            <span class="dash-log-message">@entry.Message</span>
                        </div>
                    }
                }
            </div>
        </div>
    </div>
}
