@page "/train"
@namespace Poink.Sim.Components.Pages
@using Poink.Sim.Brain.Neural
@using Poink.Sim.Components.Training
@using Poink.Sim.Components.Shared.TickDataSource
@using Poink.Shared.Client.Components.Shared.Icon

<div class="train-page">
    <div class="train-topbar">
        <header class="train-header">
            <span class="train-title">BRAIN TRAINING</span>
            @if (!string.IsNullOrWhiteSpace(_brainName))
            {
                <span class="train-header-mode">brain: @_brainName</span>
                <span class="train-header-mode">in use: @(CurrentActiveSnapshot?.Name ?? "none")</span>
            }
            <span class="train-state @(Service.IsRunning ? "train-state-running" : "")">
                @(Service.IsRunning ? (Service.IsPaused ? "PAUSED" : "TRAINING") : "IDLE")
            </span>

            <div class="train-header-end">
                <div class="train-header-save">
                    @if (_showSaveInput)
                    {
                        <input class="train-header-save-input" type="text" placeholder="e.g. mlp-v1-momentum-set"
                               @bind="_saveName" @bind:event="oninput" @onkeydown="OnSaveNameKeyDown" autofocus
                               title="Name to save this snapshot under" />
                        <button class="terminal-btn-action" @onclick="SaveModel"
                                disabled="@string.IsNullOrWhiteSpace(_saveName)"
                                title="Saves the selected brain's current weights, plus this screen's strategy/parameters, as a new snapshot">
                            SAVE
                        </button>
                        <button class="terminal-btn-action" @onclick="CancelSaveModel" title="Cancel without saving">
                            CANCEL
                        </button>
                    }
                    else
                    {
                        <button class="terminal-btn-action" @onclick="ShowSaveModelInput"
                                disabled="@string.IsNullOrWhiteSpace(_brainName)"
                                title="Saves the selected brain's current weights, plus this screen's strategy/parameters, as a new snapshot">
                            SAVE MODEL
                        </button>
                    }
                    @if (Service.SaveStatus is not null)
                    {
                        <span class="train-header-save-status">@Service.SaveStatus</span>
                    }
                </div>
            </div>
        </header>

        @if (!_controlsCollapsed)
        {
            <div class="train-datarow">
                <span class="train-section-label" title="Which symbol and time range the Start button samples episodes from">Data Range</span>
                <div class="train-datarow-field train-datarow-data">
                    <TickDataSource @bind-Table="_table" @bind-From="_from" @bind-To="_to" Disabled="Service.IsRunning" />
                </div>
            </div>

            <div class="train-datarow">
                <span class="train-section-label" title="Which brain (neural network or heuristic) this run trains and plays back">Brain Type</span>
                <BrainSelect BrainOptions="Service.BrainOptions" @bind-BrainName="_brainName" Disabled="Service.IsRunning" />
                <button class="terminal-btn-action" @onclick="ToggleBuildBrain" disabled="@Service.IsRunning"
                        title="Assemble a new brain from encoder/architecture parts -- it's added to the list above once created">
                    @(_showBuildBrain ? "- BUILD BRAIN" : "+ BUILD BRAIN")
                </button>
            </div>

            @if (_showBuildBrain)
            {
                <div class="train-datarow train-buildbrain">
                    <span class="train-section-label" title="Pick which encoders feed this brain's market data, and which network shape reads them">Build Brain</span>
                    <label class="train-brainrow-field" title="Unique name for this brain -- must not match an existing one">
                        Name
                        <input class="train-brainrow-input train-brainrow-input-wide" type="text"
                               value="@EffectiveBuildBrainName" @oninput="OnBuildBrainNameInput"
                               disabled="@(Service.IsRunning || _buildBrainNameAuto)" placeholder="e.g. lstm-vp-experiment" />
                    </label>
                    <label class="train-brainrow-field"
                           title="Auto-generate the name from architecture, layers, and selected data -- uncheck to type your own">
                        <input type="checkbox" checked="@_buildBrainNameAuto" @onchange="OnToggleAutoBuildBrainName"
                               disabled="@Service.IsRunning" /> Auto Name
                    </label>
                    <label class="train-brainrow-field" title="20-bar trailing percent-change price window">
                        <input type="checkbox" @bind="_includeBarWindow" disabled="@Service.IsRunning" /> Bar Window
                    </label>
                    <label class="train-brainrow-field" title="Volume histogram + point-of-control/value-area summary, merged from Profile lookback bars below">
                        <input type="checkbox" @bind="_includeVolumeProfile" disabled="@Service.IsRunning" /> Volume Profile
                    </label>
                    <label class="train-brainrow-field" title="Time-weighted histogram + point-of-control/value-area summary (seconds spent at each price level), merged from Profile lookback bars below">
                        <input type="checkbox" @bind="_includeTimeProfile" disabled="@Service.IsRunning" /> Time Profile
                    </label>
                    <label class="train-brainrow-field" title="Same volume histogram + point-of-control/value-area summary as Volume Profile, but unnormalized -- feeds the network exact tick counts and exact price levels instead of a fraction-of-total/percent-offset">
                        <input type="checkbox" @bind="_includeVolumeProfileRaw" disabled="@Service.IsRunning" /> Volume Profile (Raw)
                    </label>
                    <label class="train-brainrow-field" title="Same time-weighted histogram + point-of-control/value-area summary as Time Profile, but unnormalized -- feeds the network exact seconds spent and exact price levels instead of a fraction-of-total/percent-offset">
                        <input type="checkbox" @bind="_includeTimeProfileRaw" disabled="@Service.IsRunning" /> Time Profile (Raw)
                    </label>
                    <label class="train-brainrow-field" title="Always included -- every brain needs to know its own position/capital regardless of market data">
                        <input type="checkbox" checked="checked" disabled /> Trader State
                    </label>
                    <label class="train-brainrow-field" title="Network shape applied to the combined features selected above">
                        Architecture
                        <select class="train-brainrow-select" value="@_architectureKind" @onchange="OnArchitectureKindChanged" disabled="@Service.IsRunning">
                            <option value="Mlp">MLP</option>
                            <option value="Lstm">LSTM</option>
                        </select>
                    </label>
                    @if (_architectureKind == ArchitectureKind.Mlp)
                    {
                        <label class="train-brainrow-field" title="Comma-separated hidden layer sizes, e.g. 64,32,16">
                            Hidden layers
                            <input class="train-brainrow-input train-brainrow-input-wide" type="text" @bind="_mlpHiddenSizesText"
                                   disabled="@Service.IsRunning" />
                        </label>
                    }
                    else
                    {
                        <label class="train-brainrow-field" title="LSTM hidden state size">
                            Hidden size
                            <input class="train-brainrow-input" type="number" min="1" @bind="_lstmHiddenSize" disabled="@Service.IsRunning" />
                        </label>
                        <label class="train-brainrow-field" title="Number of stacked LSTM layers">
                            LSTM layers
                            <input class="train-brainrow-input" type="number" min="1" @bind="_lstmNumLayers" disabled="@Service.IsRunning" />
                        </label>
                        @if (!_includeBarWindow)
                        {
                            <span class="train-brainrow-error">LSTM needs Bar Window for its sequence</span>
                        }
                    }
                    <button class="terminal-btn-action" @onclick="CreateBrain" disabled="@(Service.IsRunning || !CanCreateBrain)"
                            title="Builds and registers this brain -- pick it from Brain Type above to train it">
                        CREATE BRAIN
                    </button>
                    @if (_buildBrainStatus is not null)
                    {
                        <span class="train-brainrow-error">@_buildBrainStatus</span>
                    }
                </div>
            }

            <div class="train-datarow">
                <span class="train-section-label" title="How raw ticks are shaped into bars, and how far back a Volume/Time Profile brain looks over that bar data">Data Structure</span>
                <label class="train-brainrow-field" title="Time span of one bar (M), in minutes -- also determines how much wall-clock time an episode's fetched ticks need to cover">
                    Bar width (min)
                    <input class="train-brainrow-input" type="number" min="1" step="1" @bind="_barWidthMinutes" disabled="@Service.IsRunning" />
                </label>
                <label class="train-brainrow-field" title="How many recent bars a Volume Profile and/or Time Profile brain merges into its profile each decision (shared between both when a brain includes both) -- ignored by brains that use neither (e.g. MLP Policy, LSTM Policy)">
                    Profile lookback (bars)
                    <input class="train-brainrow-input" type="number" min="1" step="1" @bind="_lookbackBars"
                           disabled="@Service.IsRunning" />
                </label>
            </div>

            <div class="train-datarow">
                <span class="train-section-label" title="The training algorithm, and how much data each episode/run consists of">Training</span>
                <label class="train-brainrow-field">
                    Strategy
                    <select class="train-brainrow-select" value="@_strategyName" @onchange="OnStrategyChanged" disabled="@Service.IsRunning">
                        @foreach (var name in Service.StrategyNames)
                        {
                            <option value="@name">@name</option>
                        }
                    </select>
                </label>
                <label class="train-brainrow-field">
                    Episodes
                    <input class="train-brainrow-input train-brainrow-input-narrow" type="number" min="1"
                           @bind="_episodeCount" disabled="@Service.IsRunning" />
                </label>
                <label class="train-brainrow-field" title="How many bars one episode runs for (E) -- ticks are fetched to cover this many bars, then the episode stops once the last one completes, regardless of tick density">
                    Bars/episode
                    <input class="train-brainrow-input" type="number" min="1" @bind="_episodeBars" disabled="@Service.IsRunning" />
                </label>
                <label class="train-brainrow-field">
                    Learning rate
                    <input class="train-brainrow-input" type="number" min="0.00001" step="0.0001" @bind="_learningRate"
                           disabled="@Service.IsRunning" />
                </label>
            </div>

            <div class="train-datarow">
                <span class="train-section-label" title="Starting capital the simulated Trader begins each episode with">Trader</span>
                <label class="train-brainrow-field">
                    Starting cash
                    <input class="train-brainrow-input" type="number" min="1" step="100" @bind="_startingCash"
                           disabled="@Service.IsRunning" />
                </label>
                <label class="train-brainrow-field" title="Notional exposure per unit of margin committed -- 1 means no leverage">
                    Leverage
                    <input class="train-brainrow-input" type="number" min="1" step="1" @bind="_leverage"
                           disabled="@Service.IsRunning" />
                </label>
                <label class="train-brainrow-field" title="Commission charged per fill, as a percent of that fill's notional value">
                    Commission %
                    <input class="train-brainrow-input" type="number" min="0" step="0.01" @bind="_commissionRatePercent"
                           disabled="@Service.IsRunning" />
                </label>
                <label class="train-brainrow-field" title="Force-close the open position when Margin Level (Equity ÷ Margin Used) drops below this percent">
                    Stop-out %
                    <input class="train-brainrow-input" type="number" min="1" max="100" step="1" @bind="_stopOutLevelPercent"
                           disabled="@Service.IsRunning" />
                </label>
            </div>

            <div class="train-datarow train-datarow-disabled">
                <span class="train-section-label" title="How reward is computed each decision point">Reward Policy</span>
                <span class="train-brainrow-note">Equity drift since the previous decision point -- not yet configurable</span>
            </div>
        }

        <div class="train-toolbar">
            <div class="train-controls">
                <button class="train-ctrl-btn train-ctrl-btn-collapse" @onclick="ToggleControls"
                        title="Show/hide the Data Range/Brain Type/.../Reward Policy rows above -- collapse them once a run's parameters are set, to give the panels below more room">
                    <Icon Name="@(_controlsCollapsed ? "chevron-right" : "chevron-down")" Class="train-ctrl-icon" />
                </button>

                @if (!Service.IsRunning)
                {
                    <button class="train-ctrl-btn train-ctrl-btn-play" @onclick="StartTraining"
                            title="Trains on the symbol/range picked above -- each episode streams its own random window straight from Postgres">
                        <Icon Name="play-fill" Class="train-ctrl-icon" />
                        START
                    </button>
                    <button class="train-ctrl-btn" @onclick="StepTraining"
                            title="Runs exactly one episode on the symbol/range picked above, then pauses -- lets you step through training one episode at a time from the start">
                        <Icon Name="skip-end-fill" Class="train-ctrl-icon" />
                        STEP
                    </button>
                }
                else if (Service.IsPaused)
                {
                    <button class="train-ctrl-btn train-ctrl-btn-play" @onclick="ResumeTraining"
                            title="Resume training from where it paused">
                        <Icon Name="play-fill" Class="train-ctrl-icon" />
                        RESUME
                    </button>
                    <button class="train-ctrl-btn" @onclick="StepTraining"
                            title="Runs exactly one more episode, then pauses again -- lets you step through training one episode at a time">
                        <Icon Name="skip-end-fill" Class="train-ctrl-icon" />
                        STEP
                    </button>
                    <button class="train-ctrl-btn train-ctrl-btn-warn" @onclick="StopTraining"
                            title="Stop training once the in-flight episode finishes">
                        STOP
                    </button>
                }
                else
                {
                    <button class="train-ctrl-btn train-ctrl-btn-play" @onclick="PauseTraining"
                            title="Pause training once the in-flight episode finishes">
                        <Icon Name="pause-fill" Class="train-ctrl-icon" />
                        PAUSE
                    </button>
                    <button class="train-ctrl-btn train-ctrl-btn-warn" @onclick="StopTraining"
                            title="Stop training once the in-flight episode finishes">
                        STOP
                    </button>
                }
                @if (_startError is not null)
                {
                    <span class="train-brainrow-error">@_startError</span>
                }

                @if (Service.TotalEpisodes > 0)
                {
                    <div class="train-progress">
                        <div class="train-progress-bar">
                            <div class="train-progress-fill" style="width: @(ProgressPercent)%"></div>
                        </div>
                        <span class="train-progress-text">
                            @Service.EpisodesCompleted / @Service.TotalEpisodes episodes (@ProgressPercent%)
                        </span>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="train-content">
        <EpisodeCoverageTimeline From="_from" To="_to" BlockSpan="EpisodeBlockSpan" EpisodeWindows="Service.RecentEpisodeWindows" />
        <TrainLiveTab BrainName="_brainName" />

        @if (Service.Error is not null)
        {
            <p class="train-error">@Service.Error</p>
        }
    </div>
</div>
