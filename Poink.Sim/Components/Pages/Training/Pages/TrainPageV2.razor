@page "/train2"
@namespace Poink.Sim.Components.Pages
@using Poink.Sim.Brain.Neural
@using Poink.Sim.Components.Charts
@using Poink.Sim.Components.Pages.Trade.Helpers
@using Poink.Sim.Components.Shared.BarSizeSelect
@using Poink.Sim.Components.Shared.Icon
@using Poink.Sim.Components.Shared.PolicySelector
@using Poink.Sim.Components.Shared.SymbolDataSelector
@using Poink.Sim.Components.Training
@using Poink.Sim.Helpers
@using Poink.Sim.Models
@using Poink.Sim.Training

<div class="trv2-page">
    <header class="trv2-header">
        <span class="trv2-title">TRAINING 2.0</span>
    </header>

    <div class="trv2-tabs">
        @foreach (var tab in Tabs)
        {
            <button type="button" class="trv2-tab @(_activeTab == tab ? "trv2-tab-active" : "")"
                    @onclick="() => _activeTab = tab" title="@TabTitle(tab)">
                @tab.ToString().ToUpperInvariant()
            </button>
        }
    </div>

    <div class="trv2-content">
        @switch (_activeTab)
        {
            case TrainV2Tab.Data:
                <div class="trv2-card" title="Symbol and date range training data is pulled from">
                    <SymbolDataSelector @bind-Table="_table" @bind-From="_from" @bind-To="_to"
                                         SelectedSymbolChanged="OnSelectedSymbolChanged" />
                </div>

                <div class="trv2-card trv2-details-card" title="Metadata for the selected symbol/table">
                    <div class="trv2-card-title-row">
                        <span class="trv2-card-title">Details</span>
                    </div>
                    @if (SelectedTableMeta.MaxTime is null)
                    {
                        <p class="trv2-placeholder">Select a symbol above to see its metadata.</p>
                    }
                    else
                    {
                        <div class="trv2-field-row">
                            <div class="trv2-stat" title="Table this symbol's ticks are stored in">
                                <span class="trv2-stat-label">table</span>
                                <span class="trv2-stat-value">@SelectedTableMeta.Table</span>
                            </div>
                            <div class="trv2-stat" title="Total ticks stored for this symbol">
                                <span class="trv2-stat-label">rows</span>
                                <span class="trv2-stat-value">@SelectedTableMeta.Rows.ToString("N0")</span>
                            </div>
                            <div class="trv2-stat" title="Earliest tick available for this symbol">
                                <span class="trv2-stat-label">available from</span>
                                <span class="trv2-stat-value">@(SelectedTableMeta.MinTime?.ToString("yyyy-MM-dd HH:mm") ?? "-")</span>
                            </div>
                            <div class="trv2-stat" title="Latest tick available for this symbol">
                                <span class="trv2-stat-label">available to</span>
                                <span class="trv2-stat-value">@(SelectedTableMeta.MaxTime?.ToString("yyyy-MM-dd HH:mm") ?? "-")</span>
                            </div>
                            <div class="trv2-stat" title="Span of the From/To range picked above">
                                <span class="trv2-stat-label">selected span</span>
                                <span class="trv2-stat-value">@FormatSpan(_to - _from)</span>
                            </div>
                            @if (_selectedRangeTickCount is not null)
                            {
                                <div class="trv2-stat" title="Exact tick count within the selected From/To range">
                                    <span class="trv2-stat-label">ticks in range</span>
                                    <span class="trv2-stat-value">@_selectedRangeTickCount.Value.ToString("N0")</span>
                                </div>
                            }
                        </div>
                        <button type="button" class="trv2-btn" @onclick="CountSelectedRangeTicks"
                                title="Count exact ticks within the selected From/To range -- runs a database query">
                            COUNT TICKS IN RANGE
                        </button>

                        <div class="trv2-details-divider"></div>

                        @if (_loadingSymbolMetadata)
                        {
                            <p class="trv2-placeholder">loading symbol metadata...</p>
                        }
                        else if (_selectedSymbol is null)
                        {
                            <p class="trv2-placeholder">no symbol selected yet.</p>
                        }
                        else
                        {
                            <div class="trv2-field-row">
                                <div class="trv2-stat" title="Symbol selected above">
                                    <span class="trv2-stat-label">symbol</span>
                                    <span class="trv2-stat-value">@_selectedSymbol.SymbolName</span>
                                </div>
                                <div class="trv2-stat" title="Category this symbol belongs to">
                                    <span class="trv2-stat-label">description</span>
                                    <span class="trv2-stat-value">@_selectedSymbol.Description</span>
                                </div>
                                @if (SelectedSymbolMetadata is { } metadata)
                                {
                                    <div class="trv2-stat" title="Decimal places this symbol's price is quoted to">
                                        <span class="trv2-stat-label">digits</span>
                                        <span class="trv2-stat-value">@metadata.Digits</span>
                                    </div>
                                    <div class="trv2-stat" title="Price size of one pip, derived from this symbol's pip position">
                                        <span class="trv2-stat-label">pip size</span>
                                        <span class="trv2-stat-value">@PositionPnlHelper.PipSize(metadata).ToString("0.#####")</span>
                                    </div>
                                    <div class="trv2-stat" title="Minimum/maximum/step volume this symbol accepts per order">
                                        <span class="trv2-stat-label">volume min/max/step</span>
                                        <span class="trv2-stat-value">@metadata.MinVolume / @metadata.MaxVolume / @metadata.StepVolume</span>
                                    </div>
                                    <div class="trv2-stat" title="Units per lot">
                                        <span class="trv2-stat-label">lot size</span>
                                        <span class="trv2-stat-value">@metadata.LotSize</span>
                                    </div>
                                }
                                else
                                {
                                    <p class="trv2-placeholder">no trading metadata cached for this symbol yet -- needs a cTrader session to fetch it once</p>
                                }
                            </div>
                        }
                    }
                </div>
                break;
            case TrainV2Tab.Features:
                <div class="trv2-card-stack">
                    <div class="trv2-card trv2-card-span-all"
                         title="Totals across every feature source below -- the count sizes the network's input layer, the window limits how much history each episode needs before its first decision">
                        <div class="trv2-card-title-row">
                            <span class="trv2-card-title">Summary</span>
                        </div>
                        <div class="trv2-field-row">
                            <BarSizeSelect @bind-Value="_barWidthSeconds" Label="Bar width"
                                           Title="Time span of one bar -- sets XGrid's window (Col x bar width) and how much wall-clock time an episode's fetched ticks need to cover" />
                            <div class="trv2-stat"
                                 title="@($"XGrid Signals {SelectedXGridSignalCount} + TxFold {TxFoldFeatureCount} + Trader State {TraderStateFeatureCount}")">
                                <span class="trv2-stat-label">features</span>
                                <span class="trv2-stat-value">@TotalFeatureCount</span>
                            </div>
                            <div class="trv2-stat"
                                 title="@($"Longest history any source needs before it can produce a full input vector -- set by {LargestFeatureWindow.Source}. XGrid Signals {FormatWindow(XGridWindow)} (Col x bar width), TxFold {FormatWindow(TxFoldWindow)} (largest timeframe)")">
                                <span class="trv2-stat-label">min data window</span>
                                <span class="trv2-stat-value">@FormatWindow(MinimumDataWindow)</span>
                            </div>
                            <div class="trv2-stat"
                                 title="@($"Min data window ÷ bar width ({BarSizeOptions.Label(_barWidthSeconds)}), rounded up -- the least Visible bars the Training tab needs")">
                                <span class="trv2-stat-label">min visible bars</span>
                                <span class="trv2-stat-value">@MinimumVisibleBars</span>
                            </div>
                        </div>
                    </div>

                    <div class="trv2-card">
                        <div class="trv2-card-title-row">
                            <span class="trv2-card-title"
                                  title="XGrid's boolean footprint signals -- current cell's rank/at/above/below relationship to POC/VAH/VAL/VWAP, computed over a trailing window of Col bars">
                                XGrid Signals
                            </span>
                            <span class="trv2-card-badge" title="How many of the available XGrid signals are enabled">
                                @SelectedXGridSignalCount/@TotalXGridSignalCount
                            </span>
                        </div>
                        <label class="trv2-field" title="Toggle every XGrid signal below on or off at once">
                            <input type="checkbox" checked="@AllXGridSignalsSelected" @onchange="ToggleAllXGridSignals" />
                            Select All
                        </label>
                        <div class="trv2-field-row">
                            <label class="trv2-field"
                                   title="Percent threshold for the Rank signals -- current cell counts as 'top %' when its tick count ranks in this top percent of every nonzero cell on the grid">
                                %
                                <input class="trv2-input" type="number" min="0" max="100" step="1" @bind="_xGridTopPercent"
                                       disabled="@(!AnyXGridSignalSelected)" />
                            </label>
                            <label class="trv2-field"
                                   title="How many columns (time buckets) XGrid's footprint grid is divided into -- also sets the trailing window, one bar per column">
                                Col
                                <input class="trv2-input" type="number" min="1" step="1" @bind="_xGridColCount"
                                       disabled="@(!AnyXGridSignalSelected)" />
                            </label>
                            <label class="trv2-field"
                                   title="Row height in pips -- multiplied by the selected symbol's own pip size (Data tab) for each row's fixed price height">
                                Row
                                <input class="trv2-input" type="number" min="1" step="1" @bind="_xGridRowCount"
                                       disabled="@(!AnyXGridSignalSelected)" />
                            </label>
                            <label class="trv2-field" title="Price size of one pip, derived from the symbol selected on the Data tab -- select a symbol there to set this">
                                Pip
                                <span class="trv2-decoding-value">@XGridPipSize.ToString("0.#####")</span>
                            </label>
                        </div>
                        <XGridSignalInputTable @bind-EnabledKeys="_xGridEnabledSignals" Mode="XGridSignalInputMode.Independent" />
                    </div>

                    <div class="trv2-card trv2-card-nopad">
                        <TxFold Table="" RangeStart="DateTime.UtcNow" @bind-SelectedSeconds="_txFoldSelectedSeconds"
                                @bind-BarKind="_txFoldBarKind" />
                        <div class="trv2-txfold-features">
                            <div class="trv2-card-title-row">
                                <span class="trv2-card-title" title="One row per timeframe selected above -- the 4 values TxFold feeds the network for that timeframe">
                                    Features
                                </span>
                                <span class="trv2-card-badge" title="Total inputs contributed by TxFold -- 4 per selected timeframe">
                                    @(_txFoldSelectedSeconds.Count * 4)
                                </span>
                            </div>
                            @if (_txFoldSelectedSeconds.Count == 0)
                            {
                                <p class="trv2-placeholder">none selected</p>
                            }
                            else
                            {
                                <div class="trv2-txfold-grid">
                                    @foreach (var seconds in _txFoldSelectedSeconds.OrderBy(s => s))
                                    {
                                        <div class="trv2-txfold-grid-row">
                                            <span class="trv2-txfold-grid-label">@FeatureDisplayFormatter.TimeframeLabel(seconds)</span>
                                            @foreach (var field in FeatureDisplayFormatter.TxFoldFieldLabels(_txFoldBarKind))
                                            {
                                                <span class="trv2-txfold-grid-cell">@field</span>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="trv2-card">
                        <div class="trv2-card-title-row">
                            <span class="trv2-card-title" title="Own position/capital state -- whether this brain needs to know if it already holds a position">Trader State</span>
                            <span class="trv2-card-badge" title="How many of the available Trader State fields/lists are enabled">
                                @SelectedTraderStateFieldCount/@TotalTraderStateFieldCount
                            </span>
                        </div>
                        <div class="trv2-subgroup">
                            <div class="trv2-card-title-row">
                                <span class="trv2-subgroup-title" title="Features describing the open position and the price it is measured against">Position</span>
                                <label class="trv2-field" title="Toggle every position field below on or off at once">
                                    <input type="checkbox" checked="@AllFieldsSelected(PositionFieldRows)" @onchange="e => SetAllFields(PositionFieldRows, e)" />
                                    Select All Fields
                                </label>
                            </div>
                            <div class="trv2-field-row">
                                @foreach (var row in PositionFieldRows)
                                {
                                    <label class="trv2-field" title="@row.Tooltip">
                                        <input type="checkbox" checked="@row.Get()" @onchange="e => OnTraderStateFieldChanged(row, e)" />
                                        @row.Label
                                    </label>
                                }
                            </div>
                            <div class="trv2-field-row">
                                <label class="trv2-field"
                                       title="How many trailing price records since the open position's own entry time Trader State compares against entry price, most-recent-last, zero-padded">
                                    <input type="checkbox" @bind="_includeTraderStatePositionLevel" />
                                    Level
                                    <input class="trv2-input" type="number" min="1" step="1" @bind="_traderStatePositionLevelListLength"
                                           disabled="@(!_includeTraderStatePositionLevel)" />
                                </label>
                            </div>
                        </div>
                        <div class="trv2-subgroup">
                            <div class="trv2-card-title-row">
                                <span class="trv2-subgroup-title" title="Features describing the trader's capital, profit/loss, margin and closed-trade history">Account</span>
                                <label class="trv2-field" title="Toggle every account field below on or off at once">
                                    <input type="checkbox" checked="@AllFieldsSelected(AccountFieldRows)" @onchange="e => SetAllFields(AccountFieldRows, e)" />
                                    Select All Fields
                                </label>
                            </div>
                            <div class="trv2-field-row">
                                @foreach (var row in AccountFieldRows)
                                {
                                    <label class="trv2-field" title="@row.Tooltip">
                                        <input type="checkbox" checked="@row.Get()" @onchange="e => OnTraderStateFieldChanged(row, e)" />
                                        @row.Label
                                    </label>
                                }
                            </div>
                            <div class="trv2-field-row">
                                <label class="trv2-field"
                                       title="How many of the most recent closed trades' win(1)/loss(0) outcome Trader State feeds, most-recent-last, zero-padded if fewer trades have closed yet">
                                    <input type="checkbox" @bind="_includeTraderStateOutcomes" />
                                    Outcomes
                                    <input class="trv2-input" type="number" min="1" step="1" @bind="_traderStateOutcomeListLength"
                                           disabled="@(!_includeTraderStateOutcomes)" />
                                </label>
                                <label class="trv2-field"
                                       title="How many of the most recent closed trades' direction (1=Long, 0=Short) Trader State feeds, index-aligned with Outcomes">
                                    <input type="checkbox" @bind="_includeTraderStateDirection" />
                                    Direction
                                    <input class="trv2-input" type="number" min="1" step="1" @bind="_traderStateDirectionListLength"
                                           disabled="@(!_includeTraderStateDirection)" />
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
                break;
            case TrainV2Tab.Network:
                <div class="trv2-network-layout">
                    <div class="trv2-card">
                        <div class="trv2-card-title-row">
                            <span class="trv2-card-title" title="Network shape applied to the inputs selected on the Features tab">Network</span>
                        </div>
                        <label class="trv2-field" title="Network shape applied to the combined features selected on the Features tab">
                            Architecture
                            <select class="trv2-select" @bind="_architectureKind">
                                <option value="Mlp">MLP</option>
                                <option value="Lstm">LSTM</option>
                                <option value="Cnn">CNN</option>
                            </select>
                        </label>
                        @if (_architectureKind == ArchitectureKind.Mlp)
                        {
                            <div class="trv2-layer-list">
                                <button type="button" class="trv2-btn" @onclick="AddMlpLayerOnTop"
                                        title="Add another hidden layer, inserted above layer 1 -- defaults to double layer 1's size">
                                    + ADD LAYER
                                </button>
                                @for (var i = 0; i < _mlpHiddenSizes.Count; i++)
                                {
                                    var index = i;
                                    <label class="trv2-field" title="@($"Size of hidden layer {index + 1}")">
                                        Layer @(index + 1)
                                        <input class="trv2-input" type="number" min="1" step="1" value="@_mlpHiddenSizes[index]"
                                               @oninput="e => OnMlpLayerSizeChanged(index, e)" />
                                        <button type="button" class="trv2-btn-remove"
                                                @onclick="() => RemoveMlpLayer(index)"
                                                disabled="@(_mlpHiddenSizes.Count <= 1)"
                                                title="@(_mlpHiddenSizes.Count > 1 ? "Remove this layer" : "At least one hidden layer is required")">
                                            &#215;
                                        </button>
                                    </label>
                                }
                                <button type="button" class="trv2-btn" @onclick="AddMlpLayer"
                                        title="Add another hidden layer, stacked after the ones above -- defaults to half the last layer's size">
                                    + ADD LAYER
                                </button>
                            </div>
                        }
                        else if (_architectureKind == ArchitectureKind.Lstm)
                        {
                            <label class="trv2-field" title="LSTM hidden state size">
                                Hidden size
                                <input class="trv2-input" type="number" min="1" @bind="_lstmHiddenSize" />
                            </label>
                            <label class="trv2-field" title="Number of stacked LSTM layers">
                                LSTM layers
                                <input class="trv2-input" type="number" min="1" @bind="_lstmNumLayers" />
                            </label>
                        }
                        else if (_architectureKind == ArchitectureKind.Cnn)
                        {
                            <label class="trv2-field"
                                   title="Which selected input set the convolution kernel actually sweeps over -- Bar Window (default) slides over the trailing price window; Volume Profile instead slides over its price-ordered histogram buckets">
                                Kernel sweeps
                                <select class="trv2-select" @bind="_cnnKernelSweepSource">
                                    <option value="BarWindow">Bar Window</option>
                                    <option value="VolumeProfile">Volume Profile</option>
                                </select>
                            </label>
                            <label class="trv2-field"
                                   title="Convolution kernel width applied to every conv layer -- odd sizes (3, 5, 7, ...) keep the window's time length unchanged through each layer">
                                Kernel size
                                <input class="trv2-input" type="number" min="1" step="2" @bind="_cnnKernelSize" />
                            </label>
                            <div class="trv2-layer-list">
                                @for (var i = 0; i < _cnnChannels.Count; i++)
                                {
                                    var index = i;
                                    <label class="trv2-field" title="@($"Output channel count of conv layer {index + 1}")">
                                        Layer @(index + 1)
                                        <input class="trv2-input" type="number" min="1" step="1" value="@_cnnChannels[index]"
                                               @oninput="e => OnCnnChannelSizeChanged(index, e)" />
                                        <button type="button" class="trv2-btn-remove"
                                                @onclick="() => RemoveCnnChannelLayer(index)"
                                                disabled="@(_cnnChannels.Count <= 1)"
                                                title="@(_cnnChannels.Count > 1 ? "Remove this layer" : "At least one conv layer is required")">
                                            &#215;
                                        </button>
                                    </label>
                                }
                                <button type="button" class="trv2-btn" @onclick="AddCnnChannelLayer"
                                        title="Add another conv layer, stacked after the ones above -- defaults to double the last layer's channel count">
                                    + ADD LAYER
                                </button>
                            </div>
                        }
                    </div>

                    <div class="trv2-card">
                        <div class="trv2-card-title-row">
                            <span class="trv2-card-title" title="Node-per-layer view of the hidden layers configured on the left -- each square is one unit, capped visually past 7 per layer">Hidden Layers</span>
                        </div>
                        @if (NetworkColumns.Count == 0)
                        {
                            <p class="trv2-placeholder">No hidden layers configured.</p>
                        }
                        else
                        {
                            <div class="trv2-network-columns">
                                @foreach (var column in NetworkColumns)
                                {
                                    <div class="trv2-network-column" title="@($"{column.Label}: {column.Size} units")">
                                        <span class="trv2-network-label">@column.Label</span>
                                        <div class="trv2-network-stack">
                                            @for (var i = 0; i < column.VisibleUnits; i++)
                                            {
                                                <span class="trv2-network-unit"></span>
                                            }
                                            @if (column.HiddenUnits > 0)
                                            {
                                                <span class="trv2-network-more">+@column.HiddenUnits</span>
                                            }
                                        </div>
                                        <span class="trv2-network-size">@column.Size</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
                break;
            case TrainV2Tab.Output:
                <div class="trv2-card-stack">
                    <div class="trv2-card">
                        <div class="trv2-card-title-row">
                            <span class="trv2-card-title" title="Which decisions this brain's network is allowed to make -- every one below is optional">Actions</span>
                            <span class="trv2-card-badge" title="How many of the @TotalActionOptionCount available action decisions are enabled">
                                @SelectedActionCount/@TotalActionOptionCount
                            </span>
                        </div>
                        <label class="trv2-field" title="Toggle every action decision below on or off at once">
                            <input type="checkbox" checked="@AllActionsSelected" @onchange="ToggleAllActions" />
                            Select All
                        </label>
                        <label class="trv2-field" title="Network can choose to do nothing this tick">
                            <input type="checkbox" @bind="_includeHold" /> Hold
                        </label>
                        <label class="trv2-field" title="Network can open a long position">
                            <input type="checkbox" @bind="_includeEnterLong" /> Enter Long
                        </label>
                        <label class="trv2-field" title="Network can open a short position">
                            <input type="checkbox" @bind="_includeEnterShort" /> Enter Short
                        </label>
                        <label class="trv2-field" title="Network can close an open position (or cancel a resting order)">
                            <input type="checkbox" @bind="_includeClose" /> Close
                        </label>
                        <label class="trv2-field" title="Network picks position size (25/50/75/100% of cash) for each entry, instead of a fixed 50%">
                            <input type="checkbox" @bind="_includeVolumeOutput" /> Volume
                        </label>
                        <label class="trv2-field" title="Network picks a stop-loss distance (or none) for each entry">
                            <input type="checkbox" @bind="_includeStopLossOutput" /> Stop Loss
                        </label>
                        <label class="trv2-field" title="Network picks a take-profit distance (or none) for each entry">
                            <input type="checkbox" @bind="_includeTakeProfitOutput" /> Take Profit
                        </label>
                    </div>

                    <div class="trv2-card">
                        <div class="trv2-card-title-row">
                            <span class="trv2-card-title"
                                  title="Hard legality rules enforced on the network's raw logits before Softmax -- an illegal action gets exactly 0% probability, guaranteed, rather than being left for the network to learn to avoid">
                                Action Masking
                            </span>
                            <span class="trv2-card-badge" title="How many of the @TotalMaskRuleCount available masking rules are enabled">
                                @SelectedMaskRuleCount/@TotalMaskRuleCount
                            </span>
                        </div>
                        <label class="trv2-field" title="Toggle every masking rule below on or off at once">
                            <input type="checkbox" checked="@AllMaskRulesSelected" @onchange="ToggleAllMaskRules" />
                            Select All
                        </label>
                        @foreach (var row in MaskRuleRows)
                        {
                            <label class="trv2-field" title="@row.Tooltip">
                                <input type="checkbox" checked="@row.Get()" @onchange="e => OnMaskRuleFieldChanged(row, e)" />
                                @row.Label
                            </label>
                        }
                    </div>

                    <div class="trv2-card">
                        <div class="trv2-card-title-row">
                            <span class="trv2-card-title"
                                  title="How the network's raw output logits become each enabled decision above -- every group below is decoded independently via its own softmax distribution, not one joint choice across all of them">
                                Action Decoding
                            </span>
                            <span class="trv2-card-badge" title="Total network output width: every enabled group's softmax width, summed">
                                @TotalOutputWidth
                            </span>
                        </div>
                        <label class="trv2-field"
                               title="Softmax always samples stochastically, weighted by probability -- what training needs for exploration. HardMax instead always picks the highest-probability choice, deterministically. Applies to every group below.">
                            Decoding Mode
                            <select class="trv2-select" @bind="_decisionDecoding">
                                <option value="Softmax">Softmax (stochastic)</option>
                                <option value="HardMax">HardMax (argmax)</option>
                            </select>
                        </label>
                        <label class="trv2-field"
                               title="Divides each group's raw logits before Softmax -- below 1 sharpens the distribution toward its highest choice; above 1 flattens it toward uniform. No effect under HardMax.">
                            Temperature
                            <input class="trv2-input" type="number" min="0.01" step="0.1" @bind="_decisionTemperature"
                                   disabled="@(_decisionDecoding == DecisionDecodingKind.HardMax)" />
                        </label>
                        <div class="trv2-field-row">
                            <label class="trv2-field" title="@($"Softmax over the {DirectionCount} enabled direction(s): {string.Join(" / ", EnabledDirectionLabels)}")">
                                Direction
                                <span class="trv2-decoding-value">@DirectionCount-way @DecodingLabel</span>
                            </label>
                            @if (_includeVolumeOutput)
                            {
                                <label class="trv2-field" title="Softmax over 4 capital-fraction levels: 25% / 50% / 75% / 100%">
                                    Volume
                                    <span class="trv2-decoding-value">@VolumeOutputWidth-way @DecodingLabel</span>
                                </label>
                            }
                            @if (_includeStopLossOutput)
                            {
                                <label class="trv2-field" title="Softmax over 4 stop-loss distances: None / Tight / Medium / Wide">
                                    Stop Loss
                                    <span class="trv2-decoding-value">@StopLossOutputWidth-way @DecodingLabel</span>
                                </label>
                            }
                            @if (_includeTakeProfitOutput)
                            {
                                <label class="trv2-field" title="Softmax over 4 take-profit distances: None / Tight / Medium / Wide">
                                    Take Profit
                                    <span class="trv2-decoding-value">@TakeProfitOutputWidth-way @DecodingLabel</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>
                break;
            case TrainV2Tab.Training:
                <div class="trv2-card-stack">
                    <div class="trv2-card">
                        <div class="trv2-card-title-row">
                            <span class="trv2-card-title" title="How many episodes to run, and what span of data each one covers">Episode Timing</span>
                        </div>
                        <label class="trv2-field">
                            Episodes
                            <input class="trv2-input" type="number" min="1" @bind="_episodeCount" />
                        </label>
                        @if (_restrictEpisodeTiming)
                        {
                            <label class="trv2-field"
                                   title="Derived from the session length ÷ bar width while timing is restricted -- an episode's decisions span exactly the configured day/session, so this isn't picked independently">
                                Training bars
                                <span class="trv2-decoding-value">@EffectiveTrainingBars</span>
                            </label>
                        }
                        else
                        {
                            <label class="trv2-field"
                                   title="How many bars the episode steps through making decisions -- the episode stops once the last training bar completes">
                                Training bars
                                <input class="trv2-input" type="number" min="1" @bind="_trainingBars" />
                            </label>
                        }
                        <label class="trv2-field"
                               title="@($"Bars of history visible before the first training bar ({FormatWindow(VisibleWindow)} at the current bar width) -- must cover the Features tab's min data window, {MinimumVisibleBars} bars")">
                            Visible bars
                            <input class="trv2-input" type="number" min="@MinimumVisibleBars" @bind="_visibleBars" />
                        </label>
                        @if (!VisibleBarsCoverFeatures)
                        {
                            <span class="trv2-warning"
                                  title="The selected features need more history than these bars provide -- raise Visible bars or trim features on the Features tab">
                                fewer than the features' min data window (@MinimumVisibleBars bars)
                            </span>
                        }
                        <label class="trv2-field"
                               title="Total bars one episode needs -- visible bars + training bars">
                            Episode bars
                            <span class="trv2-decoding-value">@EpisodeBars</span>
                        </label>
                        <label class="trv2-field"
                               title="Time the episode's bars cover -- episode bars x bar width (Features tab). Not defined while stepping by cell">
                            Episode span
                            <span class="trv2-decoding-value">@FormatOptionalWindow(EpisodeSpan)</span>
                        </label>
                        <label class="trv2-field"
                               title="Bar steps a decision on each bar's close. Cell steps on a fixed-width price band instead, the moment price moves into a different band">
                            Step
                            <select class="trv2-select" @bind="_steppingMode">
                                <option value="@SimulationSteppingMode.Bar">bar</option>
                                <option value="@SimulationSteppingMode.Cell">cell</option>
                            </select>
                        </label>
                        @if (_steppingMode == SimulationSteppingMode.Cell)
                        {
                            <label class="trv2-field" title="Fixed price width of each cell -- a decision fires when price crosses from one cell into the next">
                                Cell width
                                <input class="trv2-input" type="number" min="0.00001" step="0.01" @bind="_cellWidth" />
                            </label>
                        }
                        <label class="trv2-field"
                               title="Turn on to restrict episodes to specific weekdays and/or a daily time-of-day session -- off means an episode may start anywhere in the Data tab's range, including across midnight">
                            <input type="checkbox" checked="@_restrictEpisodeTiming" @onchange="ToggleRestrictEpisodeTiming" />
                            Restrict timing
                        </label>
                        @if (_restrictEpisodeTiming)
                        {
                            <label class="trv2-field" title="Which days of the week an episode may start on">
                                Weekdays
                                <div class="trv2-weekday-row">
                                    @foreach (var day in WeekdayDisplayOrder)
                                    {
                                        <button type="button" class="trv2-panel-toggle-btn @(_allowedWeekdays.Contains(day) ? "active" : "")"
                                                @onclick="@(() => ToggleWeekday(day))" title="@day.ToString()">
                                            @WeekdayAbbreviation(day)
                                        </button>
                                    }
                                </div>
                            </label>
                            <label class="trv2-field" title="Time-of-day window an episode's decisions span, on each eligible day -- 24:00 means end of day">
                                Session
                                <input class="trv2-input" type="text" placeholder="00:00" @bind="SessionStartText" />
                                to
                                <input class="trv2-input" type="text" placeholder="24:00" @bind="SessionEndText" />
                            </label>
                        }
                    </div>

                    <div class="trv2-card">
                        <div class="trv2-card-title-row">
                            <span class="trv2-card-title" title="Starting capital, leverage, commission, stop-out and risk policies the simulated trader begins each episode with">Trader Setup</span>
                        </div>
                        <label class="trv2-field">
                            Starting cash
                            <input class="trv2-input" type="number" min="1" step="100" @bind="_startingCash" />
                        </label>
                        <label class="trv2-field" title="Notional exposure per unit of margin committed -- 1 means no leverage">
                            Leverage
                            <input class="trv2-input" type="number" min="1" step="1" @bind="_leverage" />
                        </label>
                        <label class="trv2-field" title="Commission charged per fill, as a percent of that fill's notional value">
                            Commission %
                            <input class="trv2-input" type="number" min="0" step="0.01" @bind="_commissionRatePercent" />
                        </label>
                        <label class="trv2-field" title="Force-close the open position when Margin Level (Equity ÷ Margin Used) drops below this percent">
                            Stop-out %
                            <input class="trv2-input" type="number" min="1" max="100" step="1" @bind="_stopOutLevelPercent" />
                        </label>
                        @if (RiskPolicyService.AvailablePolicies.Count > 0)
                        {
                            <label class="trv2-field" title="Risk policies gate every trade action -- permit, deny or resize it -- and supervise open positions during each episode">
                                Risk policies
                                <PolicySelector Available="RiskPolicyService.AvailablePolicies" Selected="_selectedRiskPolicies" />
                            </label>
                        }
                    </div>

                    <div class="trv2-card">
                        <div class="trv2-card-title-row">
                            <span class="trv2-card-title" title="Which RL algorithm trains the network, how its reward is shaped, and its learning rate">Learning</span>
                        </div>
                        <label class="trv2-field" title="Which reinforcement-learning algorithm updates the network's weights each episode -- NEAT is parked/excluded here">
                            Strategy
                            <div class="trv2-toggle-row">
                                @foreach (var name in TrainingStrategyOptions)
                                {
                                    <button type="button" class="trv2-panel-toggle-btn @(_trainingStrategyName == name ? "active" : "")"
                                            @onclick="() => _trainingStrategyName = name" title="@name">@name</button>
                                }
                            </div>
                        </label>
                        <label class="trv2-field"
                               title="Which rules shape the per-decision reward -- Equity Drift is the raw, unshaped baseline; Hit Rate rewards net direction correctness instead">
                            Reward Policy
                            <div class="trv2-toggle-row">
                                @foreach (var name in RewardPolicyOptions)
                                {
                                    <button type="button" class="trv2-panel-toggle-btn @(_rewardPolicyName == name ? "active" : "")"
                                            @onclick="() => _rewardPolicyName = name" title="@name">@name</button>
                                }
                            </div>
                        </label>
                        <label class="trv2-field" title="Step size the optimizer applies to each weight update">
                            Learning rate
                            <input class="trv2-input" type="number" min="0.00001" step="0.0001" @bind="_learningRate" />
                        </label>
                    </div>

                    <div class="trv2-card">
                        <div class="trv2-card-title-row">
                            <span class="trv2-card-title"
                                  title="Gates whether this brain's network is even asked to decide -- opposite of Action Masking, which restricts choices after the network has already decided. With any rule below enabled, an episode's bar/tick count no longer equals its decision count">
                                Decision Masking
                            </span>
                            <span class="trv2-card-badge" title="How many of the @TotalDecisionMaskRuleCount available decision-gating rules are enabled">
                                @SelectedDecisionMaskRuleCount/@TotalDecisionMaskRuleCount
                            </span>
                        </div>
                        <label class="trv2-field" title="How often the rules below get checked -- a decision only ever fires on a resolution tick, and only when every enabled rule also passes">
                            Resolution
                            <div class="trv2-toggle-row">
                                @foreach (var option in DecisionMaskResolutionOptions)
                                {
                                    <button type="button" class="trv2-panel-toggle-btn @(_decisionMaskResolution == option.Kind ? "active" : "")"
                                            @onclick="() => _decisionMaskResolution = option.Kind" title="@option.Tooltip">@option.Label</button>
                                }
                            </div>
                        </label>
                        @if (_decisionMaskResolution == DecisionMaskResolutionKind.EverySeconds)
                        {
                            <label class="trv2-field" title="How many seconds must pass between resolution checks">
                                Seconds
                                <input class="trv2-input" type="number" min="0.001" step="1" @bind="_decisionMaskResolutionSeconds" />
                            </label>
                        }
                        @if (_decisionMaskResolution == DecisionMaskResolutionKind.OnCellWidthChange)
                        {
                            <label class="trv2-field" title="Fixed price width of each cell -- a resolution check fires when price crosses from one cell into the next">
                                Cell width
                                <input class="trv2-input" type="number" min="0.00001" step="0.01" @bind="_decisionMaskResolutionCellWidth" />
                            </label>
                        }
                        <label class="trv2-field"
                               title="A decision only fires when price is below the trailing window's Point of Control -- has no effect without the XGrid Signals encoder">
                            <input type="checkbox" @bind="_maskDecisionPriceBelowPoc" />
                            Price Below POC
                        </label>
                    </div>
                </div>
                break;
            case TrainV2Tab.Run:
                <div class="trv2-results">
                    <div class="trv2-summary-section">
                        <div class="trv2-card-title-row">
                            <span class="trv2-card-title" title="Snapshot of the options selected on each tab -- check these before starting a run">
                                Options Summary
                            </span>
                            <button type="button" class="trv2-btn" @onclick="() => _optionsSummaryCollapsed = !_optionsSummaryCollapsed"
                                    title="Collapse/expand the options summary">
                                @(_optionsSummaryCollapsed ? "+ SHOW" : "- HIDE")
                            </button>
                        </div>
                        @if (!_optionsSummaryCollapsed)
                        {
                            <div class="trv2-card-stack">
                                <div class="trv2-card" title="Symbol and date range training data is pulled from -- set on the Data tab">
                                    <div class="trv2-card-title-row">
                                        <span class="trv2-card-title">Data</span>
                                    </div>
                                    @if (_selectedSymbol is null)
                                    {
                                        <p class="trv2-placeholder">no symbol selected yet</p>
                                    }
                                    else
                                    {
                                        <div class="trv2-stat" title="Symbol selected on the Data tab">
                                            <span class="trv2-stat-label">symbol</span>
                                            <span class="trv2-stat-value">@_selectedSymbol.SymbolName</span>
                                        </div>
                                    }
                                    <div class="trv2-stat" title="Date range training data is pulled from">
                                        <span class="trv2-stat-label">range</span>
                                        <span class="trv2-stat-value">@_from.ToString("yyyy-MM-dd") to @_to.ToString("yyyy-MM-dd") (@FormatSpan(_to - _from))</span>
                                    </div>
                                </div>

                                <div class="trv2-card" title="Which encoders transform pulled data into the input vector -- set on the Features tab">
                                    <div class="trv2-card-title-row">
                                        <span class="trv2-card-title">Features</span>
                                        <span class="trv2-card-badge" title="Total input count fed to the network">@TotalFeatureCount inputs</span>
                                    </div>
                                    <div class="trv2-stat" title="XGrid signals enabled, of those available">
                                        <span class="trv2-stat-label">xgrid signals</span>
                                        <span class="trv2-stat-value">@SelectedXGridSignalCount/@TotalXGridSignalCount</span>
                                    </div>
                                    <div class="trv2-stat" title="TxFold timeframes selected, 4 values each">
                                        <span class="trv2-stat-label">txfold</span>
                                        <span class="trv2-stat-value">@_txFoldSelectedSeconds.Count timeframes (@TxFoldFeatureCount)</span>
                                    </div>
                                    <div class="trv2-stat" title="Trader State fields/lists enabled, of those available">
                                        <span class="trv2-stat-label">trader state</span>
                                        <span class="trv2-stat-value">@SelectedTraderStateFieldCount/@TotalTraderStateFieldCount</span>
                                    </div>
                                    <div class="trv2-stat" title="Longest history any feature source needs before it can produce a full input vector">
                                        <span class="trv2-stat-label">min data window</span>
                                        <span class="trv2-stat-value">@FormatWindow(MinimumDataWindow)</span>
                                    </div>
                                </div>

                                <div class="trv2-card" title="Architecture that consumes the feature vector -- set on the Network tab">
                                    <div class="trv2-card-title-row">
                                        <span class="trv2-card-title">Network</span>
                                    </div>
                                    <div class="trv2-stat" title="Network architecture kind">
                                        <span class="trv2-stat-label">architecture</span>
                                        <span class="trv2-stat-value">@_architectureKind</span>
                                    </div>
                                    <div class="trv2-stat" title="Hidden layer shape">
                                        <span class="trv2-stat-label">layers</span>
                                        <span class="trv2-stat-value">@NetworkSummaryText</span>
                                    </div>
                                </div>

                                <div class="trv2-card" title="How the network's raw outputs map to trade actions -- set on the Output tab">
                                    <div class="trv2-card-title-row">
                                        <span class="trv2-card-title">Output</span>
                                        <span class="trv2-card-badge" title="Total network output width -- every enabled group's softmax width, summed">@TotalOutputWidth-wide</span>
                                    </div>
                                    <div class="trv2-stat" title="Action decisions enabled, of those available">
                                        <span class="trv2-stat-label">actions</span>
                                        <span class="trv2-stat-value">@SelectedActionCount/@TotalActionOptionCount</span>
                                    </div>
                                    <div class="trv2-stat" title="Action masking rules enabled, of those available">
                                        <span class="trv2-stat-label">masking rules</span>
                                        <span class="trv2-stat-value">@SelectedMaskRuleCount/@TotalMaskRuleCount</span>
                                    </div>
                                    <div class="trv2-stat" title="Decoding mode applied to every output group">
                                        <span class="trv2-stat-label">decoding</span>
                                        <span class="trv2-stat-value">@DecodingLabel</span>
                                    </div>
                                </div>

                                <div class="trv2-card" title="How episodes are timed/sampled, and the trader each one starts with -- set on the Training tab">
                                    <div class="trv2-card-title-row">
                                        <span class="trv2-card-title">Training</span>
                                    </div>
                                    <div class="trv2-stat" title="Number of episodes this run will train for">
                                        <span class="trv2-stat-label">episodes</span>
                                        <span class="trv2-stat-value">@_episodeCount</span>
                                    </div>
                                    <div class="trv2-stat" title="Total bars one episode needs, and the wall-clock time they cover">
                                        <span class="trv2-stat-label">episode span</span>
                                        <span class="trv2-stat-value">@EpisodeBars bars (@FormatOptionalWindow(EpisodeSpan))</span>
                                    </div>
                                    <div class="trv2-stat" title="Starting cash and leverage the simulated trader begins each episode with">
                                        <span class="trv2-stat-label">trader</span>
                                        <span class="trv2-stat-value">@_startingCash.ToString("N0") cash, @_leverage.ToString("0.#")x</span>
                                    </div>
                                    <div class="trv2-stat" title="RL strategy and reward policy driving learning">
                                        <span class="trv2-stat-label">learning</span>
                                        <span class="trv2-stat-value">@_trainingStrategyName / @_rewardPolicyName</span>
                                    </div>
                                    <div class="trv2-stat" title="Decision-gating rules enabled, of those available -- opposite of Action Masking">
                                        <span class="trv2-stat-label">decision masking</span>
                                        <span class="trv2-stat-value">@SelectedDecisionMaskRuleCount/@TotalDecisionMaskRuleCount</span>
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="trv2-card trv2-run-controls">
                        @if (!_isRunning)
                        {
                            <button type="button" class="trv2-btn trv2-btn-play" @onclick="StartRun"
                                    title="Trains on the symbol/range picked on the Data tab -- each episode streams its own random window">
                                <Icon Name="play-fill" Class="trv2-run-icon" />
                                START
                            </button>
                            <button type="button" class="trv2-btn" @onclick="StepRun"
                                    title="Runs exactly one episode, then pauses -- lets you step through training one episode at a time from the start">
                                <Icon Name="skip-end-fill" Class="trv2-run-icon" />
                                STEP
                            </button>
                            <button type="button" class="trv2-btn" @onclick="ResetRun"
                                    title="Clears this run's episodes/metrics/charts -- the Data/Features/Network/Output/Training setup stays as configured">
                                <Icon Name="arrow-clockwise" Class="trv2-run-icon" />
                                RESET
                            </button>
                        }
                        else if (_isPaused)
                        {
                            <button type="button" class="trv2-btn trv2-btn-play" @onclick="ResumeRun" title="Resume training from where it paused">
                                <Icon Name="play-fill" Class="trv2-run-icon" />
                                RESUME
                            </button>
                            <button type="button" class="trv2-btn" @onclick="StepRun"
                                    title="Runs exactly one more episode, then pauses again -- lets you step through training one episode at a time">
                                <Icon Name="skip-end-fill" Class="trv2-run-icon" />
                                STEP
                            </button>
                            <button type="button" class="trv2-btn trv2-btn-warn" @onclick="StopRun" title="Stop training once the in-flight episode finishes">
                                STOP
                            </button>
                        }
                        else
                        {
                            <button type="button" class="trv2-btn trv2-btn-play" @onclick="PauseRun" title="Pause training once the in-flight episode finishes">
                                <Icon Name="pause-fill" Class="trv2-run-icon" />
                                PAUSE
                            </button>
                            <button type="button" class="trv2-btn trv2-btn-warn" @onclick="StopRun" title="Stop training once the in-flight episode finishes">
                                STOP
                            </button>
                        }
                        <div class="trv2-progress">
                            <div class="trv2-progress-bar">
                                <div class="trv2-progress-fill" style="width: @(RunProgressPercent.ToString("0.#"))%"></div>
                            </div>
                            <span class="trv2-progress-text">@_episodesCompleted / @TargetEpisodeCount episodes (@RunProgressPercent.ToString("0")%)</span>
                            <span class="trv2-progress-rate" title="Rolling episodes/sec over the most recent episodes -- pause/step time isn't counted">@_episodesPerSecond.ToString("0.00") eps</span>
                        </div>
                        @if (_runError is not null)
                        {
                            <p class="trv2-warning" title="@_runError">Run stopped: @_runError</p>
                        }
                    </div>

                    <div class="trv2-card trv2-metrics-panel">
                        <div class="trv2-stat">
                            <span class="trv2-stat-label" title="Mean reward across the retained rolling window of episodes">recent avg reward</span>
                            <span class="trv2-stat-value">@_recentAverageReward.ToString("N2")</span>
                        </div>
                        <div class="trv2-stat">
                            <span class="trv2-stat-label" title="Highest single-episode reward seen this run">best episode</span>
                            <span class="trv2-stat-value">@_bestReward.ToString("N2")</span>
                        </div>
                        <div class="trv2-stat">
                            <span class="trv2-stat-label" title="Lowest single-episode reward seen this run">worst episode</span>
                            <span class="trv2-stat-value">@_worstReward.ToString("N2")</span>
                        </div>
                        <div class="trv2-stat">
                            <span class="trv2-stat-label" title="Percent of retained episodes with positive reward">win rate</span>
                            <span class="trv2-stat-value">@WinRatePercent.ToString("N0")%</span>
                        </div>
                        <div class="trv2-stat">
                            <span class="trv2-stat-label" title="Median reward across the retained rolling window of episodes">median reward</span>
                            <span class="trv2-stat-value">@MedianReward.ToString("N2")</span>
                        </div>
                        <div class="trv2-stat">
                            <span class="trv2-stat-label" title="Standard deviation of reward across the retained rolling window of episodes">reward std dev</span>
                            <span class="trv2-stat-value">@RewardStdDev.ToString("N2")</span>
                        </div>
                        <div class="trv2-stat">
                            <span class="trv2-stat-label" title="Best episode minus worst episode">reward spread</span>
                            <span class="trv2-stat-value">@RewardSpread.ToString("N2")</span>
                        </div>
                    </div>

                    <div class="trv2-charts-grid">
                        <div class="trv2-card">
                            <span class="trv2-card-title">Reward</span>
                            <RewardChart Episodes="_episodeMetrics" IsRunning="@_isRunning" />
                        </div>
                        <div class="trv2-card">
                            <span class="trv2-card-title" title="Rolling-window median -- less noisy than raw reward">Median Reward</span>
                            <TrendLineChart Episodes="_episodeMetrics" IsRunning="@_isRunning"
                                            Aggregate="@RlEpisodeMetricStats.Median" ColorVariant="median" />
                        </div>
                        <div class="trv2-card">
                            <span class="trv2-card-title" title="Rolling-window spread -- falling means training is stabilizing">Reward Std Dev</span>
                            <TrendLineChart Episodes="_episodeMetrics" IsRunning="@_isRunning"
                                            Aggregate="@RlEpisodeMetricStats.StdDev" ColorVariant="stddev" />
                        </div>
                        <div class="trv2-card">
                            <span class="trv2-card-title" title="Rolling-window % of episodes with positive reward">Win Rate</span>
                            <TrendLineChart Episodes="_episodeMetrics" IsRunning="@_isRunning"
                                            Aggregate="@RlEpisodeMetricStats.WinRate" ColorVariant="winrate" ValueFormat="N0" ValueSuffix="%" />
                        </div>
                    </div>
                </div>
                break;
            case TrainV2Tab.Live:
                <LiveEpisodeView IsRunning="@_isRunning" IsPaused="@_isPaused" RunError="@_runError"
                                 OnPlayPause="ToggleLiveRun" OnStep="StepRun" OnReset="ResetRun"
                                 SpeedLabel="@LiveSpeedLabel(LiveSpeedOptions[_liveSpeedIndex])"
                                 CanDecreaseSpeed="@(_liveSpeedIndex > 0)" CanIncreaseSpeed="@(_liveSpeedIndex < LiveSpeedOptions.Length - 1)"
                                 OnDecreaseSpeed="DecreaseLiveSpeed" OnIncreaseSpeed="IncreaseLiveSpeed"
                                 EpisodesCompleted="_episodesCompleted" TargetEpisodeCount="TargetEpisodeCount"
                                 HasSnapshot="@(_liveSnapshot is not null)"
                                 Timestamp="@_liveSnapshot?.Timestamp" TimePassed="LiveTimePassed" ActionCount="_liveActionCount"
                                 Bid="@(_liveSnapshot?.Bid ?? 0)" Ask="@(_liveSnapshot?.Ask ?? 0)"
                                 LastAction="@_liveSnapshot?.Action" ActionOutputs="LiveOutputFeatures" Cash="@(_liveSnapshot?.Capital.Cash ?? 0)"
                                 Equity="@(_liveSnapshot?.Capital.Equity ?? 0)" RealizedPnl="@(_liveSnapshot?.Capital.RealizedPnl ?? 0)"
                                 UnrealizedPnl="@(_liveSnapshot?.Capital.UnrealizedPnl ?? 0)" Table="@_table"
                                 Bars="LiveChartBars" EquitySamples="LiveEquitySamples" FeatureRows="LiveFeatureRows" />
                break;
        }
    </div>
</div>
