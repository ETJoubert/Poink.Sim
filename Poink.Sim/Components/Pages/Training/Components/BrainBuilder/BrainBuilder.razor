@namespace Poink.Sim.Components.Training
@using Poink.Sim.Brain.Neural

<div class="train-card">
    <div class="train-card-title-row"
         title="Which brain (neural network) this run trains and plays back, the strategy that trains it, and the reward policy it optimizes against -- heuristic brains have no trainable weights, so they never appear here">
        <div class="train-card-title">Brain Type</div>
        <span>
            <span class="train-card-badge"
                  title="The config currently held in memory -- what Start Training actually trains, whether or not it's been saved">
                @EffectiveBuildBrainName</span>
            @if (IsDraft)
            {
                <span class="train-card-badge train-card-badge-warn"
                      title="Not saved -- Start Training uses this config live; Save Brain is what commits it to storage">
                    DRAFT</span>
            }
        </span>
    </div>
        <div class="train-card-fields-row">
            <BrainSelect BrainOptions="TrainableBrainOptions" BrainName="@BrainName" BrainNameChanged="OnBrainNameChanged"
                         Disabled="Service.IsRunning" />
            <button class="train-btn-toggle" @onclick="ToggleBuildPanel" disabled="@Service.IsRunning"
                    title="Show/hide this brain's editable config -- any change here is used immediately by Start Training; Save Brain is what commits it to storage">
                @(_showBuildPanel ? "- BUILD BRAIN" : "+ BUILD BRAIN")
            </button>
            <button type="button" class="train-btn-toggle" @onclick="SetConfig"
                    disabled="@(Service.IsRunning || !CanCreateBrain || !IsDraft)"
                    title="Applies the current config live now, without saving -- lets Training Preview below show it before you start a run">
                SET
            </button>
            <button type="button" class="train-btn-toggle" @onclick="SaveBrain"
                    disabled="@(Service.IsRunning || !CanCreateBrain || !IsDraft)"
                    title="Commits the current config to storage under its name -- updates it in place if that name's already saved">
                SAVE BRAIN
            </button>
            @if (_showDeleteConfirm)
            {
                <span class="train-brainrow-field">

                    <button type="button" class="train-btn-toggle train-btn-toggle-warn" @onclick="ConfirmDeleteBrain"
                            title="Permanently deletes this brain's saved network config -- cannot be undone">
                        YES, DELETE
                    </button>
                    <button type="button" class="train-btn-toggle" @onclick="CancelDeleteBrain"
                            title="Cancel -- keep this brain">
                        CANCEL
                    </button>
                    Delete '@BrainName'?
                </span>
            }
            else
            {
                <button type="button" class="train-btn-toggle train-btn-toggle-warn" @onclick="() => _showDeleteConfirm = true"
                        disabled="@(Service.IsRunning || string.IsNullOrEmpty(BrainName) || !BrainNameIsPersisted)"
                        title="Delete the brain currently selected above -- removes its saved network config; cannot be undone">
                    DELETE BRAIN
                </button>
            }
        </div>
        @if (_deleteStatus is not null)
        {
            <span class="train-brainrow-error">@_deleteStatus</span>
        }
        @if (_buildBrainStatus is not null)
        {
            <span class="train-brainrow-error">@_buildBrainStatus</span>
        }

        <div class="train-card-fields-row">
            <label class="train-brainrow-field">
                Strategy
                <select class="train-brainrow-select" value="@StrategyName" @onchange="OnStrategyChanged"
                        disabled="@Service.IsRunning">
                    @foreach (var name in Service.StrategyNames)
                    {
                        <option value="@name">@name</option>
                    }
                </select>
            </label>
            <label class="train-brainrow-field"
                   title="Which rules shape the per-decision reward -- Equity Drift is the raw, unshaped baseline; Trading Rules adds loss-aversion, an anti-churn entry cost, and a max-holding-time penalty on top of it">
                Reward Policy
                <select class="train-brainrow-select" value="@RewardPolicyName" @onchange="OnRewardPolicyChanged"
                        disabled="@Service.IsRunning">
                    @foreach (var name in Service.RewardPolicyNames)
                    {
                        <option value="@name">@name</option>
                    }
                </select>
            </label>
            <label class="train-brainrow-field">
                Learning rate
                <input class="train-brainrow-input" type="number" min="0.00001" step="0.0001"
                       value="@LearningRate.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                       @onchange="OnLearningRateChanged" disabled="@Service.IsRunning" />
            </label>
        </div>

        @if (_showBuildPanel)
        {
            <div class="train-buildbrain">
                <div class="train-card-fields-row train-buildbrain-name-row">
                    <label class="train-brainrow-field train-brainrow-field-grow"
                           title="Name for this config -- matching an existing brain's name edits it in place (Save Brain updates it, Start Training shadows it live until saved); any other name is a new brain">
                        Name
                        <input class="train-brainrow-input train-brainrow-input-full" type="text"
                               value="@EffectiveBuildBrainName" @oninput="OnBuildBrainNameInput"
                               disabled="@(Service.IsRunning || _buildBrainNameAuto)" placeholder="e.g. lstm-vp-experiment" />
                    </label>
                    <label class="train-brainrow-field"
                           title="Auto-generate the name from architecture, layers, and selected data -- uncheck to type your own">
                        <input type="checkbox" checked="@_buildBrainNameAuto" @onchange="OnToggleAutoBuildBrainName"
                               disabled="@Service.IsRunning" /> Auto Name
                    </label>
                </div>

                <div class="train-buildbrain-cards">
                    <div class="train-card train-card-input">
                        <div class="train-card-title-row">
                            <div class="train-card-title"
                                 title="Which market/account data feeds this brain -- check a set, then pick its normalization and input structure">
                                Input</div>
                                <span class="train-card-badge"
                                      title="Total network input width: every selected set's input count below">
                                    @TotalInputCount</span>
                                </div>
                                <table class="train-inputset-table">
                                    <thead>
                                        <tr>
                                            <th title="Which market/account data feeds this brain -- check a set to include it">Any
                                                input set</th>
                                                <th
                                                    title="Normalized feeds a fraction-of-total/percent-offset from current price; Raw feeds the literal quantity (price, tick count, or seconds); Local/Global Z-Score feed a z-score against a sub-window's/the whole set's own mean and standard deviation instead; Binary feeds 1 if an entry is higher than the one before it, 0 if lower or equal">
                                                    Normalization</th>
                                                    <th
                                                        title="How much trailing bar history this set uses -- a fixed count of bars for Bar Window, merged into one profile for Volume/Time Profile, or (for Trader State) its 3 optional trailing-list lengths">
                                                        Window</th>
                                                        <th
                                                            title="How many histogram buckets Volume/Time Profile rebins its merged bars into -- not applicable to Bar Window or Trader State">
                                                            Bucket</th>
                                                            <th
                                                                title="Only used by Local Z-Score -- how many entries (bars for Bar Window, buckets for Volume Profile) each independently-normalized sub-window covers">
                                                                Z Sub-Window</th>
                                                            </tr>
                                                        </thead>
                                                        <tbody>
                                                            <tr>
                                                                <td>
                                                                    <label class="train-brainrow-field" title="Trailing bar price window">
                                                                        <input type="checkbox" @bind="_includeBarWindow" disabled="@Service.IsRunning" />
                                                                        Bar Window
                                                                    </label>
                                                                </td>
                                                                <td>
                                                                    <select class="train-brainrow-select" value="@_barWindowNormalization"
                                                                            @onchange="OnBarWindowNormalizationChanged"
                                                                            disabled="@(Service.IsRunning || !_includeBarWindow)"
                                                                            title="Normalized feeds percent-change-from-current-price; Raw feeds the literal price; Local/Global Z-Score feed each bar's z-score against a sub-window's/the whole window's own mean and standard deviation instead; Binary feeds 1 if a bar's price is higher than the one before it, 0 if lower or equal">
                                                                        <option value="Normalized">Normalized</option>
                                                                        <option value="Raw">Raw</option>
                                                                        <option value="LocalZScore">Local Z-Score</option>
                                                                        <option value="GlobalZScore">Global Z-Score</option>
                                                                        <option value="Binary">Binary</option>
                                                                    </select>
                                                                </td>
                                                                <td>
                                                                    <input class="train-brainrow-input" type="number" min="1" step="1"
                                                                           @bind="_barWindowSize" disabled="@(Service.IsRunning || !_includeBarWindow)"
                                                                           title="How many trailing bars Bar Window feeds the network -- also its input count, 1 input per bar" />
                                                                </td>
                                                                <td class="train-inputset-cell-na" title="Bar Window has no bucketing -- one input per bar">
                                                                    &#8212;</td>
                                                                    <td>
                                                                        @if (_barWindowNormalization == NormalizationKind.LocalZScore)
                                                                        {
                                                                            <input class="train-brainrow-input" type="number" min="1" step="1"
                                                                                   @bind="_barWindowZScoreSubWindowSize"
                                                                                   disabled="@(Service.IsRunning || !_includeBarWindow)"
                                                                                   title="How many trailing bars each independently-normalized Local Z-Score sub-window covers" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="train-inputset-cell-na" title="Only used by Local Z-Score">&#8212;</span>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td>
                                                                        <label class="train-brainrow-field"
                                                                               title="Volume histogram + point-of-control/value-area summary, merged from its Window's trailing bars">
                                                                            <input type="checkbox" @bind="_includeVolumeProfile"
                                                                                   disabled="@Service.IsRunning" />
                                                                            Volume Profile
                                                                        </label>
                                                                        <label class="train-brainrow-field train-brainrow-field-sub"
                                                                               title="Split each bucket's volume into up-tick/down-tick totals plus their diff, instead of one plain total -- mirrors the Volume Profile chart's own Split up/down toggle">
                                                                            <input type="checkbox" @bind="_volumeProfileSplitUpDown"
                                                                                   disabled="@(Service.IsRunning || !_includeVolumeProfile)" />
                                                                            Split Up/Down
                                                                        </label>
                                                                    </td>
                                                                    <td>
                                                                        <select class="train-brainrow-select" value="@_volumeProfileNormalization"
                                                                                @onchange="OnVolumeProfileNormalizationChanged"
                                                                                disabled="@(Service.IsRunning || !_includeVolumeProfile)"
                                                                                title="Normalized feeds a fraction-of-total/percent-offset from current price; Raw feeds exact tick counts and exact price levels; Local/Global Z-Score feed each bucket's volume as a z-score against a sub-window's/the whole profile's own mean and standard deviation instead; Binary feeds 1 if a bucket's volume is higher than the bucket before it, 0 if lower or equal">
                                                                            <option value="Normalized">Normalized</option>
                                                                            <option value="Raw">Raw</option>
                                                                            <option value="LocalZScore">Local Z-Score</option>
                                                                            <option value="GlobalZScore">Global Z-Score</option>
                                                                            <option value="Binary">Binary</option>
                                                                        </select>
                                                                    </td>
                                                                    <td>
                                                                        <input class="train-brainrow-input" type="number" min="1" step="1"
                                                                               @bind="_volumeProfileLookbackBars"
                                                                               disabled="@(Service.IsRunning || !_includeVolumeProfile)"
                                                                               title="How many trailing bars Volume Profile merges into one profile each decision" />
                                                                    </td>
                                                                    <td>
                                                                        <input class="train-brainrow-input" type="number" min="1" step="1"
                                                                               @bind="_volumeProfileBucketCount"
                                                                               disabled="@(Service.IsRunning || !_includeVolumeProfile)"
                                                                               title="@VolumeProfileBucketsTooltip" />
                                                                    </td>
                                                                    <td>
                                                                        @if (_volumeProfileNormalization == NormalizationKind.LocalZScore)
                                                                        {
                                                                            <input class="train-brainrow-input" type="number" min="1" step="1"
                                                                                   @bind="_volumeProfileZScoreSubWindowSize"
                                                                                   disabled="@(Service.IsRunning || !_includeVolumeProfile)"
                                                                                   title="How many buckets each independently-normalized Local Z-Score sub-window covers" />
                                                                        }
                                                                        else
                                                                        {
                                                                            <span class="train-inputset-cell-na" title="Only used by Local Z-Score">&#8212;</span>
                                                                        }
                                                                    </td>
                                                                </tr>
                                                                <tr>
                                                                    <td>
                                                                        <label class="train-brainrow-field"
                                                                               title="Time-weighted histogram + point-of-control/value-area summary (seconds spent at each price level), merged from its Window's trailing bars">
                                                                            <input type="checkbox" @bind="_includeTimeProfile" disabled="@Service.IsRunning" />
                                                                            Time Profile
                                                                        </label>
                                                                        <label class="train-brainrow-field train-brainrow-field-sub"
                                                                               title="Split each bucket's seconds into up-tick/down-tick totals plus their diff, instead of one plain total -- mirrors the Volume Profile chart's own Split up/down toggle">
                                                                            <input type="checkbox" @bind="_timeProfileSplitUpDown"
                                                                                   disabled="@(Service.IsRunning || !_includeTimeProfile)" />
                                                                            Split Up/Down
                                                                        </label>
                                                                    </td>
                                                                    <td>
                                                                        <select class="train-brainrow-select" value="@_timeProfileNormalization"
                                                                                @onchange="OnTimeProfileNormalizationChanged"
                                                                                disabled="@(Service.IsRunning || !_includeTimeProfile)"
                                                                                title="Normalized feeds a fraction-of-total/percent-offset from current price; Raw feeds exact seconds spent and exact price levels instead">
                                                                            <option value="Normalized">Normalized</option>
                                                                            <option value="Raw">Raw</option>
                                                                        </select>
                                                                    </td>
                                                                    <td>
                                                                        <input class="train-brainrow-input" type="number" min="1" step="1"
                                                                               @bind="_timeProfileLookbackBars"
                                                                               disabled="@(Service.IsRunning || !_includeTimeProfile)"
                                                                               title="How many trailing bars Time Profile merges into one profile each decision" />
                                                                    </td>
                                                                    <td>
                                                                        <input class="train-brainrow-input" type="number" min="1" step="1"
                                                                               @bind="_timeProfileBucketCount"
                                                                               disabled="@(Service.IsRunning || !_includeTimeProfile)"
                                                                               title="@TimeProfileBucketsTooltip" />
                                                                    </td>
                                                                    <td class="train-inputset-cell-na"
                                                                        title="Local/Global Z-Score not offered for Time Profile">&#8212;</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>
                                                                        <label class="train-brainrow-field"
                                                                               title="Time-of-day and day-of-week as sin/cos pairs -- captures recurring FX session structure (Sydney/Tokyo/London/New York open-close, weekend closure)">
                                                                            <input type="checkbox" @bind="_includeSessionClock" disabled="@Service.IsRunning" />
                                                                            Session Clock
                                                                        </label>
                                                                    </td>
                                                                    <td class="train-inputset-cell-na"
                                                                        title="Always sin/cos-encoded, already bounded -- no Raw alternative">&#8212;</td>
                                                                    <td class="train-inputset-cell-na"
                                                                        title="Derived from the current tick's own timestamp -- no history needed">&#8212;</td>
                                                                    <td class="train-inputset-cell-na"
                                                                        title="Fixed 4 values (time-of-day sin/cos, day-of-week sin/cos), no bucketing">&#8212;
                                                                    </td>
                                                                    <td class="train-inputset-cell-na"
                                                                        title="Local/Global Z-Score not offered for Session Clock">&#8212;</td>
                                                                </tr>
                                                                <tr>
                                                                    <td>
                                                                        <label class="train-brainrow-field"
                                                                               title="Current Bid/Ask spread plus a short trailing Average True Range -- how expensive trading is right now, and how much price is actually moving">
                                                                            <input type="checkbox" @bind="_includeSpreadVolatility"
                                                                                   disabled="@Service.IsRunning" />
                                                                            Spread + Volatility
                                                                        </label>
                                                                    </td>
                                                                    <td class="train-inputset-cell-na"
                                                                        title="Always fed as literal price-scaled values -- no Raw alternative">&#8212;</td>
                                                                    <td>
                                                                        <input class="train-brainrow-input" type="number" min="1" step="1"
                                                                               @bind="_spreadVolatilityAtrPeriod"
                                                                               disabled="@(Service.IsRunning || !_includeSpreadVolatility)"
                                                                               title="How many trailing bars the Average True Range figure averages over" />
                                                                    </td>
                                                                    <td class="train-inputset-cell-na" title="Fixed 2 values (spread, ATR), no bucketing">
                                                                        &#8212;</td>
                                                                        <td class="train-inputset-cell-na"
                                                                            title="Local/Global Z-Score not offered for Spread + Volatility">&#8212;</td>
                                                                    </tr>
                                                                    <tr>
                                                                        <td>
                                                                            <label class="train-brainrow-field"
                                                                                   title="Own position/capital state -- opt-in, unchecked by default; check it if this brain needs to know whether it already holds a position">
                                                                                <input type="checkbox" @bind="_includeTraderState" disabled="@Service.IsRunning" />
                                                                                Trader State
                                                                            </label>
                                                                        </td>
                                                                        <td>
                                                                            <select class="train-brainrow-select" disabled
                                                                                    title="Every field is fed to the network exactly as reported (position, cash, equity, margin, ...) -- not yet configurable, may become selectable in the future">
                                                                                <option>Raw</option>
                                                                            </select>
                                                                        </td>
                                                                        <td>
                                                                            <label class="train-brainrow-field"
                                                                                   title="How many of the most recent closed trades' win(1)/loss(0) outcome Trader State feeds, most-recent-last, zero-padded if fewer trades have closed yet -- 0 disables this list">
                                                                                Outcomes
                                                                                <input class="train-brainrow-input" type="number" min="0" step="1"
                                                                                       @bind="_traderStateTradeOutcomeListLength"
                                                                                       disabled="@(Service.IsRunning || !_includeTraderState)" />
                                                                            </label>
                                                                            <label class="train-brainrow-field train-brainrow-field-sub"
                                                                                   title="How many trailing price records since the open position's own entry time Trader State compares against entry price (1 above, 0 at-or-below), most-recent-last, zero-padded -- flat (no position) or 0 disables this list">
                                                                                Level
                                                                                <input class="train-brainrow-input" type="number" min="0" step="1"
                                                                                       @bind="_traderStatePositionLevelListLength"
                                                                                       disabled="@(Service.IsRunning || !_includeTraderState)" />
                                                                            </label>
                                                                            <label class="train-brainrow-field train-brainrow-field-sub"
                                                                                   title="How many of the most recent closed trades' direction (1=Long, 0=Short) Trader State feeds, index-aligned with Outcomes -- 0 disables this list">
                                                                                Direction
                                                                                <input class="train-brainrow-input" type="number" min="0" step="1"
                                                                                       @bind="_traderStateDirectionListLength"
                                                                                       disabled="@(Service.IsRunning || !_includeTraderState)" />
                                                                            </label>
                                                                        </td>
                                                                            <td class="train-inputset-cell-na" title="Fixed 12 base fields, no bucketing -- Outcomes/Level/Direction list lengths (Window column) add to that count instead">&#8212;</td>
                                                                            <td class="train-inputset-cell-na"
                                                                                title="Local/Global Z-Score not offered for Trader State">&#8212;</td>
                                                                        </tr>
                                                                    </tbody>
                                                                </table>
                                                            </div>

                                                            <div class="train-card">
                                                                <div class="train-card-title-row">
                                                                    <div class="train-card-title" title="Network shape applied to the inputs selected on the left">
                                                                        Structure</div>
                                                                        @if (FirstLayerTooSmall)
                                                                        {
                                                                            <span class="train-card-badge train-card-badge-warn"
                                                                                  title="@($"First hidden layer ({FirstHiddenLayerSize}) is narrower than the network's {TotalInputCount} inputs -- a bottleneck compressing them before any transformation")">
                                                                                &#9888; @FirstHiddenLayerSize &lt; @TotalInputCount</span>
                                                                            }
                                                                        </div>
                                                                        <div class="train-buildbrain-card-fields">
                                                                            <label class="train-brainrow-field"
                                                                                   title="Network shape applied to the combined features selected above">
                                                                                Architecture
                                                                                <select class="train-brainrow-select" value="@_architectureKind"
                                                                                        @onchange="OnArchitectureKindChanged" disabled="@Service.IsRunning">
                                                                                    <option value="Mlp">MLP</option>
                                                                                    <option value="Lstm">LSTM</option>
                                                                                    <option value="Cnn">CNN</option>
                                                                                </select>
                                                                            </label>
                                                                            @if (_architectureKind == ArchitectureKind.Mlp)
                                                                            {
                                                                                <div class="train-hiddenlayers">
                                                                                    <button type="button" class="train-btn-toggle" @onclick="AddHiddenLayerOnTop"
                                                                                            disabled="@Service.IsRunning"
                                                                                            title="Add another hidden layer, inserted above layer 1 -- defaults to double layer 1's size">
                                                                                        + ADD LAYER
                                                                                    </button>
                                                                                    @for (int i = 0; i < _mlpHiddenSizes.Count; i++)
                                                                                    {
                                                                                        var index = i;
                                                                                        <label class="train-brainrow-field" title="@($"Size of hidden layer {index + 1}")">
                                                                                            Layer @(index + 1)
                                                                                            <span class="train-hiddenlayer-controls">
                                                                                                <input class="train-brainrow-input train-brainrow-input-right" type="number" min="1"
                                                                                                       step="1" value="@_mlpHiddenSizes[index]"
                                                                                                       @oninput="e => OnHiddenLayerSizeChanged(index, e)" disabled="@Service.IsRunning" />
                                                                                                <button type="button" class="train-btn-remove-layer"
                                                                                                        @onclick="() => RemoveHiddenLayer(index)"
                                                                                                        disabled="@(Service.IsRunning || !CanRemoveHiddenLayer)"
                                                                                                        title="@(CanRemoveHiddenLayer ? "Remove this layer" : "At least one hidden layer is required")">
                                                                                                    &#215;
                                                                                                </button>
                                                                                            </span>
                                                                                        </label>
                                                                                    }
                                                                                    <button type="button" class="train-btn-toggle" @onclick="AddHiddenLayer"
                                                                                            disabled="@Service.IsRunning"
                                                                                            title="Add another hidden layer, stacked after the ones above -- defaults to half the last layer's size">
                                                                                        + ADD LAYER
                                                                                    </button>
                                                                                </div>
                                                                            }
                                                                            else if (_architectureKind == ArchitectureKind.Lstm)
                                                                            {
                                                                                <label class="train-brainrow-field" title="LSTM hidden state size">
                                                                                    Hidden size
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="1"
                                                                                           @bind="_lstmHiddenSize" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                <label class="train-brainrow-field" title="Number of stacked LSTM layers">
                                                                                    LSTM layers
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="1"
                                                                                           @bind="_lstmNumLayers" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                @if (!_includeBarWindow)
                                                                                {
                                                                                    <span class="train-brainrow-error">LSTM needs Bar Window for its sequence</span>
                                                                                }
                                                                            }
                                                                            else
                                                                            {
                                                                                <label class="train-brainrow-field"
                                                                                       title="Which selected input set the convolution kernel actually sweeps over -- Bar Window (default) slides over the trailing price window; Volume Profile instead slides over its price-ordered histogram buckets, with everything else (including Bar Window if also selected) fed as plain scalars alongside the pooled conv output">
                                                                                    Kernel sweeps
                                                                                    <select class="train-brainrow-select" value="@_cnnKernelSweepSource"
                                                                                            @onchange="OnCnnKernelSweepSourceChanged" disabled="@Service.IsRunning">
                                                                                        <option value="BarWindow">Bar Window</option>
                                                                                        <option value="VolumeProfile">Volume Profile</option>
                                                                                    </select>
                                                                                </label>
                                                                                <label class="train-brainrow-field"
                                                                                       title="Convolution kernel width applied to every conv layer -- odd sizes (3, 5, 7, ...) keep the window's time length unchanged through each layer">
                                                                                    Kernel size
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="1" step="2"
                                                                                           @bind="_cnnKernelSize" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                <div class="train-hiddenlayers">
                                                                                    @for (int i = 0; i < _cnnChannels.Count; i++)
                                                                                    {
                                                                                        var index = i;
                                                                                        <label class="train-brainrow-field"
                                                                                               title="@($"Output channel count of conv layer {index + 1}")">
                                                                                            Layer @(index + 1)
                                                                                            <span class="train-hiddenlayer-controls">
                                                                                                <input class="train-brainrow-input train-brainrow-input-right" type="number" min="1"
                                                                                                       step="1" value="@_cnnChannels[index]"
                                                                                                       @oninput="e => OnCnnChannelSizeChanged(index, e)" disabled="@Service.IsRunning" />
                                                                                                <button type="button" class="train-btn-remove-layer"
                                                                                                        @onclick="() => RemoveCnnChannelLayer(index)"
                                                                                                        disabled="@(Service.IsRunning || !CanRemoveCnnChannelLayer)"
                                                                                                        title="@(CanRemoveCnnChannelLayer ? "Remove this layer" : "At least one conv layer is required")">
                                                                                                    &#215;
                                                                                                </button>
                                                                                            </span>
                                                                                        </label>
                                                                                    }
                                                                                    <button type="button" class="train-btn-toggle" @onclick="AddCnnChannelLayer"
                                                                                            disabled="@Service.IsRunning"
                                                                                            title="Add another conv layer, stacked after the ones above -- defaults to double the last layer's channel count">
                                                                                        + ADD LAYER
                                                                                    </button>
                                                                                </div>
                                                                                @if (!CnnSweepSourceIncluded)
                                                                                {
                                                                                    <span class="train-brainrow-error">
                                                                                        CNN needs @(_cnnKernelSweepSource == CnnKernelSweepSource.VolumeProfile ? "Volume Profile" :
                                                                                                         "Bar Window") for its sequence
                                                                                    </span>
                                                                                }
                                                                            }
                                                                        </div>
                                                                    </div>

                                                                    <div class="train-card">
                                                                        <div class="train-card-title-row">
                                                                            <div class="train-card-title"
                                                                                 title="Which decisions this brain's network is allowed to make -- every one below is optional">
                                                                                Actions</div>
                                                                                <span class="train-card-badge"
                                                                                      title="How many of the @TotalActionOptionCount available action decisions are enabled">
                                                                                    @SelectedActionCount/@TotalActionOptionCount</span>
                                                                                </div>
                                                                                <div class="train-buildbrain-card-fields">
                                                                                    <label class="train-brainrow-field" title="Toggle every action decision below on or off at once">
                                                                                        <input type="checkbox" @bind="AllActionsSelected" disabled="@Service.IsRunning" />
                                                                                        Select All
                                                                                    </label>
                                                                                    <label class="train-brainrow-field" title="Network can choose to do nothing this tick">
                                                                                        <input type="checkbox" @bind="_includeHold" disabled="@Service.IsRunning" /> Hold
                                                                                    </label>
                                                                                    <label class="train-brainrow-field" title="Network can open a long position">
                                                                                        <input type="checkbox" @bind="_includeEnterLong" disabled="@Service.IsRunning" />
                                                                                        Enter Long
                                                                                    </label>
                                                                                    <label class="train-brainrow-field" title="Network can open a short position">
                                                                                        <input type="checkbox" @bind="_includeEnterShort" disabled="@Service.IsRunning" />
                                                                                        Enter Short
                                                                                    </label>
                                                                                    <label class="train-brainrow-field"
                                                                                           title="Network can close an open position (or cancel a resting order)">
                                                                                        <input type="checkbox" @bind="_includeClose" disabled="@Service.IsRunning" /> Close
                                                                                    </label>
                                                                                    <label class="train-brainrow-field"
                                                                                           title="Network picks position size (25/50/75/100% of cash) for each entry, instead of a fixed 50%">
                                                                                        <input type="checkbox" @bind="_includeVolumeOutput" disabled="@Service.IsRunning" />
                                                                                        Volume
                                                                                    </label>
                                                                                    <label class="train-brainrow-field"
                                                                                           title="Network picks a stop-loss distance (or none) for each entry">
                                                                                        <input type="checkbox" @bind="_includeStopLossOutput" disabled="@Service.IsRunning" /> Stop Loss
                                                                                    </label>
                                                                                    <label class="train-brainrow-field"
                                                                                           title="Network picks a take-profit distance (or none) for each entry">
                                                                                        <input type="checkbox" @bind="_includeTakeProfitOutput" disabled="@Service.IsRunning" /> Take
                                                                                        Profit
                                                                                    </label>
                                                                                </div>
                                                                            </div>


                                                                            <div class="train-card">
                                                                                <div class="train-card-title-row">
                                                                                    <div class="train-card-title"
                                                                                         title="How the network's raw output logits become each enabled decision above -- every group below is decoded independently via its own softmax distribution, not one joint choice across all of them">
                                                                                        Action Decoding</div>
                                                                                        <span class="train-card-badge"
                                                                                              title="Total network output width: every enabled group's softmax width, summed">
                                                                                            @TotalOutputWidth</span>
                                                                                        </div>
                                                                                        <div class="train-buildbrain-card-fields">
                                                                                            <label class="train-brainrow-field"
                                                                                                   title="Softmax always samples stochastically, weighted by probability -- what training needs for exploration. HardMax instead always picks the highest-probability choice, deterministically -- for evaluating the policy the network actually learned. Applies to every group below.">
                                                                                                Decoding Mode
                                                                                                <select class="train-brainrow-select" value="@_decisionDecoding"
                                                                                                        @onchange="OnDecisionDecodingKindChanged" disabled="@Service.IsRunning">
                                                                                                    <option value="Softmax">Softmax (stochastic)</option>
                                                                                                    <option value="HardMax">HardMax (argmax)</option>
                                                                                                </select>
                                                                                            </label>
                                                                                            <label class="train-brainrow-field"
                                                                                                   title="Divides each group's raw logits before Softmax -- below 1 sharpens the distribution toward its highest choice (less exploration, closer to HardMax); above 1 flattens it toward uniform (more exploration). 1 is unscaled (today's original behavior). No effect under HardMax, which always takes the highest choice regardless.">
                                                                                                Temperature
                                                                                                <input class="train-brainrow-input" type="number" min="0.01" step="0.1"
                                                                                                       @bind="_decisionTemperature"
                                                                                                       disabled="@(Service.IsRunning || _decisionDecoding == DecisionDecodingKind.HardMax)" />
                                                                                            </label>
                                                                                        </div>
                                                                                        <div class="train-buildbrain-card-fields train-buildbrain-card-fields-end">
                                                                                            <label class="train-brainrow-field"
                                                                                                   title="@($"Softmax over the {DirectionCount} enabled direction(s): {string.Join(" / ", EnabledDirectionLabels)}")">
                                                                                                Direction
                                                                                                <span class="train-decoding-value">@DirectionCount-way @DecodingLabel</span>
                                                                                            </label>
                                                                                            @if (_includeVolumeOutput)
                                                                                            {
                                                                                                <label class="train-brainrow-field"
                                                                                                       title="Softmax over 4 capital-fraction levels: 25% / 50% / 75% / 100%">
                                                                                                    Volume
                                                                                                    <span class="train-decoding-value">@VolumeOutputWidth-way @DecodingLabel</span>
                                                                                                </label>
                                                                                            }
                                                                                            @if (_includeStopLossOutput)
                                                                                            {
                                                                                                <label class="train-brainrow-field"
                                                                                                       title="Softmax over 4 stop-loss distances: None / Tight / Medium / Wide">
                                                                                                    Stop Loss
                                                                                                    <span class="train-decoding-value">@StopLossOutputWidth-way @DecodingLabel</span>
                                                                                                </label>
                                                                                            }
                                                                                            @if (_includeTakeProfitOutput)
                                                                                            {
                                                                                                <label class="train-brainrow-field"
                                                                                                       title="Softmax over 4 take-profit distances: None / Tight / Medium / Wide">
                                                                                                    Take Profit
                                                                                                    <span class="train-decoding-value">@TakeProfitOutputWidth-way @DecodingLabel</span>
                                                                                                </label>
                                                                                            }
                                                                                        </div>
                                                                                    </div>
                                                                                </div>

                                                                            </div>
                                                                        }
                                                                    </div>
