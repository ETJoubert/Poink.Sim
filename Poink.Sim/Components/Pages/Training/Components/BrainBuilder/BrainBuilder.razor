@namespace Poink.Sim.Components.Training
@using Poink.Sim.Brain.Neural

@if (Visible)
{
    <div class="train-buildbrain">
        <div class="train-card-fields-row train-buildbrain-name-row">
            <label class="train-brainrow-field train-brainrow-field-grow"
                   title="Unique name for this brain -- must not match an existing one">
                Name
                <input class="train-brainrow-input train-brainrow-input-full" type="text"
                       value="@EffectiveBuildBrainName" @oninput="OnBuildBrainNameInput"
                       disabled="@(Service.IsRunning || _buildBrainNameAuto)"
                       placeholder="e.g. lstm-vp-experiment" />
            </label>
            <label class="train-brainrow-field"
                   title="Auto-generate the name from architecture, layers, and selected data -- uncheck to type your own">
                <input type="checkbox" checked="@_buildBrainNameAuto" @onchange="OnToggleAutoBuildBrainName"
                       disabled="@Service.IsRunning" /> Auto Name
            </label>
        </div>

        <div class="train-buildbrain-cards">
            <div class="train-card train-card-input">
                <div class="train-card-title-row">
                    <div class="train-card-title"
                         title="Which market/account data feeds this brain -- check a set, then pick its normalization and input structure">
                        Input</div>
                    <span class="train-card-badge"
                          title="Total network input width: every selected set's input count below, plus Trader State's fixed 12">
                        @TotalInputCount</span>
                </div>
                <table class="train-inputset-table">
                    <thead>
                        <tr>
                            <th title="Which market/account data feeds this brain -- check a set to include it">Any input set</th>
                            <th title="Normalized feeds a fraction-of-total/percent-offset from current price; Raw feeds the literal quantity (price, tick count, or seconds) instead">
                                Normalization</th>
                            <th title="How much trailing bar history this set uses -- a fixed count of bars for Bar Window, merged into one profile for Volume/Time Profile">
                                Window</th>
                            <th title="How many histogram buckets Volume/Time Profile rebins its merged bars into -- not applicable to Bar Window or Trader State">
                                Bucket</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>
                                <label class="train-brainrow-field" title="Trailing bar price window">
                                    <input type="checkbox" @bind="_includeBarWindow" disabled="@Service.IsRunning" />
                                    Bar Window
                                </label>
                            </td>
                            <td>
                                <select class="train-brainrow-select" value="@_barWindowNormalization"
                                        @onchange="OnBarWindowNormalizationChanged" disabled="@(Service.IsRunning || !_includeBarWindow)"
                                        title="Normalized feeds percent-change-from-current-price; Raw feeds the literal price instead">
                                    <option value="Normalized">Normalized</option>
                                    <option value="Raw">Raw</option>
                                </select>
                            </td>
                            <td>
                                <input class="train-brainrow-input" type="number" min="1" step="1"
                                       @bind="_barWindowSize" disabled="@(Service.IsRunning || !_includeBarWindow)"
                                       title="How many trailing bars Bar Window feeds the network -- also its input count, 1 input per bar" />
                            </td>
                            <td class="train-inputset-cell-na" title="Bar Window has no bucketing -- one input per bar">&#8212;</td>
                        </tr>
                        <tr>
                            <td>
                                <label class="train-brainrow-field"
                                       title="Volume histogram + point-of-control/value-area summary, merged from its Window's trailing bars">
                                    <input type="checkbox" @bind="_includeVolumeProfile" disabled="@Service.IsRunning" />
                                    Volume Profile
                                </label>
                            </td>
                            <td>
                                <select class="train-brainrow-select" value="@_volumeProfileNormalization"
                                        @onchange="OnVolumeProfileNormalizationChanged" disabled="@(Service.IsRunning || !_includeVolumeProfile)"
                                        title="Normalized feeds a fraction-of-total/percent-offset from current price; Raw feeds exact tick counts and exact price levels instead">
                                    <option value="Normalized">Normalized</option>
                                    <option value="Raw">Raw</option>
                                </select>
                            </td>
                            <td>
                                <input class="train-brainrow-input" type="number" min="1" step="1"
                                       @bind="_volumeProfileLookbackBars" disabled="@(Service.IsRunning || !_includeVolumeProfile)"
                                       title="How many trailing bars Volume Profile merges into one profile each decision" />
                            </td>
                            <td>
                                <input class="train-brainrow-input" type="number" min="1" step="1"
                                       @bind="_volumeProfileBucketCount" disabled="@(Service.IsRunning || !_includeVolumeProfile)"
                                       title="@VolumeProfileBucketsTooltip" />
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <label class="train-brainrow-field"
                                       title="Time-weighted histogram + point-of-control/value-area summary (seconds spent at each price level), merged from its Window's trailing bars">
                                    <input type="checkbox" @bind="_includeTimeProfile" disabled="@Service.IsRunning" />
                                    Time Profile
                                </label>
                            </td>
                            <td>
                                <select class="train-brainrow-select" value="@_timeProfileNormalization"
                                        @onchange="OnTimeProfileNormalizationChanged" disabled="@(Service.IsRunning || !_includeTimeProfile)"
                                        title="Normalized feeds a fraction-of-total/percent-offset from current price; Raw feeds exact seconds spent and exact price levels instead">
                                    <option value="Normalized">Normalized</option>
                                    <option value="Raw">Raw</option>
                                </select>
                            </td>
                            <td>
                                <input class="train-brainrow-input" type="number" min="1" step="1"
                                       @bind="_timeProfileLookbackBars" disabled="@(Service.IsRunning || !_includeTimeProfile)"
                                       title="How many trailing bars Time Profile merges into one profile each decision" />
                            </td>
                            <td>
                                <input class="train-brainrow-input" type="number" min="1" step="1"
                                       @bind="_timeProfileBucketCount" disabled="@(Service.IsRunning || !_includeTimeProfile)"
                                       title="@TimeProfileBucketsTooltip" />
                            </td>
                        </tr>
                        <tr>
                            <td>
                                <label class="train-brainrow-field"
                                       title="Time-of-day and day-of-week as sin/cos pairs -- captures recurring FX session structure (Sydney/Tokyo/London/New York open-close, weekend closure)">
                                    <input type="checkbox" @bind="_includeSessionClock" disabled="@Service.IsRunning" />
                                    Session Clock
                                </label>
                            </td>
                            <td class="train-inputset-cell-na" title="Always sin/cos-encoded, already bounded -- no Raw alternative">&#8212;</td>
                            <td class="train-inputset-cell-na" title="Derived from the current tick's own timestamp -- no history needed">&#8212;</td>
                            <td class="train-inputset-cell-na" title="Fixed 4 values (time-of-day sin/cos, day-of-week sin/cos), no bucketing">&#8212;</td>
                        </tr>
                        <tr>
                            <td>
                                <label class="train-brainrow-field"
                                       title="Current Bid/Ask spread plus a short trailing Average True Range -- how expensive trading is right now, and how much price is actually moving">
                                    <input type="checkbox" @bind="_includeSpreadVolatility" disabled="@Service.IsRunning" />
                                    Spread + Volatility
                                </label>
                            </td>
                            <td class="train-inputset-cell-na" title="Always fed as literal price-scaled values -- no Raw alternative">&#8212;</td>
                            <td>
                                <input class="train-brainrow-input" type="number" min="1" step="1"
                                       @bind="_spreadVolatilityAtrPeriod" disabled="@(Service.IsRunning || !_includeSpreadVolatility)"
                                       title="How many trailing bars the Average True Range figure averages over" />
                            </td>
                            <td class="train-inputset-cell-na" title="Fixed 2 values (spread, ATR), no bucketing">&#8212;</td>
                        </tr>
                        <tr>
                            <td>
                                <label class="train-brainrow-field"
                                       title="Always included -- every brain needs to know its own position/capital regardless of market data">
                                    <input type="checkbox" checked="checked" disabled /> Trader State
                                </label>
                            </td>
                            <td>
                                <select class="train-brainrow-select" disabled
                                        title="Every field is fed to the network exactly as reported (position, cash, equity, margin, ...) -- not yet configurable, may become selectable in the future">
                                    <option>Raw</option>
                                </select>
                            </td>
                            <td class="train-inputset-cell-na" title="Meaningful from the first tick -- no windowing">&#8212;</td>
                            <td class="train-inputset-cell-na" title="Fixed 12 fields, no bucketing">&#8212;</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <div class="train-card">
                <div class="train-card-title-row">
                    <div class="train-card-title" title="Network shape applied to the inputs selected on the left">Structure</div>
                    @if (FirstLayerTooSmall)
                    {
                        <span class="train-card-badge train-card-badge-warn"
                              title="@($"First hidden layer ({FirstHiddenLayerSize}) is narrower than the network's {TotalInputCount} inputs -- a bottleneck compressing them before any transformation")">
                            &#9888; @FirstHiddenLayerSize &lt; @TotalInputCount</span>
                    }
                </div>
                <div class="train-buildbrain-card-fields">
                    <label class="train-brainrow-field"
                           title="Network shape applied to the combined features selected above">
                        Architecture
                        <select class="train-brainrow-select" value="@_architectureKind"
                                @onchange="OnArchitectureKindChanged" disabled="@Service.IsRunning">
                            <option value="Mlp">MLP</option>
                            <option value="Lstm">LSTM</option>
                            <option value="Cnn">CNN</option>
                        </select>
                    </label>
                    @if (_architectureKind == ArchitectureKind.Mlp)
                    {
                        <div class="train-hiddenlayers">
                            <button type="button" class="train-btn-toggle" @onclick="AddHiddenLayerOnTop"
                                    disabled="@Service.IsRunning"
                                    title="Add another hidden layer, inserted above layer 1 -- defaults to double layer 1's size">
                                + ADD LAYER
                            </button>
                            @for (int i = 0; i < _mlpHiddenSizes.Count; i++)
                            {
                                var index = i;
                                <label class="train-brainrow-field" title="@($"Size of hidden layer {index + 1}")">
                                    Layer @(index + 1)
                                    <span class="train-hiddenlayer-controls">
                                        <input class="train-brainrow-input train-brainrow-input-right" type="number"
                                               min="1" step="1" value="@_mlpHiddenSizes[index]"
                                               @oninput="e => OnHiddenLayerSizeChanged(index, e)"
                                               disabled="@Service.IsRunning" />
                                        <button type="button" class="train-btn-remove-layer"
                                                @onclick="() => RemoveHiddenLayer(index)"
                                                disabled="@(Service.IsRunning || !CanRemoveHiddenLayer)"
                                                title="@(CanRemoveHiddenLayer ? "Remove this layer" : "At least one hidden layer is required")">
                                            &#215;
                                        </button>
                                    </span>
                                </label>
                            }
                            <button type="button" class="train-btn-toggle" @onclick="AddHiddenLayer"
                                    disabled="@Service.IsRunning"
                                    title="Add another hidden layer, stacked after the ones above -- defaults to half the last layer's size">
                                + ADD LAYER
                            </button>
                        </div>
                    }
                    else if (_architectureKind == ArchitectureKind.Lstm)
                    {
                        <label class="train-brainrow-field" title="LSTM hidden state size">
                            Hidden size
                            <input class="train-brainrow-input train-brainrow-input-right" type="number" min="1"
                                   @bind="_lstmHiddenSize" disabled="@Service.IsRunning" />
                        </label>
                        <label class="train-brainrow-field" title="Number of stacked LSTM layers">
                            LSTM layers
                            <input class="train-brainrow-input train-brainrow-input-right" type="number" min="1"
                                   @bind="_lstmNumLayers" disabled="@Service.IsRunning" />
                        </label>
                        @if (!_includeBarWindow)
                        {
                            <span class="train-brainrow-error">LSTM needs Bar Window for its sequence</span>
                        }
                    }
                    else
                    {
                        <label class="train-brainrow-field" title="Convolution kernel width applied to every conv layer -- odd sizes (3, 5, 7, ...) keep the window's time length unchanged through each layer">
                            Kernel size
                            <input class="train-brainrow-input train-brainrow-input-right" type="number" min="1" step="2"
                                   @bind="_cnnKernelSize" disabled="@Service.IsRunning" />
                        </label>
                        <div class="train-hiddenlayers">
                            @for (int i = 0; i < _cnnChannels.Count; i++)
                            {
                                var index = i;
                                <label class="train-brainrow-field" title="@($"Output channel count of conv layer {index + 1}")">
                                    Layer @(index + 1)
                                    <span class="train-hiddenlayer-controls">
                                        <input class="train-brainrow-input train-brainrow-input-right" type="number"
                                               min="1" step="1" value="@_cnnChannels[index]"
                                               @oninput="e => OnCnnChannelSizeChanged(index, e)"
                                               disabled="@Service.IsRunning" />
                                        <button type="button" class="train-btn-remove-layer"
                                                @onclick="() => RemoveCnnChannelLayer(index)"
                                                disabled="@(Service.IsRunning || !CanRemoveCnnChannelLayer)"
                                                title="@(CanRemoveCnnChannelLayer ? "Remove this layer" : "At least one conv layer is required")">
                                            &#215;
                                        </button>
                                    </span>
                                </label>
                            }
                            <button type="button" class="train-btn-toggle" @onclick="AddCnnChannelLayer"
                                    disabled="@Service.IsRunning"
                                    title="Add another conv layer, stacked after the ones above -- defaults to double the last layer's channel count">
                                + ADD LAYER
                            </button>
                        </div>
                        @if (!_includeBarWindow)
                        {
                            <span class="train-brainrow-error">CNN needs Bar Window for its sequence</span>
                        }
                    }
                </div>
            </div>

            <div class="train-card">
                <div class="train-card-title-row">
                    <div class="train-card-title"
                         title="Which decisions this brain's network is allowed to make -- every one below is optional">
                        Actions</div>
                    <span class="train-card-badge"
                          title="How many of the @TotalActionOptionCount available action decisions are enabled">
                        @SelectedActionCount/@TotalActionOptionCount</span>
                </div>
                <div class="train-buildbrain-card-fields">
                    <label class="train-brainrow-field"
                           title="Toggle every action decision below on or off at once">
                        <input type="checkbox" @bind="AllActionsSelected" disabled="@Service.IsRunning" />
                        Select All
                    </label>
                    <label class="train-brainrow-field" title="Network can choose to do nothing this tick">
                        <input type="checkbox" @bind="_includeHold" disabled="@Service.IsRunning" /> Hold
                    </label>
                    <label class="train-brainrow-field" title="Network can open a long position">
                        <input type="checkbox" @bind="_includeEnterLong" disabled="@Service.IsRunning" />
                        Enter Long
                    </label>
                    <label class="train-brainrow-field" title="Network can open a short position">
                        <input type="checkbox" @bind="_includeEnterShort" disabled="@Service.IsRunning" />
                        Enter Short
                    </label>
                    <label class="train-brainrow-field"
                           title="Network can close an open position (or cancel a resting order)">
                        <input type="checkbox" @bind="_includeClose" disabled="@Service.IsRunning" /> Close
                    </label>
                    <label class="train-brainrow-field"
                           title="Network picks position size (25/50/75/100% of cash) for each entry, instead of a fixed 50%">
                        <input type="checkbox" @bind="_includeVolumeOutput" disabled="@Service.IsRunning" />
                        Volume
                    </label>
                    <label class="train-brainrow-field"
                           title="Network picks a stop-loss distance (or none) for each entry">
                        <input type="checkbox" @bind="_includeStopLossOutput"
                               disabled="@Service.IsRunning" /> Stop Loss
                    </label>
                    <label class="train-brainrow-field"
                           title="Network picks a take-profit distance (or none) for each entry">
                        <input type="checkbox" @bind="_includeTakeProfitOutput"
                               disabled="@Service.IsRunning" /> Take Profit
                    </label>
                </div>
            </div>


            <div class="train-card">
                <div class="train-card-title-row">
                    <div class="train-card-title"
                         title="How the network's raw output logits become each enabled decision above -- every group below is decoded independently via its own softmax distribution, not one joint choice across all of them">
                        Action Decoding</div>
                    <span class="train-card-badge"
                          title="Total network output width: every enabled group's softmax width, summed">
                        @TotalOutputWidth</span>
                </div>
                <div class="train-buildbrain-card-fields">
                    <label class="train-brainrow-field"
                           title="Softmax always samples stochastically, weighted by probability -- what training needs for exploration. HardMax instead always picks the highest-probability choice, deterministically -- for evaluating the policy the network actually learned. Applies to every group below.">
                        Decoding Mode
                        <select class="train-brainrow-select" value="@_decisionDecoding"
                                @onchange="OnDecisionDecodingKindChanged" disabled="@Service.IsRunning">
                            <option value="Softmax">Softmax (stochastic)</option>
                            <option value="HardMax">HardMax (argmax)</option>
                        </select>
                    </label>
                </div>
                <div class="train-buildbrain-card-fields train-buildbrain-card-fields-end">
                    <label class="train-brainrow-field"
                           title="@($"Softmax over the {DirectionCount} enabled direction(s): {string.Join(" / ", EnabledDirectionLabels)}")">
                        Direction
                        <span class="train-decoding-value">@DirectionCount-way @DecodingLabel</span>
                    </label>
                    @if (_includeVolumeOutput)
                    {
                        <label class="train-brainrow-field"
                               title="Softmax over 4 capital-fraction levels: 25% / 50% / 75% / 100%">
                            Volume
                            <span class="train-decoding-value">@VolumeOutputWidth-way @DecodingLabel</span>
                        </label>
                    }
                    @if (_includeStopLossOutput)
                    {
                        <label class="train-brainrow-field"
                               title="Softmax over 4 stop-loss distances: None / Tight / Medium / Wide">
                            Stop Loss
                            <span class="train-decoding-value">@StopLossOutputWidth-way @DecodingLabel</span>
                        </label>
                    }
                    @if (_includeTakeProfitOutput)
                    {
                        <label class="train-brainrow-field"
                               title="Softmax over 4 take-profit distances: None / Tight / Medium / Wide">
                            Take Profit
                            <span class="train-decoding-value">@TakeProfitOutputWidth-way @DecodingLabel</span>
                        </label>
                    }
                </div>
            </div>
        </div>

        <button class="terminal-btn-action" @onclick="CreateBrain"
                disabled="@(Service.IsRunning || !CanCreateBrain)"
                title="Builds and registers this brain -- pick it from Brain Type above to train it">
            CREATE BRAIN
        </button>
        @if (_buildBrainStatus is not null)
        {
            <span class="train-brainrow-error">@_buildBrainStatus</span>
        }
    </div>
}
