@namespace Poink.Sim.Components.Training
@using Poink.Sim.Brain.Neural
@using Poink.Sim.Components.Charts
@using Poink.Sim.Components.Shared.ConfirmDialog

@if (_showDeleteConfirm)
{
    <ConfirmDialog Title="Delete Brain"
                   Message="@($"Delete '{BrainName}'? This permanently removes its saved network config and cannot be undone.")"
                   ConfirmLabel="YES, DELETE" CancelLabel="CANCEL"
                   OnConfirm="ConfirmDeleteBrain" OnCancel="CancelDeleteBrain" />
}

<div class="train-card">
    <div class="train-card-title-row">
        <div class="train-card-title"
             title="Which brain (neural network) this run trains and plays back, the strategy that trains it, and the reward policy it optimizes against -- heuristic brains have no trainable weights, so they never appear here">
            Brain Config</div>
        <BrainSelect BrainOptions="TrainableBrainOptions" BrainName="@BrainName" BrainNameChanged="OnBrainNameChanged"
                     Disabled="Service.IsRunning" />
        <span class="train-card-title-actions">
            <button type="button" class="train-btn-toggle" @onclick="StartNewBrain" disabled="@Service.IsRunning"
                    title="Start building a brand-new brain from scratch -- resets the panel below to defaults with Auto Name on">
                + NEW BRAIN
            </button>
            <button type="button" class="train-btn-toggle" @onclick="ModifyCurrentBrain"
                    disabled="@(Service.IsRunning || !BrainNameIsPersisted)"
                    title="Load the brain selected above into the panel below for editing">
                MODIFY
            </button>
            <button type="button" class="train-btn-toggle train-btn-toggle-warn" @onclick="RequestDeleteBrain"
                    disabled="@(Service.IsRunning || !BrainNameIsPersisted)"
                    title="Delete the brain selected above -- removes its saved network config; cannot be undone">
                DELETE BRAIN
            </button>
            @if (_showBuildPanel)
            {
                <button type="button" class="train-btn-toggle" @onclick="() => _showBuildPanel = false"
                        disabled="@Service.IsRunning" title="Collapse the panel below -- keeps your in-progress edits">
                    - HIDE
                </button>
            }
        </span>
    </div>
    @if (_deleteStatus is not null)
    {
        <span class="train-brainrow-error">@_deleteStatus</span>
    }

        @if (_showBuildPanel)
        {
            <div class="train-buildbrain">
                <div class="train-card-fields-row train-buildbrain-name-row">
                    <label class="train-brainrow-field train-brainrow-field-grow"
                           title="Name for this config -- matching an existing brain's name edits it in place (Save Brain updates it, Start Training shadows it live until saved); any other name is a new brain">
                        Name
                        <input class="train-brainrow-input train-brainrow-input-full" type="text"
                               value="@EffectiveBuildBrainName" @oninput="OnBuildBrainNameInput"
                               disabled="@(Service.IsRunning || _buildBrainNameAuto)" placeholder="e.g. lstm-vp-experiment" />
                    </label>
                    @if (IsModifiedFromSaved)
                    {
                        <span class="train-card-badge train-card-badge-warn"
                              title="This name matches a saved brain, but the config below no longer matches what's saved -- Save Brain commits these changes; Set applies them live without saving">
                            MODIFIED</span>
                    }
                    <label class="train-brainrow-field"
                           title="Auto-generate the name from architecture, layers, and selected data -- uncheck to type your own">
                        <input type="checkbox" checked="@_buildBrainNameAuto" @onchange="OnToggleAutoBuildBrainName"
                               disabled="@Service.IsRunning" /> Auto Name
                    </label>
                    <button type="button" class="train-btn-toggle" @onclick="SetConfig"
                            disabled="@(Service.IsRunning || !CanCreateBrain || !IsDraft)"
                            title="Applies the current config live now, without saving -- lets Training Preview below show it before you start a run">
                        SET
                    </button>
                    <button type="button" class="train-btn-toggle" @onclick="SaveBrain"
                            disabled="@(Service.IsRunning || !CanCreateBrain || !IsDraft)"
                            title="Commits the current config to storage under its name -- updates it in place if that name's already saved, and selects it above as the brain in use">
                        SAVE BRAIN
                    </button>
                </div>
                @if (_buildBrainStatus is not null)
                {
                    <span class="train-brainrow-error">@_buildBrainStatus</span>
                }

                <div class="train-buildbrain-tabs">
                    <button type="button" class="train-buildbrain-tab @(_activeBuildTab == BrainBuilderTab.Learning ? "active" : "")"
                            @onclick="() => _activeBuildTab = BrainBuilderTab.Learning" title="Strategy, reward policy, and learning rate">
                        LEARNING
                    </button>
                    <button type="button" class="train-buildbrain-tab @(_activeBuildTab == BrainBuilderTab.Inputs ? "active" : "")"
                            @onclick="() => _activeBuildTab = BrainBuilderTab.Inputs"
                            title="Time-series inputs, trader state, and XGrid signals fed into the network">
                        INPUTS
                    </button>
                    <button type="button" class="train-buildbrain-tab @(_activeBuildTab == BrainBuilderTab.DecisionMasking ? "active" : "")"
                            @onclick="() => _activeBuildTab = BrainBuilderTab.DecisionMasking"
                            title="Gates whether this brain's network is even asked to decide">
                        DECISION MASKING
                    </button>
                    <button type="button" class="train-buildbrain-tab @(_activeBuildTab == BrainBuilderTab.Structure ? "active" : "")"
                            @onclick="() => _activeBuildTab = BrainBuilderTab.Structure"
                            title="Network shape applied to the inputs selected on the Inputs tab">
                        STRUCTURE
                    </button>
                    <button type="button" class="train-buildbrain-tab @(_activeBuildTab == BrainBuilderTab.Actions ? "active" : "")"
                            @onclick="() => _activeBuildTab = BrainBuilderTab.Actions"
                            title="Which decisions this brain's network is allowed to make">
                        ACTIONS
                    </button>
                    <button type="button" class="train-buildbrain-tab @(_activeBuildTab == BrainBuilderTab.ActionMasking ? "active" : "")"
                            @onclick="() => _activeBuildTab = BrainBuilderTab.ActionMasking"
                            title="Hard legality rules enforced on the network's raw logits before Softmax">
                        ACTION MASKING
                    </button>
                    <button type="button" class="train-buildbrain-tab @(_activeBuildTab == BrainBuilderTab.ActionDecoding ? "active" : "")"
                            @onclick="() => _activeBuildTab = BrainBuilderTab.ActionDecoding"
                            title="How the network's raw output logits become each enabled decision">
                        ACTION DECODING
                    </button>
                </div>

                <div class="train-buildbrain-cards">
                    @if (_activeBuildTab == BrainBuilderTab.Learning)
                    {
                        <div class="train-card-fields-row">
                            <label class="train-brainrow-field">
                                Strategy
                                <select class="train-brainrow-select" value="@StrategyName" @onchange="OnStrategyChanged"
                                        disabled="@Service.IsRunning">
                                    @foreach (var name in Service.StrategyNames)
                                    {
                                        <option value="@name">@name</option>
                                    }
                                </select>
                            </label>
                            <label class="train-brainrow-field"
                                   title="Which rules shape the per-decision reward -- Equity Drift is the raw, unshaped baseline; Trading Rules adds loss-aversion, an anti-churn entry cost, and a max-holding-time penalty on top of it">
                                Reward Policy
                                <select class="train-brainrow-select" value="@RewardPolicyService.SelectedPolicyName" @onchange="OnRewardPolicyChanged"
                                        disabled="@Service.IsRunning">
                                    @foreach (var name in RewardPolicyService.PolicyNames)
                                    {
                                        <option value="@name">@name</option>
                                    }
                                </select>
                            </label>
                            <label class="train-brainrow-field">
                                Learning rate
                                <input class="train-brainrow-input" type="number" min="0.00001" step="0.0001"
                                       value="@LearningRate.ToString(System.Globalization.CultureInfo.InvariantCulture)"
                                       @onchange="OnLearningRateChanged" disabled="@Service.IsRunning" />
                            </label>
                        </div>
                    }
                    else if (_activeBuildTab == BrainBuilderTab.Inputs)
                    {
                    <div class="train-buildbrain-input-stack">
                        <div class="train-card">
                            <div class="train-card-title-row">
                                <div class="train-card-title"
                                     title="Trailing-history market data sets -- Bar Window, Volume Profile, Time Profile, Session Clock, and Spread + Volatility">
                                    Time Series Inputs</div>
                                @if (!_timeSeriesInputsHidden)
                                {
                                    <span class="train-card-badge" title="Combined input count from every included set below">
                                        @TimeSeriesInputsFeatureCount</span>
                                }
                                <span class="train-card-title-actions">
                                    <button type="button" class="train-btn-toggle" @onclick="() => _timeSeriesInputsHidden = !_timeSeriesInputsHidden"
                                            disabled="@Service.IsRunning" title="Collapse/expand this whole group of input sets">
                                        @(_timeSeriesInputsHidden ? "+ SHOW" : "- HIDE")
                                    </button>
                                </span>
                            </div>
                            @if (!_timeSeriesInputsHidden)
                            {
                                <div class="train-timeseries-groups">
                                    <div class="train-timeseries-set">
                                        <label class="train-brainrow-field" title="Trailing bar price window">
                                            <input type="checkbox" @bind="_includeBarWindow" disabled="@Service.IsRunning" />
                                            Bar Window
                                        </label>
                                        <div class="train-card-fields-row">
                                            <label class="train-brainrow-field"
                                                   title="Normalized feeds percent-change-from-current-price; Raw feeds the literal price; Local/Global Z-Score feed each bar's z-score against a sub-window's/the whole window's own mean and standard deviation instead; Binary feeds 1 if a bar's price is higher than the one before it, 0 if lower or equal">
                                                Normalization
                                                <select class="train-brainrow-select" value="@_barWindowNormalization"
                                                        @onchange="OnBarWindowNormalizationChanged" disabled="@(Service.IsRunning || !_includeBarWindow)">
                                                    <option value="Normalized">Normalized</option>
                                                    <option value="Raw">Raw</option>
                                                    <option value="LocalZScore">Local Z-Score</option>
                                                    <option value="GlobalZScore">Global Z-Score</option>
                                                    <option value="Binary">Binary</option>
                                                </select>
                                            </label>
                                            <label class="train-brainrow-field" title="How many trailing bars Bar Window feeds the network -- also its input count, 1 input per bar">
                                                Window
                                                <input class="train-brainrow-input" type="number" min="1" step="1"
                                                       @bind="_barWindowSize" disabled="@(Service.IsRunning || !_includeBarWindow)" />
                                            </label>
                                            @if (_barWindowNormalization == NormalizationKind.LocalZScore)
                                            {
                                                <label class="train-brainrow-field" title="How many trailing bars each independently-normalized Local Z-Score sub-window covers">
                                                    Z Sub-Window
                                                    <input class="train-brainrow-input" type="number" min="1" step="1"
                                                           @bind="_barWindowZScoreSubWindowSize" disabled="@(Service.IsRunning || !_includeBarWindow)" />
                                                </label>
                                            }
                                            @if (_includeBarWindow)
                                            {
                                                <span class="train-card-badge" title="Input count contributed by Bar Window -- 1 input per bar">@BarWindowFeatureCount</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="train-timeseries-set">
                                        <label class="train-brainrow-field"
                                               title="Volume histogram + point-of-control/value-area summary, merged from its Window's trailing bars">
                                            <input type="checkbox" @bind="_includeVolumeProfile" disabled="@Service.IsRunning" />
                                            Volume Profile
                                        </label>
                                        <div class="train-card-fields-row">
                                            <label class="train-brainrow-field"
                                                   title="Normalized feeds a fraction-of-total/percent-offset from current price; Raw feeds exact tick counts and exact price levels; Local/Global Z-Score feed each bucket's volume as a z-score against a sub-window's/the whole profile's own mean and standard deviation instead; Binary feeds 1 if a bucket's volume is higher than the bucket before it, 0 if lower or equal">
                                                Normalization
                                                <select class="train-brainrow-select" value="@_volumeProfileNormalization"
                                                        @onchange="OnVolumeProfileNormalizationChanged" disabled="@(Service.IsRunning || !_includeVolumeProfile)">
                                                    <option value="Normalized">Normalized</option>
                                                    <option value="Raw">Raw</option>
                                                    <option value="LocalZScore">Local Z-Score</option>
                                                    <option value="GlobalZScore">Global Z-Score</option>
                                                    <option value="Binary">Binary</option>
                                                </select>
                                            </label>
                                            <label class="train-brainrow-field" title="How many trailing bars Volume Profile merges into one profile each decision">
                                                Lookback
                                                <input class="train-brainrow-input" type="number" min="1" step="1"
                                                       @bind="_volumeProfileLookbackBars" disabled="@(Service.IsRunning || !_includeVolumeProfile)" />
                                            </label>
                                            <label class="train-brainrow-field" title="@VolumeProfileBucketsTooltip">
                                                Bucket
                                                <input class="train-brainrow-input" type="number" min="1" step="1"
                                                       @bind="_volumeProfileBucketCount" disabled="@(Service.IsRunning || !_includeVolumeProfile)" />
                                            </label>
                                            @if (_volumeProfileNormalization == NormalizationKind.LocalZScore)
                                            {
                                                <label class="train-brainrow-field" title="How many buckets each independently-normalized Local Z-Score sub-window covers">
                                                    Z Sub-Window
                                                    <input class="train-brainrow-input" type="number" min="1" step="1"
                                                           @bind="_volumeProfileZScoreSubWindowSize" disabled="@(Service.IsRunning || !_includeVolumeProfile)" />
                                                </label>
                                            }
                                            <label class="train-brainrow-field"
                                                   title="Split each bucket's volume into up-tick/down-tick totals plus their diff, instead of one plain total -- mirrors the Volume Profile chart's own Split up/down toggle">
                                                <input type="checkbox" @bind="_volumeProfileSplitUpDown" disabled="@(Service.IsRunning || !_includeVolumeProfile)" />
                                                Split Up/Down
                                            </label>
                                            @if (_includeVolumeProfile)
                                            {
                                                <span class="train-card-badge" title="Input count contributed by Volume Profile">@VolumeProfileFeatureCount</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="train-timeseries-set">
                                        <label class="train-brainrow-field"
                                               title="Time-weighted histogram + point-of-control/value-area summary (seconds spent at each price level), merged from its Window's trailing bars">
                                            <input type="checkbox" @bind="_includeTimeProfile" disabled="@Service.IsRunning" />
                                            Time Profile
                                        </label>
                                        <div class="train-card-fields-row">
                                            <label class="train-brainrow-field"
                                                   title="Normalized feeds a fraction-of-total/percent-offset from current price; Raw feeds exact seconds spent and exact price levels instead">
                                                Normalization
                                                <select class="train-brainrow-select" value="@_timeProfileNormalization"
                                                        @onchange="OnTimeProfileNormalizationChanged" disabled="@(Service.IsRunning || !_includeTimeProfile)">
                                                    <option value="Normalized">Normalized</option>
                                                    <option value="Raw">Raw</option>
                                                </select>
                                            </label>
                                            <label class="train-brainrow-field" title="How many trailing bars Time Profile merges into one profile each decision">
                                                Lookback
                                                <input class="train-brainrow-input" type="number" min="1" step="1"
                                                       @bind="_timeProfileLookbackBars" disabled="@(Service.IsRunning || !_includeTimeProfile)" />
                                            </label>
                                            <label class="train-brainrow-field" title="@TimeProfileBucketsTooltip">
                                                Bucket
                                                <input class="train-brainrow-input" type="number" min="1" step="1"
                                                       @bind="_timeProfileBucketCount" disabled="@(Service.IsRunning || !_includeTimeProfile)" />
                                            </label>
                                            <label class="train-brainrow-field"
                                                   title="Split each bucket's seconds into up-tick/down-tick totals plus their diff, instead of one plain total -- mirrors the Volume Profile chart's own Split up/down toggle">
                                                <input type="checkbox" @bind="_timeProfileSplitUpDown" disabled="@(Service.IsRunning || !_includeTimeProfile)" />
                                                Split Up/Down
                                            </label>
                                            @if (_includeTimeProfile)
                                            {
                                                <span class="train-card-badge" title="Input count contributed by Time Profile">@TimeProfileFeatureCount</span>
                                            }
                                        </div>
                                    </div>

                                    <div class="train-timeseries-set">
                                        <label class="train-brainrow-field"
                                               title="Time-of-day and day-of-week as sin/cos pairs -- captures recurring FX session structure (Sydney/Tokyo/London/New York open-close, weekend closure)">
                                            <input type="checkbox" @bind="_includeSessionClock" disabled="@Service.IsRunning" />
                                            Session Clock
                                        </label>
                                        @if (_includeSessionClock)
                                        {
                                            <span class="train-card-badge" title="Input count contributed by Session Clock -- fixed 4 values, no configuration">
                                                @SessionClockFeatureCount</span>
                                        }
                                    </div>

                                    <div class="train-timeseries-set">
                                        <label class="train-brainrow-field"
                                               title="Current Bid/Ask spread plus a short trailing Average True Range -- how expensive trading is right now, and how much price is actually moving">
                                            <input type="checkbox" @bind="_includeSpreadVolatility" disabled="@Service.IsRunning" />
                                            Spread + Volatility
                                        </label>
                                        <div class="train-card-fields-row">
                                            <label class="train-brainrow-field" title="How many trailing bars the Average True Range figure averages over">
                                                ATR Period
                                                <input class="train-brainrow-input" type="number" min="1" step="1"
                                                       @bind="_spreadVolatilityAtrPeriod" disabled="@(Service.IsRunning || !_includeSpreadVolatility)" />
                                            </label>
                                            @if (_includeSpreadVolatility)
                                            {
                                                <span class="train-card-badge" title="Input count contributed by Spread + Volatility -- fixed 2 values (spread, ATR)">@SpreadVolatilityFeatureCount</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>

                        <div class="train-card">
                            <div class="train-card-title-row">
                                <label class="train-brainrow-field"
                                       title="Own position/capital state -- opt-in, unchecked by default; check it if this brain needs to know whether it already holds a position">
                                    <input type="checkbox" @bind="_includeTraderState" disabled="@Service.IsRunning" />
                                    <span class="train-card-title">Trader State</span>
                                </label>
                                <span class="train-card-badge" title="Input count contributed by Trader State -- the enabled state fields plus the enabled trailing lists below">
                                    @TraderStateFeatureCount</span>
                            </div>
                            <div class="train-buildbrain-card-fields">
                                <label class="train-brainrow-field" title="Toggle every state field below on or off at once">
                                    <input type="checkbox" @bind="AllTraderStateBaseFieldsSelected" disabled="@(Service.IsRunning || !_includeTraderState)" />
                                    Select All Fields (@SelectedTraderStateFieldCount/@TotalTraderStateFieldCount)
                                </label>
                                <div class="train-card-fields-row">
                                    @foreach (var row in TraderStateFieldRows)
                                    {
                                        <label class="train-brainrow-field" title="@row.Tooltip">
                                            <input type="checkbox" checked="@row.Get()"
                                                   @onchange="e => row.Set(e.Value is bool b && b)"
                                                   disabled="@(Service.IsRunning || !_includeTraderState)" />
                                            @row.Label
                                        </label>
                                    }
                                </div>
                                <label class="train-brainrow-field" title="Toggle every trailing list below on or off at once">
                                    <input type="checkbox" @bind="AllTraderStateListsSelected" disabled="@(Service.IsRunning || !_includeTraderState)" />
                                    Select All Lists
                                </label>
                                <div class="train-card-fields-row">
                                    <label class="train-brainrow-field"
                                           title="How many of the most recent closed trades' win(1)/loss(0) outcome Trader State feeds, most-recent-last, zero-padded if fewer trades have closed yet">
                                        <input type="checkbox" @bind="_includeTraderStateOutcomes" disabled="@(Service.IsRunning || !_includeTraderState)" />
                                        Outcomes
                                        <input class="train-brainrow-input" type="number" min="1" step="1" @bind="_traderStateTradeOutcomeListLength"
                                               disabled="@(Service.IsRunning || !_includeTraderState || !_includeTraderStateOutcomes)" />
                                    </label>
                                    <label class="train-brainrow-field"
                                           title="How many trailing price records since the open position's own entry time Trader State compares against entry price (1 above, 0 at-or-below), most-recent-last, zero-padded -- flat (no position) leaves this list zero-padded regardless">
                                        <input type="checkbox" @bind="_includeTraderStatePositionLevel" disabled="@(Service.IsRunning || !_includeTraderState)" />
                                        Level
                                        <input class="train-brainrow-input" type="number" min="1" step="1" @bind="_traderStatePositionLevelListLength"
                                               disabled="@(Service.IsRunning || !_includeTraderState || !_includeTraderStatePositionLevel)" />
                                    </label>
                                    <label class="train-brainrow-field"
                                           title="How many of the most recent closed trades' direction (1=Long, 0=Short) Trader State feeds, index-aligned with Outcomes">
                                        <input type="checkbox" @bind="_includeTraderStateDirection" disabled="@(Service.IsRunning || !_includeTraderState)" />
                                        Direction
                                        <input class="train-brainrow-input" type="number" min="1" step="1" @bind="_traderStateDirectionListLength"
                                               disabled="@(Service.IsRunning || !_includeTraderState || !_includeTraderStateDirection)" />
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="train-card train-card-xgrid">
                                                                <div class="train-card-title-row">
                                                                    <div class="train-card-title"
                                                                         title="XGrid's boolean footprint signals -- current cell's rank/at/above/below relationship to POC/VAH/VAL/VWAP, computed over a trailing window of bars">
                                                                        XGrid Signals</div>
                                                                    <span class="train-card-badge"
                                                                          title="How many of the available XGrid signals are enabled">
                                                                        @SelectedXGridSignalCount/@TotalXGridSignalCount</span>
                                                                </div>
                                                                <div class="train-buildbrain-card-fields">
                                                                    <label class="train-brainrow-field" title="Toggle every XGrid signal below on or off at once">
                                                                        <input type="checkbox" @bind="AllXGridSignalsSelected" disabled="@Service.IsRunning" />
                                                                        Select All
                                                                    </label>
                                                                    <div class="train-card-fields-row">
                                                                        <label class="train-brainrow-field"
                                                                               title="Percent threshold for the Rank signals -- current cell counts as 'top %' when its tick count ranks in this top percent of every nonzero cell on the grid">
                                                                            %
                                                                            <input class="train-brainrow-input" type="number" min="0" max="100" step="1"
                                                                                   @bind="_xgridTopPercent" disabled="@(Service.IsRunning || !AnyXGridSignalSelected)" />
                                                                        </label>
                                                                        <label class="train-brainrow-field"
                                                                               title="How many columns (time buckets) XGrid's footprint grid is divided into over its trailing Window">
                                                                            Col
                                                                            <input class="train-brainrow-input" type="number" min="1" step="1"
                                                                                   @bind="_xgridColCount" disabled="@(Service.IsRunning || !AnyXGridSignalSelected)" />
                                                                        </label>
                                                                        <label class="train-brainrow-field"
                                                                               title="Row height in pips -- multiplied by Pip below for each row's fixed price height. Rows snap to an absolute price grid, so how many of them XGrid's footprint grid needs is derived from the price range rather than fixed">
                                                                            Row
                                                                            <input class="train-brainrow-input" type="number" min="1" step="1"
                                                                                   @bind="_xgridRowCount" disabled="@(Service.IsRunning || !AnyXGridSignalSelected)" />
                                                                        </label>
                                                                        <label class="train-brainrow-field"
                                                                               title="Price size of one pip -- row height = Row x Pip">
                                                                            Pip
                                                                            <input class="train-brainrow-input" type="number" min="0.00001" step="0.001"
                                                                                   @bind="_xgridPipSize" disabled="@(Service.IsRunning || !AnyXGridSignalSelected)" />
                                                                        </label>
                                                                        <label class="train-brainrow-field"
                                                                               title="How many trailing bars XGrid computes its footprint grid over each decision">
                                                                            Window
                                                                            <input class="train-brainrow-input" type="number" min="1" step="1"
                                                                                   @bind="_xgridWindowBars" disabled="@(Service.IsRunning || !AnyXGridSignalSelected)" />
                                                                        </label>
                                                                    </div>
                                                                    <XGridSignalInputTable @bind-EnabledKeys="_xgridEnabledSignals"
                                                                                            Mode="XGridSignalInputMode.Independent" Disabled="Service.IsRunning" />
                                                                </div>
                                                            </div>
                                                            </div>
                    }
                    else if (_activeBuildTab == BrainBuilderTab.DecisionMasking)
                    {
                                                            <div class="train-card">
                                                                <div class="train-card-title-row">
                                                                    <div class="train-card-title"
                                                                         title="Gates whether this brain's network is even asked to decide -- opposite of Action Masking, which restricts choices after the network has already decided. With any rule below enabled, an episode's bar/tick count no longer equals its decision count">
                                                                        Decision Masking</div>
                                                                        <span class="train-card-badge"
                                                                              title="How many of the @TotalDecisionMaskRuleCount available decision-gating rules are enabled">
                                                                            @SelectedDecisionMaskRuleCount/@TotalDecisionMaskRuleCount</span>
                                                                        </div>
                                                                        <div class="train-buildbrain-card-fields">
                                                                            <label class="train-brainrow-field"
                                                                                   title="How often the rules below get checked -- a decision only ever fires on a resolution tick, and only when every enabled rule also passes">
                                                                                Resolution
                                                                                <select class="train-brainrow-select" @bind="_decisionMaskResolution" disabled="@Service.IsRunning">
                                                                                    <option value="@DecisionMaskResolutionKind.PerBar">Once per bar</option>
                                                                                    <option value="@DecisionMaskResolutionKind.EverySeconds">Every X seconds</option>
                                                                                    <option value="@DecisionMaskResolutionKind.PerTick">Every tick</option>
                                                                                    <option value="@DecisionMaskResolutionKind.OnCellWidthChange">On cell width change</option>
                                                                                </select>
                                                                            </label>
                                                                            @if (_decisionMaskResolution == DecisionMaskResolutionKind.EverySeconds)
                                                                            {
                                                                                <label class="train-brainrow-field" title="How many seconds must pass between resolution checks">
                                                                                    Seconds
                                                                                    <input class="train-brainrow-input" type="number" min="0.001" step="1"
                                                                                           @bind="_decisionMaskResolutionSeconds" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                            }
                                                                            @if (_decisionMaskResolution == DecisionMaskResolutionKind.OnCellWidthChange)
                                                                            {
                                                                                <label class="train-brainrow-field"
                                                                                       title="Fixed price width of each cell -- a resolution check fires when price crosses from one cell into the next">
                                                                                    Cell width
                                                                                    <input class="train-brainrow-input" type="number" min="0.00001" step="0.01"
                                                                                           @bind="_decisionMaskResolutionCellWidth" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                            }
                                                                        </div>
                                                                        <div class="train-buildbrain-card-fields">
                                                                            <label class="train-brainrow-field" title="Toggle every decision-gating rule below on or off at once">
                                                                                <input type="checkbox" @bind="AllDecisionMaskRulesSelected" disabled="@Service.IsRunning" />
                                                                                Select All
                                                                            </label>
                                                                            @foreach (var row in DecisionMaskRuleRows)
                                                                            {
                                                                                <label class="train-brainrow-field" title="@row.Tooltip">
                                                                                    <input type="checkbox" checked="@row.Get()"
                                                                                           @onchange="e => row.Set(e.Value is bool b && b)"
                                                                                           disabled="@Service.IsRunning" />
                                                                                    @row.Label
                                                                                </label>
                                                                            }
                                                                        </div>
                                                                    </div>
                    }
                    else if (_activeBuildTab == BrainBuilderTab.Structure)
                    {
                                                            <div class="train-card">
                                                                <div class="train-card-title-row">
                                                                    <div class="train-card-title" title="Network shape applied to the inputs selected on the left">
                                                                        Structure</div>
                                                                        @if (FirstLayerTooSmall)
                                                                        {
                                                                            <span class="train-card-badge train-card-badge-warn"
                                                                                  title="@($"First hidden layer ({FirstHiddenLayerSize}) is narrower than the network's {TotalInputCount} inputs -- a bottleneck compressing them before any transformation")">
                                                                                &#9888; @FirstHiddenLayerSize &lt; @TotalInputCount</span>
                                                                            }
                                                                        </div>
                                                                        <div class="train-buildbrain-card-fields">
                                                                            <label class="train-brainrow-field"
                                                                                   title="Network shape applied to the combined features selected above">
                                                                                Architecture
                                                                                <select class="train-brainrow-select" value="@_architectureKind"
                                                                                        @onchange="OnArchitectureKindChanged" disabled="@Service.IsRunning">
                                                                                    <option value="Mlp">MLP</option>
                                                                                    <option value="Lstm">LSTM</option>
                                                                                    <option value="Cnn">CNN</option>
                                                                                    <option value="Neat">NEAT</option>
                                                                                </select>
                                                                            </label>
                                                                            @if (_architectureKind == ArchitectureKind.Mlp)
                                                                            {
                                                                                <div class="train-hiddenlayers">
                                                                                    <button type="button" class="train-btn-toggle" @onclick="AddHiddenLayerOnTop"
                                                                                            disabled="@Service.IsRunning"
                                                                                            title="Add another hidden layer, inserted above layer 1 -- defaults to double layer 1's size">
                                                                                        + ADD LAYER
                                                                                    </button>
                                                                                    @for (int i = 0; i < _mlpHiddenSizes.Count; i++)
                                                                                    {
                                                                                        var index = i;
                                                                                        <label class="train-brainrow-field" title="@($"Size of hidden layer {index + 1}")">
                                                                                            Layer @(index + 1)
                                                                                            <span class="train-hiddenlayer-controls">
                                                                                                <input class="train-brainrow-input train-brainrow-input-right" type="number" min="1"
                                                                                                       step="1" value="@_mlpHiddenSizes[index]"
                                                                                                       @oninput="e => OnHiddenLayerSizeChanged(index, e)" disabled="@Service.IsRunning" />
                                                                                                <button type="button" class="train-btn-remove-layer"
                                                                                                        @onclick="() => RemoveHiddenLayer(index)"
                                                                                                        disabled="@(Service.IsRunning || !CanRemoveHiddenLayer)"
                                                                                                        title="@(CanRemoveHiddenLayer ? "Remove this layer" : "At least one hidden layer is required")">
                                                                                                    &#215;
                                                                                                </button>
                                                                                            </span>
                                                                                        </label>
                                                                                    }
                                                                                    <button type="button" class="train-btn-toggle" @onclick="AddHiddenLayer"
                                                                                            disabled="@Service.IsRunning"
                                                                                            title="Add another hidden layer, stacked after the ones above -- defaults to half the last layer's size">
                                                                                        + ADD LAYER
                                                                                    </button>
                                                                                </div>
                                                                            }
                                                                            else if (_architectureKind == ArchitectureKind.Lstm)
                                                                            {
                                                                                <label class="train-brainrow-field" title="LSTM hidden state size">
                                                                                    Hidden size
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="1"
                                                                                           @bind="_lstmHiddenSize" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                <label class="train-brainrow-field" title="Number of stacked LSTM layers">
                                                                                    LSTM layers
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="1"
                                                                                           @bind="_lstmNumLayers" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                @if (!_includeBarWindow)
                                                                                {
                                                                                    <span class="train-brainrow-error">LSTM needs Bar Window for its sequence</span>
                                                                                }
                                                                            }
                                                                            else if (_architectureKind == ArchitectureKind.Cnn)
                                                                            {
                                                                                <label class="train-brainrow-field"
                                                                                       title="Which selected input set the convolution kernel actually sweeps over -- Bar Window (default) slides over the trailing price window; Volume Profile instead slides over its price-ordered histogram buckets, with everything else (including Bar Window if also selected) fed as plain scalars alongside the pooled conv output">
                                                                                    Kernel sweeps
                                                                                    <select class="train-brainrow-select" value="@_cnnKernelSweepSource"
                                                                                            @onchange="OnCnnKernelSweepSourceChanged" disabled="@Service.IsRunning">
                                                                                        <option value="BarWindow">Bar Window</option>
                                                                                        <option value="VolumeProfile">Volume Profile</option>
                                                                                    </select>
                                                                                </label>
                                                                                <label class="train-brainrow-field"
                                                                                       title="Convolution kernel width applied to every conv layer -- odd sizes (3, 5, 7, ...) keep the window's time length unchanged through each layer">
                                                                                    Kernel size
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="1" step="2"
                                                                                           @bind="_cnnKernelSize" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                <div class="train-hiddenlayers">
                                                                                    @for (int i = 0; i < _cnnChannels.Count; i++)
                                                                                    {
                                                                                        var index = i;
                                                                                        <label class="train-brainrow-field"
                                                                                               title="@($"Output channel count of conv layer {index + 1}")">
                                                                                            Layer @(index + 1)
                                                                                            <span class="train-hiddenlayer-controls">
                                                                                                <input class="train-brainrow-input train-brainrow-input-right" type="number" min="1"
                                                                                                       step="1" value="@_cnnChannels[index]"
                                                                                                       @oninput="e => OnCnnChannelSizeChanged(index, e)" disabled="@Service.IsRunning" />
                                                                                                <button type="button" class="train-btn-remove-layer"
                                                                                                        @onclick="() => RemoveCnnChannelLayer(index)"
                                                                                                        disabled="@(Service.IsRunning || !CanRemoveCnnChannelLayer)"
                                                                                                        title="@(CanRemoveCnnChannelLayer ? "Remove this layer" : "At least one conv layer is required")">
                                                                                                    &#215;
                                                                                                </button>
                                                                                            </span>
                                                                                        </label>
                                                                                    }
                                                                                    <button type="button" class="train-btn-toggle" @onclick="AddCnnChannelLayer"
                                                                                            disabled="@Service.IsRunning"
                                                                                            title="Add another conv layer, stacked after the ones above -- defaults to double the last layer's channel count">
                                                                                        + ADD LAYER
                                                                                    </button>
                                                                                </div>
                                                                                @if (!CnnSweepSourceIncluded)
                                                                                {
                                                                                    <span class="train-brainrow-error">
                                                                                        CNN needs @(_cnnKernelSweepSource == CnnKernelSweepSource.VolumeProfile ? "Volume Profile" :
                                                                                                         "Bar Window") for its sequence
                                                                                    </span>
                                                                                }
                                                                            }
                                                                            else if (_architectureKind == ArchitectureKind.Neat)
                                                                            {
                                                                                <label class="train-brainrow-field" title="Number of candidate networks (genomes) evaluated per generation -- higher explores more per generation at the cost of one training episode per genome">
                                                                                    Population size
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="1" step="1"
                                                                                           @bind="_neatPopulationSize" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                <label class="train-brainrow-field" title="How similar two genomes must be to share a species -- lower creates more, smaller species; higher creates fewer, broader ones">
                                                                                    Compatibility threshold
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="0" step="0.1"
                                                                                           @bind="_neatCompatibilityThreshold" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                <label class="train-brainrow-field" title="Weight given to excess genes (structural genes beyond the other genome's highest innovation number) when computing compatibility distance">
                                                                                    Excess coefficient
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="0" step="0.1"
                                                                                           @bind="_neatExcessCoefficient" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                <label class="train-brainrow-field" title="Weight given to disjoint genes (structural genes that don't match between two genomes) when computing compatibility distance">
                                                                                    Disjoint coefficient
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="0" step="0.1"
                                                                                           @bind="_neatDisjointCoefficient" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                <label class="train-brainrow-field" title="Weight given to the average connection-weight difference between matching genes when computing compatibility distance">
                                                                                    Weight diff coefficient
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="0" step="0.1"
                                                                                           @bind="_neatWeightDiffCoefficient" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                <label class="train-brainrow-field" title="A species is culled if its best fitness hasn't improved in this many generations">
                                                                                    Stagnation generations
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="1" step="1"
                                                                                           @bind="_neatStagnationGenerations" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                <label class="train-brainrow-field" title="A species at or above this size automatically carries its best genome into the next generation unchanged">
                                                                                    Elitism min species size
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="1" step="1"
                                                                                           @bind="_neatElitismMinSpeciesSize" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                <label class="train-brainrow-field" title="Fraction of each species, ranked by fitness, allowed to breed the next generation">
                                                                                    Survival threshold
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="0" max="1" step="0.01"
                                                                                           @bind="_neatSurvivalThreshold" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                <label class="train-brainrow-field" title="Chance a child's second parent is drawn from a different species instead of its own">
                                                                                    Interspecies mating rate
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="0" max="1" step="0.001"
                                                                                           @bind="_neatInterspeciesMatingRate" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                <label class="train-brainrow-field" title="Chance a child's connection weights are mutated at all">
                                                                                    Weight mutation rate
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="0" max="1" step="0.01"
                                                                                           @bind="_neatWeightMutationRate" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                <label class="train-brainrow-field" title="When weights mutate, the chance a given connection gets a brand new random weight instead of being perturbed">
                                                                                    Weight reset chance
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="0" max="1" step="0.01"
                                                                                           @bind="_neatWeightResetChance" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                <label class="train-brainrow-field" title="Standard deviation of the random nudge applied to a connection weight during perturbation">
                                                                                    Weight perturb std dev
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="0" step="0.01"
                                                                                           @bind="_neatWeightPerturbStdDev" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                <label class="train-brainrow-field" title="Chance a new connection is added between two previously unconnected nodes">
                                                                                    Add connection rate
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="0" max="1" step="0.01"
                                                                                           @bind="_neatAddConnectionMutationRate" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                <label class="train-brainrow-field" title="Chance an existing connection is split by inserting a new node into it">
                                                                                    Add node rate
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="0" max="1" step="0.01"
                                                                                           @bind="_neatAddNodeMutationRate" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                                <label class="train-brainrow-field" title="Chance a gene inherited from crossover, disabled in either parent, stays disabled in the child">
                                                                                    Disable inherited gene chance
                                                                                    <input class="train-brainrow-input train-brainrow-input-right" type="number" min="0" max="1" step="0.01"
                                                                                           @bind="_neatDisableInheritedGeneChance" disabled="@Service.IsRunning" />
                                                                                </label>
                                                                            }
                                                                        </div>
                                                                    </div>
                    }
                    else if (_activeBuildTab == BrainBuilderTab.Actions)
                    {
                                                                    <div class="train-card">
                                                                        <div class="train-card-title-row">
                                                                            <div class="train-card-title"
                                                                                 title="Which decisions this brain's network is allowed to make -- every one below is optional">
                                                                                Actions</div>
                                                                                <span class="train-card-badge"
                                                                                      title="How many of the @TotalActionOptionCount available action decisions are enabled">
                                                                                    @SelectedActionCount/@TotalActionOptionCount</span>
                                                                                </div>
                                                                                <div class="train-buildbrain-card-fields">
                                                                                    <label class="train-brainrow-field" title="Toggle every action decision below on or off at once">
                                                                                        <input type="checkbox" @bind="AllActionsSelected" disabled="@Service.IsRunning" />
                                                                                        Select All
                                                                                    </label>
                                                                                    <label class="train-brainrow-field" title="Network can choose to do nothing this tick">
                                                                                        <input type="checkbox" @bind="_includeHold" disabled="@Service.IsRunning" /> Hold
                                                                                    </label>
                                                                                    <label class="train-brainrow-field" title="Network can open a long position">
                                                                                        <input type="checkbox" @bind="_includeEnterLong" disabled="@Service.IsRunning" />
                                                                                        Enter Long
                                                                                    </label>
                                                                                    <label class="train-brainrow-field" title="Network can open a short position">
                                                                                        <input type="checkbox" @bind="_includeEnterShort" disabled="@Service.IsRunning" />
                                                                                        Enter Short
                                                                                    </label>
                                                                                    <label class="train-brainrow-field"
                                                                                           title="Network can close an open position (or cancel a resting order)">
                                                                                        <input type="checkbox" @bind="_includeClose" disabled="@Service.IsRunning" /> Close
                                                                                    </label>
                                                                                    <label class="train-brainrow-field"
                                                                                           title="Network picks position size (25/50/75/100% of cash) for each entry, instead of a fixed 50%">
                                                                                        <input type="checkbox" @bind="_includeVolumeOutput" disabled="@Service.IsRunning" />
                                                                                        Volume
                                                                                    </label>
                                                                                    <label class="train-brainrow-field"
                                                                                           title="Network picks a stop-loss distance (or none) for each entry">
                                                                                        <input type="checkbox" @bind="_includeStopLossOutput" disabled="@Service.IsRunning" /> Stop Loss
                                                                                    </label>
                                                                                    <label class="train-brainrow-field"
                                                                                           title="Network picks a take-profit distance (or none) for each entry">
                                                                                        <input type="checkbox" @bind="_includeTakeProfitOutput" disabled="@Service.IsRunning" /> Take
                                                                                        Profit
                                                                                    </label>
                                                                                </div>
                                                                            </div>
                    }
                    else if (_activeBuildTab == BrainBuilderTab.ActionMasking)
                    {
                                                                            <div class="train-card">
                                                                                <div class="train-card-title-row">
                                                                                    <div class="train-card-title"
                                                                                         title="Hard legality rules enforced on the network's raw logits before Softmax -- an illegal action gets exactly 0% probability, guaranteed, rather than being left for the network to learn to avoid">
                                                                                        Action Masking</div>
                                                                                        <span class="train-card-badge"
                                                                                              title="How many of the @TotalMaskRuleCount available masking rules are enabled">
                                                                                            @SelectedMaskRuleCount/@TotalMaskRuleCount</span>
                                                                                        </div>
                                                                                        <div class="train-buildbrain-card-fields">
                                                                                            <label class="train-brainrow-field" title="Toggle every masking rule below on or off at once">
                                                                                                <input type="checkbox" @bind="AllMaskRulesSelected" disabled="@Service.IsRunning" />
                                                                                                Select All
                                                                                            </label>
                                                                                            @foreach (var row in MaskRuleRows)
                                                                                            {
                                                                                                <label class="train-brainrow-field" title="@row.Tooltip">
                                                                                                    <input type="checkbox" checked="@row.Get()"
                                                                                                           @onchange="e => row.Set(e.Value is bool b && b)"
                                                                                                           disabled="@Service.IsRunning" />
                                                                                                    @row.Label
                                                                                                </label>
                                                                                            }
                                                                                        </div>
                                                                                    </div>
                    }
                    else if (_activeBuildTab == BrainBuilderTab.ActionDecoding)
                    {
                                                                            <div class="train-card">
                                                                                <div class="train-card-title-row">
                                                                                    <div class="train-card-title"
                                                                                         title="How the network's raw output logits become each enabled decision above -- every group below is decoded independently via its own softmax distribution, not one joint choice across all of them">
                                                                                        Action Decoding</div>
                                                                                        <span class="train-card-badge"
                                                                                              title="Total network output width: every enabled group's softmax width, summed">
                                                                                            @TotalOutputWidth</span>
                                                                                        </div>
                                                                                        <div class="train-buildbrain-card-fields">
                                                                                            <label class="train-brainrow-field"
                                                                                                   title="Softmax always samples stochastically, weighted by probability -- what training needs for exploration. HardMax instead always picks the highest-probability choice, deterministically -- for evaluating the policy the network actually learned. Applies to every group below.">
                                                                                                Decoding Mode
                                                                                                <select class="train-brainrow-select" value="@_decisionDecoding"
                                                                                                        @onchange="OnDecisionDecodingKindChanged" disabled="@Service.IsRunning">
                                                                                                    <option value="Softmax">Softmax (stochastic)</option>
                                                                                                    <option value="HardMax">HardMax (argmax)</option>
                                                                                                </select>
                                                                                            </label>
                                                                                            <label class="train-brainrow-field"
                                                                                                   title="Divides each group's raw logits before Softmax -- below 1 sharpens the distribution toward its highest choice (less exploration, closer to HardMax); above 1 flattens it toward uniform (more exploration). 1 is unscaled (today's original behavior). No effect under HardMax, which always takes the highest choice regardless.">
                                                                                                Temperature
                                                                                                <input class="train-brainrow-input" type="number" min="0.01" step="0.1"
                                                                                                       @bind="_decisionTemperature"
                                                                                                       disabled="@(Service.IsRunning || _decisionDecoding == DecisionDecodingKind.HardMax)" />
                                                                                            </label>
                                                                                        </div>
                                                                                        <div class="train-buildbrain-card-fields train-buildbrain-card-fields-end">
                                                                                            <label class="train-brainrow-field"
                                                                                                   title="@($"Softmax over the {DirectionCount} enabled direction(s): {string.Join(" / ", EnabledDirectionLabels)}")">
                                                                                                Direction
                                                                                                <span class="train-decoding-value">@DirectionCount-way @DecodingLabel</span>
                                                                                            </label>
                                                                                            @if (_includeVolumeOutput)
                                                                                            {
                                                                                                <label class="train-brainrow-field"
                                                                                                       title="Softmax over 4 capital-fraction levels: 25% / 50% / 75% / 100%">
                                                                                                    Volume
                                                                                                    <span class="train-decoding-value">@VolumeOutputWidth-way @DecodingLabel</span>
                                                                                                </label>
                                                                                            }
                                                                                            @if (_includeStopLossOutput)
                                                                                            {
                                                                                                <label class="train-brainrow-field"
                                                                                                       title="Softmax over 4 stop-loss distances: None / Tight / Medium / Wide">
                                                                                                    Stop Loss
                                                                                                    <span class="train-decoding-value">@StopLossOutputWidth-way @DecodingLabel</span>
                                                                                                </label>
                                                                                            }
                                                                                            @if (_includeTakeProfitOutput)
                                                                                            {
                                                                                                <label class="train-brainrow-field"
                                                                                                       title="Softmax over 4 take-profit distances: None / Tight / Medium / Wide">
                                                                                                    Take Profit
                                                                                                    <span class="train-decoding-value">@TakeProfitOutputWidth-way @DecodingLabel</span>
                                                                                                </label>
                                                                                            }
                                                                                        </div>
                                                                                    </div>
                    }
                                                                                </div>
                                                                            </div>
                                                                        }
                                                                    </div>
