@namespace Poink.Sim.Components.Training
@using Poink.Sim.Components.Shared.ConfirmDialog

@if (_showDeleteConfirm)
{
    <ConfirmDialog Title="Delete Brain"
                   Message="@($"Delete '{BrainName}'? This permanently removes its saved network config and cannot be undone.")"
                   ConfirmLabel="YES, DELETE" CancelLabel="CANCEL"
                   OnConfirm="ConfirmDeleteBrain" OnCancel="CancelDeleteBrain" />
}

<div class="train-card">
    <div class="train-card-title-row">
        <div class="train-card-title"
             title="Which brain (neural network) this run trains and plays back, the strategy that trains it, and the reward policy it optimizes against -- heuristic brains have no trainable weights, so they never appear here">
            Brain Config</div>
        <BrainSelect BrainOptions="TrainableBrainOptions" BrainName="@BrainName" BrainNameChanged="OnBrainNameChanged"
                     Disabled="Service.IsRunning" />
        <span class="train-card-title-actions">
            <button type="button" class="train-btn-toggle" @onclick="StartNewBrain" disabled="@Service.IsRunning"
                    title="Start building a brand-new brain from scratch -- resets the panel below to defaults with Auto Name on">
                + NEW BRAIN
            </button>
            <button type="button" class="train-btn-toggle" @onclick="ModifyCurrentBrain"
                    disabled="@(Service.IsRunning || !BrainNameIsPersisted)"
                    title="Load the brain selected above into the panel below for editing">
                MODIFY
            </button>
            <button type="button" class="train-btn-toggle train-btn-toggle-warn" @onclick="RequestDeleteBrain"
                    disabled="@(Service.IsRunning || !BrainNameIsPersisted)"
                    title="Delete the brain selected above -- removes its saved network config; cannot be undone">
                DELETE BRAIN
            </button>
            @if (_showBuildPanel)
            {
                <button type="button" class="train-btn-toggle" @onclick="() => _showBuildPanel = false"
                        disabled="@Service.IsRunning" title="Collapse the panel below -- keeps your in-progress edits">
                    - HIDE
                </button>
            }
        </span>
    </div>
    @if (_deleteStatus is not null)
    {
        <span class="train-brainrow-error">@_deleteStatus</span>
    }

        @if (_showBuildPanel)
        {
            <div class="train-buildbrain">
                <div class="train-card-fields-row train-buildbrain-name-row">
                    <label class="train-brainrow-field train-brainrow-field-grow"
                           title="Name for this config -- matching an existing brain's name edits it in place (Save Brain updates it, Start Training shadows it live until saved); any other name is a new brain">
                        Name
                        <input class="train-brainrow-input train-brainrow-input-full" type="text"
                               value="@EffectiveBuildBrainName" @oninput="OnBuildBrainNameInput"
                               disabled="@(Service.IsRunning || _buildBrainNameAuto)" placeholder="e.g. lstm-vp-experiment" />
                    </label>
                    @if (IsModifiedFromSaved)
                    {
                        <span class="train-card-badge train-card-badge-warn"
                              title="This name matches a saved brain, but the config below no longer matches what's saved -- Save Brain commits these changes; Set applies them live without saving">
                            MODIFIED</span>
                    }
                    <label class="train-brainrow-field"
                           title="Auto-generate the name from architecture, layers, and selected data -- uncheck to type your own">
                        <input type="checkbox" checked="@_buildBrainNameAuto" @onchange="OnToggleAutoBuildBrainName"
                               disabled="@Service.IsRunning" /> Auto Name
                    </label>
                    <button type="button" class="train-btn-toggle" @onclick="SetConfig"
                            disabled="@(Service.IsRunning || !CanCreateBrain || !IsDraft)"
                            title="Applies the current config live now, without saving -- lets Training Preview below show it before you start a run">
                        SET
                    </button>
                    <button type="button" class="train-btn-toggle" @onclick="SaveBrain"
                            disabled="@(Service.IsRunning || !CanCreateBrain || !IsDraft)"
                            title="Commits the current config to storage under its name -- updates it in place if that name's already saved, and selects it above as the brain in use">
                        SAVE BRAIN
                    </button>
                </div>
                @if (_buildBrainStatus is not null)
                {
                    <span class="train-brainrow-error">@_buildBrainStatus</span>
                }

                <div class="train-buildbrain-tabs">
                    <button type="button" class="train-buildbrain-tab @(_activeBuildTab == BrainBuilderTab.Learn ? "active" : "")"
                            @onclick="() => _activeBuildTab = BrainBuilderTab.Learn" title="Strategy, reward policy, and learning rate">
                        LEARN
                    </button>
                    <button type="button" class="train-buildbrain-tab @(_activeBuildTab == BrainBuilderTab.Features ? "active" : "")"
                            @onclick="() => _activeBuildTab = BrainBuilderTab.Features"
                            title="Time-series inputs, trader state, and XGrid signals fed into the network">
                        FEATURES
                    </button>
                    <button type="button" class="train-buildbrain-tab @(_activeBuildTab == BrainBuilderTab.Decide ? "active" : "")"
                            @onclick="() => _activeBuildTab = BrainBuilderTab.Decide"
                            title="Gates whether this brain's network is even asked to decide">
                        DECIDE
                    </button>
                    <button type="button" class="train-buildbrain-tab @(_activeBuildTab == BrainBuilderTab.Struct ? "active" : "")"
                            @onclick="() => _activeBuildTab = BrainBuilderTab.Struct"
                            title="Network shape applied to the selected features">
                        STRUCT
                    </button>
                    <button type="button" class="train-buildbrain-tab @(_activeBuildTab == BrainBuilderTab.Actions ? "active" : "")"
                            @onclick="() => _activeBuildTab = BrainBuilderTab.Actions"
                            title="Which decisions the network can make, the legality rules on them, and how its raw output decodes into each one">
                        ACTIONS
                    </button>
                </div>

                <div class="train-buildbrain-cards">
                    @if (_activeBuildTab == BrainBuilderTab.Learn)
                    {
                        <LearnSection StrategyName="StrategyName" StrategyNameChanged="StrategyNameChanged"
                                      LearningRate="LearningRate" LearningRateChanged="LearningRateChanged" />
                    }
                    else if (_activeBuildTab == BrainBuilderTab.Features)
                    {
                        <FeaturesSection State="_state" OnChanged="SectionChanged"
                                         TimeSeriesInputsFeatureCount="TimeSeriesInputsFeatureCount"
                                         BarWindowFeatureCount="BarWindowFeatureCount"
                                         VolumeProfileFeatureCount="VolumeProfileFeatureCount"
                                         TimeProfileFeatureCount="TimeProfileFeatureCount"
                                         SessionClockFeatureCount="SessionClockFeatureCount"
                                         SpreadVolatilityFeatureCount="SpreadVolatilityFeatureCount"
                                         TraderStateFeatureCount="TraderStateFeatureCount" />
                    }
                    else if (_activeBuildTab == BrainBuilderTab.Decide)
                    {
                        <DecideSection State="_state" OnChanged="SectionChanged" />
                    }
                    else if (_activeBuildTab == BrainBuilderTab.Struct)
                    {
                        <StructSection State="_state" OnChanged="SectionChanged" TotalInputCount="TotalInputCount" />
                    }
                    else if (_activeBuildTab == BrainBuilderTab.Actions)
                    {
                        <ActionsSection State="_state" OnChanged="SectionChanged" />
                    }
                </div>
            </div>
        }
    </div>
