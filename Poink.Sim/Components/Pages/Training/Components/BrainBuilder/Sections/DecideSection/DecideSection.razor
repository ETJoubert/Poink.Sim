@namespace Poink.Sim.Components.Training
@using Poink.Sim.Brain.Neural

<div class="train-card">
    <div class="train-card-title-row">
        <div class="train-card-title"
             title="Gates whether this brain's network is even asked to decide -- opposite of Action Masking, which restricts choices after the network has already decided. With any rule below enabled, an episode's bar/tick count no longer equals its decision count">
            Decision Masking</div>
        <span class="train-card-badge"
              title="How many of the @TotalDecisionMaskRuleCount available decision-gating rules are enabled">
            @SelectedDecisionMaskRuleCount/@TotalDecisionMaskRuleCount</span>
    </div>
    <div class="train-buildbrain-card-fields">
        <label class="train-brainrow-field"
               title="How often the rules below get checked -- a decision only ever fires on a resolution tick, and only when every enabled rule also passes">
            Resolution
            <select class="train-brainrow-select" @bind="State.DecisionMaskResolution" @bind:after="NotifyChanged" disabled="@Service.IsRunning">
                <option value="@DecisionMaskResolutionKind.PerBar">Once per bar</option>
                <option value="@DecisionMaskResolutionKind.EverySeconds">Every X seconds</option>
                <option value="@DecisionMaskResolutionKind.PerTick">Every tick</option>
                <option value="@DecisionMaskResolutionKind.OnCellWidthChange">On cell width change</option>
            </select>
        </label>
        @if (State.DecisionMaskResolution == DecisionMaskResolutionKind.EverySeconds)
        {
            <label class="train-brainrow-field" title="How many seconds must pass between resolution checks">
                Seconds
                <input class="train-brainrow-input" type="number" min="0.001" step="1"
                       @bind="State.DecisionMaskResolutionSeconds" @bind:after="NotifyChanged" disabled="@Service.IsRunning" />
            </label>
        }
        @if (State.DecisionMaskResolution == DecisionMaskResolutionKind.OnCellWidthChange)
        {
            <label class="train-brainrow-field"
                   title="Fixed price width of each cell -- a resolution check fires when price crosses from one cell into the next">
                Cell width
                <input class="train-brainrow-input" type="number" min="0.00001" step="0.01"
                       @bind="State.DecisionMaskResolutionCellWidth" @bind:after="NotifyChanged" disabled="@Service.IsRunning" />
            </label>
        }
    </div>
    <div class="train-buildbrain-card-fields">
        <label class="train-brainrow-field" title="Toggle every decision-gating rule below on or off at once">
            <input type="checkbox" @bind="AllDecisionMaskRulesSelected" @bind:after="NotifyChanged" disabled="@Service.IsRunning" />
            Select All
        </label>
        @foreach (var row in DecisionMaskRuleRows)
        {
            <label class="train-brainrow-field" title="@row.Tooltip">
                <input type="checkbox" checked="@row.Get()"
                       @onchange="e => OnDecisionMaskRuleRowChanged(row, e)"
                       disabled="@Service.IsRunning" />
                @row.Label
            </label>
        }
    </div>
</div>
