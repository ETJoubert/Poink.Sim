@namespace Poink.Sim.Components.Training
@using Poink.Sim.Components.Charts
@using Poink.Sim.Components.Shared.BrainIoPanel
@using Poink.Sim.Components.Shared.Icon

<div class="lev-root">
    <div class="lev-controls">
        <button type="button" class="lev-btn lev-btn-play" @onclick="OnPlayPause"
                title="@(IsRunning && !IsPaused ? "Pause training" : IsPaused ? "Resume training from where it paused" : "Start training")">
            <Icon Name="@(IsRunning && !IsPaused ? "pause-fill" : "play-fill")" Class="lev-run-icon" />
            @(IsRunning && !IsPaused ? "PAUSE" : "PLAY")
        </button>
        <button type="button" class="lev-btn" @onclick="OnStep" disabled="@(IsRunning && !IsPaused)"
                title="Run exactly one episode, live, then pause -- lets you watch a single episode from the start">
            <Icon Name="skip-end-fill" Class="lev-run-icon" />
            STEP
        </button>
        <button type="button" class="lev-btn" @onclick="OnReset"
                title="Stop training and clear this run's progress -- the Data/Features/Network/Output/Training setup stays as configured">
            <Icon Name="arrow-clockwise" Class="lev-run-icon" />
            RESET
        </button>
        <div class="lev-speed" title="How fast the live episode plays -- lower values slow decisions down so you can actually watch them; higher values approach real training speed">
            <button type="button" class="lev-speed-btn" @onclick="OnDecreaseSpeed" disabled="@(!CanDecreaseSpeed)" title="Slower">-</button>
            <span class="lev-speed-value">@SpeedLabel</span>
            <button type="button" class="lev-speed-btn" @onclick="OnIncreaseSpeed" disabled="@(!CanIncreaseSpeed)" title="Faster">+</button>
            <button type="button" class="lev-speed-btn lev-speed-btn-max" @onclick="OnMaxSpeed" disabled="@(!CanIncreaseSpeed)" title="Jump straight to max speed">MAX</button>
        </div>
        <span class="lev-episode-count" title="Episodes completed this run, out of the configured target">
            @EpisodesCompleted / @TargetEpisodeCount episodes
        </span>
    </div>
    @if (RunError is not null)
    {
        <p class="lev-warning" title="@RunError">Run stopped: @RunError</p>
    }

    @if (!HasSnapshot)
    {
        <p class="lev-placeholder">@(IsRunning ? "waiting for the first decision..." : "start a run on the Run tab to see live episode data here")</p>
    }
    else
    {
        <div class="lev-status-row">
            <div class="lev-stat" title="Timestamp of the most recent decision">
                <span class="lev-stat-label">time</span>
                <span class="lev-stat-value">@Timestamp?.ToString("yyyy-MM-dd HH:mm:ss")</span>
            </div>
            <div class="lev-stat" title="Simulated time elapsed since this episode started">
                <span class="lev-stat-label">time passed</span>
                <span class="lev-stat-value">@FormatTimePassed(TimePassed)</span>
            </div>
            <div class="lev-stat" title="Action chosen on the most recent decision">
                <span class="lev-stat-label">last action</span>
                <span class="lev-stat-value">@LastAction</span>
            </div>
            <div class="lev-stat" title="Decisions made so far this episode">
                <span class="lev-stat-label">actions</span>
                <span class="lev-stat-value">@ActionCount</span>
            </div>
            <div class="lev-stat" title="Current equity -- cash plus unrealized profit/loss">
                <span class="lev-stat-label">equity</span>
                <span class="lev-stat-value">@Equity.ToString("N2")</span>
            </div>
            <div class="lev-stat" title="Realized profit/loss booked so far this episode">
                <span class="lev-stat-label">realized</span>
                <span class="lev-stat-value">@RealizedPnl.ToString("N2")</span>
            </div>
            <div class="lev-stat" title="Unrealized profit/loss on the currently open position">
                <span class="lev-stat-label">unrealized</span>
                <span class="lev-stat-value">@UnrealizedPnl.ToString("N2")</span>
            </div>
            <div class="lev-stat" title="Units of the currently open position">
                <span class="lev-stat-label">volume</span>
                <span class="lev-stat-value">@(PositionVolume?.ToString("0.####") ?? "--")</span>
            </div>
            <div class="lev-stat" title="Stop-loss price of the open position">
                <span class="lev-stat-label">stop-loss</span>
                <span class="lev-stat-value">@(StopLossPrice?.ToString("0.#####") ?? "--")</span>
            </div>
            <div class="lev-stat" title="Take-profit price of the open position">
                <span class="lev-stat-label">take-profit</span>
                <span class="lev-stat-value">@(TakeProfitPrice?.ToString("0.#####") ?? "--")</span>
            </div>
            <div class="lev-stat" title="Projected loss if the stop-loss is hit, and that loss as a percent of cash, before commission">
                <span class="lev-stat-label">risk at stop</span>
                <span class="lev-stat-value">@RiskAtStopText</span>
            </div>
            <div class="lev-stat" title="Projected profit if the take-profit is hit, and that profit as a percent of cash, before commission">
                <span class="lev-stat-label">reward at target</span>
                <span class="lev-stat-value">@RewardAtTargetText</span>
            </div>
            <div class="lev-stat" title="Projected reward divided by risk for the open position">
                <span class="lev-stat-label">reward : risk</span>
                <span class="lev-stat-value">@RewardRiskText</span>
            </div>
            <div class="lev-stat" title="Trades closed so far this episode">
                <span class="lev-stat-label">trades</span>
                <span class="lev-stat-value">@TradeCount</span>
            </div>
        </div>
    }

    <div class="lev-panel-toggles" title="Show or hide each panel below">
        <span class="lev-panel-toggles-label">Panels</span>
        <button type="button" class="lev-panel-toggle-btn @(ShowMarketChart ? "active" : "")"
                @onclick="() => TogglePanel(ShowMarketChart, ShowMarketChartChanged)" title="Show or hide the live price chart">Chart</button>
        <button type="button" class="lev-panel-toggle-btn @(ShowXGrid ? "active" : "")"
                @onclick="() => TogglePanel(ShowXGrid, ShowXGridChanged)"
                title="Show or hide the footprint grid -- not wired to live data yet, XGrid Signals feature encoding is still deferred">XGrid</button>
        <button type="button" class="lev-panel-toggle-btn @(ShowTxFold ? "active" : "")"
                @onclick="() => TogglePanel(ShowTxFold, ShowTxFoldChanged)"
                title="Show or hide the multi-timeframe TxFold snapshot, anchored to the episode's current time">TxFold</button>
        <button type="button" class="lev-panel-toggle-btn @(ShowEquityCurve ? "active" : "")"
                @onclick="() => TogglePanel(ShowEquityCurve, ShowEquityCurveChanged)" title="Show or hide this episode's equity curve">Equity curve</button>
        <button type="button" class="lev-panel-toggle-btn @(ShowFeatures ? "active" : "")"
                @onclick="() => TogglePanel(ShowFeatures, ShowFeaturesChanged)" title="Show or hide the current feature values">Features</button>
        <button type="button" class="lev-panel-toggle-btn @(ShowActions ? "active" : "")"
                @onclick="() => TogglePanel(ShowActions, ShowActionsChanged)" title="Show or hide the network's action probability distribution">Actions</button>
        <button type="button" class="lev-panel-toggle-btn lev-panel-toggle-btn-hideall" @onclick="HideAllPanels" title="Hide every panel below">Hide All</button>
    </div>

    <div class="lev-grid">
        @if (ShowMarketChart)
        {
            <div class="lev-card lev-card-nopad lev-panel" title="Live price chart built from the current episode's ticks">
                <MarketChartContainer Bars="Bars" Interactive="false" LiveMode="true" CurrentBid="@Bid" CurrentAsk="@Ask" />
            </div>
        }
        @if (ShowXGrid)
        {
            <div class="lev-card lev-card-nopad lev-panel">
                <XGridController />
                <p class="lev-placeholder">XGrid Signals live view isn't wired yet -- its feature encoding is still deferred (see Features tab).</p>
            </div>
        }
        @if (ShowTxFold)
        {
            <div class="lev-card lev-card-nopad lev-panel" title="TxFold snapshot for the episode's symbol, anchored to the current decision's time, with the open position's entry, stop-loss and take-profit">
                <TxFold Table="@Table" AnchorEnd="@(Timestamp ?? DateTime.UtcNow)" RangeStart="@(EpisodeStart ?? Timestamp ?? DateTime.UtcNow)"
                        LatestPrice="@(HasSnapshot ? (Bid + Ask) / 2 : null)" EntryPrice="EntryPrice" PositionIsLong="PositionIsLong"
                        StopLossPrice="StopLossPrice" TakeProfitPrice="TakeProfitPrice" />
            </div>
        }
        @if (ShowEquityCurve)
        {
            <div class="lev-card lev-card-nopad lev-panel" title="Equity over time for the episode currently in progress">
                <EquityCurve Samples="EquitySamples" />
            </div>
        }
        @if (ShowFeatures)
        {
            <div class="lev-card lev-panel lev-features" title="Every enabled feature's current value for the most recent decision, grouped by source">
                <div class="lev-card-title-row">
                    <span class="lev-card-title">Features</span>
                    <span class="lev-card-badge" title="Total feature values shown below">@FeatureRows.Count</span>
                </div>
                @if (FeatureRows.Count == 0)
                {
                    <p class="lev-placeholder">none yet</p>
                }
                else
                {
                    <div class="lev-features-grid">
                        @foreach (var group in FeatureRows.GroupBy(r => r.Section))
                        {
                            <div class="lev-features-section">
                                <span class="lev-features-section-title">@group.Key</span>
                                @if (group.Key == "TxFold")
                                {
                                    <div class="lev-txfold-grid">
                                        @foreach (var row in TxFoldRows)
                                        {
                                            <div class="lev-txfold-grid-row">
                                                <span class="lev-txfold-grid-label">@row.Label</span>
                                                @foreach (var cell in row.Cells)
                                                {
                                                    <span class="lev-txfold-grid-cell" title="@cell.Field">
                                                        <span class="lev-txfold-grid-cell-field">@cell.Field</span>
                                                        <span class="lev-txfold-grid-cell-value">@cell.Value</span>
                                                    </span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    @foreach (var row in group)
                                    {
                                        <div class="lev-features-row" title="@row.Label">
                                            <span class="lev-features-label">@row.Label</span>
                                            <span class="lev-features-value">@row.Value</span>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        }
        @if (ShowActions)
        {
            <div class="lev-card lev-panel" title="The network's action probability distribution on the most recent decision -- same card the old training page uses">
                <BrainIoPanel Outputs="ActionOutputs" CurrentPrice="@((Bid + Ask) / 2)" Equity="@Equity" />
            </div>
        }
    </div>
</div>
