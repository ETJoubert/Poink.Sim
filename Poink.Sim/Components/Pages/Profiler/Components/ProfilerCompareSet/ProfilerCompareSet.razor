@namespace Poink.Sim.Components.Profiler
@using Poink.Sim.Components.Charts

<section class="pcmp-set">
    <header class="pcmp-header">
        <span class="pcmp-title" title="Every selected symbol on one chart">COMPARE</span>
        <label class="pcmp-field" title="What each symbol's % change is measured from">
            Mode
            <select class="pcmp-select" value="@Mode" @onchange="OnModeSelected"
                    title="% change: from the first bar in view, re-basing as you pan. Window: from the Lookback Window edge picked under Anchor">
                <option value="@ProfilerCompareMode.PercentChange">% change</option>
                <option value="@ProfilerCompareMode.WindowAnchored">Window</option>
            </select>
        </label>
        <label class="pcmp-field" title="Which Lookback Window edge Window mode measures from">
            Anchor
            <select class="pcmp-select" value="@WindowAnchor" @onchange="OnAnchorSelected" disabled="@(Mode != ProfilerCompareMode.WindowAnchored)"
                    title="@(Mode != ProfilerCompareMode.WindowAnchored
                               ? "Only applies in Window mode"
                               : "Start: lines fan out from 0% at the window's left edge. End: lines meet 0% at the window's right edge, the same point TxFold anchors at")">
                <option value="@ProfilerCompareAnchor.WindowStart">Start</option>
                <option value="@ProfilerCompareAnchor.WindowEnd">End</option>
            </select>
        </label>
        <label class="pcmp-field" title="Draw each symbol as a line, or as candles in its own colour">
            Style
            <select class="pcmp-select" value="@Style" @onchange="OnStyleSelected"
                    title="Lines: one close line per symbol. Bars: candles in each symbol's colour (up filled, down hollow), semi-transparent so overlaps stay readable">
                <option value="@CompareChartSeriesStyle.Lines">Lines</option>
                <option value="@CompareChartSeriesStyle.Bars">Bars</option>
            </select>
        </label>
        <label class="pcmp-field" title="Divides the primary symbol by another selected symbol, shown in a lower pane">
            Ratio @Primary?.Table ÷
            <select class="pcmp-select" value="@(HasRatio ? RatioTable : "")" @onchange="OnRatioSelected" disabled="@(Sets.Count < 2)"
                    title="@(Sets.Count < 2 ? "Select a second symbol to chart a ratio" : "Pick the symbol the primary is divided by, or None to hide the ratio pane")">
                <option value="">None</option>
                @foreach (var set in Comparisons)
                {
                    <option value="@set.Table">@set.Table</option>
                }
            </select>
        </label>
        <div class="pcmp-legend" title="Line colour per symbol">
            @foreach (var set in Sets)
            {
                <span class="pcmp-legend-item" style="color: var(@ColorVarFor(set.Table))"
                      title="@(set.IsLoading ? $"{set.Table} -- loading" : set.Error ?? $"{set.Table} -- {set.SummaryLabel}")">
                    @set.Table@(set.IsLoading ? " …" : "")
                </span>
            }
            @if (HasRatio)
            {
                <span class="pcmp-legend-item" style="color: var(@ProfilerCompareHelper.RatioColorVar)"
                      title="Primary close divided by the ratio symbol's close at the same bar time">
                    @ProfilerCompareHelper.RatioLabel(Primary!.Table, RatioTable!)
                </span>
            }
        </div>
        <span class="pcmp-note" title="What the % axis is measured from">@ModeNote()</span>
        <button type="button" class="pcmp-toggle @(TxFold.Show ? "active" : "")"
                @onclick="() => SetTxFold(TxFold with { Show = !TxFold.Show })"
                title="Show or hide a TxFold panel comparing every symbol's trailing-window bars at the Lookback Window's right edge">TxFold</button>
    </header>
    <div class="pcmp-body">
        <div class="pcmp-chart">
            <CompareChart Series="_series" ScaleMode="ScaleMode" Style="Style" WindowStart="WindowStart" WindowEnd="WindowEnd"
                          Zones="TxFoldZones()" Markers="TxFoldMarkers()"
                          CanLoadMore="CanLoadMore" OnNearStart="OnNearStart" Tooltip="@ChartTooltip()" />
        </div>
        @if (TxFold.Show)
        {
            <div class="pcmp-txfold">
                <CompareTxFold Symbols="TxFoldSymbols()" AnchorEnd="TxFoldAnchor" RangeStart="RangeStart"
                               NoAnchorMessage="Select a Lookback Window -- its right edge anchors every symbol's trailing windows."
                               SelectedSeconds="TxFoldSeconds" SelectedSecondsChanged="seconds => SetTxFold(TxFold with { Seconds = seconds.Order().ToList() })"
                               BarKind="TxFold.BarKind" BarKindChanged="kind => SetTxFold(TxFold with { BarKind = kind })"
                               Layout="TxFold.Layout" LayoutChanged="layout => SetTxFold(TxFold with { Layout = layout })" />
            </div>
        }
    </div>
</section>
