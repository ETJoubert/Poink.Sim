@page "/profiler"
@namespace Poink.Sim.Components.Pages
@using Poink.Sim.Components.Charts
@using Poink.Sim.Components.Shared.BarSizeSelect
@using Poink.Sim.Components.Shared.DataTable
@using Poink.Sim.Components.Shared.Icon
@using Poink.Sim.Components.Shared.TickDataSource
@using Poink.Sim.Helpers
@using Poink.Sim.Repository
@using Poink.Sim.Models

<div class="prof-page">

    <div class="prof-topbar">
        <header class="prof-header">
            <div class="prof-header-title">
                <span class="prof-header-symbol">PROFILER</span>
                @if (_config is not null)
                {
                    <span class="prof-header-mode">@_config.Table</span>
                    <span class="prof-header-mode">@($"{BarSizeOptions.Label((int)_config.BarSize.TotalSeconds)} bars")</span>
                    <span class="prof-header-mode">
                        @_bars.Count.ToString("N0") bars / @_tickCount.ToString("N0") ticks
                        @(_reachedStart ? " (full range loaded)" : " (more history available)")
                    </span>
                }
                <span class="prof-header-state @StateClass()" title="Current profiler state">
                    @(_isLoading ? "LOADING" : HasData ? "READY" : "SETUP")
                </span>
            </div>
        </header>

        <div class="prof-datarow">
            <div class="prof-datarow-field prof-datarow-data">
                <TickDataSource @bind-Table="_table" @bind-From="_from" @bind-To="_to" @bind-To:after="OnRangeSettled" Disabled="_isLoading" />
            </div>
            <div class="prof-datarow-actions">
                <button class="prof-ctrl-btn prof-ctrl-btn-play" @onclick="Load"
                        disabled="@(_isLoading || _isLoadingMore)"
                        title="Load a recent slice of the selected range -- older history backfills automatically as you pan the chart">
                    @(_isLoading ? "LOADING..." : "LOAD")
                </button>
                @if (_error is not null)
                {
                    <span class="prof-error-inline" title="@_error">@_error</span>
                }
            </div>
        </div>
    </div>

    <div class="prof-body">
    <main class="prof-main">
    @if (HasData)
    {
        <div class="prof-chart-toolbar">
            <div class="prof-overlay-toggles prof-agg-toggles" title="How ticks are aggregated into bars for the chart below">
                <span class="prof-overlay-toggles-label">Aggregation</span>
                <BarSizeSelect @bind-Value="_barSizeSeconds" Disabled="@_isLoading" />
                <label class="prof-agg-field" title="OHLC draws each bar's real Open/High/Low/Close; Quartile draws a box plot of Min/Q1/Median/Q3/Max instead -- Volume/Time profile and XGrid always stay computed from raw ticks either way">
                    Bar kind
                    <select class="prof-agg-select" @bind="_barAggregationKind" @bind:after="RefreshBarRows" disabled="@_isLoading"
                            title="OHLC draws each bar's real Open/High/Low/Close; Quartile draws a box plot of Min/Q1/Median/Q3/Max instead -- Volume/Time profile and XGrid always stay computed from raw ticks either way">
                        <option value="@BarAggregationKind.Ohlc">OHLC</option>
                        <option value="@BarAggregationKind.Quartile">Quartile</option>
                    </select>
                </label>
            </div>
            <div class="prof-overlay-toggles"
                 title="Toggle the computed chart overlays introduced alongside the volume profile -- these aren't Drawings, so they aren't listed/removable below">
                <span class="prof-overlay-toggles-label">Overlays</span>
                <button type="button" class="prof-overlay-toggle-btn prof-overlay-toggle-btn-poc @(_showProfilePanelLevels ? "active" : "")"
                        @onclick="() => _showProfilePanelLevels = !_showProfilePanelLevels"
                        title="Highlight the Point of Control (most-traded price) and Value Area rows inside the volume profile panel">POC/VA</button>
                <button type="button" class="prof-overlay-toggle-btn prof-overlay-toggle-btn-lines @(_showProfileChartLines ? "active" : "")"
                        @onclick="() => _showProfileChartLines = !_showProfileChartLines"
                        title="Project the Point of Control/Value Area High/Low as three dashed lines on the main chart">POC/VAH/VAL</button>
                <button type="button" class="prof-overlay-toggle-btn prof-overlay-toggle-btn-vwap @(_showVwap ? "active" : "")"
                        @onclick="() => _showVwap = !_showVwap"
                        title="Show a cumulative volume-weighted average price line on the main chart, narrowed to the Lookback Window if one is active">VWAP</button>
                <button type="button" class="prof-overlay-toggle-btn prof-overlay-toggle-btn-avg @(_showAverageLine ? "active" : "")"
                        @onclick="() => _showAverageLine = !_showAverageLine"
                        title="Project the mean price as a dashed line on the main chart, narrowed to the Lookback Window if one is active">AVG</button>
                <button type="button" class="prof-overlay-toggle-btn prof-overlay-toggle-btn-med @(_showMedianLine ? "active" : "")"
                        @onclick="() => _showMedianLine = !_showMedianLine"
                        title="Project the median price as a dashed line on the main chart, narrowed to the Lookback Window if one is active">MED</button>
            </div>
            <div class="prof-overlay-toggles prof-lookback-toggles"
                 title="The Lookback Window narrows the volume/time profile panels, XGrid, and VWAP to a slice of the loaded bars -- set it here by width/offset, drag it (or its edges, to resize) on the sparkline below, or draw it on the chart with the LOOKBACK WINDOW tool">
                <button type="button" class="prof-overlay-toggle-btn @(_lookbackEnabled ? "active" : "")"
                        @onclick="ToggleLookbackWindow" title="Turn the Lookback Window on/off">Lookback Window</button>
                <label class="prof-lookback-field" title="Number of bars the window spans">
                    Width
                    <input type="number" min="1" class="prof-lookback-input" title="Number of bars the window spans"
                           @bind="LookbackWidth" @bind:event="onchange" />
                </label>
                <label class="prof-lookback-field" title="Bars back from the most recently loaded bar to the end of the window">
                    Offset
                    <input type="number" min="0" class="prof-lookback-input" title="Bars back from the most recently loaded bar to the end of the window"
                           @bind="LookbackOffset" @bind:event="onchange" />
                </label>
            </div>
            <div class="prof-overlay-toggles prof-profile-toggles" title="Show or hide the chart and profile panels">
                <span class="prof-overlay-toggles-label">Panels</span>
                <button type="button" class="prof-overlay-toggle-btn @(_showMainChart ? "active" : "")"
                        @onclick="() => _showMainChart = !_showMainChart" title="Show or hide the main price chart">Chart</button>
                <button type="button" class="prof-overlay-toggle-btn @(_showXGrid ? "active" : "")"
                        @onclick="() => _showXGrid = !_showXGrid" title="Show or hide the footprint grid">XGrid</button>
                <button type="button" class="prof-overlay-toggle-btn @(_showVolumeProfile ? "active" : "")"
                        @onclick="() => _showVolumeProfile = !_showVolumeProfile" title="Volume-at-price histogram over the current window">Volume profile</button>
                <button type="button" class="prof-overlay-toggle-btn @(_showTimeProfile ? "active" : "")"
                        @onclick="() => _showTimeProfile = !_showTimeProfile" title="Time-at-price histogram over the current window">Time profile</button>
                <button type="button" class="prof-overlay-toggle-btn @(_showSubchart ? "active" : "")"
                        @onclick="() => _showSubchart = !_showSubchart"
                        title="A second market chart, aggregated with its own bar size/kind, scoped to the selected Lookback Window">Subchart</button>
            </div>
        </div>
        <div class="prof-chart-sparkline">
            @if (!_reachedStart)
            {
                <button class="prof-load-older-btn" @onclick="LoadMore" disabled="@(_isLoading || _isLoadingMore)"
                        title="Fetch the next older chunk of history -- same as panning the chart back to its earliest bar">
                    <Icon Name="chevron-left" Class="prof-load-older-icon" />
                </button>
            }
            <MarketChartSparkline Bars="_barRows"
                                   WindowWidth="_lookbackEnabled ? _lookbackWidth : (int?)null"
                                   WindowOffset="_lookbackEnabled ? _lookbackOffset : (int?)null"
                                   WindowChanged="OnWindowChanged" />
        </div>
        <div class="prof-chart" @ref="_chartRowRef">
            @if (_showMainChart)
            {
                <div class="prof-chart-main"
                     title="OHLC bar chart -- pan left to backfill older history, or use the toolbar to draw H-Line/V-Line/D-Line/T-Range/P-Range/Rectangle/T-Range Chart/T-Range Reference Chart/Lookback Window. POC/VAH/VAL, a cumulative VWAP line, and Average/Median lines are shown automatically for whatever window the volume profile panel is built from">
                    <MarketChartContainer Bars="_barRows" KeepView="_keepView" OnNearStart="LoadMore"
                                 HorizontalLines="AllHorizontalLines()" VerticalLines="AllVerticalLines()"
                                 DiagonalLines="AllDiagonalLines()" RangeFills="AllRangeFills()" VwapLine="VwapPoints()"
                                 MedianLine="_medianLine"
                                 OnHorizontalLineDrawn="AddHorizontalLine" OnVerticalLineDrawn="AddVerticalLine"
                                 OnDiagonalLineDrawn="AddDiagonalLine" OnTRangeChartDrawn="AddTRangeChart"
                                 OnReferenceLineDrawn="AddReferenceLine" OnVolumeRangeDrawn="SetVolumeRange"
                                 HasVolumeRange="_volumeRangeStart is not null" OnVolumeRangeCleared="ClearVolumeRange"
                                 OnDrawFinished="FinishDrawing" />
                </div>
            }
            @if (_showXGrid)
            {
                <div class="prof-chart-divider" @ref="_chartDividerRefXGrid" data-min-width="200" title="Drag to resize"></div>
                <div class="prof-chart-side">
                    <div class="prof-vp"
                         title="@(VolumeRangeLabel() is { } xgridLabel
                                                                              ? $"Footprint grid for the selected Lookback Window ({xgridLabel}) -- rows are price buckets, columns are bars"
                                                                              : "Select a Lookback Window to build the footprint grid -- rows are price buckets, columns are bars")">
                        <XGridController Grid="ComputeXGrid()" @bind-PipCount="_xgridPipCount" @bind-ColCount="_xgridColCount"
                                       ProfileBarCount="_lookbackWidth" />
                    </div>
                </div>
            }
            @if (_showVolumeProfile)
            {
                <div class="prof-chart-divider" @ref="_chartDividerRef" data-min-width="200" title="Drag to resize"></div>
                <div class="prof-chart-side">
                    <div class="prof-vp"
                         title="@((VolumeRangeLabel() is { } label
                                                                              ? $"Volume profile for the selected Lookback Window ({label}) -- use the toolbar's CLEAR LOOKBACK WINDOW button to go back to every loaded bar"
                                                                              : "Volume profile across every bar loaded so far -- use the toolbar's LOOKBACK WINDOW tool to narrow it to a specific time window")
                                                                              + ". POC/Value Area are highlighted below and projected onto the main chart as POC/VAH/VAL lines")">
                        <TickVolumeProfileChart WeightedSamples="MergedSamples()" CurrentPrice="LastClose"
                                                ShowLevels="_showProfilePanelLevels" />
                    </div>
                </div>
            }
            @if (_showTimeProfile)
            {
                <div class="prof-chart-divider" @ref="_chartDividerRef2" data-min-width="200" title="Drag to resize"></div>
                <div class="prof-chart-side">
                    <div class="prof-vp"
                         title="@((VolumeRangeLabel() is { } timeLabel
                                                                              ? $"Time profile for the selected Lookback Window ({timeLabel}) -- use the toolbar's CLEAR LOOKBACK WINDOW button to go back to every loaded bar"
                                                                              : "Time profile across every bar loaded so far -- use the toolbar's LOOKBACK WINDOW tool to narrow it to a specific time window")
                                                                              + ". Measures dwell time (seconds) per price level instead of tick count")">
                        <TickTimeProfileChart WeightedSamples="MergedTimeSamples()" CurrentPrice="LastClose" />
                    </div>
                </div>
            }
            @if (_showSubchart)
            {
                <div class="prof-chart-divider" @ref="_chartDividerRefSubchart" data-min-width="200" title="Drag to resize"></div>
                <div class="prof-chart-side">
                    <div class="prof-vp" title="A second market chart scoped to the selected Lookback Window, aggregated independently of the main chart above">
                        <div class="prof-subchart-panel">
                            <div class="prof-subchart-toolbar">
                                <BarSizeSelect @bind-Value="_subchartBarSizeSeconds" Disabled="@_subchartLoading" />
                                <label class="prof-agg-field" title="OHLC draws each bar's real Open/High/Low/Close; Quartile draws a box plot of Min/Q1/Median/Q3/Max instead">
                                    Bar kind
                                    <select class="prof-agg-select" @bind="_subchartBarKind" disabled="@_subchartLoading"
                                            title="OHLC draws each bar's real Open/High/Low/Close; Quartile draws a box plot of Min/Q1/Median/Q3/Max instead">
                                        <option value="@BarAggregationKind.Ohlc">OHLC</option>
                                        <option value="@BarAggregationKind.Quartile">Quartile</option>
                                    </select>
                                </label>
                            </div>
                            <div class="prof-subchart-chart">
                                @if (_volumeRangeStart is null || _volumeRangeEnd is null)
                                {
                                    <p class="prof-drawings-empty">Select a Lookback Window to view the subchart.</p>
                                }
                                else if (_subchartError is not null)
                                {
                                    <p class="prof-drawings-empty">@_subchartError</p>
                                }
                                else if (_subchartLoading && _subchartBars.Count == 0)
                                {
                                    <p class="prof-drawings-empty">Loading...</p>
                                }
                                else
                                {
                                    <MarketChartContainer Bars="_subchartBars" MedianLine="_subchartMedianLine" ShowAnnotationTools="false" />
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (!_isLoading)
    {
        <p class="prof-empty">Pick a symbol and date range above, then LOAD to view its bar chart and volume profile.</p>
    }
    </main>

    <aside class="prof-right-side-panel @(_rightPanelCollapsed ? "prof-right-side-panel-collapsed" : "")">
        <div class="prof-side-panel-header">
            <button type="button" class="prof-side-panel-toggle" @onclick="() => _rightPanelCollapsed = !_rightPanelCollapsed"
                    title="@(_rightPanelCollapsed ? "Expand panel" : "Collapse panel")">
                <Icon Name="@(_rightPanelCollapsed ? "chevron-left" : "chevron-right")" Class="prof-side-panel-toggle-icon" />
            </button>
            @if (!_rightPanelCollapsed)
            {
                <span class="prof-side-panel-label">DRAWINGS</span>
            }
        </div>
        @if (!_rightPanelCollapsed)
        {
        <div class="prof-side-panel-tabs">
            <button class="prof-side-panel-tab @(_activePanelTab == PanelTab.Drawings ? "active" : "")"
                    @onclick="() => _activePanelTab = PanelTab.Drawings">DRAWINGS</button>
            <button class="prof-side-panel-tab @(_activePanelTab == PanelTab.SavedTRangeCharts ? "active" : "")"
                    @onclick="() => _activePanelTab = PanelTab.SavedTRangeCharts">SAVED T-RANGE CHARTS</button>
            <button class="prof-side-panel-tab @(_activePanelTab == PanelTab.SavedTRangeReferenceCharts ? "active" : "")"
                    @onclick="() => _activePanelTab = PanelTab.SavedTRangeReferenceCharts">SAVED T-RANGE REFERENCE
                CHARTS</button>
            </div>
            <div class="prof-side-panel-content">
                @if (_activePanelTab == PanelTab.Drawings)
                {
                    <div class="prof-drawings-panel" title="Everything drawn on the chart via the toolbar">
                        @if (_selectedDrawingIds.Count > 0)
                        {
                            <div class="prof-drawings-selection-bar">
                                <span class="prof-drawings-selection-count">@_selectedDrawingIds.Count SELECTED</span>
                                @if (_showLabelInput)
                                {
                                    <input class="prof-drawings-label-input" type="text" placeholder="e.g. reversal-setup-a"
                                           @bind="_labelText" @bind:event="oninput" @onkeydown="OnLabelKeyDown" autofocus
                                           title="Label to save the selected T-Range Chart/T-Range Reference Chart drawings under" />
                                    <button class="prof-ctrl-btn" @onclick="SaveSelectedDrawings"
                                            disabled="@string.IsNullOrWhiteSpace(_labelText)"
                                            title="Saves the selected drawings' ranges to the Poink.Sim database under this label -- only T-RANGE CHART/T-RANGE REFERENCE CHART drawings can be saved">
                                        SAVE
                                    </button>
                                    <button class="prof-ctrl-btn" @onclick="CancelLabelSelected"
                                            title="Cancel without saving">CANCEL</button>
                                }
                                else
                                {
                                    <button class="prof-ctrl-btn" @onclick="ShowLabelSelectedInput"
                                            title="Label the selected drawings and save their ranges to the Poink.Sim database -- only T-RANGE CHART/T-RANGE REFERENCE CHART drawings can be saved">
                                        LABEL SELECTED
                                    </button>
                                }
                                <button class="prof-ctrl-btn" @onclick="RemoveSelectedDrawings"
                                        title="Remove the selected drawings from the chart -- does not affect anything already saved to the database">
                                    DELETE
                                </button>
                                <button class="prof-drawings-selection-clear" @onclick="() => _selectedDrawingIds.Clear()"
                                        title="Clear selection">
                                    CLEAR
                                </button>
                            </div>
                        }
                        @if (!HasData)
                        {
                            <p class="prof-drawings-empty">Load a symbol and date range above to start drawing.</p>
                        }
                        else if (_drawings.Count == 0)
                        {
                            <p class="prof-drawings-empty">Use the chart toolbar (H-LINE, V-LINE, D-LINE, T-RANGE, P-RANGE, RECT,
                                T-RANGE CHART, T-RANGE REF CHART) to add one.</p>
                            }
                    else
                            {
                                <div class="prof-drawings-row">
                                    @for (var i = 0; i < _drawings.Count; i++)
                                    {
                                        var index = i;
                                        var d = _drawings[index];
                                        var isSelected = _selectedDrawingIds.Contains(d.Id);
                                        <div class="prof-drawing-card prof-drawing-card-@d.ColorGroup @(isSelected ? "prof-drawing-card-selected" : "")"
                                             @onclick="() => ToggleDrawingSelected(d.Id)" title="Click to select">
                                            <div class="prof-drawing-card-header">
                                                <input type="checkbox" class="prof-drawing-select" checked="@isSelected"
                                                       @onchange="() => ToggleDrawingSelected(d.Id)" @onclick:stopPropagation="true"
                                                       title="Select this drawing" />
                                                <span class="prof-drawing-kind">#@d.Id @d.Kind</span>
                                                @if (_savedDrawingIds.Contains(d.Id))
                                                {
                                                    <span class="prof-drawing-saved-badge" title="Saved to the Poink.Sim database">SAVED</span>
                                                }
                                                <button class="prof-drawing-remove" @onclick="() => RemoveDrawing(index)"
                                                        @onclick:stopPropagation="true"
                                                        title="Remove this drawing (and every line it's made of)">✕</button>
                                            </div>
                                            @if (d.IsRange && d.RangeBarCount is { } barCount && d.RangeSpan is { } span)
                                            {
                                                <div class="prof-drawing-stats" title="Bars and time span between this range's two lines">
                                                    @barCount.ToString("N0") bars, @FormatSpan(span)
                                                </div>
                                            }
                                            @if (d.ReferenceBarCount is { } refBarCount)
                                            {
                                                <div class="prof-drawing-stats"
                                                     title="Bars inside the reference window (shaded in the mini chart below)">
                                                    @refBarCount.ToString("N0") reference bars
                                                </div>
                                            }
                                            @foreach (var h in d.HorizontalLines)
                                            {
                                                <div class="prof-drawing-line">H @h.Label</div>
                                            }
                                            @foreach (var v in d.VerticalLines)
                                            {
                                                <div class="prof-drawing-line">V @v.Label</div>
                                            }
                                            @foreach (var dl in d.DiagonalLines)
                                            {
                                                <div class="prof-drawing-line">D @dl.Label</div>
                                            }
                                            @foreach (var r in d.ReferenceLines)
                                            {
                                                <div class="prof-drawing-line">REF @r.Label</div>
                                            }
                                            @if (d.ChartBars.Count > 0)
                                            {
                                                <div class="prof-drawing-minichart"
                                                     title="Bars inside this time range (reference window shaded, if any)">
                                                    <CandlestickChart Bars="d.ChartBars" ReferenceBarCount="@(d.ReferenceBarCount ?? 0)" />
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
            else if (_activePanelTab == PanelTab.SavedTRangeCharts)
                    {
                        <div class="prof-saved-drawings-panel"
                             title="Every T-Range Chart labeled and saved to the Poink.Sim database, across every symbol/session">
                            <DataTable TItem="TRangeChart" Items="_savedTRangeCharts" ShowRowNumbers="false" ActionsHeader="ACTIONS"
                                       ExcludeProperties="@(new List<string> { "Id" })" OnDelete="HandleDeleteTRangeChart"
                                       EmptyMessage="no saved T-Range Charts yet -- select a T-Range Chart card above and use LABEL SELECTED">
                                <CardContent Context="chart">
                                    @{
                                        var bars = GetChartBars(chart);
                                    }
                                    @if (bars is null)
                                    {
                                        <p class="prof-saved-drawing-loading">loading chart...</p>
                                    }
                                    else if (bars.Count > 0)
                                    {
                                        <div class="prof-saved-drawing-chart" title="Redrawn from this range's ticks">
                                            <CandlestickChart Bars="bars" />
                                        </div>
                                    }
                                </CardContent>
                                <DetailContent Context="chart">
                                    @{
                                        var bars = GetChartBars(chart);
                                    }
                                    @if (bars is null)
                                    {
                                        <p class="prof-saved-drawing-loading">loading chart...</p>
                                    }
                                    else if (bars.Count > 0)
                                    {
                                        <div class="prof-saved-drawing-chart prof-saved-drawing-chart-detail"
                                             title="Redrawn from this range's ticks">
                                            <CandlestickChart Bars="bars" />
                                        </div>
                                    }
                                </DetailContent>
                            </DataTable>
                        </div>
                    }
                    else
                    {
                        <div class="prof-saved-drawings-panel"
                             title="Every T-Range Reference Chart labeled and saved to the Poink.Sim database, across every symbol/session">
                            <DataTable TItem="TRangeReferenceChart" Items="_savedTRangeReferenceCharts" ShowRowNumbers="false"
                                       ActionsHeader="ACTIONS" ExcludeProperties="@(new List<string> { "Id" })"
                                       OnDelete="HandleDeleteTRangeReferenceChart"
                                       EmptyMessage="no saved T-Range Reference Charts yet -- select a T-Range Reference Chart card above and use LABEL SELECTED">
                                <CardContent Context="chart">
                                    @{
                                        var bars = GetReferenceChartBars(chart);
                                    }
                                    @if (bars is null)
                                    {
                                        <p class="prof-saved-drawing-loading">loading chart...</p>
                                    }
                                    else if (bars.Count > 0)
                                    {
                                        <div class="prof-saved-drawing-chart"
                                             title="Redrawn from this range's ticks -- reference window shaded">
                                            <CandlestickChart Bars="bars" ReferenceBarCount="chart.ReferenceBarCount" />
                                        </div>
                                    }
                                </CardContent>
                                <DetailContent Context="chart">
                                    @{
                                        var bars = GetReferenceChartBars(chart);
                                    }
                                    @if (bars is null)
                                    {
                                        <p class="prof-saved-drawing-loading">loading chart...</p>
                                    }
                                    else if (bars.Count > 0)
                                    {
                                        <div class="prof-saved-drawing-chart prof-saved-drawing-chart-detail"
                                             title="Redrawn from this range's ticks -- reference window shaded">
                                            <CandlestickChart Bars="bars" ReferenceBarCount="chart.ReferenceBarCount" />
                                        </div>
                                    }
                                </DetailContent>
                            </DataTable>
                        </div>
                    }
                </div>
            }
        </aside>
    </div>
</div>
