@page "/"
@page "/simulation"
@namespace Poink.Sim.Components.Pages
@using Poink.Sim.Components.Charts
@using Poink.Sim.Components.Shared.DateRangeSlider
@using Poink.Sim.Components.Shared.LookbackWindowBar
@using Poink.Sim.Components.Shared.SimTimeline
@using Poink.Sim.Components.Shared.IndicatorPanel
@using Poink.Sim.Components.Shared.Indicators
@using Poink.Sim.Components.Shared.StatisticsPanel
@using Poink.Sim.Components.Shared.TickDataSource
@using Poink.Sim.Components.Shared.BarSizeSelect
@using Poink.Sim.Components.Shared.PolicySelector
@using Poink.Sim.Components.Shared.SymbolMetadataFields
@using Poink.Sim.Components.Simulation
@using Poink.Sim.Components.Training
@using Poink.Sim.Helpers
@using Poink.Sim.Models
@using Poink.Sim.Components.Shared.Icon
@using Poink.Sim.Components.Shared.ViewDatatable
@using Poink.Sim.Components.Shared.TraderSidePanel
@using Poink.Sim.Components.Shared.TradeConsole
@using Poink.Sim.Components.Shared.FinancialsPanel
@using Poink.Sim.Components.Shared.PositionTable
@using Poink.Sim.Trader.Risk

<div class="sim-page">

    <div class="sim-topbar">
        <header class="sim-header">
            <div class="sim-header-title">
                <span class="sim-header-symbol" title="Trader simulation -- replays the symbols picked in the SYMBOL tab over the date range beside it, trading the first and watching the rest">TRADER SIMULATION</span>
                <span class="sim-header-state @StateCssClass" title="Current state of the simulation">@StateLabel</span>
            </div>
            <div class="sim-header-range" title="Date range the simulation replays -- applies on the next SET, RESET or PLAY">
                <TickDataSource @bind-Table="_table" ShowTablePicker="false" @bind-From="_from" @bind-To="_to"
                                Disabled="@_isLoading" />
            </div>
            <div class="sim-header-actions">
                <button class="sim-ctrl-btn sim-ctrl-btn-play" @onclick="ApplyDataRange" disabled="@_isLoading"
                        title="Apply the selected symbol and date range -- loads the simulation from it, with enough earlier history that the rule engine's lookback is already filled at the start">
                    @(_isLoading ? "LOADING..." : "SET")
                </button>
                @if (_loadError is not null)
                {
                    <span class="sim-brainrow-error" title="@_loadError">@_loadError</span>
                }
                @if (_snapshot is null && _error is not null)
                {
                    <span class="sim-brainrow-error" title="@_error">@_error</span>
                }
            </div>
        </header>

        <div class="sim-toolbar">
            <div class="sim-controls">
                @if (_snapshot is not null)
                {
                    var s = _snapshot;
                    <button class="sim-ctrl-btn sim-ctrl-btn-play" @onclick="TogglePlayPause" disabled="@s.IsFinished"
                            title="@(s.IsPlaying ? "Pause playback" : "Resume playback")">
                        <Icon Name="@(s.IsPlaying ? "pause-fill" : "play-fill")" Class="sim-ctrl-icon" />
                        @(s.IsPlaying ? "PAUSE" : "PLAY")
                    </button>
                    <button class="sim-ctrl-btn" @onclick="StepOnce" disabled="@(s.IsPlaying || s.IsFinished)"
                            title="Advance a single step">
                        <Icon Name="skip-end-fill" Class="sim-ctrl-icon" />
                        STEP
                    </button>
                    <div class="sim-speed-stepper @(s.IsUncapped ? "sim-speed-stepper-inactive" : "")"
                         title="Playback speed">
                        <button class="sim-ctrl-btn sim-speed-step" @onclick="() => DecreaseSpeed(s)"
                                disabled="@(SpeedIndex(s) == 0)" title="Slower">−</button>
                        <span class="sim-speed-value" title="Current playback speed">@FormatSpeed(s.SpeedMultiplier)</span>
                        <button class="sim-ctrl-btn sim-speed-step" @onclick="() => IncreaseSpeed(s)"
                                disabled="@(SpeedIndex(s) == Speeds.Length - 1)" title="Faster">+</button>
                    </div>
                    <button class="sim-ctrl-btn sim-ctrl-btn-max @(s.IsUncapped ? "active" : "")" @onclick="SetMax"
                            title="Uncapped backend speed -- combine with Hide Chart for the fastest runs">MAX</button>
                    <button class="sim-ctrl-btn sim-ctrl-btn-warn" @onclick="ResetSim"
                            title="Discard this run and return to setup -- pressing Play afterwards starts a new simulation">RESET</button>
                }
                else
                {
                    <button class="sim-ctrl-btn sim-ctrl-btn-play" @onclick="TogglePlayPause" disabled="@_isLoading"
                            title="Load the data range with the setup and policy settings, then start playback">
                        <Icon Name="play-fill" Class="sim-ctrl-icon" />
                        @(_isLoading ? "LOADING..." : "PLAY")
                    </button>
                    <button class="sim-ctrl-btn sim-ctrl-btn-warn" @onclick="ResetSim" disabled="@_isLoading"
                            title="Load a simulation from the current setup and policy settings">RESET</button>
                }
                <span class="sim-toolbar-divider"></span>
                <SimulationAggregationControls @bind-Aggregate="_aggregate" @bind-Aggregate:after="OnAggregationSettingChanged"
                                               @bind-BarSizeSeconds="_barSizeSeconds" @bind-BarSizeSeconds:after="OnAggregationSettingChanged"
                                               Disabled="@_isLoading" />
                @if (_snapshot is not null)
                {
                    <SimTimeline />

                    <div class="sim-controls-right">
                        <span class="sim-toolbar-divider"></span>

                        <button class="sim-ctrl-btn sim-ctrl-btn-toggle @(_hideChart ? "active" : "")"
                                @onclick="ToggleHideChart"
                                title="@(_hideChart ? "Show the chart and profile panels" : "Hide the chart and profile panels -- combine with MAX for the fastest runs")">
                            @(_hideChart ? "SHOW CHART" : "HIDE CHART")
                        </button>
                    </div>
                }
            </div>
        </div>
    </div>

        <div class="sim-body">
                <aside class="sim-left-side-panel @(_leftSidePanelCollapsed ? "sim-left-side-panel-collapsed" : "") @(!_leftSidePanelCollapsed && _activeLeftPanelTab == SimLeftPanelTab.RuleEngine ? "sim-left-side-panel-wide" : "")">
                    <div class="sim-left-side-panel-header">
                        <button type="button" class="sim-left-side-panel-toggle" @onclick="() => _leftSidePanelCollapsed = !_leftSidePanelCollapsed"
                                title="@(_leftSidePanelCollapsed ? "Expand the setup and traders panel" : "Collapse the setup and traders panel")">
                            <Icon Name="@(_leftSidePanelCollapsed ? "chevron-right" : "chevron-left")" Class="sim-left-side-panel-toggle-icon" />
                        </button>
                        @if (!_leftSidePanelCollapsed)
                        {
                            @if (_snapshot is null)
                            {
                                <span class="sim-left-side-panel-label">SETUP</span>
                            }
                            else
                            {
                                <span class="sim-left-side-panel-label">TRADERS <span class="trade-section-count">@_snapshot.Traders.Count</span></span>
                            }
                        }
                    </div>
                    @if (!_leftSidePanelCollapsed)
                    {
                        <div class="sim-left-side-panel-tabs">
                            <button type="button" class="sim-left-side-panel-tab @(_activeLeftPanelTab == SimLeftPanelTab.Symbol ? "active" : "")"
                                    @onclick="() => _activeLeftPanelTab = SimLeftPanelTab.Symbol"
                                    title="Symbol the simulation replays and its trading parameters -- a new pick applies when SET is pressed">SYMBOL</button>
                            <button type="button" class="sim-left-side-panel-tab @(_activeLeftPanelTab == SimLeftPanelTab.Setup ? "active" : "")"
                                    @onclick="() => _activeLeftPanelTab = SimLeftPanelTab.Setup"
                                    title="Trader account settings -- changes apply to the bots when SET is pressed">SETUP</button>
                            <button type="button" class="sim-left-side-panel-tab @(_activeLeftPanelTab == SimLeftPanelTab.Traders ? "active" : "")"
                                    @onclick="() => _activeLeftPanelTab = SimLeftPanelTab.Traders"
                                    title="Every trader's live cash/equity/P&L, selectable to drive the right-side controls">TRADERS</button>
                            <button type="button" class="sim-left-side-panel-tab @(_activeLeftPanelTab == SimLeftPanelTab.RuleEngine ? "active" : "")"
                                    @onclick="() => _activeLeftPanelTab = SimLeftPanelTab.RuleEngine"
                                    title="Above/In/Below mask over the baseline signals (POC/VAH/VAL/VWAP/Median/Regression), XGrid's Top %/Delta rows, and TxFold's per-timeframe mean+/-stddev rows -- the input side of the rule engine">RULE ENGINE</button>
                        </div>
                        <div class="sim-left-side-panel-content">
                            @if (_activeLeftPanelTab == SimLeftPanelTab.Symbol)
                            {
                                <SimulationSymbolPanel SelectedTables="SelectedTables" SelectedTablesChanged="OnSymbolsSelected" SymbolColors="SymbolColors"
                                                       LoadedTables="LoadedTables" Disabled="@_isLoading" />
                                <SymbolMetadataFields Symbol="_symbol" Metadata="_symbolMetadata" Loading="_loadingSymbolMetadata" />
                            }
                            else if (_activeLeftPanelTab == SimLeftPanelTab.Setup)
                            {
                                <div class="sim-setup-form">
                                    <label class="sim-brainrow-field"
                                           title="Cash each trader starts with -- applies when SET is pressed">
                                        Starting cash
                                        <input class="sim-brainrow-input" type="number" min="1" step="100" @bind="_startingCash"
                                               disabled="@_isLoading" />
                                    </label>
                                    <label class="sim-brainrow-field"
                                           title="How many traders to run side by side on the same data -- applies when SET is pressed">
                                        Traders
                                        <input class="sim-brainrow-input sim-brainrow-input-narrow" type="number" min="1" max="20"
                                               @bind="_traderCount" disabled="@_isLoading" />
                                    </label>
                                    <label class="sim-brainrow-field"
                                           title="Notional exposure per unit of margin committed -- 1 means no leverage -- applies when SET is pressed">
                                        Leverage
                                        <input class="sim-brainrow-input sim-brainrow-input-narrow" type="number" min="1" step="1"
                                               @bind="_leverage" disabled="@_isLoading" />
                                    </label>
                                    <label class="sim-brainrow-field"
                                           title="Commission charged per fill, as a percent of that fill's notional value -- applies when SET is pressed">
                                        Commission %
                                        <input class="sim-brainrow-input sim-brainrow-input-narrow" type="number" min="0" step="0.01"
                                               @bind="_commissionRatePercent" disabled="@_isLoading" />
                                    </label>
                                    <label class="sim-brainrow-field"
                                           title="Force-close the open position when Margin Level (Equity ÷ Margin Used) drops below this percent -- applies when SET is pressed">
                                        Stop-out %
                                        <input class="sim-brainrow-input sim-brainrow-input-narrow"
                                            type="number"
                                            min="1"
                                            max="100"
                                            step="1"
                                            @bind="_stopOutLevelPercent" disabled="@_isLoading" />
                                    </label>
                                    <button class="sim-ctrl-btn sim-ctrl-btn-play" @onclick="ApplyAccountSettings" disabled="@_isLoading"
                                            title="Apply these account settings to the bots -- each bot gets a fresh account with them; the replay keeps its position">SET</button>
                                </div>
                            }
                            else if (_snapshot is null)
                            {
                                <p class="sim-drawings-empty">No simulation loaded.</p>
                            }
                            else if (_activeLeftPanelTab == SimLeftPanelTab.Traders)
                            {
                                @foreach (var trader in _snapshot.Traders)
                                {
                                    <TraderCard Label="@trader.Label"
                                                PositionStatus="@TraderPositionStatus(trader)" PositionStatusCssClass="@TraderPositionStatusCssClass(trader)"
                                                TradeCount="trader.TradeCount" Cash="trader.Capital.Cash" Equity="trader.Capital.Equity"
                                                RealizedPnl="trader.Capital.RealizedPnl" UnrealizedPnl="trader.Capital.UnrealizedPnl"
                                                MarginUsed="trader.Capital.MarginUsed" MarginLevel="trader.Capital.MarginLevel"
                                                IsSelected="trader.Id == SelectedTrader?.Id" OnSelect="() => SelectTrader(trader.Id)" />
                                }
                            }
                            else if (_activeLeftPanelTab == SimLeftPanelTab.RuleEngine)
                            {
                                <RuleEnginePanel @bind-EnabledKeys="_ruleEngineEnabledKeys" @bind-XGridPercent="_ruleEngineXGridPercent"
                                                 @bind-InTolerancePips="_ruleEngineInTolerancePips" @bind-MinMatches="_ruleEngineMinMatches"
                                                 DisabledGroups="_ruleEngineDisabledGroups" Result="ComputeRuleEngine(_snapshot, _ruleEngineXGridPercent, _ruleEngineDisabledGroups, _ruleEngineInTolerancePips)" CurrentTimestampUtc="_snapshot.CurrentTimestampUtc"
                                                 TxFoldTable="@_snapshot.Config.Table" TxFoldAnchorEnd="SnapshotAnchorBar(_snapshot)?.CloseTime.AddTicks(1)"
                                                 TxFoldRangeStart="_snapshot.Config.LoadFrom" TxFoldSelectedSeconds="_txFoldSelectedSeconds" />
                            }
                        </div>
                    }
                </aside>
            <div class="sim-main">
                @if (_snapshot is null)
                {
                    <p class="sim-drawings-empty">@(_isLoading ? "Loading simulation..." : "No simulation loaded -- pick a symbol in the SYMBOL tab and a date range above, then press SET.")</p>
                }

                @if (_snapshot is not null)
                {
                    var s = _snapshot;
                    var indicatorOverlays = IndicatorOverlays(s);

                    @if (!_hideChart)
                    {
                        <div class="sim-chart-toolbar">
                            <span class="sim-chart-title" style="color: var(@SymbolColorHelper.ColorVarFor(SymbolColors, s.Config.Table))"
                                  title="Traded symbol's data table -- its colour matches the SYMBOL tab and the compare chart">@s.Config.Table</span>
                            <div class="sim-profile-toggles"
                                 title="Show or hide the chart and profile panels">
                                <span class="sim-overlay-toggles-label">Panels</span>
                                @if (CompareAvailable(s))
                                {
                                    <button type="button" class="sim-overlay-toggle-btn @(_showCompare ? "active" : "")"
                                            @onclick="() => _showCompare = !_showCompare"
                                            title="Replace the chart row and the watched charts with one chart comparing the traded and watched symbols as % change -- the other panel toggles apply again once this is off">Compare</button>
                                }
                                <button type="button" class="sim-overlay-toggle-btn @(_showMainChart ? "active" : "")"
                                        @onclick="() => _showMainChart = !_showMainChart"
                                        title="Show or hide the main price chart">Chart</button>
                                @if (s.Config.Aggregate)
                                {
                                    <button type="button" class="sim-overlay-toggle-btn @(_showXGrid ? "active" : "")"
                                            @onclick="() => _showXGrid = !_showXGrid"
                                            title="Show or hide the XGrid footprint panel">XGrid</button>
                                }
                                <button type="button" class="sim-overlay-toggle-btn @(_showVolumeProfile ? "active" : "")"
                                        @onclick="() => _showVolumeProfile = !_showVolumeProfile"
                                        title="Volume-at-price histogram over the current window">Volume profile</button>
                                <button type="button" class="sim-overlay-toggle-btn @(_showTimeProfile ? "active" : "")"
                                        @onclick="() => _showTimeProfile = !_showTimeProfile"
                                        title="Time-at-price histogram over the current window">Time profile</button>
                                @if (s.Config.Aggregate)
                                {
                                    <button type="button" class="sim-overlay-toggle-btn @(_showSnapshot ? "active" : "")"
                                            @onclick="() => _showSnapshot = !_showSnapshot"
                                            title="One OHLC/Quartile bar per toggled timeframe, each a trailing window ending at the current Lookback Window's right edge">TxFold</button>
                                }
                                <button type="button" class="sim-overlay-toggle-btn @(_showIndicators ? "active" : "")"
                                        @onclick="() => _showIndicators = !_showIndicators"
                                        title="Show or hide the indicator panel -- calculated values such as ATR for the current window">Indicators</button>
                                @if (WatchedSymbols(s).Count > 0)
                                {
                                    <button type="button" class="sim-overlay-toggle-btn @(_showWatchedCharts ? "active" : "")"
                                            @onclick="() => _showWatchedCharts = !_showWatchedCharts"
                                            title="Show or hide the watched symbols' chart sets -- each shows the same panels as the traded symbol, replayed in step with it and driven by the same Lookback Window and Indicators">Watched</button>
                                }
                            </div>
                        </div>

                        @if (s.Config.Aggregate)
                        {
                            <Indicators @bind-Settings="_indicators">
                                <LookbackContent>
                                    <LookbackWindowBar Label="LOOKBACK WINDOW" MaxWindow="MaxBarWindow" MinWidth="10"
                                                        @bind-Width="_barWindowSize" @bind-Offset="_barWindowOffset"
                                                        RailTitle="The highlighted segment is the window itself -- drag either edge to resize it, or drag the bar to move the whole window; its right edge is Offset bars back from now, its left edge Offset+Width bars back"
                                                        SizeInputTitle="Number of bars the window spans -- their price histograms drive the volume profile window, and the bar itself drives the chart's window-start marker"
                                                        OffsetLabelTitle="Bars back from the most recent bar to the end of the window -- 0 keeps the window anchored to now"
                                                        OffsetInputTitle="Bars back from the most recent bar to the end of the window" />
                                </LookbackContent>
                            </Indicators>
                        }
                        else
                        {
                            <LookbackWindowBar Label="TICK WINDOW" MaxWindow="MaxTickWindow" MinWidth="10"
                                                @bind-Width="_tickWindowSize" @bind-Offset="_tickWindowOffset"
                                                RailTitle="The highlighted segment is the window itself -- drag either edge to resize it, or drag the bar to move the whole window; its right edge is Offset ticks back from now, its left edge Offset+Width ticks back"
                                                SizeInputTitle="Number of ticks the window spans -- drives the volume profile window"
                                                OffsetLabelTitle="Ticks back from the most recent tick to the end of the window -- 0 keeps the window anchored to now"
                                                OffsetInputTitle="Ticks back from the most recent tick to the end of the window" />
                        }

                        @if (_showIndicators)
                        {
                            <IndicatorPanel Rows="IndicatorRows(s)" />
                        }

                        <div class="sim-chart @(CompareActive(s) ? "sim-chart-compare" : "")" @ref="_chartRowRef">
                            @if (CompareActive(s))
                            {
                                var compareWindow = LookbackWindowTimes(s);
                                <SimulationCompareSet Symbols="CompareSymbols(s)" @bind-Mode="_compareMode" @bind-Anchor="_compareAnchor"
                                                      @bind-Style="_compareStyle" @bind-RatioTable="_compareRatioTable"
                                                      WindowStart="compareWindow.Start" WindowEnd="compareWindow.End"
                                                      @bind-TxFold="_compareTxFold" TxFoldAnchor="CompareTxFoldAnchor(s)" RangeStart="s.Config.From"
                                                      @bind-XGrid="_compareXGrid" XGridResult="CompareXGrid(s)" @bind-MainPanel="_compareMainPanel" />
                            }
                            else
                            {
                                @if (_showMainChart)
                                {
                                    <div class="sim-chart-main">
                                        @if (s.Config.Aggregate)
                                        {
                                            <MarketChartContainer Bars="SimulationRowHelper.ToBarRows(ChartBars(s))" KeepView="_keepChartView"
                                                                OnNearStart="LoadOlderChartHistory"
                                                                CurrentBid="s.CurrentBid"
                                                                CurrentAsk="s.CurrentAsk" EntryPrice="SelectedTrader?.Position?.EntryPrice"
                                                                PositionIsLong="SelectedPositionIsLong" StopLossPrice="SelectedTrader?.Position?.StopLossPrice"
                                                                TakeProfitPrice="SelectedTrader?.Position?.TakeProfitPrice"
                                                                WindowStartUtc="WindowStartUtc(s)" WindowEndUtc="WindowEndUtc(s)"
                                                                HorizontalLines="indicatorOverlays.HorizontalLines"
                                                                VerticalLines="indicatorOverlays.VerticalLines"
                                                                DiagonalLines="indicatorOverlays.DiagonalLines"
                                                                VwapLine="indicatorOverlays.VwapLine" />
                                        }
                                        else
                                        {
                                            <ViewDatatable Items="TickRows" Title="RECENT TICKS" />
                                        }
                                    </div>
                                }
                                @if (s.Config.Aggregate && _showXGrid)
                                {
                                    @if (ShowXGridDivider(s))
                                    {
                                        <div class="sim-chart-divider" @ref="_chartDividerRefXGrid" data-min-width="160"
                                             title="Drag to resize"></div>
                                    }
                                    <div class="sim-chart-side">
                                        <XGridController Grid="ComputeXGrid(s)" Positions="XGridPositions(s)"
                                               Pending="XGridPending()" OnOrderPlaced="PlaceXGridOrder"
                                               OnPendingModified="ModifyXGridPending" OnPendingCancelled="CancelXGridPending"
                                               OnPositionClosed="CloseXGridPosition"
                                               ExternalDraft="XGridDraft" PipSize="s.Config.PipSize"
                                               @bind-PipCount="_xgridPipCount" @bind-ColCount="_xgridColCount"
                                               ProfileBarCount="ClampedBarWindow" Indicators="_indicators">
                                            <ExpandedControls>
                                                <button class="sim-ctrl-btn sim-ctrl-btn-play" @onclick="TogglePlayPause" disabled="@s.IsFinished"
                                                        title="@(s.IsPlaying ? "Pause playback" : "Resume playback")">
                                                    <Icon Name="@(s.IsPlaying ? "pause-fill" : "play-fill")" Class="sim-ctrl-icon" />
                                                    @(s.IsPlaying ? "PAUSE" : "PLAY")
                                                </button>
                                                <button class="sim-ctrl-btn" @onclick="StepOnce" disabled="@(s.IsPlaying || s.IsFinished)"
                                                        title="Advance a single step">
                                                    <Icon Name="skip-end-fill" Class="sim-ctrl-icon" />
                                                    STEP
                                                </button>
                                                <div class="sim-speed-stepper @(s.IsUncapped ? "sim-speed-stepper-inactive" : "")"
                                                     title="Playback speed">
                                                    <button class="sim-ctrl-btn sim-speed-step" @onclick="() => DecreaseSpeed(s)"
                                                            disabled="@(SpeedIndex(s) == 0)" title="Slower">−</button>
                                                    <span class="sim-speed-value">@FormatSpeed(s.SpeedMultiplier)</span>
                                                    <button class="sim-ctrl-btn sim-speed-step" @onclick="() => IncreaseSpeed(s)"
                                                            disabled="@(SpeedIndex(s) == Speeds.Length - 1)" title="Faster">+</button>
                                                </div>
                                                <button class="sim-ctrl-btn sim-ctrl-btn-max @(s.IsUncapped ? "active" : "")" @onclick="SetMax"
                                                        title="Uncapped backend speed">MAX</button>
                                                @if (s.Config.Aggregate)
                                                {
                                                    <span class="sim-window-title">LOOKBACK WINDOW</span>
                                                    <input class="sim-window-input" type="number" min="1" max="@MaxBarWindow"
                                                           @bind="_barWindowSize" @bind:event="oninput"
                                                           title="Number of bars the window spans -- their price histograms drive the volume profile window" />
                                                    <input class="sim-window-input" type="number" min="0" max="@(MaxBarWindow - 1)"
                                                           @bind="_barWindowOffset" @bind:event="oninput"
                                                           title="Bars back from the most recent bar to the end of the window -- 0 keeps the window anchored to now" />
                                                }
                                            </ExpandedControls>
                                        </XGridController>
                                    </div>
                                }
                                @if (_showVolumeProfile)
                                {
                                    @if (ShowVolumeProfileDivider(s))
                                    {
                                        <div class="sim-chart-divider" @ref="_chartDividerRef" data-min-width="160"
                                             title="Drag to resize"></div>
                                    }
                                    <div class="sim-chart-side">
                                        @if (s.Config.Aggregate)
                                        {
                                            <TickVolumeProfileChart WeightedSamples="MergedBarSamples(s)" CurrentPrice="s.CurrentPrice"
                                                                    ShowLevels="ShowVolumeProfileLevels" />
                                        }
                                        else
                                        {
                                            <TickVolumeProfileChart Prices="ToMidPrices(WindowedTicks(s))" CurrentPrice="s.CurrentPrice"
                                                                    WindowSize="ClampedTickWindow" />
                                        }
                                    </div>
                                }
                                @if (_showTimeProfile)
                                {
                                    @if (ShowTimeProfileDivider(s))
                                    {
                                        <div class="sim-chart-divider" @ref="_chartDividerRef2" data-min-width="160"
                                             title="Drag to resize"></div>
                                    }
                                    <div class="sim-chart-side">
                                        @if (s.Config.Aggregate)
                                        {
                                            <TickTimeProfileChart WeightedSamples="MergedBarTimeSamples(s)" CurrentPrice="s.CurrentPrice" />
                                        }
                                        else
                                        {
                                            <TickTimeProfileChart Ticks="ToTimedMidPrices(WindowedTicks(s))" CurrentPrice="s.CurrentPrice"
                                                                  WindowSize="ClampedTickWindow" />
                                        }
                                    </div>
                                }
                                @if (s.Config.Aggregate && _showSnapshot)
                                {
                                    @if (ShowSnapshotDivider(s))
                                    {
                                        <div class="sim-chart-divider" @ref="_chartDividerRefSnapshot" data-min-width="160"
                                             title="Drag to resize"></div>
                                    }
                                    <div class="sim-chart-side">
                                        @if (SnapshotAnchorBar(s) is { } anchorBar)
                                        {
                                            <TxFold Table="@s.Config.Table" AnchorEnd="@anchorBar.CloseTime.AddTicks(1)" RangeStart="@s.Config.From"
                                                    @bind-SelectedSeconds="_txFoldSelectedSeconds"
                                                    LatestPrice="anchorBar.Close" EntryPrice="SelectedTrader?.Position?.EntryPrice"
                                                    PositionIsLong="SelectedPositionIsLong" StopLossPrice="SelectedTrader?.Position?.StopLossPrice"
                                                    TakeProfitPrice="SelectedTrader?.Position?.TakeProfitPrice"
                                                    DraftEntryPrice="_draft?.EntryPrice" DraftIsLong="_draft?.IsLong"
                                                    DraftStopLossPrice="_draft?.StopLossPrice" DraftTakeProfitPrice="_draft?.TakeProfitPrice"
                                                    ShownLevels="IndicatorsHelper.ToTxFoldLevels(_indicators)" ShowLevelToggles="false" />
                                        }
                                        else
                                        {
                                            <p class="sim-drawings-empty">No bars in the current Lookback Window yet.</p>
                                        }
                                    </div>
                                }
                            }
                        </div>

                        @if (!CompareActive(s) && _showWatchedCharts && WatchedSymbols(s).Count > 0)
                        {
                            var chartSetOptions = ChartSetOptions(s);
                            <div class="sim-watch-sets" title="Watched symbols -- each replays its own ticks in step with the traded symbol and shows the same panels">
                                @foreach (var panels in WatchedPanels(s))
                                {
                                    var table = panels.Table;
                                    <SimulationSymbolChartSet @key="table" Data="panels" Options="chartSetOptions" KeepView="_keepChartView"
                                                              XGridPipCount="WatchXGridPipCount(table)" XGridPipCountChanged="count => SetWatchXGridPipCount(table, count)"
                                                              @bind-XGridColCount="_xgridColCount" @bind-TxFoldSelectedSeconds="_txFoldSelectedSeconds" />
                                }
                            </div>
                        }

                        <div class="sim-chart-hdivider" @ref="_chartHDividerRef" data-min-height="160" data-max-height-vh="70"
                             title="Drag to resize"></div>
                    }

                    <div class="sim-log-panel">
                        <SimulationFinancials TraderId="SelectedTrader?.Id" OnClosePosition='() => CloseSelectedTrader("manual")' />
                    </div>

                    @if (_error is not null)
                    {
                        <p class="sim-error">@_error</p>
                    }
                    @if (_snapshot?.StopReason is { } stopReason)
                    {
                        <p class="sim-error" title="Playback stopped on its own -- Reset, Seek, or apply new account options under SET to continue">@stopReason</p>
                    }
                }
            </div>

                <aside class="sim-right-side-panel @(_traderControlsCollapsed ? "sim-right-side-panel-collapsed" : "")">
                    <div class="sim-right-side-panel-header">
                        <button type="button" class="sim-right-side-panel-toggle" @onclick="() => _traderControlsCollapsed = !_traderControlsCollapsed"
                                title="@(_traderControlsCollapsed ? "Expand trader controls" : "Collapse trader controls")">
                            <Icon Name="@(_traderControlsCollapsed ? "chevron-left" : "chevron-right")" Class="sim-right-side-panel-toggle-icon" />
                        </button>
                        @if (!_traderControlsCollapsed && SelectedTrader is not null)
                        {
                            <span class="sim-right-side-panel-label">@SelectedTrader.Label</span>
                        }
                    </div>
                    <div class="sim-right-side-panel-content">
                        <TraderSidePanel InitialTab="TraderSidePanel.SidePanelTab.Policies" Collapsed="_traderControlsCollapsed" OnExpandRequested="() => _traderControlsCollapsed = false">
                            <TradeTab>
                                @if (_snapshot is null)
                                {
                                    <p class="sim-drawings-empty">Load a simulation to place trades.</p>
                                }
                                else
                                {
                                    <TradeConsole @ref="_consoleRef" MinStopLossDistancePrice="_symbolLimits?.MinStopLossDistancePrice" MinTakeProfitDistancePrice="_symbolLimits?.MinTakeProfitDistancePrice"
                                                  PriceStep="_symbolLimits?.PriceStep" SymbolVolumeStep="_symbolLimits?.VolumeStep"
                                                  MinVolume="_symbolLimits?.MinVolume" MaxVolume="_symbolLimits?.MaxVolume"
                                                  AllowShort="_symbolLimits?.AllowShort ?? true"
                                                  Options="_tradeConsoleOptions" OnOptionsChanged="SetTradeConsoleOptions"
                                                  HasSelection="SelectedTrader is not null"
                                                  Balance="SelectedTrader?.Capital.Cash" Leverage="SelectedTrader?.Leverage"
                                                  PipSize="_snapshot?.Config.PipSize ?? 0.01"
                                                  CurrentPrice="_snapshot?.CurrentPrice"
                                                  CurrentBid="_snapshot?.CurrentBid"
                                                  CurrentAsk="_snapshot?.CurrentAsk"
                                                  StatusMessage="@_consoleError" StatusIsError="_consoleError is not null"
                                                  OnSubmit="HandleConsoleSubmit" OnDraftChanged="HandleDraftChanged" />
                                }
                            </TradeTab>
                            <PoliciesTab>
                                @if (_snapshot is null)
                                {
                                    <div class="sim-riskrow"
                                         title="Risk policies gate every trade action -- permit, deny or resize it -- and supervise open positions, on top of manual controls">
                                        <PolicySelector Available="RiskPolicyService.AvailablePolicies" Selected="_selectedRiskPolicies"
                                                        Disabled="@_isLoading" OnChanged="StateHasChanged" />
                                    </div>
                                }
                                else
                                {
                                    <RiskPolicyPanel Policies="_snapshot.RiskPolicies"
                                                     Statuses="SelectedTrader?.RiskPolicyStatuses" LastDenial="SelectedTrader?.LastDenial" />
                                }
                            </PoliciesTab>
                            <RobotTab>
                                <RobotPanel Limits="_symbolLimits" EvaluationSeconds="_robotEvaluationSeconds" OnEvaluationSecondsChanged="SetRobotEvaluationSeconds" SubTab="_robotSubTab" OnSubTabChanged="SetRobotSubTab" OpenSide="_robotOpenSide" OnOpenSideChanged="SetRobotOpenSide" CloseSide="_robotCloseSide" OnCloseSideChanged="SetRobotCloseSide"
                                            CooldownSeconds="_robotCooldownSeconds" OnCooldownSecondsChanged="SetRobotCooldownSeconds" RequireRearm="_robotRequireRearm" OnRequireRearmChanged="SetRobotRequireRearm" Enabled="_robotEnabled" OnEnabledChanged="SetRobotEnabled" Options="_robotPositionOptions" OnOptionsChanged="SetRobotPositionOptions"
                                            HasSelection="SelectedTrader is not null"
                                            Balance="SelectedTrader?.Capital.Cash" Leverage="SelectedTrader?.Leverage"
                                            PipSize="_snapshot?.Config.PipSize ?? 0.01"
                                            CurrentPrice="_snapshot?.CurrentPrice"
                                            CurrentBid="_snapshot?.CurrentBid"
                                            CurrentAsk="_snapshot?.CurrentAsk"
                                            OpenLongRules="_openLongRules" OpenShortRules="_openShortRules" CloseLongRules="_closeLongRules" CloseShortRules="_closeShortRules"
                                            SignalSettings="_ruleSignalSettings" OnSignalSettingsChanged="SetRuleSignalSettings"
                                            PositionRules="_robotPositionRules" OnPositionRulesChanged="SetRobotPositionRules"
                                            OnRulesChanged="OnRobotRulesChanged" ComputeRuleEngine="ComputeRobotRuleEngine"
                                            CurrentTimestampUtc="_snapshot?.CurrentTimestampUtc"
                                            TxFoldTable="@_snapshot?.Config.Table"
                                            TxFoldAnchorEnd="_snapshot is null ? null : SnapshotAnchorBar(_snapshot)?.CloseTime.AddTicks(1)"
                                            TxFoldRangeStart="_snapshot?.Config.LoadFrom"
                                            TxFoldSelectedSeconds="_txFoldSelectedSeconds" />
                            </RobotTab>
                        </TraderSidePanel>
                    </div>
                </aside>
        </div>
    </div>
