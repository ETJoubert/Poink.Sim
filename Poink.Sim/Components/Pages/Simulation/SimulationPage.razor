@page "/"
@page "/simulation"
@namespace Poink.Sim.Components.Pages
@using Poink.Sim.Components.Charts
@using Poink.Sim.Components.Shared.BrainIoPanel
@using Poink.Sim.Components.Shared.DateRangeSlider
@using Poink.Sim.Components.Shared.LookbackWindowBar
@using Poink.Sim.Components.Shared.SimTimeline
@using Poink.Sim.Components.Shared.StatisticsPanel
@using Poink.Sim.Components.Shared.TickDataSource
@using Poink.Sim.Components.Shared.BarSizeSelect
@using Poink.Sim.Components.Shared.PolicySelector
@using Poink.Sim.Components.Simulation
@using Poink.Sim.Components.Training
@using Poink.Sim.Helpers
@using Poink.Sim.Models
@using Poink.Sim.Components.Shared.Icon
@using Poink.Sim.Components.Shared.ViewDatatable
@using Poink.Sim.Components.Shared.TraderSidePanel
@using Poink.Sim.Components.Shared.TradeConsole
@using Poink.Sim.Components.Shared.FinancialsPanel
@using Poink.Sim.Components.Shared.PositionTable
@using Poink.Sim.Trader.Risk

<div class="sim-page">

    <div class="sim-topbar">
        <header class="sim-header">
         
            @if (_snapshot is null)
            {
                <div class="sim-header-title">
                    <span class="sim-header-symbol">TRADER SIMULATION</span>
                    <span class="sim-header-state sim-state-setup">@(_isLoading ? "LOADING" : "SETUP")</span>
                </div>
                <div class="sim-header-actions">
                    <button class="sim-ctrl-btn sim-ctrl-btn-play" @onclick="LoadSimulation" disabled="@_isLoading"
                            title="Load the selected data range and brain into a live simulation">
                        @(_isLoading ? "LOADING..." : "LOAD SIMULATION")
                    </button>
                    <button class="sim-ctrl-btn" @onclick="LoadDummySimulation" disabled="@_isLoading"
                            title="Synthetic random-walk ticks -- no Postgres required">
                        LOAD DUMMY DATA
                    </button>
                    @if (_loadError is not null)
                    {
                        <span class="sim-brainrow-error">@_loadError</span>
                    }
                    @if (_error is not null)
                    {
                        <span class="sim-brainrow-error">@_error</span>
                    }
                </div>
            }
            else
            {
                var s = _snapshot;
                var trader = SelectedTrader!;
                <div class="sim-stats">
                        @if (s.Config.SteppingMode == SimulationSteppingMode.Cell && s.CellState is { } cellStat)
                        {
                            <div class="sim-stat" title="How many times price has crossed into a new cell -- this is what drives decisions instead of the bar clock">
                                <span class="sim-stat-label">cell steps</span>
                                <span class="sim-stat-value">@cellStat.StepCount</span>
                            </div>
                            <div class="sim-stat" title="Low/high edge of the price band the latest decision stepped into">
                                <span class="sim-stat-label">cell band</span>
                                <span class="sim-stat-value">@cellStat.CellLow.ToString("F5") – @cellStat.CellHigh.ToString("F5")</span>
                            </div>
                        }
                    </div>
                }
            </header>

            <div class="sim-setup">
                @if (!_setupCollapsed)
                {
                <div class="sim-setup-rows">

            <div class="sim-datarow">
                <div class="sim-datarow-field sim-datarow-data">
                    <TickDataSource @bind-Table="_table" @bind-From="_from" @bind-To="_to"
                                    Disabled="@(_isLoading || _snapshot is not null)" />
                </div>
                <div class="sim-datarow-field">
                    <div class="sim-datarow-aggregate">
                        <label class="sim-datarow-checkbox"
                               title="Aggregate into HLOC/AVDT bars instead of raw ticks -- can be changed while a simulation is running">
                            <input type="checkbox" @bind="_aggregate" @bind:after="OnAggregationSettingChanged"
                                   disabled="@_isLoading" />
                            Bars
                        </label>
                        @if (_aggregate)
                        {
                            <BarSizeSelect @bind-Value="_barSizeSeconds" @bind-Value:after="OnAggregationSettingChanged"
                                           Disabled="@_isLoading"
                                           Title="Size of each aggregated bar -- can be changed while a simulation is running" />
                            <select class="sim-datarow-select" @bind="_steppingMode" @bind:after="OnSteppingModeChanged"
                                    disabled="@_isLoading"
                                    title="Bar steps a decision on each aggregated bar's close. Cell steps on a fixed-width price band instead, the moment price moves into a different band -- can be changed while a simulation is running">
                                <option value="@SimulationSteppingMode.Bar">step: bar</option>
                                <option value="@SimulationSteppingMode.Cell">step: cell</option>
                            </select>
                            @if (_steppingMode == SimulationSteppingMode.Cell)
                            {
                                <input class="sim-window-input" type="number" min="0.00001" step="0.01"
                                       @bind="_cellWidth" @bind:after="OnSteppingModeChanged" disabled="@_isLoading"
                                       title="Fixed price width of each cell -- a decision fires when price crosses from one cell into the next" />
                            }
                        }
                    </div>
                </div>
            </div>

            <div class="sim-datarow">
                <label class="sim-brainrow-field"
                       title="Only trained models (plus heuristic strategies, which have no weights to train) can be run in Simulation -- an untrained or freshly-built brain never appears here">
                    Brain
                    <select class="sim-brainrow-select" value="@SelectedOptionKey" @onchange="OnSimulationBrainChanged"
                            disabled="@(_isLoading || _snapshot is not null)">
                        <option value="">-- pick a brain --</option>
                        @if (SimulationBrainOptions.Any(o => o.ModelId is not null))
                        {
                            <optgroup label="TRAINED MODELS">
                                @foreach (var o in SimulationBrainOptions.Where(o => o.ModelId is not null))
                                {
                                    <option value="@OptionKey(o)">@o.DisplayName</option>
                                }
                            </optgroup>
                        }
                        @if (SimulationBrainOptions.Any(o => o.ModelId is null))
                        {
                            <optgroup label="HEURISTIC">
                                @foreach (var o in SimulationBrainOptions.Where(o => o.ModelId is null))
                                {
                                    <option value="@OptionKey(o)">@o.DisplayName</option>
                                }
                            </optgroup>
                        }
                    </select>
                </label>
                <label class="sim-brainrow-field">
                    Starting cash
                    <input class="sim-brainrow-input" type="number" min="1" step="100" @bind="_startingCash"
                           disabled="@(_isLoading || _snapshot is not null)" />
                </label>
                <label class="sim-brainrow-field">
                    Traders
                    <input class="sim-brainrow-input sim-brainrow-input-narrow" type="number" min="1" max="20"
                           @bind="_traderCount" disabled="@(_isLoading || _snapshot is not null)" />
                </label>
                <label class="sim-brainrow-field"
                       title="Notional exposure per unit of margin committed -- 1 means no leverage">
                    Leverage
                    <input class="sim-brainrow-input sim-brainrow-input-narrow" type="number" min="1" step="1"
                           @bind="_leverage" disabled="@(_isLoading || _snapshot is not null)" />
                </label>
                <label class="sim-brainrow-field"
                       title="Commission charged per fill, as a percent of that fill's notional value">
                    Commission %
                    <input class="sim-brainrow-input sim-brainrow-input-narrow" type="number" min="0" step="0.01"
                           @bind="_commissionRatePercent" disabled="@(_isLoading || _snapshot is not null)" />
                </label>
                <label class="sim-brainrow-field"
                       title="Force-close the open position when Margin Level (Equity ÷ Margin Used) drops below this percent">
                    Stop-out %
                    <input class="sim-brainrow-input sim-brainrow-input-narrow"
                        type="number"
                        min="1"
                        max="100"
                        step="1"
                        @bind="_stopOutLevelPercent" disabled="@(_isLoading || _snapshot is not null)" />
                </label>
                <label class="sim-brainrow-field"
                       title="Price value of one pip for this instrument -- stop-loss and take-profit distances are entered in pips and converted through this">
                    Pip size
                    <input class="sim-brainrow-input sim-brainrow-input-narrow" type="number" min="0" step="0.00001"
                           @bind="_pipSize" disabled="@(_isLoading || _snapshot is not null)" />
                </label>
            </div>

            @if (RiskPolicyService.AvailablePolicies.Count > 0)
            {
                <div class="sim-datarow sim-riskrow"
                     title="Risk policies gate every trade action -- permit, deny or resize it -- and supervise open positions, on top of the brain and manual controls">
                    <span class="sim-riskrow-label">Risk Policies</span>
                    <PolicySelector Available="RiskPolicyService.AvailablePolicies" Selected="_selectedRiskPolicies"
                                    Disabled="@(_isLoading || _snapshot is not null)" OnChanged="StateHasChanged">
                        <Actions>
                            @if (_selectedRiskPolicies.Count > 0)
                            {
                                <label class="sim-locktoggle"
                                       title="Opt in to fix these policies for the whole run -- once loaded they cannot be toggled during playback">
                                    <input type="checkbox" @bind="_lockRiskPolicies"
                                           disabled="@(_isLoading || _snapshot is not null)" />
                                    Lock for run
                                </label>
                            }
                        </Actions>
                    </PolicySelector>
                </div>
            }

                </div>
                }
            </div>

            @if (_snapshot is not null)
            {
                var s = _snapshot;
                <div class="sim-toolbar">
                    <div class="sim-controls">
                           <button class="sim-setup-toggle" @onclick="ToggleSetupPanel"
                    title="@(_setupCollapsed ? "Expand the data range, brain and trader options" : "Collapse the data range, brain and trader options")">
                <Icon Name="@(_setupCollapsed ? "chevron-right" : "chevron-down")" Class="sim-setup-toggle-icon" />
            </button>
                        <button class="sim-ctrl-btn sim-ctrl-btn-play" @onclick="TogglePlayPause" disabled="@s.IsFinished">
                            <Icon Name="@(s.IsPlaying ? "pause-fill" : "play-fill")" Class="sim-ctrl-icon" />
                            @(s.IsPlaying ? "PAUSE" : "PLAY")
                        </button>
                        <button class="sim-ctrl-btn" @onclick="StepOnce" disabled="@(s.IsPlaying || s.IsFinished)">
                            <Icon Name="skip-end-fill" Class="sim-ctrl-icon" />
                            STEP
                        </button>
                        <div class="sim-speed-stepper @(s.IsUncapped ? "sim-speed-stepper-inactive" : "")"
                             title="Playback speed">
                            <button class="sim-ctrl-btn sim-speed-step" @onclick="() => DecreaseSpeed(s)"
                                    disabled="@(SpeedIndex(s) == 0)" title="Slower">−</button>
                            <span class="sim-speed-value">@FormatSpeed(s.SpeedMultiplier)</span>
                            <button class="sim-ctrl-btn sim-speed-step" @onclick="() => IncreaseSpeed(s)"
                                    disabled="@(SpeedIndex(s) == Speeds.Length - 1)" title="Faster">+</button>
                        </div>
                        <button class="sim-ctrl-btn sim-ctrl-btn-max @(s.IsUncapped ? "active" : "")" @onclick="SetMax"
                                title="Uncapped backend speed -- combine with Hide Chart for the fastest runs">MAX</button>
                        <button class="sim-ctrl-btn sim-ctrl-btn-warn" @onclick="ResetSim">RESET</button>
                        @if (_setupCollapsed && s.Config.Aggregate)
                        {
                            <span class="sim-toolbar-divider"></span>
                            <div class="sim-toolbar-stepctrls">
                                <BarSizeSelect @bind-Value="_barSizeSeconds" @bind-Value:after="OnAggregationSettingChanged"
                                               Disabled="@_isLoading" Label=""
                                               Title="Size of each aggregated bar -- can be changed while a simulation is running" />
                                <select class="sim-datarow-select sim-toolbar-select" @bind="_steppingMode"
                                        @bind:after="OnSteppingModeChanged" disabled="@_isLoading"
                                        title="Bar steps a decision on each aggregated bar's close. Cell steps on a fixed-width price band instead, the moment price moves into a different band -- can be changed while a simulation is running">
                                    <option value="@SimulationSteppingMode.Bar">step: bar</option>
                                    <option value="@SimulationSteppingMode.Cell">step: cell</option>
                                </select>
                                @if (_steppingMode == SimulationSteppingMode.Cell)
                                {
                                    <input class="sim-window-input sim-toolbar-cell-input" type="number" min="0.00001"
                                           step="0.01" @bind="_cellWidth" @bind:after="OnSteppingModeChanged"
                                           disabled="@_isLoading"
                                           title="Fixed price width of each cell -- a decision fires when price crosses from one cell into the next" />
                                }
                            </div>
                        }
                        <SimTimeline />

                        <div class="sim-controls-right">
                            @if (SelectedTrader is not null)
                            {
                                <button class="sim-ctrl-btn sim-ctrl-btn-toggle @(SelectedTraderIsManual ? "active" : "")"
                                        @onclick="ToggleSelectedTraderMode"
                                        title="@(SelectedTraderIsManual ? "Hand this trader back to the Brain" : "Take manual control -- the Brain stops deciding for this trader")">
                                    @(SelectedTraderIsManual ? "MANUAL" : "AUTO")
                                </button>
                            }
                            <span class="sim-toolbar-divider"></span>

                            <button class="sim-ctrl-btn sim-ctrl-btn-warn" @onclick="UnloadSim">NEW SIMULATION</button>
                            <button class="sim-ctrl-btn sim-ctrl-btn-toggle @(_hideChart ? "active" : "")"
                                    @onclick="ToggleHideChart">
                                @(_hideChart ? "SHOW CHART" : "HIDE CHART")
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="sim-body">
            @if (_snapshot is not null)
            {
                <aside class="sim-left-side-panel @(_leftSidePanelCollapsed ? "sim-left-side-panel-collapsed" : "") @(!_leftSidePanelCollapsed && _activeLeftPanelTab == SimLeftPanelTab.RuleEngine ? "sim-left-side-panel-wide" : "")">
                    <div class="sim-left-side-panel-header">
                        <button type="button" class="sim-left-side-panel-toggle" @onclick="() => _leftSidePanelCollapsed = !_leftSidePanelCollapsed"
                                title="@(_leftSidePanelCollapsed ? "Expand the traders panel" : "Collapse the traders panel")">
                            <Icon Name="@(_leftSidePanelCollapsed ? "chevron-right" : "chevron-left")" Class="sim-left-side-panel-toggle-icon" />
                        </button>
                        @if (!_leftSidePanelCollapsed)
                        {
                            <span class="sim-left-side-panel-label">TRADERS <span class="trade-section-count">@_snapshot.Traders.Count</span></span>
                        }
                    </div>
                    @if (!_leftSidePanelCollapsed)
                    {
                        <div class="sim-left-side-panel-tabs">
                            <button type="button" class="sim-left-side-panel-tab @(_activeLeftPanelTab == SimLeftPanelTab.Traders ? "active" : "")"
                                    @onclick="() => _activeLeftPanelTab = SimLeftPanelTab.Traders"
                                    title="Every trader's live cash/equity/P&L, selectable to drive the right-side controls">TRADERS</button>
                            <button type="button" class="sim-left-side-panel-tab @(_activeLeftPanelTab == SimLeftPanelTab.TraderIo ? "active" : "")"
                                    @onclick="() => _activeLeftPanelTab = SimLeftPanelTab.TraderIo"
                                    title="The selected trader's live brain inputs and output decision distribution">TRADER IO</button>
                            <button type="button" class="sim-left-side-panel-tab @(_activeLeftPanelTab == SimLeftPanelTab.RuleEngine ? "active" : "")"
                                    @onclick="() => _activeLeftPanelTab = SimLeftPanelTab.RuleEngine"
                                    title="Above/In/Below mask over every XGrid signal -- the input side of the rule engine">RULE ENGINE</button>
                        </div>
                        <div class="sim-left-side-panel-content">
                            @if (_activeLeftPanelTab == SimLeftPanelTab.Traders)
                            {
                                @foreach (var trader in _snapshot.Traders)
                                {
                                    <TraderCard Label="@trader.Label" IsManual="TraderIsManual(trader)"
                                                PositionStatus="@TraderPositionStatus(trader)" PositionStatusCssClass="@TraderPositionStatusCssClass(trader)"
                                                TradeCount="trader.TradeCount" Cash="trader.Capital.Cash" Equity="trader.Capital.Equity"
                                                RealizedPnl="trader.Capital.RealizedPnl" UnrealizedPnl="trader.Capital.UnrealizedPnl"
                                                MarginUsed="trader.Capital.MarginUsed" MarginLevel="trader.Capital.MarginLevel"
                                                IsSelected="trader.Id == SelectedTrader?.Id" OnSelect="() => SelectTrader(trader.Id)" />
                                }
                            }
                            else if (_activeLeftPanelTab == SimLeftPanelTab.TraderIo)
                            {
                                <BrainIoPanel Inputs="SelectedTrader?.Inputs" Outputs="SelectedTrader?.Outputs"
                                              CurrentPrice="_snapshot?.CurrentPrice" Equity="SelectedTrader?.Capital.Equity" />
                            }
                            else if (_activeLeftPanelTab == SimLeftPanelTab.RuleEngine)
                            {
                                var ruleGrid = ComputeXGrid(_snapshot);
                                <div class="xgrid-rule-layout">
                                    <XGridRulePanel @bind-EnabledKeys="_ruleEngineEnabledKeys" Grid="ruleGrid"
                                                    CurrentTimestampUtc="_snapshot.CurrentTimestampUtc" />
                                    @if (ruleGrid is { } grid)
                                    {
                                        <XGridSignalsPanel Grid="grid" />
                                    }
                                    <XGridRuleMatchBar EnabledKeys="_ruleEngineEnabledKeys" Grid="ruleGrid" />
                                </div>
                            }
                        </div>
                    }
                </aside>
            }
            <div class="sim-main">

                @if (_snapshot is null)
                {
                    <div class="sim-setup-content">
                        <SavedBrainsTable SavedBrains="ModelService.Models" OnUse="UseSavedBrain"
                                          OnDelete="DeleteSavedBrainSnapshot"
                                          UseTitle="Loads these weights into the brain and selects it for this simulation -- also what Train's brain picker will use" />
                    </div>
                }

                @if (_snapshot is not null)
                {
                    var s = _snapshot;

                    @if (!_hideChart)
                    {
                        <div class="sim-chart-toolbar">
                            <span class="sim-chart-title" title="Data table this simulation was loaded from">@s.Config.Table</span>
                            @if (s.Config.Aggregate)
                            {
                                <div class="sim-overlay-toggles"
                                     title="Toggle the computed chart overlays alongside the volume profile -- Point of Control/Value Area and a cumulative VWAP line">
                                    <span class="sim-overlay-toggles-label">Overlays</span>
                                    <button type="button" class="sim-overlay-toggle-btn sim-overlay-toggle-btn-poc @(_showProfilePanelLevels ? "active" : "")"
                                            @onclick="() => _showProfilePanelLevels = !_showProfilePanelLevels"
                                            title="Highlight the Point of Control (most-traded price) and Value Area rows inside the volume profile panel">POC/VA</button>
                                    <button type="button" class="sim-overlay-toggle-btn sim-overlay-toggle-btn-lines @(_showProfileChartLines ? "active" : "")"
                                            @onclick="() => _showProfileChartLines = !_showProfileChartLines"
                                            title="Project the Point of Control/Value Area High/Low as three dashed lines on the main chart">POC/VAH/VAL</button>
                                    <button type="button" class="sim-overlay-toggle-btn sim-overlay-toggle-btn-vwap @(_showVwap ? "active" : "")"
                                            @onclick="() => _showVwap = !_showVwap"
                                            title="Show a cumulative volume-weighted average price line on the main chart, over the same bar window as the volume profile">VWAP</button>
                                </div>
                            }
                            <div class="sim-profile-toggles"
                                 title="Show or hide the chart and profile panels">
                                <span class="sim-overlay-toggles-label">Panels</span>
                                <button type="button" class="sim-overlay-toggle-btn @(_showMainChart ? "active" : "")"
                                        @onclick="() => _showMainChart = !_showMainChart"
                                        title="Show or hide the main price chart">Chart</button>
                                @if (s.Config.Aggregate)
                                {
                                    <button type="button" class="sim-overlay-toggle-btn @(_showXGrid ? "active" : "")"
                                            @onclick="() => _showXGrid = !_showXGrid"
                                            title="Show or hide the XGrid footprint panel">XGrid</button>
                                }
                                <button type="button" class="sim-overlay-toggle-btn @(_showVolumeProfile ? "active" : "")"
                                        @onclick="() => _showVolumeProfile = !_showVolumeProfile"
                                        title="Volume-at-price histogram over the current window">Volume profile</button>
                                <button type="button" class="sim-overlay-toggle-btn @(_showTimeProfile ? "active" : "")"
                                        @onclick="() => _showTimeProfile = !_showTimeProfile"
                                        title="Time-at-price histogram over the current window">Time profile</button>
                            </div>
                        </div>

                        @if (s.Config.Aggregate)
                        {
                            <LookbackWindowBar Label="LOOKBACK WINDOW" MaxWindow="MaxBarWindow" MinWidth="10"
                                                @bind-Width="_barWindowSize" @bind-Offset="_barWindowOffset"
                                                RailTitle="The highlighted segment is the window itself -- drag either edge to resize it, or drag the bar to move the whole window; its right edge is Offset bars back from now, its left edge Offset+Width bars back"
                                                SizeInputTitle="Number of bars the window spans -- their price histograms drive the volume profile window, and the bar itself drives the chart's window-start marker"
                                                OffsetLabelTitle="Bars back from the most recent bar to the end of the window -- 0 keeps the window anchored to now"
                                                OffsetInputTitle="Bars back from the most recent bar to the end of the window" />
                        }
                        else
                        {
                            <LookbackWindowBar Label="TICK WINDOW" MaxWindow="MaxTickWindow" MinWidth="10"
                                                @bind-Width="_tickWindowSize" @bind-Offset="_tickWindowOffset"
                                                RailTitle="The highlighted segment is the window itself -- drag either edge to resize it, or drag the bar to move the whole window; its right edge is Offset ticks back from now, its left edge Offset+Width ticks back"
                                                SizeInputTitle="Number of ticks the window spans -- drives the volume profile window"
                                                OffsetLabelTitle="Ticks back from the most recent tick to the end of the window -- 0 keeps the window anchored to now"
                                                OffsetInputTitle="Ticks back from the most recent tick to the end of the window" />
                        }

                        <div class="sim-chart" @ref="_chartRowRef">
                            @if (_showMainChart)
                            {
                                <div class="sim-chart-main">
                                    @if (s.Config.Aggregate)
                                    {
                                        <MarketChartContainer Bars="ToBarRows(ChartBars(s))" KeepView="_keepChartView"
                                                            OnNearStart="LoadOlderChartHistory"
                                                            CurrentBid="s.CurrentBid"
                                                            CurrentAsk="s.CurrentAsk" EntryPrice="SelectedTrader?.Position?.EntryPrice"
                                                            PositionIsLong="SelectedPositionIsLong" StopLossPrice="SelectedTrader?.Position?.StopLossPrice"
                                                            TakeProfitPrice="SelectedTrader?.Position?.TakeProfitPrice"
                                                            WindowStartUtc="WindowStartUtc(s)" WindowEndUtc="WindowEndUtc(s)"
                                                            HorizontalLines="ProfileLevelLines(s)"
                                                            VwapLine="VwapPoints(s)" />
                                    }
                                    else
                                    {
                                        <ViewDatatable Items="TickRows" Title="RECENT TICKS" />
                                    }
                                </div>
                            }
                            @if (s.Config.Aggregate && _showXGrid)
                            {
                                @if (ShowXGridDivider(s))
                                {
                                    <div class="sim-chart-divider" @ref="_chartDividerRefXGrid" data-min-width="160"
                                         title="Drag to resize"></div>
                                }
                                <div class="sim-chart-side">
                                    <XGridController Grid="ComputeXGrid(s)" Positions="XGridPositions(s)"
                                           Pending="XGridPending()" OnOrderPlaced="PlaceXGridOrder"
                                           OnPendingModified="ModifyXGridPending" OnPendingCancelled="CancelXGridPending"
                                           OnPositionClosed="CloseXGridPosition" Lines="CellBandLines(s)"
                                           @bind-PipCount="_xgridPipCount" @bind-ColCount="_xgridColCount"
                                           ProfileBarCount="ClampedBarWindow">
                                        <ExpandedControls>
                                            <button class="sim-ctrl-btn sim-ctrl-btn-play" @onclick="TogglePlayPause" disabled="@s.IsFinished"
                                                    title="@(s.IsPlaying ? "Pause playback" : "Resume playback")">
                                                <Icon Name="@(s.IsPlaying ? "pause-fill" : "play-fill")" Class="sim-ctrl-icon" />
                                                @(s.IsPlaying ? "PAUSE" : "PLAY")
                                            </button>
                                            <button class="sim-ctrl-btn" @onclick="StepOnce" disabled="@(s.IsPlaying || s.IsFinished)"
                                                    title="Advance a single step">
                                                <Icon Name="skip-end-fill" Class="sim-ctrl-icon" />
                                                STEP
                                            </button>
                                            <div class="sim-speed-stepper @(s.IsUncapped ? "sim-speed-stepper-inactive" : "")"
                                                 title="Playback speed">
                                                <button class="sim-ctrl-btn sim-speed-step" @onclick="() => DecreaseSpeed(s)"
                                                        disabled="@(SpeedIndex(s) == 0)" title="Slower">−</button>
                                                <span class="sim-speed-value">@FormatSpeed(s.SpeedMultiplier)</span>
                                                <button class="sim-ctrl-btn sim-speed-step" @onclick="() => IncreaseSpeed(s)"
                                                        disabled="@(SpeedIndex(s) == Speeds.Length - 1)" title="Faster">+</button>
                                            </div>
                                            <button class="sim-ctrl-btn sim-ctrl-btn-max @(s.IsUncapped ? "active" : "")" @onclick="SetMax"
                                                    title="Uncapped backend speed">MAX</button>
                                            @if (s.Config.Aggregate)
                                            {
                                                <span class="sim-window-title">LOOKBACK WINDOW</span>
                                                <input class="sim-window-input" type="number" min="1" max="@MaxBarWindow"
                                                       @bind="_barWindowSize" @bind:event="oninput"
                                                       title="Number of bars the window spans -- their price histograms drive the volume profile window" />
                                                <input class="sim-window-input" type="number" min="0" max="@(MaxBarWindow - 1)"
                                                       @bind="_barWindowOffset" @bind:event="oninput"
                                                       title="Bars back from the most recent bar to the end of the window -- 0 keeps the window anchored to now" />
                                            }
                                        </ExpandedControls>
                                    </XGridController>
                                </div>
                            }
                            @if (_showVolumeProfile)
                            {
                                @if (ShowVolumeProfileDivider(s))
                                {
                                    <div class="sim-chart-divider" @ref="_chartDividerRef" data-min-width="160"
                                         title="Drag to resize"></div>
                                }
                                <div class="sim-chart-side">
                                    @if (s.Config.Aggregate)
                                    {
                                        <TickVolumeProfileChart WeightedSamples="MergedBarSamples(s)" CurrentPrice="s.CurrentPrice"
                                                                ShowLevels="_showProfilePanelLevels" />
                                    }
                                    else
                                    {
                                        <TickVolumeProfileChart Prices="ToMidPrices(WindowedTicks(s))" CurrentPrice="s.CurrentPrice"
                                                                WindowSize="ClampedTickWindow" />
                                    }
                                </div>
                            }
                            @if (_showTimeProfile)
                            {
                                @if (ShowTimeProfileDivider(s))
                                {
                                    <div class="sim-chart-divider" @ref="_chartDividerRef2" data-min-width="160"
                                         title="Drag to resize"></div>
                                }
                                <div class="sim-chart-side">
                                    @if (s.Config.Aggregate)
                                    {
                                        <TickTimeProfileChart WeightedSamples="MergedBarTimeSamples(s)" CurrentPrice="s.CurrentPrice" />
                                    }
                                    else
                                    {
                                        <TickTimeProfileChart Ticks="ToTimedMidPrices(WindowedTicks(s))" CurrentPrice="s.CurrentPrice"
                                                              WindowSize="ClampedTickWindow" />
                                    }
                                </div>
                            }
                        </div>

                        <div class="sim-chart-hdivider" @ref="_chartHDividerRef" data-min-height="160" data-max-height-vh="70"
                             title="Drag to resize"></div>
                    }

                    <div class="sim-log-panel">
                        <FinancialsPanel PositionsCount="PositionRows.Count" HistoryCount="LogRows.Count"
                                         HistoryTabTitle="Decisions logged so far this run"
                                         FinancialsSummaryTitle="Balance, margin, and realized/unrealized P&L for the selected trader"
                                         Balance="SelectedTrader?.Capital.Cash" Equity="SelectedTrader?.Capital.Equity" MarginUsed="SelectedTrader?.Capital.MarginUsed"
                                         MarginLevel="SelectedTrader?.Capital.MarginLevel" FreeMargin="SelectedTrader?.Capital.MarginFree" UnrealizedPnl="SelectedTrader?.Capital.UnrealizedPnl">
                            <PositionsContent>
                                <PositionTable TPosition="Position" Rows="PositionRows" OnClose='_ => CloseSelectedTrader("manual")' />
                            </PositionsContent>
                            <HistoryContent>
                                <div class="fp-history">
                                    @if (LogRows.Count == 0)
                                    {
                                        <p class="fp-history-message">No decisions logged yet.</p>
                                    }
                                    else
                                    {
                                        <table class="fp-history-table">
                                            <thead>
                                                <tr>
                                                    <th>Closed</th>
                                                    <th>Side</th>
                                                    <th>Volume</th>
                                                    <th>Price</th>
                                                    <th title="Commission charged on this decision">Commission</th>
                                                    <th>P/L</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                @foreach (var row in LogRows)
                                                {
                                                    <tr>
                                                        <td>@row.Time</td>
                                                        <td class="@(row.Direction == "Long" ? "fp-side-long" : "fp-side-short")">@row.Direction.ToUpperInvariant()</td>
                                                        <td>@row.Size</td>
                                                        <td>@row.Price</td>
                                                        <td>@FinancialsPanel.Money(row.Commission)</td>
                                                        <td class="@FinancialsPanel.PnlCssClass(row.RealizedPnl)">@FinancialsPanel.SignedMoney(row.RealizedPnl)</td>
                                                    </tr>
                                                }
                                            </tbody>
                                        </table>
                                    }
                                </div>
                            </HistoryContent>
                            <StatisticsContent>
                                <StatisticsPanel Groups="StatGroups" EmptyMessage="no closed trades yet" />
                            </StatisticsContent>
                            <EquityContent>
                                <EquityCurve Samples="SelectedTraderEquityCurveSamples" />
                            </EquityContent>
                            <RealizedContent>
                                <div class="fp-item">
                                    <span class="fp-label">Realized</span>
                                    <span class="fp-value @FinancialsPanel.PnlCssClass(SelectedTrader?.Capital.RealizedPnl)">
                                        @FinancialsPanel.SignedMoney(SelectedTrader?.Capital.RealizedPnl)
                                        <span class="fp-value-pct" title="Realized P/L as a percentage of balance">@FinancialsPanel.SignedPercent(RealizedPnlPercentOfBalance())</span>
                                    </span>
                                </div>
                            </RealizedContent>
                        </FinancialsPanel>
                    </div>

                    @if (_error is not null)
                    {
                        <p class="sim-error">@_error</p>
                    }
                }
            </div>

            @if (_snapshot is not null)
            {
                <aside class="sim-right-side-panel @(_traderControlsCollapsed ? "sim-right-side-panel-collapsed" : "")">
                    <div class="sim-right-side-panel-header">
                        <button type="button" class="sim-right-side-panel-toggle" @onclick="() => _traderControlsCollapsed = !_traderControlsCollapsed"
                                title="@(_traderControlsCollapsed ? "Expand trader controls" : "Collapse trader controls")">
                            <Icon Name="@(_traderControlsCollapsed ? "chevron-left" : "chevron-right")" Class="sim-right-side-panel-toggle-icon" />
                        </button>
                        @if (!_traderControlsCollapsed && SelectedTrader is not null)
                        {
                            <span class="sim-right-side-panel-label">@SelectedTrader.Label</span>
                        }
                    </div>
                    <div class="sim-right-side-panel-content">
                        <TraderSidePanel Collapsed="_traderControlsCollapsed" OnExpandRequested="() => _traderControlsCollapsed = false">
                            <TradeTab>
                                <TradeConsole HasSelection="SelectedTrader is not null"
                                              Balance="SelectedTrader?.Capital.Cash" Leverage="SelectedTrader?.Leverage"
                                              PipSize="_snapshot?.Config.PipSize ?? 0.01"
                                              CurrentPrice="_snapshot?.CurrentPrice"
                                              CurrentBid="_snapshot?.CurrentBid"
                                              CurrentAsk="_snapshot?.CurrentAsk"
                                              StatusMessage="@_consoleError" StatusIsError="_consoleError is not null"
                                              OnSubmit="HandleConsoleSubmit" />
                            </TradeTab>
                            <PoliciesTab>
                                <RiskPolicyPanel Policies="@(_snapshot?.RiskPolicies ?? Array.Empty<RiskPolicySnapshot>())"
                                                 Locked="_snapshot?.RiskPoliciesLocked ?? false"
                                                 Statuses="SelectedTrader?.RiskPolicyStatuses" LastDenial="SelectedTrader?.LastDenial" />
                            </PoliciesTab>
                            <RobotTab>
                                <BrainInfoCard BrainName="@(_snapshot?.Config.BrainName ?? string.Empty)"
                                               IsNeuralNetwork="CurrentBrainIsNeuralNetwork(_snapshot?.Config.BrainName ?? string.Empty)"
                                               ActiveSnapshot="TrainingService.GetActiveSnapshot(_snapshot?.Config.BrainName ?? string.Empty)" />
                            </RobotTab>
                        </TraderSidePanel>
                    </div>
                </aside>
            }
        </div>
    </div>
