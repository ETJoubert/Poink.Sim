@page "/"
@page "/simulation"
@namespace Poink.Sim.Components.Pages
@using Poink.Sim.Components.Charts
@using Poink.Sim.Components.Shared.BrainIoPanel
@using Poink.Sim.Components.Shared.DataTable
@using Poink.Sim.Components.Shared.DateRangeSlider
@using Poink.Sim.Components.Shared.SimTimeline
@using Poink.Sim.Components.Shared.StatisticsPanel
@using Poink.Sim.Components.Shared.TickDataSource
@using Poink.Sim.Components.Shared.BarSizeSelect
@using Poink.Sim.Components.Shared.PolicySelector
@using Poink.Sim.Components.Simulation
@using Poink.Sim.Components.Training
@using Poink.Sim.Helpers
@using Poink.Shared.Client.Components.Shared.Icon
@using Poink.Shared.Client.Components.Shared.ViewDatatable
@using System.Globalization

<div class="sim-page">

    <div class="sim-topbar">
        <header class="sim-header">
            <button class="sim-setup-toggle" @onclick="ToggleSetupPanel"
                    title="@(_setupCollapsed ? "Expand the data range, brain and trader options" : "Collapse the data range, brain and trader options")">
                <Icon Name="@(_setupCollapsed ? "chevron-right" : "chevron-down")" Class="sim-setup-toggle-icon" />
            </button>
            @if (_snapshot is null)
            {
                <div class="sim-header-title">
                    <span class="sim-header-symbol">TRADER SIMULATION</span>
                    <span class="sim-header-state sim-state-setup">@(_isLoading ? "LOADING" : "SETUP")</span>
                </div>
                <div class="sim-header-actions">
                    <button class="sim-ctrl-btn sim-ctrl-btn-play" @onclick="LoadSimulation" disabled="@_isLoading"
                            title="Load the selected data range and brain into a live simulation">
                        @(_isLoading ? "LOADING..." : "LOAD SIMULATION")
                    </button>
                    <button class="sim-ctrl-btn" @onclick="LoadDummySimulation" disabled="@_isLoading"
                            title="Synthetic random-walk ticks -- no Postgres required">
                        LOAD DUMMY DATA
                    </button>
                    @if (_loadError is not null)
                    {
                        <span class="sim-brainrow-error">@_loadError</span>
                    }
                    @if (_error is not null)
                    {
                        <span class="sim-brainrow-error">@_error</span>
                    }
                </div>
            }
            else
            {
                var s = _snapshot;
                var trader = SelectedTrader!;
                <div class="sim-header-title">
                    <span class="sim-header-symbol">@s.Config.Table</span>
                    <span class="sim-header-mode">@(s.Config.Aggregate ? $"{BarSizeOptions.Label((int)s.Config.BarSize.TotalSeconds)} bars" : "raw ticks")</span>
                    <span class="sim-header-mode">viewing: @trader.Label</span>
                    <span class="sim-header-state @StateClass(s)">
                        @(s.IsFinished ? "FINISHED" : s.IsPlaying ? "PLAYING" : "PAUSED")
                    </span>
                </div>
                <div class="sim-stats">
                    <div class="sim-stat">
                        <span class="sim-stat-label">price</span>
                        <span class="sim-stat-value">@PriceStr(s.CurrentPrice)</span>
                    </div>
                    <div class="sim-stat">
                        <span class="sim-stat-label">cash</span>
                        <span class="sim-stat-value">@Money(trader.Capital.Cash)</span>
                    </div>
                    <div class="sim-stat">
                        <span class="sim-stat-label">realized</span>
                        <span
                        class="sim-stat-value @PnlClass(trader.Capital.RealizedPnl)">@Money(trader.Capital.RealizedPnl)</span>
                    </div>
                    <div class="sim-stat">
                        <span class="sim-stat-label">unrealized</span>
                        <span
                        class="sim-stat-value @PnlClass(trader.Capital.UnrealizedPnl)">@Money(trader.Capital.UnrealizedPnl)</span>
                    </div>
                    <div class="sim-stat sim-stat-highlight">
                        <span class="sim-stat-label">equity</span>
                        <span class="sim-stat-value">@Money(trader.Capital.Equity)</span>
                    </div>
                    <div class="sim-stat" title="Margin locked against Equity by the open position -- 0 while flat">
                        <span class="sim-stat-label">margin used</span>
                        <span class="sim-stat-value">@Money(trader.Capital.MarginUsed)</span>
                    </div>
                    <div class="sim-stat"
                         title="Equity ÷ Margin Used -- a stop-out force-closes the position below the configured threshold">
                        <span class="sim-stat-label">margin level</span>
                        <span class="sim-stat-value">@(trader.Capital.MarginLevel is { } level ? $"{level:F1}%" :
                                                                                                     "—")</span>
                        </div>
                        <div class="sim-stat">
                            <span class="sim-stat-label">positions</span>
                            <span class="sim-stat-value">@(trader.Position is not null ? 1 : 0)</span>
                        </div>
                        <div class="sim-stat">
                            <span class="sim-stat-label">trades</span>
                            <span class="sim-stat-value">@trader.TradeCount</span>
                        </div>
                    </div>
                }
            </header>

            <div class="sim-setup">
                @if (!_setupCollapsed)
                {
                <div class="sim-setup-rows">

            <div class="sim-datarow">
                <div class="sim-datarow-field sim-datarow-data">
                    <TickDataSource @bind-Table="_table" @bind-From="_from" @bind-To="_to"
                                    Disabled="@(_isLoading || _snapshot is not null)" />
                </div>
                <div class="sim-datarow-field">
                    <div class="sim-datarow-aggregate">
                        <label class="sim-datarow-checkbox"
                               title="Aggregate into HLOC/AVDT bars instead of raw ticks -- can be changed while a simulation is running">
                            <input type="checkbox" @bind="_aggregate" @bind:after="OnAggregationSettingChanged"
                                   disabled="@_isLoading" />
                            Bars
                        </label>
                        @if (_aggregate)
                        {
                            <BarSizeSelect @bind-Value="_barSizeSeconds" @bind-Value:after="OnAggregationSettingChanged"
                                           Disabled="@_isLoading"
                                           Title="Size of each aggregated bar -- can be changed while a simulation is running" />
                        }
                    </div>
                </div>
            </div>

            <div class="sim-datarow">
                <label class="sim-brainrow-field"
                       title="Only trained models (plus heuristic strategies, which have no weights to train) can be run in Simulation -- an untrained or freshly-built brain never appears here">
                    Brain
                    <select class="sim-brainrow-select" value="@SelectedOptionKey" @onchange="OnSimulationBrainChanged"
                            disabled="@(_isLoading || _snapshot is not null)">
                        <option value="">-- pick a brain --</option>
                        @if (SimulationBrainOptions.Any(o => o.ModelId is not null))
                        {
                            <optgroup label="TRAINED MODELS">
                                @foreach (var o in SimulationBrainOptions.Where(o => o.ModelId is not null))
                                {
                                    <option value="@OptionKey(o)">@o.DisplayName</option>
                                }
                            </optgroup>
                        }
                        @if (SimulationBrainOptions.Any(o => o.ModelId is null))
                        {
                            <optgroup label="HEURISTIC">
                                @foreach (var o in SimulationBrainOptions.Where(o => o.ModelId is null))
                                {
                                    <option value="@OptionKey(o)">@o.DisplayName</option>
                                }
                            </optgroup>
                        }
                    </select>
                </label>
                <label class="sim-brainrow-field">
                    Starting cash
                    <input class="sim-brainrow-input" type="number" min="1" step="100" @bind="_startingCash"
                           disabled="@(_isLoading || _snapshot is not null)" />
                </label>
                <label class="sim-brainrow-field">
                    Traders
                    <input class="sim-brainrow-input sim-brainrow-input-narrow" type="number" min="1" max="20"
                           @bind="_traderCount" disabled="@(_isLoading || _snapshot is not null)" />
                </label>
                <label class="sim-brainrow-field"
                       title="Notional exposure per unit of margin committed -- 1 means no leverage">
                    Leverage
                    <input class="sim-brainrow-input sim-brainrow-input-narrow" type="number" min="1" step="1"
                           @bind="_leverage" disabled="@(_isLoading || _snapshot is not null)" />
                </label>
                <label class="sim-brainrow-field"
                       title="Commission charged per fill, as a percent of that fill's notional value">
                    Commission %
                    <input class="sim-brainrow-input sim-brainrow-input-narrow" type="number" min="0" step="0.01"
                           @bind="_commissionRatePercent" disabled="@(_isLoading || _snapshot is not null)" />
                </label>
                <label class="sim-brainrow-field"
                       title="Force-close the open position when Margin Level (Equity ÷ Margin Used) drops below this percent">
                    Stop-out %
                    <input class="sim-brainrow-input sim-brainrow-input-narrow" type="number" min="1" max="100" step="1"
                           @bind="_stopOutLevelPercent" disabled="@(_isLoading || _snapshot is not null)" />
                </label>
                <label class="sim-brainrow-field"
                       title="Price value of one pip for this instrument -- stop-loss and take-profit distances are entered in pips and converted through this">
                    Pip size
                    <input class="sim-brainrow-input sim-brainrow-input-narrow" type="number" min="0" step="0.00001"
                           @bind="_pipSize" disabled="@(_isLoading || _snapshot is not null)" />
                </label>
            </div>

            @if (RiskPolicyService.AvailablePolicies.Count > 0)
            {
                <div class="sim-datarow sim-riskrow"
                     title="Risk policies gate every trade action -- permit, deny or resize it -- and supervise open positions, on top of the brain and manual controls">
                    <span class="sim-riskrow-label">Risk Policies</span>
                    <PolicySelector Available="RiskPolicyService.AvailablePolicies" Selected="_selectedRiskPolicies"
                                    Disabled="@(_isLoading || _snapshot is not null)" OnChanged="StateHasChanged">
                        <Actions>
                            @if (_selectedRiskPolicies.Count > 0)
                            {
                                <label class="sim-locktoggle"
                                       title="Opt in to fix these policies for the whole run -- once loaded they cannot be toggled during playback">
                                    <input type="checkbox" @bind="_lockRiskPolicies"
                                           disabled="@(_isLoading || _snapshot is not null)" />
                                    Lock for run
                                </label>
                            }
                        </Actions>
                    </PolicySelector>
                </div>
            }

                </div>
                }
            </div>

            @if (_snapshot is not null)
            {
                var s = _snapshot;
                <div class="sim-toolbar">
                    <div class="sim-controls">
                        <button class="sim-ctrl-btn sim-ctrl-btn-play" @onclick="TogglePlayPause" disabled="@s.IsFinished">
                            <Icon Name="@(s.IsPlaying ? "pause-fill" : "play-fill")" Class="sim-ctrl-icon" />
                            @(s.IsPlaying ? "PAUSE" : "PLAY")
                        </button>
                        <button class="sim-ctrl-btn" @onclick="StepOnce" disabled="@(s.IsPlaying || s.IsFinished)">
                            <Icon Name="skip-end-fill" Class="sim-ctrl-icon" />
                            STEP
                        </button>
                        <div class="sim-speed-stepper @(s.IsUncapped ? "sim-speed-stepper-inactive" : "")"
                             title="Playback speed">
                            <button class="sim-ctrl-btn sim-speed-step" @onclick="() => DecreaseSpeed(s)"
                                    disabled="@(SpeedIndex(s) == 0)" title="Slower">−</button>
                            <span class="sim-speed-value">@FormatSpeed(s.SpeedMultiplier)</span>
                            <button class="sim-ctrl-btn sim-speed-step" @onclick="() => IncreaseSpeed(s)"
                                    disabled="@(SpeedIndex(s) == Speeds.Length - 1)" title="Faster">+</button>
                        </div>
                        <button class="sim-ctrl-btn sim-ctrl-btn-max @(s.IsUncapped ? "active" : "")" @onclick="SetMax"
                                title="Uncapped backend speed -- combine with Hide Chart for the fastest runs">MAX</button>
                        <button class="sim-ctrl-btn sim-ctrl-btn-warn" @onclick="ResetSim">RESET</button>
                        <SimTimeline />

                        <div class="sim-controls-right">
                            <span class="sim-toolbar-divider"></span>

                            <button class="sim-ctrl-btn sim-ctrl-btn-warn" @onclick="UnloadSim">NEW SIMULATION</button>
                            <button class="sim-ctrl-btn sim-ctrl-btn-toggle @(_hideChart ? "active" : "")"
                                    @onclick="ToggleHideChart">
                                @(_hideChart ? "SHOW CHART" : "HIDE CHART")
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>

        <div class="sim-body">
            <div class="sim-main">

                @if (_snapshot is null)
                {
                    <div class="sim-setup-content">
                        <SavedBrainsTable SavedBrains="ModelService.Models" OnUse="UseSavedBrain"
                                          OnDelete="DeleteSavedBrainSnapshot"
                                          UseTitle="Loads these weights into the brain and selects it for this simulation -- also what Train's brain picker will use" />
                    </div>
                }

                @if (_snapshot is not null)
                {
                    var s = _snapshot;

                    @if (!_hideChart)
                    {
                        <div class="sim-window-bar">
                            @if (s.Config.Aggregate)
                            {
                                <span class="sim-window-title">PROFILE BARS</span>
                                <div class="sim-window-rail">
                                    <div class="sim-window-track"></div>
                                    <div class="sim-window-fill"
                                         style="width: @(BarWindowFillPercent.ToString("0.##", CultureInfo.InvariantCulture))%"></div>
                                    <input type="range" class="sim-window-slider" min="1" max="@MaxBarWindow" step="1"
                                           @bind="_barWindowSize" @bind:event="oninput"
                                           title="Bars back from now -- their price histograms drive the volume profile window, and the bar itself drives the chart's window-start marker" />
                                </div>
                                <input class="sim-window-input" type="number" min="1" max="@MaxBarWindow" @bind="_barWindowSize"
                                       @bind:event="oninput" />
                            }
                            else
                            {
                                <span class="sim-window-title">TICK WINDOW</span>
                                <div class="sim-window-rail">
                                    <div class="sim-window-track"></div>
                                    <div class="sim-window-fill"
                                         style="width: @(TickWindowFillPercent.ToString("0.##", CultureInfo.InvariantCulture))%"></div>
                                    <input type="range" class="sim-window-slider" min="0" max="@MaxTickWindow" step="1"
                                           @bind="_tickWindowSize" @bind:event="oninput"
                                           title="Ticks back from now -- drives the volume profile window" />
                                </div>
                                <input class="sim-window-input" type="number" min="0" max="@MaxTickWindow" @bind="_tickWindowSize"
                                       @bind:event="oninput" />
                            }
                        </div>

                        <div class="sim-chart-toolbar">
                            @if (s.Config.Aggregate)
                            {
                                <div class="sim-overlay-toggles"
                                     title="Toggle the computed chart overlays alongside the volume profile -- Point of Control/Value Area and a cumulative VWAP line">
                                    <span class="sim-overlay-toggles-label">CHART OVERLAYS</span>
                                    <label class="sim-overlay-toggle"
                                           title="Highlight the Point of Control (most-traded price) and Value Area rows inside the volume profile panel">
                                        <input type="checkbox" @bind="_showProfilePanelLevels" />
                                        <span>POC/VA in profile</span>
                                    </label>
                                    <label class="sim-overlay-toggle"
                                           title="Project the Point of Control/Value Area High/Low as three dashed lines on the main chart">
                                        <input type="checkbox" @bind="_showProfileChartLines" />
                                        <span>POC/VAH/VAL lines</span>
                                    </label>
                                    <label class="sim-overlay-toggle"
                                           title="Show a cumulative volume-weighted average price line on the main chart, over the same bar window as the volume profile">
                                        <input type="checkbox" @bind="_showVwap" />
                                        <span>VWAP line</span>
                                    </label>
                                </div>
                            }
                            <div class="sim-profile-toggles"
                                 title="Show or hide the chart and profile panels">
                                <span class="sim-overlay-toggles-label">PANELS</span>
                                <label class="sim-overlay-toggle"
                                       title="Show or hide the main price chart">
                                    <input type="checkbox" @bind="_showMainChart" />
                                    <span>Chart</span>
                                </label>
                                @if (s.Config.Aggregate)
                                {
                                    <label class="sim-overlay-toggle">
                                        <input type="checkbox" @bind="_showXGrid" />
                                        <span>XGrid</span>
                                    </label>
                                }
                                <label class="sim-overlay-toggle"
                                       title="Volume-at-price histogram over the current window">
                                    <input type="checkbox" @bind="_showVolumeProfile" />
                                    <span>Volume profile</span>
                                </label>
                                <label class="sim-overlay-toggle"
                                       title="Time-at-price histogram over the current window">
                                    <input type="checkbox" @bind="_showTimeProfile" />
                                    <span>Time profile</span>
                                </label>
                            </div>
                        </div>

                        <div class="sim-chart">
                            @if (_showMainChart)
                            {
                                <div class="sim-chart-main">
                                    @if (s.Config.Aggregate)
                                    {
                                        <MarketChart Bars="ToBarRows(s.RecentBars)" KeepView="_keepChartView"
                                                            CurrentBid="s.CurrentBid"
                                                            CurrentAsk="s.CurrentAsk" EntryPrice="SelectedTrader?.Position?.EntryPrice"
                                                            PositionIsLong="SelectedPositionIsLong" StopLossPrice="SelectedTrader?.Position?.StopLossPrice"
                                                            TakeProfitPrice="SelectedTrader?.Position?.TakeProfitPrice"
                                                            WindowStartUtc="WindowStartUtc(s.RecentBars)" HorizontalLines="ProfileLevelLines(s)"
                                                            VwapLine="VwapPoints(s)" />
                                    }
                                    else
                                    {
                                        <ViewDatatable Items="TickRows" Title="RECENT TICKS" />
                                    }
                                </div>
                            }
                            @if (s.Config.Aggregate && _showXGrid)
                            {
                                <div class="sim-chart-divider" @ref="_chartDividerRefXGrid" data-min-width="160"
                                     data-max-width="480" title="Drag to resize"></div>
                                <div class="sim-chart-side @(_xgridCollapsed ? "sim-chart-side-collapsed" : "")">
                                    <XGrid Grid="ComputeXGrid(s)" Positions="XGridPositions(s)"
                                           Pending="XGridPending()" OnOrderPlaced="PlaceXGridOrder"
                                           OnPendingModified="ModifyXGridPending" OnPendingCancelled="CancelXGridPending"
                                           OnPositionClosed="CloseXGridPosition"
                                           @bind-RowCount="_xgridRowCount" @bind-ColCount="_xgridColCount"
                                           @bind-Collapsed="_xgridCollapsed">
                                        <ExpandedControls>
                                            <button class="sim-ctrl-btn sim-ctrl-btn-play" @onclick="TogglePlayPause" disabled="@s.IsFinished"
                                                    title="@(s.IsPlaying ? "Pause playback" : "Resume playback")">
                                                <Icon Name="@(s.IsPlaying ? "pause-fill" : "play-fill")" Class="sim-ctrl-icon" />
                                                @(s.IsPlaying ? "PAUSE" : "PLAY")
                                            </button>
                                            <button class="sim-ctrl-btn" @onclick="StepOnce" disabled="@(s.IsPlaying || s.IsFinished)"
                                                    title="Advance a single step">
                                                <Icon Name="skip-end-fill" Class="sim-ctrl-icon" />
                                                STEP
                                            </button>
                                            <div class="sim-speed-stepper @(s.IsUncapped ? "sim-speed-stepper-inactive" : "")"
                                                 title="Playback speed">
                                                <button class="sim-ctrl-btn sim-speed-step" @onclick="() => DecreaseSpeed(s)"
                                                        disabled="@(SpeedIndex(s) == 0)" title="Slower">−</button>
                                                <span class="sim-speed-value">@FormatSpeed(s.SpeedMultiplier)</span>
                                                <button class="sim-ctrl-btn sim-speed-step" @onclick="() => IncreaseSpeed(s)"
                                                        disabled="@(SpeedIndex(s) == Speeds.Length - 1)" title="Faster">+</button>
                                            </div>
                                            <button class="sim-ctrl-btn sim-ctrl-btn-max @(s.IsUncapped ? "active" : "")" @onclick="SetMax"
                                                    title="Uncapped backend speed">MAX</button>
                                            @if (s.Config.Aggregate)
                                            {
                                                <span class="sim-window-title">PROFILE BARS</span>
                                                <input class="sim-window-input" type="number" min="1" max="@MaxBarWindow"
                                                       @bind="_barWindowSize" @bind:event="oninput"
                                                       title="Bars back from now -- their price histograms drive the volume profile window" />
                                            }
                                        </ExpandedControls>
                                    </XGrid>
                                </div>
                            }
                            @if (_showVolumeProfile)
                            {
                                <div class="sim-chart-divider" @ref="_chartDividerRef" data-min-width="160" data-max-width="480"
                                     title="Drag to resize"></div>
                                <div class="sim-chart-side @(_volumeProfileCollapsed ? "sim-chart-side-collapsed" : "")">
                                    @if (s.Config.Aggregate)
                                    {
                                        <TickVolumeProfileChart WeightedSamples="MergedBarSamples(s)" CurrentPrice="s.CurrentPrice"
                                                                ShowLevels="_showProfilePanelLevels" @bind-Collapsed="_volumeProfileCollapsed" />
                                    }
                                    else
                                    {
                                        <TickVolumeProfileChart Prices="ToMidPrices(s.RecentTicks)" CurrentPrice="s.CurrentPrice"
                                                                WindowSize="ClampedTickWindow" @bind-Collapsed="_volumeProfileCollapsed" />
                                    }
                                </div>
                            }
                            @if (_showTimeProfile)
                            {
                                <div class="sim-chart-divider" @ref="_chartDividerRef2" data-min-width="160" data-max-width="480"
                                     title="Drag to resize"></div>
                                <div class="sim-chart-side @(_timeProfileCollapsed ? "sim-chart-side-collapsed" : "")">
                                    @if (s.Config.Aggregate)
                                    {
                                        <TickTimeProfileChart WeightedSamples="MergedBarTimeSamples(s)" CurrentPrice="s.CurrentPrice"
                                                              @bind-Collapsed="_timeProfileCollapsed" />
                                    }
                                    else
                                    {
                                        <TickTimeProfileChart Ticks="ToTimedMidPrices(s.RecentTicks)" CurrentPrice="s.CurrentPrice"
                                                              WindowSize="ClampedTickWindow" @bind-Collapsed="_timeProfileCollapsed" />
                                    }
                                </div>
                            }
                        </div>

                        <div class="sim-chart-hdivider" @ref="_chartHDividerRef" data-min-height="160" data-max-height-vh="80"
                             title="Drag to resize"></div>
                    }

                    <div class="sim-log-panel">
                        <div class="sim-log-tabs">
                            <button class="sim-tab-btn @(_activeLogTab == LogTab.Traders ? "active" : "")"
                                    @onclick="() => _activeLogTab = LogTab.Traders">TRADERS</button>
                            <button class="sim-tab-btn @(_activeLogTab == LogTab.Brain ? "active" : "")"
                                    @onclick="() => _activeLogTab = LogTab.Brain">BRAIN</button>
                            <button class="sim-tab-btn @(_activeLogTab == LogTab.InputsOutputs ? "active" : "")"
                                    @onclick="() => _activeLogTab = LogTab.InputsOutputs">INPUTS/OUTPUTS</button>
                            <button class="sim-tab-btn @(_activeLogTab == LogTab.Decisions ? "active" : "")"
                                    @onclick="() => _activeLogTab = LogTab.Decisions">DECISION LOG</button>
                            <button class="sim-tab-btn @(_activeLogTab == LogTab.Positions ? "active" : "")"
                                    @onclick="() => _activeLogTab = LogTab.Positions">POSITIONS</button>
                            <button class="sim-tab-btn @(_activeLogTab == LogTab.Statistics ? "active" : "")"
                                    @onclick="() => _activeLogTab = LogTab.Statistics">STATISTICS</button>
                        </div>
                        <div class="sim-log-content">
                            @if (_activeLogTab == LogTab.Decisions)
                            {
                                <DataTable TItem="DecisionLogRow" Items="LogRows" ShowRowNumbers="false" ActionsHeader="VIEW"
                                           CellClass="DecisionLogCellClass" EmptyMessage="no decisions yet" />
                            }
                            else if (_activeLogTab == LogTab.Positions)
                            {
                                <DataTable TItem="OpenPositionRow" Items="OpenPositionRows" ShowRowNumbers="false"
                                           ActionsHeader="VIEW" CellClass="PositionCellClass" EmptyMessage="flat" />
                            }
                            else if (_activeLogTab == LogTab.Traders)
                            {
                                <DataTable TItem="TraderCardItem" Items="TraderItems"
                                           ExcludeProperties="@(new List<string> { "Id" })" ShowRowNumbers="false" ActionsHeader="VIEW"
                                           CellClass="TraderCellClass" OnView="item => SelectTrader(item.Id)" />
                            }
                            else if (_activeLogTab == LogTab.Brain)
                            {
                                <BrainInfoCard BrainName="@s.Config.BrainName"
                                               IsNeuralNetwork="CurrentBrainIsNeuralNetwork(s.Config.BrainName)"
                                               ActiveSnapshot="TrainingService.GetActiveSnapshot(s.Config.BrainName)" />
                            }
                            else if (_activeLogTab == LogTab.InputsOutputs)
                            {
                                <BrainIoPanel Inputs="SelectedTrader?.Inputs" Outputs="SelectedTrader?.Outputs"
                                              CurrentPrice="_snapshot?.CurrentPrice" Equity="SelectedTrader?.Capital.Equity" />
                            }
                            else
                            {
                                <StatisticsPanel Groups="StatGroups" EmptyMessage="no closed trades yet" />
                            }
                        </div>
                    </div>

                    @if (_error is not null)
                    {
                        <p class="sim-error">@_error</p>
                    }
                }
            </div>

            @if (_snapshot is not null)
            {
                @if (!_traderPanelCollapsed)
                {
                    <div class="sim-chart-divider sim-chart-divider-side" @ref="_sidePanelDividerRef"
                         data-min-width="220" data-max-width="640"
                         title="Drag to resize the trader controls panel"></div>
                }
                <div class="sim-sidepanel @(_traderPanelCollapsed ? "sim-sidepanel-collapsed" : "")">
                    <button class="sim-sidepanel-toggle" @onclick="ToggleTraderPanel"
                            title="@(_traderPanelCollapsed ? "Expand trader controls" : "Collapse trader controls")">
                        <Icon Name="@(_traderPanelCollapsed ? "chevron-left" : "chevron-right")"
                              Class="sim-sidepanel-toggle-icon" />
                    </button>
                    @if (!_traderPanelCollapsed)
                    {
                        <div class="sim-sidepanel-content">
                            <TraderControlsPanel TraderId="SelectedTrader?.Id" TraderLabel="SelectedTraderLabel"
                                                 IsManual="SelectedTraderIsManual" PositionSummary="SelectedPositionSummary"
                                                 PendingSummary="SelectedPendingSummary"
                                                 Cash="SelectedTrader?.Capital.Cash ?? 0"
                                                 Leverage="SelectedTrader?.Leverage ?? 1"
                                                 StopOutLevelPercent="SelectedTrader?.StopOutLevelPercent ?? 50"
                                                 PipSize="_snapshot?.Config.PipSize ?? 0.01"
                                                 CurrentPrice="_snapshot?.CurrentPrice"
                                                 CurrentBid="_snapshot?.CurrentBid"
                                                 CurrentAsk="_snapshot?.CurrentAsk" />
                        </div>
                    }
                </div>
                @if (_snapshot?.RiskPolicies.Count > 0)
                {
                    <div class="sim-sidepanel sim-sidepanel-risk">
                        <div class="sim-sidepanel-content">
                            <RiskPolicyPanel Policies="_snapshot.RiskPolicies" Locked="_snapshot.RiskPoliciesLocked"
                                             Statuses="SelectedTrader?.RiskPolicyStatuses" LastDenial="SelectedTrader?.LastDenial" />
                        </div>
                    </div>
                }
            }
        </div>
    </div>
