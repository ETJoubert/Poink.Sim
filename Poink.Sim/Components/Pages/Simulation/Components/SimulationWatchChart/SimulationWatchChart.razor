@namespace Poink.Sim.Components.Simulation
@using Poink.Sim.Components.Charts
@using Poink.Sim.Components.Shared.ViewDatatable

<section class="swc-set" title="@($"{Table} -- watched symbol, its ticks replayed in step with the traded symbol")">
    <header class="swc-header">
        <span class="swc-name" title="Watched symbol's tick table">@Table</span>
        @if (CurrentPrice is { } mid)
        {
            <span class="swc-quote" title="Mid price of this symbol's latest tick at or before the traded symbol's current tick">@mid.ToString("F5")</span>
            <span class="swc-meta" title="Bid / ask of this symbol's latest tick">@CurrentBid?.ToString("F5") / @CurrentAsk?.ToString("F5")</span>
            <span class="swc-meta" title="Time of this symbol's latest tick">@CurrentTimestampUtc?.ToString("yyyy-MM-dd HH:mm:ss")</span>
        }
        else
        {
            <span class="swc-meta" title="This symbol has no tick at or before the traded symbol's current tick yet">no ticks yet</span>
        }
    </header>
    <div class="swc-body">
        @if (Aggregate)
        {
            <MarketChartContainer Bars="Bars" KeepView="KeepView" LiveMode="true" ShowAnnotationTools="false"
                                  CurrentBid="CurrentBid" CurrentAsk="CurrentAsk" />
        }
        else
        {
            <ViewDatatable Items="TickRows" Title="RECENT TICKS" />
        }
    </div>
</section>
