@namespace Poink.Sim.Components.Simulation
@using Poink.Sim.Models

<div class="tcp-panel">
    @if (TraderId is null)
    {
        <p class="tcp-hint">No trader selected.</p>
    }
    else
    {
        <div class="tcp-status">
            @if (PositionSummary is { } position)
            {
                <span>@position</span>
            }
            else if (PendingSummary is { } pending)
            {
                <span>@pending</span>
            }
            else
            {
                <span>FLAT</span>
            }
        </div>

        <div class="tcp-field"
             title="Market fills immediately; Limit/Stop queue a pending order until price crosses the trigger">
            Order type
            <div class="tcp-toggle-group" role="group">
                <button type="button" class="tcp-toggle @(_orderType == OrderType.Market ? "active" : "")"
                        @onclick="() => _orderType = OrderType.Market"
                        title="Fill immediately at the current market price">Market</button>
                <button type="button" class="tcp-toggle @(_orderType == OrderType.Limit ? "active" : "")"
                        @onclick="() => _orderType = OrderType.Limit"
                        title="Queue a pending order until price reaches the trigger from the favourable side">Limit</button>
                <button type="button" class="tcp-toggle @(_orderType == OrderType.Stop ? "active" : "")"
                        @onclick="() => _orderType = OrderType.Stop"
                        title="Queue a pending order until price breaks through the trigger">Stop</button>
            </div>
        </div>

        @if (_orderType != OrderType.Market)
        {
            <label class="tcp-field" title="Price level the pending order triggers at">
                Trigger price
                <input class="tcp-input" type="number" step="0.00001" @bind="_triggerPrice" @bind:event="oninput" />
            </label>
        }

        <div class="tcp-field" title="Direction the Place button enters in">
            Direction
            <div class="tcp-toggle-group" role="group">
                <button type="button" class="tcp-toggle tcp-toggle-buy @(_isLong ? "active" : "")"
                        @onclick="() => _isLong = true"
                        title="Enter long when Place is pressed">BUY</button>
                <button type="button" class="tcp-toggle tcp-toggle-sell @(!_isLong ? "active" : "")"
                        @onclick="() => _isLong = false"
                        title="Enter short when Place is pressed">SELL</button>
            </div>
        </div>

        <div class="tcp-field" title="Position size -- entered directly, or solved from a stop-loss distance and a percent of cash risked">
            <div class="tcp-field-head">
                <span>Volume</span>
                <div class="tcp-toggle-group tcp-toggle-group-sm" role="group">
                    <button type="button" class="tcp-toggle @(_volumeSizingMode == VolumeSizingMode.Manual ? "active" : "")"
                            @onclick="() => _volumeSizingMode = VolumeSizingMode.Manual"
                            title="Enter the position size directly">MANUAL</button>
                    <button type="button" class="tcp-toggle @(_volumeSizingMode == VolumeSizingMode.Risk ? "active" : "")"
                            @onclick="SwitchToRiskSizing"
                            title="Solve the position size from the stop loss distance and a percent of cash risked">% CASH</button>
                </div>
            </div>
            @if (_volumeSizingMode == VolumeSizingMode.Manual)
            {
                <div class="tcp-field-head">
                    <div class="tcp-toggle-group tcp-toggle-group-sm" role="group">
                        <button type="button" class="tcp-toggle @(_volumeMode == VolumeMode.Set ? "active" : "")"
                                @onclick="() => _volumeMode = VolumeMode.Set"
                                title="Enter the exact position size in units">SET</button>
                        <button type="button" class="tcp-toggle @(_volumeMode == VolumeMode.PercentCash ? "active" : "")"
                                @onclick="() => _volumeMode = VolumeMode.PercentCash"
                                title="Enter the position size as a percent of cash committed as margin">% CASH</button>
                    </div>
                </div>
                <div class="tcp-input-row">
                    @if (_volumeMode == VolumeMode.Set)
                    {
                        <input class="tcp-input" type="number" min="0" step="0.01" @bind="_volumeUnits" @bind:event="oninput"
                               title="Exact position size in units" />
                        <button type="button" class="tcp-clear" @onclick="() => _volumeUnits = null"
                                disabled="@(_volumeUnits is null)" title="Clear the volume">×</button>
                    }
                    else
                    {
                        <input class="tcp-input" type="number" min="0.01" max="100" step="1" @bind="_capitalPercent" @bind:event="oninput"
                               title="Percent of cash committed as margin" />
                    }
                </div>
            }
            else
            {
                <div class="tcp-calculated" title="Percent of cash committed as margin, solved from the stop loss and risk percent below">
                    @(CalculatedCapitalFraction is { } cf ? cf.ToString("P1") : "--")
                </div>
                <div class="tcp-input-row">
                    <input class="tcp-input" type="number" min="0" step="0.1" placeholder="% cash to risk"
                           @bind="_riskPercent" @bind:event="oninput"
                           title="Percent of cash to risk if the stop loss is hit -- volume is solved to match" />
                    <button type="button" class="tcp-clear" @onclick="() => _riskPercent = null"
                            disabled="@(_riskPercent is null)" title="Clear the risk percent">×</button>
                </div>
            }
        </div>

        <div class="tcp-field" title="Optional stop loss -- entered as a pip distance or as a percent of cash risked if it is hit">
            <div class="tcp-field-head">
                <span>Stop loss</span>
                @if (_volumeSizingMode == VolumeSizingMode.Manual)
                {
                    <div class="tcp-toggle-group tcp-toggle-group-sm" role="group">
                        <button type="button" class="tcp-toggle @(_stopLossMode == SizingMode.Pips ? "active" : "")"
                                @onclick="() => _stopLossMode = SizingMode.Pips"
                                title="Enter the stop as a distance in pips">PIPS</button>
                        <button type="button" class="tcp-toggle @(_stopLossMode == SizingMode.PercentCash ? "active" : "")"
                                @onclick="() => _stopLossMode = SizingMode.PercentCash"
                                title="Enter the stop as a percent of cash lost if it is hit">% CASH</button>
                    </div>
                }
            </div>
            <div class="tcp-input-row">
                @if (_volumeSizingMode == VolumeSizingMode.Manual && _stopLossMode == SizingMode.PercentCash)
                {
                    <input class="tcp-input" type="number" min="0" step="0.1" @bind="_stopLossPercent" @bind:event="oninput"
                           title="Percent of cash lost if the stop is hit" />
                    <button type="button" class="tcp-clear" @onclick="() => _stopLossPercent = null"
                            disabled="@(_stopLossPercent is null)" title="Clear the stop loss">×</button>
                }
                else
                {
                    <input class="tcp-input" type="number" min="0" step="1" @bind="_stopLossPips" @bind:event="oninput"
                           title="Distance in pips from the entry to the stop, on the losing side" />
                    <button type="button" class="tcp-clear" @onclick="() => _stopLossPips = null"
                            disabled="@(_stopLossPips is null)" title="Clear the stop loss">×</button>
                }
            </div>
        </div>

        <div class="tcp-field" title="Optional take profit -- entered as a pip distance or as a percent of cash gained if it is hit">
            <div class="tcp-field-head">
                <span>Take profit</span>
                <div class="tcp-toggle-group tcp-toggle-group-sm" role="group">
                    <button type="button" class="tcp-toggle @(_takeProfitMode == SizingMode.Pips ? "active" : "")"
                            @onclick="() => _takeProfitMode = SizingMode.Pips"
                            title="Enter the target as a distance in pips">PIPS</button>
                    <button type="button" class="tcp-toggle @(_takeProfitMode == SizingMode.PercentCash ? "active" : "")"
                            @onclick="() => _takeProfitMode = SizingMode.PercentCash"
                            title="Enter the target as a percent of cash gained if it is hit">% CASH</button>
                </div>
            </div>
            <div class="tcp-input-row">
                @if (_takeProfitMode == SizingMode.Pips)
                {
                    <input class="tcp-input" type="number" min="0" step="1" @bind="_takeProfitPips" @bind:event="oninput"
                           title="Distance in pips from the entry to the target, on the winning side" />
                    <button type="button" class="tcp-clear" @onclick="() => _takeProfitPips = null"
                            disabled="@(_takeProfitPips is null)" title="Clear the take profit">×</button>
                }
                else
                {
                    <input class="tcp-input" type="number" min="0" step="0.1" @bind="_takeProfitPercent" @bind:event="oninput"
                           title="Percent of cash gained if the target is hit" />
                    <button type="button" class="tcp-clear" @onclick="() => _takeProfitPercent = null"
                            disabled="@(_takeProfitPercent is null)" title="Clear the take profit">×</button>
                }
            </div>
        </div>

        <div class="tcp-preview" title="Entry, stop, and target prices for this draft">
            <span class="tcp-preview-title">Entry</span>
            @{
                RenderFragment entryRow =
                    @<tr title="Market price at the time of entry, or the Limit/Stop trigger price -- distance to the current market price">
                        <td class="tcp-table-label">Entry</td>
                        <td>@(EntryReferencePrice is { } e ? e.ToString("N5") : "--")</td>
                        <td>@FormatPips(EntryDistancePips)</td>
                    </tr>;
                RenderFragment stopLossRow =
                    @<tr class="loss" title="Stop loss price, with its distance from entry on the losing side">
                        <td class="tcp-table-label">SL</td>
                        <td>@(StopLossPrice is { } sl ? sl.ToString("N5") : "--")</td>
                        <td>@FormatPips(StopLossDistancePips)</td>
                    </tr>;
                RenderFragment takeProfitRow =
                    @<tr class="gain" title="Take profit price, with its distance from entry on the winning side">
                        <td class="tcp-table-label">TP</td>
                        <td>@(TakeProfitPrice is { } tp ? tp.ToString("N5") : "--")</td>
                        <td>@FormatPips(TakeProfitDistancePips)</td>
                    </tr>;
            }
            <table class="tcp-table">
                <thead>
                    <tr>
                        <th></th>
                        <th>Price</th>
                        <th>Dist(pips)</th>
                    </tr>
                </thead>
                <tbody>
                    @if (_isLong)
                    {
                        @takeProfitRow
                        @entryRow
                        @stopLossRow
                    }
                    else
                    {
                        @stopLossRow
                        @entryRow
                        @takeProfitRow
                    }
                </tbody>
            </table>
        </div>

        <div class="tcp-preview" title="Projected size and outcome for this draft">
            <span class="tcp-preview-title">Projections</span>
            <table class="tcp-table">
                <thead>
                    <tr>
                        <th></th>
                        <th>Value</th>
                        <th>% Cash</th>
                    </tr>
                </thead>
                <tbody>
                    <tr title="Margin committed against cash -- capital fraction x cash">
                        <td class="tcp-table-label">Margin use</td>
                        <td>@MarginUsedText</td>
                        <td>@MarginUsedPercentText</td>
                    </tr>
                    <tr title="Cash left uncommitted after this position's margin">
                        <td class="tcp-table-label">Margin free</td>
                        <td>@MarginFreeText</td>
                        <td>@MarginFreePercentText</td>
                    </tr>
                    <tr class="@LossRow.RowClass" title="@LossRow.Title">
                        <td class="tcp-table-label">@LossRow.Label</td>
                        <td>@LossRow.Value</td>
                        <td>@LossRow.Percent</td>
                    </tr>
                    <tr class="gain" title="Money gained if the take profit is hit for this volume from the entry price">
                        <td class="tcp-table-label">Profit</td>
                        <td>@ProfitValueText</td>
                        <td>@ProfitPercentText</td>
                    </tr>
                    <tr title="Reward-to-risk ratio -- projected take-profit gain divided by the stop-loss risk">
                        <td class="tcp-table-label">RR</td>
                        <td colspan="2">@RewardToRiskText</td>
                    </tr>
                </tbody>
            </table>
        </div>

        <div class="tcp-actions">
            <button class="tcp-btn @(_isLong ? "tcp-buy" : "tcp-sell")" @onclick="() => SubmitEntry(_isLong)"
                    title="Place the entry using the selected direction, order type, size, SL and TP">PLACE</button>
            <button class="tcp-btn tcp-btn-warn" @onclick="SubmitCloseOrCancel"
                    title="Close the open position, or cancel a resting pending order">CLOSE / CANCEL</button>
        </div>

        @if (_error is not null)
        {
            <span class="tcp-error">@_error</span>
        }
    }
</div>
