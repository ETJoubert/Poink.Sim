@namespace Poink.Sim.Components.Simulation
@using Poink.Sim.Components.RuleEngine
@using Poink.Sim.Components.Shared.TradeConsole
@using Poink.Sim.Models

<div class="robot-panel">
    <button type="button" class="robot-switch @(Enabled ? "active" : "")" @onclick="() => OnEnabledChanged.InvokeAsync(!Enabled)"
            title="@(Enabled ? "The robot trades whenever its open and close conditions match -- click to switch it off" : "The robot is off and will not trade -- click to let it trade when its conditions match")">
        ROBOT: @(Enabled ? "ON" : "OFF")
    </button>
    <label class="robot-interval"
           title="How often the robot checks its open and close conditions, in simulated seconds -- 0 checks on every tick, larger values keep fast playback responsive">
        Evaluate every (s)
        <input type="number" min="0" step="1" value="@EvaluationSeconds" @onchange="SetEvaluationSeconds" />
    </label>
    <label class="robot-interval"
           title="After any close (robot, stop loss, take profit, stop-out or manual), how many simulated seconds a bot waits before it may open again -- 0 lets it re-enter straight away">
        Cooldown (s)
        <input type="number" min="0" step="1" value="@CooldownSeconds" @onchange="SetCooldownSeconds" />
    </label>
    <label class="robot-interval"
           title="After a close, a side may only open again once its open conditions have stopped matching at least once -- stops the bot re-entering on the same signal it just traded">
        <input type="checkbox" checked="@RequireRearm" @onchange="SetRequireRearm" />
        Re-arm after close
    </label>
    <div class="robot-subtabs">
        <button type="button" class="robot-subtab @(SubTab == RobotSubTab.Positioning ? "active" : "")"
                @onclick="() => SelectSubTab(RobotSubTab.Positioning)"
                title="How the robot sizes a position and places its stop loss and take profit">POSITIONING</button>
        <button type="button" class="robot-subtab @(SubTab == RobotSubTab.Open ? "active" : "")"
                @onclick="() => SelectSubTab(RobotSubTab.Open)"
                title="The conditions that make the robot open a position">OPEN</button>
        <button type="button" class="robot-subtab @(SubTab == RobotSubTab.Close ? "active" : "")"
                @onclick="() => SelectSubTab(RobotSubTab.Close)"
                title="The conditions that make the robot close a position">CLOSE</button>
        <button type="button" class="robot-subtab @(SubTab == RobotSubTab.Signals ? "active" : "")"
                @onclick="() => SelectSubTab(RobotSubTab.Signals)"
                title="Thresholds and lookbacks for the event, zone, regime, session and position signals, shared by every rule set">SIGNALS</button>
    </div>

    <div class="robot-subtab-content">
        @if (SubTab == RobotSubTab.Positioning)
        {
            <TradeConsole SettingsMode="true" MinStopLossDistancePrice="Limits?.MinStopLossDistancePrice" MinTakeProfitDistancePrice="Limits?.MinTakeProfitDistancePrice"
                          PriceStep="Limits?.PriceStep" SymbolVolumeStep="Limits?.VolumeStep" MinVolume="Limits?.MinVolume"
                          MaxVolume="Limits?.MaxVolume" AllowShort="Limits?.AllowShort ?? true"
                          Options="Options" OnOptionsChanged="OnOptionsChanged"
                          HasSelection="HasSelection" Balance="Balance" Leverage="Leverage" PipSize="PipSize"
                          CurrentPrice="CurrentPrice" CurrentBid="CurrentBid" CurrentAsk="CurrentAsk" />
            <RobotPositionRulesPanel Rules="PositionRules" RulesChanged="OnPositionRulesChanged" />
        }
        else if (SubTab == RobotSubTab.Open)
        {
            <div class="robot-subtabs robot-subtabs-nested">
                <button type="button" class="robot-subtab @(OpenSide == RobotSide.Long ? "active" : "")"
                        @onclick="() => SelectOpenSide(RobotSide.Long)"
                        title="The conditions that must hold for the robot to open a long position">LONG</button>
                <button type="button" class="robot-subtab @(OpenSide == RobotSide.Short ? "active" : "")"
                        @onclick="() => SelectOpenSide(RobotSide.Short)"
                        title="The conditions that must hold for the robot to open a short position">SHORT</button>
            </div>
            @RuleEditor(OpenSide == RobotSide.Long ? OpenLongRules : OpenShortRules, false)
        }
        else if (SubTab == RobotSubTab.Signals)
        {
            <RuleSignalSettingsPanel Settings="SignalSettings" SettingsChanged="OnSignalSettingsChanged" />
        }
        else
        {
            <div class="robot-subtabs robot-subtabs-nested">
                <button type="button" class="robot-subtab @(CloseSide == RobotSide.Long ? "active" : "")"
                        @onclick="() => SelectCloseSide(RobotSide.Long)"
                        title="The conditions that must hold for the robot to close a long position">LONG</button>
                <button type="button" class="robot-subtab @(CloseSide == RobotSide.Short ? "active" : "")"
                        @onclick="() => SelectCloseSide(RobotSide.Short)"
                        title="The conditions that must hold for the robot to close a short position">SHORT</button>
            </div>
            @RuleEditor(CloseSide == RobotSide.Long ? CloseLongRules : CloseShortRules, true)
        }
    </div>
</div>

@code {
    private RenderFragment RuleEditor(RobotRuleSet rules, bool isClose) =>
        @<RuleEnginePanel @key="rules" EnabledKeys="rules.EnabledKeys" EnabledKeysChanged="_ => OnRulesChanged.InvokeAsync()"
                          HiddenGroups="isClose ? NoGroups : OpenHiddenGroups"
                          XGridPercent="rules.XGridPercent" XGridPercentChanged="percent => SetXGridPercent(rules, percent)"
                          InTolerancePips="rules.InTolerancePips" InTolerancePipsChanged="pips => SetInTolerancePips(rules, pips)"
                          MinMatches="rules.MinMatches" MinMatchesChanged="count => SetMinMatches(rules, count)"
                          DisabledGroups="rules.DisabledGroups" DisabledGroupsChanged="_ => OnRulesChanged.InvokeAsync()"
                          Result="ComputeRuleEngine(rules)" CurrentTimestampUtc="CurrentTimestampUtc"
                          TxFoldTable="@TxFoldTable" TxFoldAnchorEnd="TxFoldAnchorEnd" TxFoldRangeStart="TxFoldRangeStart"
                          TxFoldSelectedSeconds="TxFoldSelectedSeconds" />;
}
