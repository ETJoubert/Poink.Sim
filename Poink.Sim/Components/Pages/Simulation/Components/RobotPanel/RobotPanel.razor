@namespace Poink.Sim.Components.Simulation
@using Poink.Sim.Components.RuleEngine
@using Poink.Sim.Components.Shared.TradeConsole
@using Poink.Sim.Models

<div class="robot-panel">
    <div class="robot-subtabs">
        <button type="button" class="robot-subtab @(_activeTab == RobotSubTab.Positioning ? "active" : "")"
                @onclick="() => _activeTab = RobotSubTab.Positioning"
                title="How the robot sizes a position and places its stop loss and take profit">POSITIONING</button>
        <button type="button" class="robot-subtab @(_activeTab == RobotSubTab.Open ? "active" : "")"
                @onclick="() => _activeTab = RobotSubTab.Open"
                title="The conditions that make the robot open a position">OPEN</button>
        <button type="button" class="robot-subtab @(_activeTab == RobotSubTab.Close ? "active" : "")"
                @onclick="() => _activeTab = RobotSubTab.Close"
                title="The conditions that make the robot close a position">CLOSE</button>
    </div>

    <div class="robot-subtab-content">
        @if (_activeTab == RobotSubTab.Positioning)
        {
            <TradeConsole SettingsMode="true" Options="Options" OnOptionsSet="OnOptionsChanged"
                          HasSelection="HasSelection" Balance="Balance" Leverage="Leverage" PipSize="PipSize"
                          CurrentPrice="CurrentPrice" CurrentBid="CurrentBid" CurrentAsk="CurrentAsk" />
        }
        else if (_activeTab == RobotSubTab.Open)
        {
            <div class="robot-subtabs robot-subtabs-nested">
                <button type="button" class="robot-subtab @(_openSide == OpenSide.Long ? "active" : "")"
                        @onclick="() => _openSide = OpenSide.Long"
                        title="The conditions that must all hold for the robot to open a long position">LONG</button>
                <button type="button" class="robot-subtab @(_openSide == OpenSide.Short ? "active" : "")"
                        @onclick="() => _openSide = OpenSide.Short"
                        title="The conditions that must all hold for the robot to open a short position">SHORT</button>
            </div>
            @RuleEditor(_openSide == OpenSide.Long ? OpenLongRules : OpenShortRules)
        }
        else
        {
            @RuleEditor(CloseRules)
        }
    </div>
</div>

@code {
    private RenderFragment RuleEditor(RobotRuleSet rules) =>
        @<RuleEnginePanel @key="rules" EnabledKeys="rules.EnabledKeys" EnabledKeysChanged="_ => OnRulesChanged.InvokeAsync()"
                          XGridPercent="rules.XGridPercent" XGridPercentChanged="percent => SetXGridPercent(rules, percent)"
                          Result="ComputeRuleEngine(rules.XGridPercent)" CurrentTimestampUtc="CurrentTimestampUtc"
                          TxFoldTable="@TxFoldTable" TxFoldAnchorEnd="TxFoldAnchorEnd" TxFoldRangeStart="TxFoldRangeStart"
                          TxFoldSelectedSeconds="TxFoldSelectedSeconds" />;
}
