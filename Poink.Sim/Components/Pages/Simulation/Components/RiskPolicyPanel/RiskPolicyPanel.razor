@namespace Poink.Sim.Components.Simulation

<div class="riskpolicy-panel">
    <div class="riskpolicy-panel-header">
        <span class="riskpolicy-panel-title"
              title="Risk policies gate every trade action -- permit, deny or resize -- and supervise open positions for every trader in this run">
            Risk Policies
        </span>
    </div>

    <div class="riskpolicy-panel-list">
        @for (int i = 0; i < Policies.Count; i++)
        {
            var policy = Policies[i];
            var index = i;
            var denied = DeniedBy(policy.Name);
            <div class="riskpolicy-card @(policy.Enabled ? "riskpolicy-card-on" : "riskpolicy-card-off") @(denied ? "riskpolicy-card-denied" : null)"
                 role="button"
                 tabindex="0"
                 aria-pressed="@policy.Enabled"
                 @onclick="() => ToggleCard(policy)"
                 @onkeydown="e => OnCardKey(e, policy)"
                 title="@policy.Description">
                <span class="riskpolicy-card-order" @onclick:stopPropagation="true">
                    <button type="button" class="riskpolicy-order-btn" @onclick="() => MoveRiskPolicy(policy.Name, -1)"
                            disabled="@(index == 0)" title="Run earlier">&#9650;</button>
                    <button type="button" class="riskpolicy-order-btn" @onclick="() => MoveRiskPolicy(policy.Name, 1)"
                            disabled="@(index == Policies.Count - 1)" title="Run later">&#9660;</button>
                </span>
                <span class="riskpolicy-card-indicator"
                      title="@(denied ? $"Denied the last decision: {LastDenial?.Reason}" : policy.Enabled ? "Active -- click to deactivate" : "Inactive -- click to activate")"></span>
                <span class="riskpolicy-card-body">
                    <span class="riskpolicy-card-label">
                        <span class="riskpolicy-card-name">@policy.Name</span>
                        <span class="riskpolicy-card-state">@(policy.Enabled ? "on" : "off")</span>
                    </span>
                    @if (denied)
                    {
                        <span class="riskpolicy-card-denied-badge" title="@LastDenial?.Reason">denied</span>
                    }
                    @if (StatusFor(policy.Name) is { } status)
                    {
                        <span class="riskpolicy-card-status" title="Live state for the trader you are viewing">@status</span>
                    }
                    @if (policy.Parameters.Count > 0)
                    {
                        <span class="riskpolicy-card-parameters" @onclick:stopPropagation="true">
                            @foreach (var parameter in policy.Parameters)
                            {
                                <label class="riskpolicy-parameter" title="@($"{parameter.Label} for {policy.Name} -- range {parameter.Min:0.##} to {parameter.Max:0.##}")">
                                    <span class="riskpolicy-parameter-label">@parameter.Label</span>
                                    <input type="number" class="riskpolicy-parameter-input"
                                           value="@parameter.Value" min="@parameter.Min" max="@parameter.Max" step="@parameter.Step"
                                           title="@($"{parameter.Label} for {policy.Name} -- range {parameter.Min:0.##} to {parameter.Max:0.##}")"
                                           @onchange="e => SetParameter(policy.Name, parameter.Key, e)" />
                                </label>
                            }
                        </span>
                    }
                </span>
            </div>
        }
    </div>
</div>
