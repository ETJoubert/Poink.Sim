@namespace Poink.Sim.Components.TradeMap
@using Poink.Sim.Components.Pages.TradeMap.Models

<div class="@CardClass" title="@Tooltip" role="button" tabindex="0" @onclick="RaiseSelected" @onclick:stopPropagation="true" @onkeydown="HandleKeyDown">
    <div class="tmnc-head">
        <span class="tmnc-eyebrow">@KindLabel</span>
        <span class="tmnc-title">@Node.Title</span>
    </div>

    @foreach (var port in Ports)
    {
        <div class="@PortClass(port)" style="@PortStyle(port)" title="@port.Tooltip">
            <span class="tmnc-port-dot"></span>
            <span class="tmnc-port-label">@port.Label</span>
        </div>
    }
</div>
