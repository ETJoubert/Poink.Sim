@page "/data"
@namespace Poink.Sim.Components.Pages.Data
@using System.IO
@using Poink.Sim.Services.CTrader
@using Poink.Sim.Services.MarketData
@using Poink.Sim.Services.MarketData.Import
@using Poink.Sim.Components.Charts
@using Poink.Sim.Components.Shared.Icon
@using Poink.Sim.Components.Shared.DataTable
@using Poink.Sim.Components.Shared.FolderBrowserDialog

<div class="data-page">

    @if (_showFolderBrowser)
    {
        <FolderBrowserDialog StartPath="@FolderBrowserStartPath()" OnSelect="OnFolderSelected" OnCancel="CloseFolderBrowser" />
    }

    <div class="data-topbar">
        <header class="data-header">
            <div class="data-header-title">
                <span class="data-header-symbol">DATA — TICK INGEST</span>
            </div>
            <div class="data-header-actions">
                @if (!IsConnected)
                {
                    <span class="data-hint" title="Some actions on this page need a connected cTrader session">
                        Not connected — log in on the Trade page.
                    </span>
                }
            </div>
        </header>
        <div class="data-tabs">
            <button class="data-tab @(_activeTab == Tab.Registry ? "active" : "")" @onclick="() => SwitchTab(Tab.Registry)">REGISTRY</button>
            <button class="data-tab @(_activeTab == Tab.Symbols ? "active" : "")" @onclick="() => SwitchTab(Tab.Symbols)">SYMBOLS</button>
            <button class="data-tab @(_activeTab == Tab.Log ? "active" : "")" @onclick="() => SwitchTab(Tab.Log)">LOG</button>
            <button class="data-tab @(_activeTab == Tab.Daily ? "active" : "")" @onclick="() => SwitchTab(Tab.Daily)">DAILY</button>
        </div>
    </div>

    <div class="data-body">

        @if (_activeTab == Tab.Registry)
        {
            <div class="data-registry-layout">
                <aside class="data-import-panel">
                    <div class="data-panel-header">
                        <span class="data-panel-title">IMPORT ZTICKS CACHE</span>
                    </div>

                    <p class="data-empty">
                        Reads cTrader's local .zticks backtesting cache (a reverse-engineered, undocumented,
                        but vetted source) and writes it through the same path as live ingest -- always into
                        the live table, since that's the only data valid for training/simulation.
                    </p>

                    <div class="data-track-controls data-track-controls-column">
                        <input type="text" class="data-search" placeholder="Cache file or folder path..."
                               value="@_importCachePath" @oninput="e => SetImportCachePath(e.Value?.ToString())"
                               title="A single .zticks file, or a folder of them (e.g. the broker's t1 folder) -- saved to the registry on import, so it can be re-scanned for a diff later. cTrader's own cache folder naming (...\live_<account>\#<Symbol>\t1) is read for a symbol and live/demo hint." />
                        <button class="data-btn" @onclick="OpenFolderBrowser" title="Browse the server's filesystem for the cache folder">
                            <Icon Name="folder2-open" Class="data-btn-icon" />
                            BROWSE
                        </button>
                        @if (_pathIsLive == false)
                        {
                            <span class="data-state-pill data-state-error"
                                  title="This cache path's account-environment folder is named demo_<account> -- importing would write demo-sourced ticks into the live table, which the live-only data policy prohibits. Import is disabled until you point at a live-environment cache.">
                                DEMO CACHE — IMPORT BLOCKED
                            </span>
                        }

                        <input type="text" class="data-search" placeholder="Symbol (e.g. USNDAQ100)..."
                               value="@_importSymbol" @oninput="e => _importSymbol = e.Value?.ToString() ?? string.Empty"
                               disabled="@(_selectedRegistryTable is not null)"
                               list="data-import-symbols"
                               title="@(_selectedRegistryTable is not null ? "Bound to the selected registry entry -- change the association via the table's Symbol column instead" : "Symbol name as tracked by Poink.Sim; determines the live_ticks_ table -- auto-filled from the cache path's #<Symbol> folder when left blank")" />
                        <datalist id="data-import-symbols">
                            @foreach (var symbol in Session.Symbols)
                            {
                                <option value="@symbol.SymbolName"></option>
                            }
                        </datalist>

                        <label class="data-checkbox" title="Create the target table if it does not exist yet (explicit opt-in)">
                            <input type="checkbox" @bind="_importCreateTable" />
                            Create table if missing
                        </label>
                    </div>

                    <div class="data-track-controls data-track-controls-column">
                        <button class="data-btn" @onclick="ScanImportAsync"
                                disabled="@(_importScanBusy || ZTicksImport.IsRunning || string.IsNullOrWhiteSpace(_importCachePath))"
                                title="Parse the matching .zticks files and show counts without writing to the database">
                            <Icon Name="search" Class="data-btn-icon" />
                            @(_importScanBusy ? "SCANNING..." : "SCAN")
                        </button>
                        <button class="data-btn data-btn-play" @onclick="StartImport"
                                disabled="@(ZTicksImport.IsRunning || _importScanBusy || _importPreview.Count == 0 || string.IsNullOrWhiteSpace(_importSymbol) || _pathIsLive == false)"
                                title="@(_pathIsLive == false ? "This cache path looks like a demo backtesting cache -- import is blocked" : string.IsNullOrWhiteSpace(_importSymbol) ? "Enter a symbol name first" : $"Write the scanned files into live_ticks_{_importSymbol}")">
                            <Icon Name="cloud-upload" Class="data-btn-icon" />
                            @(ZTicksImport.IsRunning ? "IMPORTING..." : "IMPORT")
                        </button>
                        @if (ZTicksImport.IsRunning)
                        {
                            <button class="data-btn data-btn-warn" @onclick="CancelImport" title="Cancel the running import">
                                <Icon Name="x-lg" Class="data-btn-icon" />
                                CANCEL
                            </button>
                        }
                    </div>
                    @if (_scanResult is not null)
                    {
                        <p class="data-empty" title="@_scanResult">@_scanResult</p>
                    }

                    @if (ZTicksImport.IsRunning && ZTicksImport.Progress is { } progress)
                    {
                        var percent = ImportPercent(progress);
                        <div class="data-progress" title="@($"{Percent(percent)}% -- {progress.FilesDone}/{progress.FilesTotal} day(s)")">
                            <div class="data-progress-track">
                                <div class="data-progress-fill" style="width: @(Percent(percent))%"></div>
                            </div>
                            <span class="data-progress-label">
                                @Percent(percent)% — @progress.FilesDone / @progress.FilesTotal day(s), @Count(progress.TicksParsed) parsed, @Count(progress.RowsWritten) written
                            </span>
                        </div>
                        <p class="data-empty">
                            Running in the background — safe to switch tabs or navigate away. Last finished: @Path.GetFileName(progress.CurrentFile)
                        </p>
                    }
                    else if (ZTicksImport.LastResult is { } lastResult)
                    {
                        <p class="data-empty">
                            Last import: wrote @Count(lastResult.RowsWritten) row(s) of @Count(lastResult.TicksParsed) parsed into @lastResult.Table (@Count(lastResult.FilesProcessed) day(s)).
                        </p>
                    }
                    else if (ZTicksImport.LastError is not null)
                    {
                        <p class="data-empty">Last import failed: @ZTicksImport.LastError</p>
                    }

                    @if (_importPreview.Count > 0)
                    {
                        <div class="data-table-scroll">
                            <table class="data-table">
                                <thead>
                                    <tr>
                                        <th>File</th>
                                        <th>Date</th>
                                        <th class="data-num">Ticks</th>
                                        <th>Min (UTC)</th>
                                        <th>Max (UTC)</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var entry in _importPreview)
                                    {
                                        <tr>
                                            <td class="data-mono">@Path.GetFileName(entry.File)</td>
                                            <td class="data-mono">@(entry.Date?.ToString("yyyy-MM-dd") ?? "—")</td>
                                            <td class="data-num data-mono">@Count(entry.TickCount)</td>
                                            <td class="data-mono">@Time(entry.MinUtc)</td>
                                            <td class="data-mono">@Time(entry.MaxUtc)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else if (!_importScanBusy)
                    {
                        <p class="data-empty">No files scanned yet. Enter a cache path and click Scan.</p>
                    }
                </aside>

                <div class="data-registry-main">
                    @if (SelectedRegistrySymbol is { } selectedSymbol)
                    {
                        <DataSeriesSyncChart SymbolName="@selectedSymbol" RefreshToken="_syncChartRefreshToken" />
                        @if (_importDiff is { } diff)
                        {
                            <div class="data-diff-cards">
                                <div class="data-diff-card" title="Calendar days in the last scan with no tick_daily_stats row yet -- these are what Import will actually write">
                                    <span class="data-diff-card-label">DAYS TO IMPORT</span>
                                    <span class="data-diff-card-value @(diff.DaysMissing > 0 ? "data-diff-warn" : "data-diff-ok")">@diff.DaysMissing</span>
                                </div>
                                <div class="data-diff-card" title="Calendar days present in both the scan and tick_daily_stats, but with a different tick count -- likely a partial or interrupted prior import">
                                    <span class="data-diff-card-label">DAYS MISMATCHED</span>
                                    <span class="data-diff-card-value @(diff.DaysMismatched > 0 ? "data-diff-warn" : "data-diff-ok")">@diff.DaysMismatched</span>
                                </div>
                                <div class="data-diff-card" title="Calendar days already imported with a matching tick count -- Import will skip re-writing these">
                                    <span class="data-diff-card-label">DAYS UP TO DATE</span>
                                    <span class="data-diff-card-value data-diff-ok">@diff.DaysMatching</span>
                                </div>
                            </div>
                            @if (diff.DaysMissing > 0)
                            {
                                <p class="data-empty">@Count(diff.MissingTickCount) tick(s) across @diff.DaysMissing missing day(s) still to import.</p>
                            }
                        }
                        else if (_importPreview.Count == 0)
                        {
                            <p class="data-empty" title="Scan a cache path in the panel on the left to see what's missing from the database">Scan a cache path to check what still needs importing.</p>
                        }
                    }
                    else
                    {
                        <p class="data-empty" title="Click a row in the table below to see its live tick coverage">Select a registry entry below to see its live tick coverage.</p>
                    }

                    <section class="data-panel">
                        <div class="data-panel-header">
                            <span class="data-panel-title">tick_table_stats</span>
                            <span class="data-panel-count">@_registry.Count</span>
                        </div>
                        @if (_registry.Count == 0)
                        {
                            <p class="data-empty">No registry rows.</p>
                        }
                        else
                        {
                            <div class="data-table-scroll">
                                <table class="data-table">
                                    <thead>
                                        <tr>
                                            <th>Table</th>
                                            <th>Symbol</th>
                                            <th class="data-num">Rows</th>
                                            <th class="data-num" title="Distinct calendar days recorded in tick_daily_stats for this table">Days</th>
                                            <th>Min (UTC)</th>
                                            <th>Max (UTC)</th>
                                            <th>Refreshed (UTC)</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var r in _registry)
                                        {
                                            <tr class="data-row-selectable @(r.Table == _selectedRegistryTable ? "data-row-selected" : "")"
                                                @onclick="() => SelectRegistryEntry(r)"
                                                title="@(string.IsNullOrEmpty(r.SourcePath) ? "Select to view this table's live tick coverage above" : $"Select to view coverage above -- saved source: {r.SourcePath}")">
                                                <td class="data-mono">@r.Table</td>
                                                <td class="data-sym">
                                                    <input type="text" class="data-symbol-edit"
                                                           value="@r.Symbol"
                                                           placeholder="—"
                                                           @onchange="e => UpdateRegistrySymbolAsync(r.Table, e.Value?.ToString() ?? string.Empty)"
                                                           @onclick:stopPropagation="true"
                                                           title="Symbol name associated with @r.Table in the registry" />
                                                </td>
                                                <td class="data-num data-mono">@Count(r.Rows)</td>
                                                <td class="data-num data-mono">@Count(r.DayCount)</td>
                                                <td class="data-mono">@Time(r.MinUtc)</td>
                                                <td class="data-mono">@Time(r.MaxUtc)</td>
                                                <td class="data-mono">@Time(r.RefreshedAt)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </section>
                </div>
            </div>
        }
        else if (_activeTab == Tab.Symbols)
        {
            <section class="data-panel">
                <div class="data-panel-header">
                    <span class="data-panel-title">SYMBOLS</span>
                    <span class="data-panel-count">@_symbols.Count</span>
                    <button class="data-btn data-btn-play" @onclick="GetSymbolsAsync"
                            disabled="@(!IsConnected || _symbolsBusy)"
                            title="@(IsConnected ? "Fetch the connected account's latest symbol list from cTrader and save it" : "Log in on the Trade page first")">
                        <Icon Name="cloud-download" Class="data-btn-icon" />
                        @(_symbolsBusy ? "FETCHING..." : "GET SYMBOLS")
                    </button>
                    @if (_symbolsResult is not null)
                    {
                        <span class="data-hint" title="@_symbolsResult">@_symbolsResult</span>
                    }
                </div>

                <DataTable TItem="SymbolRow" Items="Rows" ShowRowNumbers="false"
                           EmptyMessage="No symbols saved yet. Click Get Symbols while connected.">
                    <CustomActions Context="row">
                        <button class="data-table-action-btn" @onclick="() => GetMetadataAsync(row.SymbolId)"
                                disabled="@(!IsConnected || IsMetadataBusy(row.SymbolId))"
                                title="@(IsConnected ? $"Load full trading detail for {row.SymbolName} from the database, or cTrader if not saved yet" : "Log in on the Trade page first")">
                            <Icon Name="info-circle" Class="dt-icon" />
                        </button>
                    </CustomActions>
                    <DetailContent Context="row">
                        @{
                            var metadata = GetMetadata(row.SymbolId);
                        }
                        @if (metadata is null)
                        {
                            <p class="data-empty">
                                No metadata loaded yet.
                                <button class="data-btn data-btn-play" @onclick="() => GetMetadataAsync(row.SymbolId)"
                                        disabled="@(!IsConnected || IsMetadataBusy(row.SymbolId))"
                                        title="Load full trading detail for @row.SymbolName from the database, or cTrader if not saved yet">
                                    @(IsMetadataBusy(row.SymbolId) ? "LOADING..." : "GET METADATA")
                                </button>
                            </p>
                        }
                        else
                        {
                            <div class="data-table-detail-body">
                                <div class="data-table-detail-row">
                                    <span class="data-table-detail-label">DIGITS / PIP POSITION</span>
                                    <span class="data-table-detail-value">@metadata.Digits / @metadata.PipPosition</span>
                                </div>
                                <div class="data-table-detail-row">
                                    <span class="data-table-detail-label">LOT SIZE</span>
                                    <span class="data-table-detail-value">@metadata.LotSize</span>
                                </div>
                                <div class="data-table-detail-row">
                                    <span class="data-table-detail-label">MIN / MAX / STEP VOLUME</span>
                                    <span class="data-table-detail-value">@metadata.MinVolume / @metadata.MaxVolume / @metadata.StepVolume</span>
                                </div>
                                <div class="data-table-detail-row">
                                    <span class="data-table-detail-label">MAX EXPOSURE</span>
                                    <span class="data-table-detail-value">@metadata.MaxExposure</span>
                                </div>
                                <div class="data-table-detail-row">
                                    <span class="data-table-detail-label">SWAP LONG / SHORT</span>
                                    <span class="data-table-detail-value">@metadata.SwapLong / @metadata.SwapShort (@metadata.SwapCalculationType)</span>
                                </div>
                                <div class="data-table-detail-row">
                                    <span class="data-table-detail-label">COMMISSION</span>
                                    <span class="data-table-detail-value">@metadata.PreciseTradingCommissionRate (@metadata.CommissionType), min @metadata.PreciseMinCommission @metadata.MinCommissionAsset</span>
                                </div>
                                <div class="data-table-detail-row">
                                    <span class="data-table-detail-label">TRADING MODE</span>
                                    <span class="data-table-detail-value">@metadata.TradingMode</span>
                                </div>
                                <div class="data-table-detail-row">
                                    <span class="data-table-detail-label">SHORT SELLING / GUARANTEED SL</span>
                                    <span class="data-table-detail-value">@(metadata.EnableShortSelling ? "Yes" : "No") / @(metadata.GuaranteedStopLoss ? "Yes" : "No")</span>
                                </div>
                                <div class="data-table-detail-row">
                                    <span class="data-table-detail-label">SCHEDULE</span>
                                    <span class="data-table-detail-value">@metadata.ScheduleIntervals.Count interval(s), @metadata.ScheduleTimeZone</span>
                                </div>
                                <div class="data-table-detail-row">
                                    <span class="data-table-detail-label">HOLIDAYS</span>
                                    <span class="data-table-detail-value">@metadata.Holidays.Count</span>
                                </div>
                                <div class="data-table-detail-row">
                                    <span class="data-table-detail-label">FETCHED</span>
                                    <span class="data-table-detail-value">@Time(metadata.ChangedAt ?? metadata.CreatedAt)</span>
                                </div>
                            </div>
                        }
                    </DetailContent>
                </DataTable>
            </section>
        }
        else if (_activeTab == Tab.Log)
        {
            <section class="data-panel">
                <div class="data-panel-header">
                    <span class="data-panel-title">tick_backfill_log</span>
                    <span class="data-panel-count">@FilteredLog.Count</span>
                </div>

                <div class="data-track-controls">
                    <input type="text" class="data-search" placeholder="Filter by symbol..."
                           value="@_logSymbolFilter" @oninput="e => _logSymbolFilter = e.Value?.ToString() ?? string.Empty"
                           title="Filter the backfill log by symbol name" />
                </div>

                @if (FilteredLog.Count == 0)
                {
                    <p class="data-empty">No backfill log rows@(string.IsNullOrWhiteSpace(_logSymbolFilter) ? "" : $" matching '{_logSymbolFilter}'").</p>
                }
                else
                {
                    <div class="data-table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Table</th>
                                    <th>Symbol</th>
                                    <th>From (UTC)</th>
                                    <th>To (UTC)</th>
                                    <th class="data-num">Records</th>
                                    <th>Trigger</th>
                                    <th>Triggered (UTC)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in FilteredLog)
                                {
                                    <tr>
                                        <td class="data-mono">@e.TickTableName</td>
                                        <td class="data-sym">@e.SymbolName</td>
                                        <td class="data-mono">@Time(e.BackfillFrom)</td>
                                        <td class="data-mono">@Time(e.BackfillTo)</td>
                                        <td class="data-num data-mono">@Count(e.RecordCount)</td>
                                        <td>
                                            <span class="data-state-pill @(e.TriggerEntity == BackfillTrigger.User ? "data-state-live" : "data-state-idle")"
                                                  title="Triggered by @e.TriggerEntity">@e.TriggerEntity.ToString().ToUpperInvariant()</span>
                                        </td>
                                        <td class="data-mono">@Time(e.TriggeredAtUtc)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }
        else
        {
            <section class="data-panel">
                <div class="data-panel-header">
                    <span class="data-panel-title">tick_daily_stats</span>
                    <span class="data-panel-count">@_dailyStats.Count</span>
                </div>

                <p class="data-empty">
                    One row per calendar day per table: row count and time bounds, refreshed on each import. A gap
                    of more than one day between consecutive rows means a day's data (and likely its .zticks file)
                    is missing — check this instead of scanning the full tick table.
                </p>

                <div class="data-track-controls">
                    <select class="data-search data-search-narrow" value="@_dailyStatsTable"
                            @onchange="e => SelectDailyStatsTable(e.Value?.ToString() ?? string.Empty)"
                            title="Which tick table's daily rollup to inspect">
                        <option value="">Select a table...</option>
                        @foreach (var r in _registry)
                        {
                            <option value="@r.Table">@r.Table</option>
                        }
                    </select>
                    @{
                        var gapCount = CountGaps(_dailyStats);
                    }
                    @if (gapCount > 0)
                    {
                        <span class="data-state-pill data-state-error"
                              title="@gapCount day(s) preceded by more than a one-day gap — a .zticks file is likely missing">
                            @gapCount GAP@(gapCount == 1 ? "" : "S")
                        </span>
                    }
                </div>

                @if (string.IsNullOrEmpty(_dailyStatsTable))
                {
                    <p class="data-empty">Pick a table to inspect its daily row counts and time bounds.</p>
                }
                else if (_dailyStats.Count == 0)
                {
                    <p class="data-empty">No daily stats recorded yet for @_dailyStatsTable. Run an import to populate this table.</p>
                }
                else
                {
                    <div class="data-table-scroll">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Day</th>
                                    <th class="data-num">Ticks</th>
                                    <th>Min (UTC)</th>
                                    <th>Max (UTC)</th>
                                    <th>Refreshed (UTC)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (var i = 0; i < _dailyStats.Count; i++)
                                {
                                    var row = _dailyStats[i];
                                    var missing = i > 0 ? row.Day.DayNumber - _dailyStats[i - 1].Day.DayNumber - 1 : 0;
                                    <tr class="@(missing > 0 ? "data-row-gap" : "")">
                                        <td class="data-mono">
                                            @row.Day.ToString("yyyy-MM-dd")
                                            @if (missing > 0)
                                            {
                                                <span class="data-state-pill data-state-error"
                                                      title="@missing day(s) missing before this one">GAP</span>
                                            }
                                        </td>
                                        <td class="data-num data-mono">@Count(row.RowCount)</td>
                                        <td class="data-mono">@Time(row.MinUtc)</td>
                                        <td class="data-mono">@Time(row.MaxUtc)</td>
                                        <td class="data-mono">@Time(row.RefreshedAt)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        }

    </div>

</div>
