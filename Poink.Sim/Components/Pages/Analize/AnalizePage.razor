@page "/analize"
@namespace Poink.Sim.Components.Pages.Analize
@using Poink.Sim.Components.Charts
@using Poink.Sim.Components.Shared.BarSizeSelect
@using Poink.Sim.Components.Shared.DataTable
@using Poink.Sim.Components.Shared.Icon
@using Poink.Sim.Components.Shared.TickDataSource
@using Poink.Sim.Models
@using Poink.Sim.Repository

<div class="analize-page">
    <div class="analize-topbar">
        <header class="analize-header">
            <span class="analize-title">ANALYSIS</span>

            <div class="analize-header-data">
                <TickDataSource @bind-Table="_table" @bind-From="_from" @bind-To="_to" />
            </div>
        </header>
    </div>

    <div class="analize-body">
        <aside class="analize-left-side-panel @(_leftPanelCollapsed ? "analize-left-side-panel-collapsed" : "")">
            <div class="analize-side-panel-header">
                <button type="button" class="analize-side-panel-toggle" @onclick="() => _leftPanelCollapsed = !_leftPanelCollapsed"
                        title="@(_leftPanelCollapsed ? "Expand panel" : "Collapse panel")">
                    <Icon Name="@(_leftPanelCollapsed ? "chevron-right" : "chevron-left")" Class="analize-side-panel-toggle-icon" />
                </button>
                @if (!_leftPanelCollapsed)
                {
                    <span class="analize-side-panel-label">OVERVIEW</span>
                }
            </div>
            @if (!_leftPanelCollapsed)
            {
                <div class="analize-side-panel-tabs">
                    <button type="button" class="analize-side-panel-tab @(_activeLeftTab == AnalizeLeftTab.Analyses ? "active" : "")"
                            @onclick="() => _activeLeftTab = AnalizeLeftTab.Analyses" title="Configure and run an analysis">
                        ANALYSES
                    </button>
                    <button type="button" class="analize-side-panel-tab @(_activeLeftTab == AnalizeLeftTab.Session ? "active" : "")"
                            @onclick="() => _activeLeftTab = AnalizeLeftTab.Session" title="Analyses run this page visit -- save any of them to History">
                        SESSION@(_sessionEntries.Count > 0 ? $" ({_sessionEntries.Count})" : "")
                    </button>
                    <button type="button" class="analize-side-panel-tab @(_activeLeftTab == AnalizeLeftTab.History ? "active" : "")"
                            @onclick="() => _activeLeftTab = AnalizeLeftTab.History" title="Analyses saved to the database">
                        HISTORY@(_historyEntries.Count > 0 ? $" ({_historyEntries.Count})" : "")
                    </button>
                </div>
                <div class="analize-side-panel-content">
                @if (_activeLeftTab == AnalizeLeftTab.Session)
                {
                    @if (_sessionEntries.Count == 0)
                    {
                        <p class="analize-side-panel-placeholder">no analyses run yet this session</p>
                    }
                    else
                    {
                        @foreach (var entry in _sessionEntries)
                        {
                            <AnalysisDetailCard Snapshot="@BuildDetailView(entry)" ShowLabelHeader="true" SelectedSeries="@_returnSelectedSeries"
                                                 Clickable="true" OnCardClick="@(() => SelectSessionEntry(entry))">
                                <Actions>
                                    @if (entry.SavedHistoryId is not null)
                                    {
                                        <span class="analysis-detail-card-saved-badge" title="Already saved to History">SAVED</span>
                                    }
                                    else
                                    {
                                        <button type="button" class="analize-card-view-btn" @onclick="() => SaveSessionEntry(entry)" title="Persist this run to History">
                                            SAVE
                                        </button>
                                    }
                                </Actions>
                            </AnalysisDetailCard>
                        }
                    }
                }
                else if (_activeLeftTab == AnalizeLeftTab.History)
                {
                    @if (_historyEntries.Count == 0)
                    {
                        <p class="analize-side-panel-placeholder">no saved analyses yet</p>
                    }
                    else
                    {
                        @foreach (var record in _historyEntries)
                        {
                            <AnalysisDetailCard Snapshot="@BuildDetailView(record)" ShowLabelHeader="true" SelectedSeries="@_returnSelectedSeries"
                                                 Clickable="true" OnCardClick="@(() => LoadHistoryEntry(record.Id))">
                                <Actions>
                                    <button type="button" class="analize-card-view-btn" @onclick="() => DeleteHistoryEntry(record.Id)" title="Discard this saved analysis">
                                        DELETE
                                    </button>
                                </Actions>
                            </AnalysisDetailCard>
                        }
                    }
                }
                else
                {
                    <div class="card analize-card @(_activeAnalysis == ActiveAnalysis.TimeAboveBelow ? "analize-card-active" : "")"
                         title="For each point in time, what fraction of the next X minutes is price above that point">
                        <div class="analize-card-title-row">
                            <button type="button" class="analize-card-collapse-btn"
                                    @onclick="() => _timeAboveBelowCardCollapsed = !_timeAboveBelowCardCollapsed"
                                    title="@(_timeAboveBelowCardCollapsed ? "Expand" : "Collapse")">
                                <Icon Name="@(_timeAboveBelowCardCollapsed ? "chevron-right" : "chevron-down")" Class="analize-card-collapse-icon" />
                            </button>
                            <span class="analize-card-title">Time Above/Below Distribution</span>
                            @if (_activeAnalysis == ActiveAnalysis.TimeAboveBelow)
                            {
                                <span class="analize-card-active-badge" title="Shown in the main and DETAILS panels">ACTIVE</span>
                            }
                            else
                            {
                                <button type="button" class="analize-card-view-btn" @onclick="() => _activeAnalysis = ActiveAnalysis.TimeAboveBelow"
                                        title="Show this analysis's results in the main and DETAILS panels">
                                    VIEW
                                </button>
                            }
                        </div>

                        @if (!_timeAboveBelowCardCollapsed)
                        {
                            <label class="analize-field" title="How many minutes forward to look from each point in the series">
                                Window (minutes)
                                <input class="analize-input" type="number" min="1" step="1" @bind="_timeAboveBelowWindowMinutes"
                                       disabled="@TimeAboveBelowService.IsRunning" />
                            </label>

                            @if (!TimeAboveBelowService.IsRunning)
                            {
                                <button type="button" class="analize-btn analize-btn-run" @onclick="RunTimeAboveBelow"
                                        title="Streams every tick in the selected symbol/date range and computes the distribution -- can take a while on large ranges">
                                    RUN
                                </button>
                            }
                            else
                            {
                                <button type="button" class="analize-btn analize-btn-cancel" @onclick="() => TimeAboveBelowService.Cancel()"
                                        title="Stop the analysis currently in progress">
                                    CANCEL
                                </button>
                                <div class="analize-progress">
                                    <div class="analize-progress-bar">
                                        <div class="analize-progress-fill" style="width: @(TimeAboveBelowProgressPercentText)%"></div>
                                    </div>
                                    <span class="analize-progress-text">@(TimeAboveBelowProgressPercentText)%</span>
                                </div>
                            }

                            @if (_timeAboveBelowStartError is not null)
                            {
                                <p class="analize-error">@_timeAboveBelowStartError</p>
                            }
                            @if (TimeAboveBelowService.Error is not null)
                            {
                                <p class="analize-error">@TimeAboveBelowService.Error</p>
                            }
                            @if (TimeAboveBelowService.WasCancelled)
                            {
                                <p class="analize-note">cancelled</p>
                            }
                        }
                    </div>

                    <div class="card analize-card @(_activeAnalysis == ActiveAnalysis.ReturnProbability ? "analize-card-active" : "")"
                         title="For each point in time, does price ever come back to that same price within the next X minutes">
                        <div class="analize-card-title-row">
                            <button type="button" class="analize-card-collapse-btn"
                                    @onclick="() => _returnCardCollapsed = !_returnCardCollapsed"
                                    title="@(_returnCardCollapsed ? "Expand" : "Collapse")">
                                <Icon Name="@(_returnCardCollapsed ? "chevron-right" : "chevron-down")" Class="analize-card-collapse-icon" />
                            </button>
                            <span class="analize-card-title">Return Probability</span>
                            @if (_activeAnalysis == ActiveAnalysis.ReturnProbability)
                            {
                                <span class="analize-card-active-badge" title="Shown in the main and DETAILS panels">ACTIVE</span>
                            }
                            else
                            {
                                <button type="button" class="analize-card-view-btn" @onclick="() => _activeAnalysis = ActiveAnalysis.ReturnProbability"
                                        title="Show this analysis's results in the main and DETAILS panels">
                                    VIEW
                                </button>
                            }
                        </div>

                        @if (!_returnCardCollapsed)
                        {
                            <label class="analize-field analize-field-row"
                                   title="Run the same check on aggregated bars instead of raw ticks -- far fewer points, using each bar's traded range, at the cost of return-time precision">
                                <input type="checkbox" @bind="_returnUseAggregation" disabled="@ReturnService.IsRunning" />
                                Aggregation
                            </label>

                            @if (_returnUseAggregation)
                            {
                                <label class="analize-field"
                                       title="OHLC checks each bar's Open/High/Low/Close; Quartile checks each bar's Min/Q1/Median/Q3/Max five-number summary instead">
                                    Bar kind
                                    <select class="analize-input" @bind="_returnAggregationKind" disabled="@ReturnService.IsRunning">
                                        <option value="@BarAggregationKind.Ohlc">OHLC</option>
                                        <option value="@BarAggregationKind.Quartile">Quartile</option>
                                    </select>
                                </label>
                                <BarSizeSelect @bind-Value="_returnAggregationBarWidthSeconds" Disabled="@ReturnService.IsRunning" Label="Bar width" />
                                <label class="analize-field"
                                       title="How many bars forward to watch, as a whole multiple of the bar width above -- so the window always ends exactly on a bar edge">
                                    Window (bars)
                                    <input class="analize-input" type="number" min="1" step="1" @bind="_returnWindowBars"
                                           disabled="@ReturnService.IsRunning" />
                                </label>
                                <p class="analize-caption">= @(ReturnWindowBarsMinutesText) min, @_returnWindowBars buckets (1 per bar)</p>
                            }
                            else
                            {
                                <label class="analize-field" title="How many minutes forward to watch for price returning to its starting point">
                                    Window (minutes)
                                    <input class="analize-input" type="number" min="1" step="1" @bind="_returnWindowMinutes"
                                           disabled="@ReturnService.IsRunning" />
                                </label>
                            }

                            @if (!ReturnService.IsRunning)
                            {
                                <button type="button" class="analize-btn analize-btn-run" @onclick="RunReturnProbability"
                                        title="Streams every tick in the selected symbol/date range and computes the return probability -- can take a while on large ranges">
                                    RUN
                                </button>
                            }
                            else
                            {
                                <button type="button" class="analize-btn analize-btn-cancel" @onclick="() => ReturnService.Cancel()"
                                        title="Stop the analysis currently in progress">
                                    CANCEL
                                </button>
                                <div class="analize-progress">
                                    <div class="analize-progress-bar">
                                        <div class="analize-progress-fill" style="width: @(ReturnProgressPercentText)%"></div>
                                    </div>
                                    <span class="analize-progress-text">@(ReturnProgressPercentText)%</span>
                                </div>
                            }

                            @if (_returnStartError is not null)
                            {
                                <p class="analize-error">@_returnStartError</p>
                            }
                            @if (ReturnService.Error is not null)
                            {
                                <p class="analize-error">@ReturnService.Error</p>
                            }
                            @if (ReturnService.WasCancelled)
                            {
                                <p class="analize-note">cancelled</p>
                            }
                            @if (ReturnService.Result is { SampleCount: > 0 } returnSummary)
                            {
                                <p class="analize-caption">
                                    @((returnSummary.ReturnProbability * 100).ToString("N1"))% chance of returning within @ReturnEffectiveWindowText
                                </p>
                            }
                        }
                    </div>
                    <div class="card analize-card @(_activeAnalysis == ActiveAnalysis.BarrierMap ? "analize-card-active" : "")"
                         title="Open a trade every few seconds through the range and test it against a grid of stop-loss and take-profit sizes and time limits">
                        <div class="analize-card-title-row">
                            <button type="button" class="analize-card-collapse-btn"
                                    @onclick="() => _barrierCardCollapsed = !_barrierCardCollapsed"
                                    title="@(_barrierCardCollapsed ? "Expand" : "Collapse")">
                                <Icon Name="@(_barrierCardCollapsed ? "chevron-right" : "chevron-down")" Class="analize-card-collapse-icon" />
                            </button>
                            <span class="analize-card-title">Barrier Map</span>
                            @if (_activeAnalysis == ActiveAnalysis.BarrierMap)
                            {
                                <span class="analize-card-active-badge" title="Shown in the main and DETAILS panels">ACTIVE</span>
                            }
                            else
                            {
                                <button type="button" class="analize-card-view-btn" @onclick="() => _activeAnalysis = ActiveAnalysis.BarrierMap"
                                        title="Show this analysis's results in the main and DETAILS panels">
                                    VIEW
                                </button>
                            }
                        </div>

                        @if (!_barrierCardCollapsed)
                        {
                            <label class="analize-field" title="Stop-loss sizes to test, in pips, comma separated">
                                Stop losses (pips)
                                <input class="analize-input" type="text" @bind="_barrierStopsText" disabled="@BarrierService.IsRunning" />
                            </label>
                            <label class="analize-field" title="Take-profit sizes to test, in pips, comma separated">
                                Take profits (pips)
                                <input class="analize-input" type="text" @bind="_barrierTargetsText" disabled="@BarrierService.IsRunning" />
                            </label>
                            <label class="analize-field" title="Minutes a trade may stay open before it is closed at the market, comma separated">
                                Time limits (minutes)
                                <input class="analize-input" type="text" @bind="_barrierLimitsText" disabled="@BarrierService.IsRunning" />
                            </label>
                            <label class="analize-field" title="Seconds between trade entries -- one long and one short is opened at each">
                                Entry every (seconds)
                                <input class="analize-input" type="number" min="1" step="1" @bind="_barrierSpacingSeconds" disabled="@BarrierService.IsRunning" />
                            </label>
                            <label class="analize-field" title="Price size of one pip -- filled from the symbol's metadata when you run, editable when it is not known">
                                Pip size
                                <input class="analize-input" type="number" min="0" step="any" @bind="_barrierPipSize" disabled="@BarrierService.IsRunning" />
                            </label>

                            @if (!BarrierService.IsRunning)
                            {
                                <button type="button" class="analize-btn analize-btn-run" @onclick="RunBarrierMap"
                                        title="Reads every tick in the selected symbol/date range and tests every stop/target/time-limit combination -- can take a while on large ranges">
                                    RUN
                                </button>
                            }
                            else
                            {
                                <button type="button" class="analize-btn analize-btn-cancel" @onclick="() => BarrierService.Cancel()"
                                        title="Stop the analysis currently in progress">
                                    CANCEL
                                </button>
                                <div class="analize-progress">
                                    <div class="analize-progress-bar">
                                        <div class="analize-progress-fill" style="width: @(BarrierProgressPercentText)%"></div>
                                    </div>
                                    <span class="analize-progress-text">@(BarrierProgressPercentText)%</span>
                                </div>
                            }

                            @if (_barrierStartError is not null)
                            {
                                <p class="analize-error">@_barrierStartError</p>
                            }
                            @if (BarrierService.Error is not null)
                            {
                                <p class="analize-error">@BarrierService.Error</p>
                            }
                            @if (BarrierService.WasCancelled)
                            {
                                <p class="analize-note">cancelled</p>
                            }
                        }
                    </div>
                }
                </div>
            }
        </aside>

        <main class="analize-main">
            <div class="analize-tabs">
                <button type="button" class="analize-btn-toggle @(_activeMainTab == AnalizeMainTab.Chart ? "analize-btn-toggle-active" : "")"
                        @onclick="() => _activeMainTab = AnalizeMainTab.Chart" title="Bar chart view of the distribution">
                    CHART
                </button>
                <button type="button" class="analize-btn-toggle @(_activeMainTab == AnalizeMainTab.Results ? "analize-btn-toggle-active" : "")"
                        @onclick="() => _activeMainTab = AnalizeMainTab.Results" title="Raw bucket counts as a table">
                    RESULTS
                </button>
                <button type="button" class="analize-btn-toggle @(_activeMainTab == AnalizeMainTab.Price ? "analize-btn-toggle-active" : "")"
                        @onclick="SelectPriceTab" title="Price chart for the selected symbol and date range">
                    PRICE
                </button>
            </div>

            @if (_pinnedTimeAboveBelow is not null || _pinnedReturn is not null)
            {
                <div class="analysis-detail-pinned-banner">
                    <span>viewing a saved/session run, not the live result</span>
                    <button type="button" class="analize-card-view-btn" @onclick="ClearPin" title="Go back to showing the live analysis result">
                        BACK TO LIVE
                    </button>
                </div>
            }

            <div class="analize-content">
                @if (_activeAnalysis == ActiveAnalysis.BarrierMap && _activeMainTab != AnalizeMainTab.Price)
                {
                    <div class="card analize-card analize-card-fill" title="Barrier map for the selected data">
                        @if (BarrierService.Result is not { } barrierResult || _barrierSelection is not { } barrierSelection)
                        {
                            <p class="analize-side-panel-placeholder">Set the sizes and click RUN (Barrier Map) in the left panel to see the map</p>
                        }
                        else if (_activeMainTab == AnalizeMainTab.Chart)
                        {
                            <BarrierMapView Result="barrierResult" Selection="barrierSelection" SelectionChanged="selection => _barrierSelection = selection" />
                        }
                        else
                        {
                            <div class="analize-price-toolbar">
                                <button type="button" class="analize-btn" @onclick="ExportBarrierCsvAsync"
                                        title="Download every cell of every side and time limit as a CSV file">
                                    EXPORT CSV
                                </button>
                            </div>
                            <DataTable TItem="BarrierResultRow" Items="@BarrierResultRows" ShowActions="false" ShowRowNumbers="false"
                                       EmptyMessage="no cells for this side and time limit" />
                        }
                    </div>
                }
                else if (_activeMainTab == AnalizeMainTab.Chart && _activeAnalysis == ActiveAnalysis.TimeAboveBelow)
                {
                    <div class="card analize-card analize-card-fill" title="Time-above distribution for the selected data and window">
                        <HistogramChart Bins="@TimeAboveBelowChartBins" Title="TIME ABOVE DISTRIBUTION" ValueUnit="%" ValueScale="100"
                                         EmptyMessage="Set a window and click RUN (Time Above/Below) in the left panel to see the distribution" />
                        @if (CurrentTimeAboveBelowView is not null)
                        {
                            <p class="analize-caption" title="Each point's time above and time below the same window always add up to 100%">
                                each bucket's mirror (100% minus its value) is that same time spent below -- see DETAILS for both explicitly
                            </p>
                        }
                    </div>
                }
                else if (_activeMainTab == AnalizeMainTab.Chart)
                {
                    <div class="card analize-card analize-card-fill" title="Time-to-return distribution for the selected data and window">
                        @if (CurrentReturnView?.Result.SeriesBreakdown is not null)
                        {
                            <div class="analize-series-tabs">
                                @foreach (var name in ReturnChartSeriesNames)
                                {
                                    <button type="button" class="analize-btn-toggle @(_returnSelectedSeries == name ? "analize-btn-toggle-active" : "")"
                                            @onclick="() => _returnSelectedSeries = name"
                                            title="@(name == "All" ? $"Show {string.Join('/', ReturnSeriesNames)} together, one color per series" : $"Show the {name}-based series")">
                                        @name
                                    </button>
                                }
                            </div>
                        }
                        @if (_returnSelectedSeries == "All" && CurrentReturnView?.Result.SeriesBreakdown is not null)
                        {
                            <HistogramChart Series="@ReturnAllSeriesChart" SampleCount="@CurrentReturnView?.Result.SampleCount" Title="TIME TO RETURN DISTRIBUTION -- ALL SERIES"
                                             EmptyMessage="Set a window and click RUN (Return Probability) in the left panel to see the distribution" />
                        }
                        else
                        {
                            <HistogramChart Bins="@ReturnChartBins" Title="TIME TO RETURN DISTRIBUTION" ValueUnit="@(SelectedReturnSeries.Unit == "bars" ? " bars" : " min")" ValueScale="1"
                                             EmptyMessage="Set a window and click RUN (Return Probability) in the left panel to see the distribution" />
                        }
                        @if (CurrentReturnView is { } returnChartView)
                        {
                            <p class="analize-caption" title="Bucket counts cover only the points that did return -- see DETAILS for the overall chance">
                                @((returnChartView.Result.ReturnProbability * 100).ToString("N1"))% of points returned at all;
                                buckets show how long that took for those that did -- see DETAILS for the full breakdown
                            </p>
                        }
                    </div>
                }
                else if (_activeMainTab == AnalizeMainTab.Results && _activeAnalysis == ActiveAnalysis.TimeAboveBelow)
                {
                    <div class="card analize-card analize-card-fill" title="Raw bucket counts for the most recently completed run">
                        <DataTable TItem="AnalizeBinRow" Items="@TimeAboveBelowResultRows" ShowActions="false" ShowRowNumbers="false"
                                   EmptyMessage="Set a window and click RUN (Time Above/Below) in the left panel to see results" />
                    </div>
                }
                else if (_activeMainTab == AnalizeMainTab.Results)
                {
                    <div class="card analize-card analize-card-fill" title="Raw bucket counts (returned points only) for the most recently completed run">
                        @if (CurrentReturnView?.Result.SeriesBreakdown is not null)
                        {
                            <div class="analize-series-tabs">
                                @foreach (var name in ReturnSeriesNames)
                                {
                                    <button type="button" class="analize-btn-toggle @(_returnSelectedSeries == name ? "analize-btn-toggle-active" : "")"
                                            @onclick="() => _returnSelectedSeries = name" title="Show the @name-based series">
                                        @name
                                    </button>
                                }
                            </div>
                        }
                        <DataTable TItem="AnalizeBinRow" Items="@ReturnResultRows" ShowActions="false" ShowRowNumbers="false"
                                   EmptyMessage="Set a window and click RUN (Return Probability) in the left panel to see results" />
                    </div>
                }
                else
                {
                    <div class="card analize-card analize-card-fill" title="Price chart for the selected symbol and date range">
                        <div class="analize-price-toolbar">
                            <BarSizeSelect @bind-Value="_marketChartBarWidthSeconds" Disabled="_marketChartLoading" />
                            <label class="analize-field analize-field-row"
                                   title="OHLC draws each bar's real Open/High/Low/Close; Quartile draws a box plot instead, using each bar's Min/Q1/Q3/Max">
                                Bar kind
                                <select class="analize-input" @bind="_marketChartBarKind" disabled="@_marketChartLoading">
                                    <option value="@BarAggregationKind.Ohlc">OHLC</option>
                                    <option value="@BarAggregationKind.Quartile">Quartile</option>
                                </select>
                            </label>
                            <button type="button" class="analize-btn" @onclick="LoadMarketChartAsync" disabled="@_marketChartLoading"
                                    title="Reload the price chart for the current symbol, date range, bar width and bar kind">
                                @(_marketChartLoading ? "LOADING..." : "RELOAD")
                            </button>
                        </div>
                        @if (_marketChartBarKind == BarAggregationKind.Quartile)
                        {
                            <p class="analize-caption" title="The chart has no dedicated box-plot series, so each bar's five-number summary is drawn through the candle shape plus a dotted overlay line">
                                quartile box plot -- candle body is Q1-Q3, wicks are Min-Max (hover shows them labeled O/H/L/C), dotted line is the Median
                            </p>
                        }
                        @if (_marketChartError is not null)
                        {
                            <p class="analize-error">@_marketChartError</p>
                        }
                        @if (_marketChartBars.Count == 0)
                        {
                            <p class="analize-side-panel-placeholder">@(_marketChartLoading ? "loading..." : "no bars for this range")</p>
                        }
                        else
                        {
                            <MarketChartContainer Bars="_marketChartBars" MedianLine="_marketChartMedianLine" Interactive="false" />
                        }
                    </div>
                }
            </div>
        </main>

        <aside class="analize-right-side-panel @(_rightPanelCollapsed ? "analize-right-side-panel-collapsed" : "")">
            <div class="analize-side-panel-header">
                <button type="button" class="analize-side-panel-toggle" @onclick="() => _rightPanelCollapsed = !_rightPanelCollapsed"
                        title="@(_rightPanelCollapsed ? "Expand panel" : "Collapse panel")">
                    <Icon Name="@(_rightPanelCollapsed ? "chevron-left" : "chevron-right")" Class="analize-side-panel-toggle-icon" />
                </button>
                @if (!_rightPanelCollapsed)
                {
                    <span class="analize-side-panel-label">DETAILS</span>
                }
            </div>
            @if (!_rightPanelCollapsed)
            {
                <div class="analize-side-panel-tabs">
                    <button type="button" class="analize-side-panel-tab active" title="Stats for the most recently completed run">
                        DETAILS
                    </button>
                </div>
                <div class="analize-side-panel-content">
                    @if (_activeAnalysis == ActiveAnalysis.BarrierMap)
                    {
                        @if (BarrierService.Result is { } detailResult && _barrierSelection is { } detailSelection)
                        {
                            <BarrierCellDetail Result="detailResult" Selection="detailSelection" />
                        }
                    }
                    else
                    {
                        <AnalysisDetailCard Snapshot="@CurrentDetailView" SelectedSeries="@_returnSelectedSeries" />
                    }
                </div>
            }
        </aside>
    </div>
</div>
