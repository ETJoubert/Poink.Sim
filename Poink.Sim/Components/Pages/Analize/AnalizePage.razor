@page "/analize"
@namespace Poink.Sim.Components.Pages.Analize
@using Poink.Sim.Components.Charts
@using Poink.Sim.Components.Shared.BarSizeSelect
@using Poink.Sim.Components.Shared.DataTable
@using Poink.Sim.Components.Shared.Icon
@using Poink.Sim.Components.Shared.TickDataSource

<div class="analize-page">
    <div class="analize-topbar">
        <header class="analize-header">
            <span class="analize-title">ANALYSIS</span>

            <div class="analize-header-data">
                <TickDataSource @bind-Table="_table" @bind-From="_from" @bind-To="_to" />
            </div>
        </header>
    </div>

    <div class="analize-body">
        <aside class="analize-left-side-panel @(_leftPanelCollapsed ? "analize-left-side-panel-collapsed" : "")">
            <div class="analize-side-panel-header">
                <button type="button" class="analize-side-panel-toggle" @onclick="() => _leftPanelCollapsed = !_leftPanelCollapsed"
                        title="@(_leftPanelCollapsed ? "Expand panel" : "Collapse panel")">
                    <Icon Name="@(_leftPanelCollapsed ? "chevron-right" : "chevron-left")" Class="analize-side-panel-toggle-icon" />
                </button>
                @if (!_leftPanelCollapsed)
                {
                    <span class="analize-side-panel-label">OVERVIEW</span>
                }
            </div>
            @if (!_leftPanelCollapsed)
            {
                <div class="analize-side-panel-tabs">
                    <button type="button" class="analize-side-panel-tab active" title="Configure and run an analysis">
                        ANALYSES
                    </button>
                </div>
                <div class="analize-side-panel-content">
                    <div class="card analize-card @(_activeAnalysis == ActiveAnalysis.TimeAboveBelow ? "analize-card-active" : "")"
                         title="For each point in time, what fraction of the next X minutes is price above that point">
                        <div class="analize-card-title-row">
                            <button type="button" class="analize-card-collapse-btn"
                                    @onclick="() => _timeAboveBelowCardCollapsed = !_timeAboveBelowCardCollapsed"
                                    title="@(_timeAboveBelowCardCollapsed ? "Expand" : "Collapse")">
                                <Icon Name="@(_timeAboveBelowCardCollapsed ? "chevron-right" : "chevron-down")" Class="analize-card-collapse-icon" />
                            </button>
                            <span class="analize-card-title">Time Above/Below Distribution</span>
                            @if (_activeAnalysis == ActiveAnalysis.TimeAboveBelow)
                            {
                                <span class="analize-card-active-badge" title="Shown in the main and DETAILS panels">ACTIVE</span>
                            }
                            else
                            {
                                <button type="button" class="analize-card-view-btn" @onclick="() => _activeAnalysis = ActiveAnalysis.TimeAboveBelow"
                                        title="Show this analysis's results in the main and DETAILS panels">
                                    VIEW
                                </button>
                            }
                        </div>

                        @if (!_timeAboveBelowCardCollapsed)
                        {
                            <label class="analize-field" title="How many minutes forward to look from each point in the series">
                                Window (minutes)
                                <input class="analize-input" type="number" min="1" step="1" @bind="_timeAboveBelowWindowMinutes"
                                       disabled="@TimeAboveBelowService.IsRunning" />
                            </label>

                            @if (!TimeAboveBelowService.IsRunning)
                            {
                                <button type="button" class="analize-btn analize-btn-run" @onclick="RunTimeAboveBelow"
                                        title="Streams every tick in the selected symbol/date range and computes the distribution -- can take a while on large ranges">
                                    RUN
                                </button>
                            }
                            else
                            {
                                <button type="button" class="analize-btn analize-btn-cancel" @onclick="() => TimeAboveBelowService.Cancel()"
                                        title="Stop the analysis currently in progress">
                                    CANCEL
                                </button>
                                <div class="analize-progress">
                                    <div class="analize-progress-bar">
                                        <div class="analize-progress-fill" style="width: @(TimeAboveBelowProgressPercentText)%"></div>
                                    </div>
                                    <span class="analize-progress-text">@(TimeAboveBelowProgressPercentText)%</span>
                                </div>
                            }

                            @if (_timeAboveBelowStartError is not null)
                            {
                                <p class="analize-error">@_timeAboveBelowStartError</p>
                            }
                            @if (TimeAboveBelowService.Error is not null)
                            {
                                <p class="analize-error">@TimeAboveBelowService.Error</p>
                            }
                            @if (TimeAboveBelowService.WasCancelled)
                            {
                                <p class="analize-note">cancelled</p>
                            }
                        }
                    </div>

                    <div class="card analize-card @(_activeAnalysis == ActiveAnalysis.ReturnProbability ? "analize-card-active" : "")"
                         title="For each point in time, does price ever come back to that same price within the next X minutes">
                        <div class="analize-card-title-row">
                            <button type="button" class="analize-card-collapse-btn"
                                    @onclick="() => _returnCardCollapsed = !_returnCardCollapsed"
                                    title="@(_returnCardCollapsed ? "Expand" : "Collapse")">
                                <Icon Name="@(_returnCardCollapsed ? "chevron-right" : "chevron-down")" Class="analize-card-collapse-icon" />
                            </button>
                            <span class="analize-card-title">Return Probability</span>
                            @if (_activeAnalysis == ActiveAnalysis.ReturnProbability)
                            {
                                <span class="analize-card-active-badge" title="Shown in the main and DETAILS panels">ACTIVE</span>
                            }
                            else
                            {
                                <button type="button" class="analize-card-view-btn" @onclick="() => _activeAnalysis = ActiveAnalysis.ReturnProbability"
                                        title="Show this analysis's results in the main and DETAILS panels">
                                    VIEW
                                </button>
                            }
                        </div>

                        @if (!_returnCardCollapsed)
                        {
                            <label class="analize-field" title="How many minutes forward to watch for price returning to its starting point">
                                Window (minutes)
                                <input class="analize-input" type="number" min="1" step="1" @bind="_returnWindowMinutes"
                                       disabled="@ReturnService.IsRunning" />
                            </label>

                            @if (!ReturnService.IsRunning)
                            {
                                <button type="button" class="analize-btn analize-btn-run" @onclick="RunReturnProbability"
                                        title="Streams every tick in the selected symbol/date range and computes the return probability -- can take a while on large ranges">
                                    RUN
                                </button>
                            }
                            else
                            {
                                <button type="button" class="analize-btn analize-btn-cancel" @onclick="() => ReturnService.Cancel()"
                                        title="Stop the analysis currently in progress">
                                    CANCEL
                                </button>
                                <div class="analize-progress">
                                    <div class="analize-progress-bar">
                                        <div class="analize-progress-fill" style="width: @(ReturnProgressPercentText)%"></div>
                                    </div>
                                    <span class="analize-progress-text">@(ReturnProgressPercentText)%</span>
                                </div>
                            }

                            @if (_returnStartError is not null)
                            {
                                <p class="analize-error">@_returnStartError</p>
                            }
                            @if (ReturnService.Error is not null)
                            {
                                <p class="analize-error">@ReturnService.Error</p>
                            }
                            @if (ReturnService.WasCancelled)
                            {
                                <p class="analize-note">cancelled</p>
                            }
                            @if (ReturnService.Result is { SampleCount: > 0 } returnSummary)
                            {
                                <p class="analize-caption">
                                    @((returnSummary.ReturnProbability * 100).ToString("N1"))% chance of returning within @_returnWindowMinutes min
                                </p>
                            }
                        }
                    </div>
                </div>
            }
        </aside>

        <main class="analize-main">
            <div class="analize-tabs">
                <button type="button" class="analize-btn-toggle @(_activeMainTab == AnalizeMainTab.Chart ? "analize-btn-toggle-active" : "")"
                        @onclick="() => _activeMainTab = AnalizeMainTab.Chart" title="Bar chart view of the distribution">
                    CHART
                </button>
                <button type="button" class="analize-btn-toggle @(_activeMainTab == AnalizeMainTab.Results ? "analize-btn-toggle-active" : "")"
                        @onclick="() => _activeMainTab = AnalizeMainTab.Results" title="Raw bucket counts as a table">
                    RESULTS
                </button>
                <button type="button" class="analize-btn-toggle @(_activeMainTab == AnalizeMainTab.Price ? "analize-btn-toggle-active" : "")"
                        @onclick="SelectPriceTab" title="Price chart for the selected symbol and date range">
                    PRICE
                </button>
            </div>

            <div class="analize-content">
                @if (_activeMainTab == AnalizeMainTab.Chart && _activeAnalysis == ActiveAnalysis.TimeAboveBelow)
                {
                    <div class="card analize-card analize-card-fill" title="Time-above distribution for the selected data and window">
                        <HistogramChart Bins="@TimeAboveBelowChartBins" Title="TIME ABOVE DISTRIBUTION" ValueUnit="%" ValueScale="100"
                                         EmptyMessage="Set a window and click RUN (Time Above/Below) in the left panel to see the distribution" />
                        @if (TimeAboveBelowService.Result is { SampleCount: > 0 })
                        {
                            <p class="analize-caption" title="Each point's time above and time below the same window always add up to 100%">
                                each bucket's mirror (100% minus its value) is that same time spent below -- see DETAILS for both explicitly
                            </p>
                        }
                    </div>
                }
                else if (_activeMainTab == AnalizeMainTab.Chart)
                {
                    <div class="card analize-card analize-card-fill" title="Time-to-return distribution for the selected data and window">
                        <HistogramChart Bins="@ReturnChartBins" Title="TIME TO RETURN DISTRIBUTION" ValueUnit=" min" ValueScale="1"
                                         EmptyMessage="Set a window and click RUN (Return Probability) in the left panel to see the distribution" />
                        @if (ReturnService.Result is { SampleCount: > 0 } returnChartResult)
                        {
                            <p class="analize-caption" title="Bucket counts cover only the points that did return -- see DETAILS for the overall chance">
                                @((returnChartResult.ReturnProbability * 100).ToString("N1"))% of points returned at all;
                                buckets show how long that took for those that did -- see DETAILS for the full breakdown
                            </p>
                        }
                    </div>
                }
                else if (_activeMainTab == AnalizeMainTab.Results && _activeAnalysis == ActiveAnalysis.TimeAboveBelow)
                {
                    <div class="card analize-card analize-card-fill" title="Raw bucket counts for the most recently completed run">
                        <DataTable TItem="AnalizeBinRow" Items="@TimeAboveBelowResultRows" ShowActions="false" ShowRowNumbers="false"
                                   EmptyMessage="Set a window and click RUN (Time Above/Below) in the left panel to see results" />
                    </div>
                }
                else if (_activeMainTab == AnalizeMainTab.Results)
                {
                    <div class="card analize-card analize-card-fill" title="Raw bucket counts (returned points only) for the most recently completed run">
                        <DataTable TItem="AnalizeBinRow" Items="@ReturnResultRows" ShowActions="false" ShowRowNumbers="false"
                                   EmptyMessage="Set a window and click RUN (Return Probability) in the left panel to see results" />
                    </div>
                }
                else
                {
                    <div class="card analize-card analize-card-fill" title="Price chart for the selected symbol and date range">
                        <div class="analize-price-toolbar">
                            <BarSizeSelect @bind-Value="_marketChartBarWidthSeconds" Disabled="_marketChartLoading" />
                            <button type="button" class="analize-btn" @onclick="LoadMarketChartAsync" disabled="@_marketChartLoading"
                                    title="Reload the price chart for the current symbol, date range and bar width">
                                @(_marketChartLoading ? "LOADING..." : "RELOAD")
                            </button>
                        </div>
                        @if (_marketChartError is not null)
                        {
                            <p class="analize-error">@_marketChartError</p>
                        }
                        @if (_marketChartBars.Count == 0)
                        {
                            <p class="analize-side-panel-placeholder">@(_marketChartLoading ? "loading..." : "no bars for this range")</p>
                        }
                        else
                        {
                            <MarketChartContainer Bars="_marketChartBars" Interactive="false" />
                        }
                    </div>
                }
            </div>
        </main>

        <aside class="analize-right-side-panel @(_rightPanelCollapsed ? "analize-right-side-panel-collapsed" : "")">
            <div class="analize-side-panel-header">
                <button type="button" class="analize-side-panel-toggle" @onclick="() => _rightPanelCollapsed = !_rightPanelCollapsed"
                        title="@(_rightPanelCollapsed ? "Expand panel" : "Collapse panel")">
                    <Icon Name="@(_rightPanelCollapsed ? "chevron-left" : "chevron-right")" Class="analize-side-panel-toggle-icon" />
                </button>
                @if (!_rightPanelCollapsed)
                {
                    <span class="analize-side-panel-label">DETAILS</span>
                }
            </div>
            @if (!_rightPanelCollapsed)
            {
                <div class="analize-side-panel-tabs">
                    <button type="button" class="analize-side-panel-tab active" title="Stats for the most recently completed run">
                        DETAILS
                    </button>
                </div>
                <div class="analize-side-panel-content">
                    <div class="card analize-card" title="Stats for the most recently completed run">
                        <div class="analize-card-title">Details</div>
                        @if (_activeAnalysis == ActiveAnalysis.TimeAboveBelow)
                        {
                            @if (TimeAboveBelowService.Result is { } result && result.SampleCount > 0)
                            {
                                <div class="analize-stat">
                                    <span class="analize-stat-label">samples</span>
                                    <span class="analize-stat-value">@result.SampleCount.ToString("N0")</span>
                                </div>
                                <div class="analize-stat">
                                    <span class="analize-stat-label">mean time above / below</span>
                                    <span class="analize-stat-value">@((result.MeanFractionAbove * 100).ToString("N1"))% / @((100 - result.MeanFractionAbove * 100).ToString("N1"))%</span>
                                </div>
                                <div class="analize-stat">
                                    <span class="analize-stat-label">median time above / below</span>
                                    <span class="analize-stat-value">@((result.MedianFractionAbove * 100).ToString("N1"))% / @((100 - result.MedianFractionAbove * 100).ToString("N1"))%</span>
                                </div>
                                <div class="analize-stat">
                                    <span class="analize-stat-label">std dev</span>
                                    <span class="analize-stat-value">@((result.StdDevFractionAbove * 100).ToString("N1"))%</span>
                                </div>
                                <div class="analize-stat" title="Across all points -- the widest and narrowest time-above shares seen">
                                    <span class="analize-stat-label">min / max above</span>
                                    <span class="analize-stat-value">@((result.MinFractionAbove * 100).ToString("N1"))% / @((result.MaxFractionAbove * 100).ToString("N1"))%</span>
                                </div>
                                <div class="analize-stat" title="Same points, expressed as time below instead -- always 100% minus time above">
                                    <span class="analize-stat-label">min / max below</span>
                                    <span class="analize-stat-value">@((100 - result.MaxFractionAbove * 100).ToString("N1"))% / @((100 - result.MinFractionAbove * 100).ToString("N1"))%</span>
                                </div>
                                <div class="analize-stat">
                                    <span class="analize-stat-label">window</span>
                                    <span class="analize-stat-value">@_timeAboveBelowWindowMinutes min</span>
                                </div>
                                @if (TimeAboveBelowService.Elapsed is { } elapsed)
                                {
                                    <div class="analize-stat">
                                        <span class="analize-stat-label">compute time</span>
                                        <span class="analize-stat-value">@elapsed.ToString("g")</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="analize-side-panel-placeholder">no completed run yet</p>
                            }
                        }
                        else
                        {
                            @if (ReturnService.Result is { } result && result.SampleCount > 0)
                            {
                                <div class="analize-stat" title="Chance that price ever touches back to its own starting price within the window">
                                    <span class="analize-stat-label">return probability</span>
                                    <span class="analize-stat-value">@((result.ReturnProbability * 100).ToString("N1"))%</span>
                                </div>
                                <div class="analize-stat">
                                    <span class="analize-stat-label">samples</span>
                                    <span class="analize-stat-value">@result.SampleCount.ToString("N0")</span>
                                </div>
                                <div class="analize-stat">
                                    <span class="analize-stat-label">returned</span>
                                    <span class="analize-stat-value">@result.ReturnedCount.ToString("N0")</span>
                                </div>
                                <div class="analize-stat" title="Among points that did return -- how long it took">
                                    <span class="analize-stat-label">mean / median time to return</span>
                                    <span class="analize-stat-value">@(result.MeanMinutesToReturn.ToString("N1")) / @(result.MedianMinutesToReturn.ToString("N1")) min</span>
                                </div>
                                <div class="analize-stat">
                                    <span class="analize-stat-label">window</span>
                                    <span class="analize-stat-value">@_returnWindowMinutes min</span>
                                </div>
                                @if (ReturnService.Elapsed is { } elapsed)
                                {
                                    <div class="analize-stat">
                                        <span class="analize-stat-label">compute time</span>
                                        <span class="analize-stat-value">@elapsed.ToString("g")</span>
                                    </div>
                                }
                            }
                            else
                            {
                                <p class="analize-side-panel-placeholder">no completed run yet</p>
                            }
                        }
                    </div>
                </div>
            }
        </aside>
    </div>
</div>
