@page "/train"
@namespace Poink.Sim.Components.Pages
@using Poink.Shared.Client.Components.Shared.Icon
@using Poink.Shared.Client.Components.Shared.ViewDatatable
@using Poink.Sim.Components.Training
@using Poink.Sim.Components.Shared.DataTable
@using Poink.Sim.Components.Shared.DateRangeSlider

<div class="train-page">
    <header class="train-header">
        <span class="train-title">BRAIN TRAINING</span>
        <span class="train-state @(Service.IsRunning ? "train-state-running" : "")">
            @(Service.IsRunning ? "TRAINING" : "IDLE")
        </span>
    </header>

    <div class="train-tabs">
        <button class="terminal-btn-action @(_activeTab == TrainTab.Setup ? "active" : "")"
                @onclick="() => _activeTab = TrainTab.Setup">SETUP</button>
        <button class="terminal-btn-action @(_activeTab == TrainTab.Live ? "active" : "")"
                @onclick="() => _activeTab = TrainTab.Live">LIVE</button>
    </div>

    @if (_activeTab == TrainTab.Setup)
    {
        <p class="train-help">
            Runs a brain through many headless simulated episodes, training it via the
            selected strategy after each episode. Either synthetic random-walk ticks (no
            Postgres needed) or a real historic range, randomly windowed per episode. Only
            brains the strategy recognizes as trainable can be selected.
        </p>

        <div class="train-setup-grid">
            <div class="train-group train-group-wide">
                <div class="train-group-title">Data source</div>
                <div class="train-row">
                    <label>
                        <input type="checkbox" @bind="_useHistoricData" disabled="@Service.IsRunning" />
                        Train on real historic ticks
                    </label>
                </div>
                @if (_useHistoricData)
                {
                    <div class="train-row">
                        <label>
                            Symbol
                            @if (_availableTables.Count > 0)
                            {
                                <select class="terminal-input" @bind="SelectedTable" disabled="@(Service.IsRunning || _loadingTables)">
                                    @foreach (var t in _availableTables)
                                    {
                                        <option value="@t.Table">@t.Table (@t.Rows.ToString("N0") rows)</option>
                                    }
                                </select>
                                <button class="terminal-btn-action" @onclick="RecountTables" disabled="@(Service.IsRunning || _loadingTables)"
                                        title="Rescans every ticks_* table (COUNT/MIN/MAX) and refreshes stored row counts -- slow, only needed after new data has been written">
                                    @(_loadingTables ? "RECOUNTING..." : "RECOUNT")
                                </button>
                            }
                            else if (_loadingTables)
                            {
                                <span>loading tables...</span>
                            }
                            else
                            {
                                <button class="terminal-btn-action" @onclick="LoadTables" disabled="@Service.IsRunning"
                                        title="Loads the cached tick_table_stats registry -- fast, no table scanning">
                                    @(_tableListFailed ? "RETRY" : "LOAD TABLES")
                                </button>
                            }
                        </label>
                    </div>
                    @if (_tableListFailed)
                    {
                        <p class="train-error">Tick table list unavailable (Postgres down?).</p>
                    }
                    <div class="train-row train-row-range">
                        <DateRangeSlider Min="SliderMin" Max="SliderMax" From="_from" FromChanged="@(v => _from = v)"
                                         To="_to" ToChanged="@(v => _to = v)"
                                         Disabled="@(Service.IsRunning || _loadingTables || TickDataStore.IsLoading)" />
                    </div>
                    <div class="train-row">
                        <span class="data-status @(IsDataReady ? "data-status-ready" : "data-status-pending")">
                            @(TickDataStore.IsLoading ? "LOADING..." : IsDataReady ? $"DATA LOADED ({TickDataStore.LoadedCount:N0} ticks)" : "DATA NOT LOADED")
                        </span>
                        <button class="terminal-btn-action" @onclick="LoadData"
                                disabled="@(Service.IsRunning || string.IsNullOrWhiteSpace(_table) || TickDataStore.IsLoading)"
                                title="Reads ticks for the selected symbol/range into memory -- required before Start Training">
                            @(TickDataStore.IsLoading ? "LOADING..." : "LOAD DATA")
                        </button>
                    </div>
                }
            </div>

            <BrainStrategyPicker BrainOptions="Service.BrainOptions" StrategyNames="Service.StrategyNames"
                                  @bind-BrainName="_brainName" @bind-StrategyName="_strategyName" Disabled="Service.IsRunning" />

            <div class="train-group">
                <div class="train-group-title">Run parameters</div>
                <div class="train-row">
                    <label>
                        Episodes
                        <input class="terminal-input" type="number" min="1" @bind="_episodeCount" disabled="@Service.IsRunning" />
                    </label>
                    <label>
                        Ticks / episode
                        <input class="terminal-input" type="number" min="2" @bind="_ticksPerEpisode" disabled="@Service.IsRunning" />
                    </label>
                    <label>
                        Starting cash
                        <input class="terminal-input" type="number" min="1" step="100" @bind="_startingCash" disabled="@Service.IsRunning" />
                    </label>
                    <label>
                        Learning rate
                        <input class="terminal-input" type="number" min="0.00001" step="0.0001" @bind="_learningRate" disabled="@Service.IsRunning" />
                    </label>
                </div>
            </div>
        </div>

        <div class="train-group train-group-wide">
            <div class="train-group-title">Save current brain</div>
            <div class="train-row">
                <label>
                    Name
                    <input class="terminal-input" type="text" placeholder="e.g. mlp-v1-momentum-set" @bind="_saveName" />
                </label>
                <button class="terminal-btn-action" @onclick="SaveModel"
                        disabled="@(string.IsNullOrWhiteSpace(_brainName) || string.IsNullOrWhiteSpace(_saveName))"
                        title="Saves the selected brain's current weights, plus this screen's strategy/parameters, as a new snapshot">
                    SAVE MODEL
                </button>
                @if (Service.SaveStatus is not null)
                {
                    <span class="train-help">@Service.SaveStatus</span>
                }
            </div>
        </div>

        <div class="train-group train-group-wide">
            <div class="train-group-title">Saved brains</div>
            <DataTable TItem="SavedBrainRow" Items="SavedBrainRows" ShowRowNumbers="false" ActionsHeader="ACTIONS"
                       ExcludeProperties="@(new List<string> { "Id" })" OnDelete="DeleteSavedBrain">
                <CustomActions Context="row">
                    <button class="data-table-action-btn" @onclick="() => LoadSavedBrain(row)"
                            title="Loads these weights into the live brain -- also what Simulation's Brain dropdown will use">
                        <Icon Name="check2-square" Class="dt-icon" /> USE
                    </button>
                </CustomActions>
            </DataTable>
        </div>

        <div class="train-actions">
            <button class="terminal-btn-action" @onclick="StartTraining" disabled="@Service.IsRunning">
                @(Service.IsRunning ? "TRAINING..." : "START TRAINING")
            </button>
        </div>

        @if (_startError is not null)
        {
            <p class="train-error">@_startError</p>
        }
        @if (Service.Error is not null)
        {
            <p class="train-error">@Service.Error</p>
        }

        @if (Service.TotalEpisodes > 0)
        {
            <div class="train-progress">
                <div class="train-progress-bar">
                    <div class="train-progress-fill" style="width: @(ProgressPercent)%"></div>
                </div>
                <span class="train-progress-text">
                    @Service.EpisodesCompleted / @Service.TotalEpisodes episodes (@ProgressPercent%)
                </span>
            </div>
        }
    }
    else
    {
        @if (Service.TotalEpisodes == 0)
        {
            <p class="train-help">No training run yet — switch to SETUP and start one.</p>
        }
        else
        {
            <div class="train-progress">
                <div class="train-progress-bar">
                    <div class="train-progress-fill" style="width: @(ProgressPercent)%"></div>
                </div>
                <span class="train-progress-text">
                    @Service.EpisodesCompleted / @Service.TotalEpisodes episodes (@ProgressPercent%)
                </span>
            </div>

            <div class="train-stats">
                <div class="train-stat">
                    <span class="train-stat-label">recent avg reward</span>
                    <span class="train-stat-value">@Service.RecentAverageReward.ToString("N2")</span>
                </div>
                <div class="train-stat">
                    <span class="train-stat-label">best episode</span>
                    <span class="train-stat-value">@Service.BestReward.ToString("N2")</span>
                </div>
                <div class="train-stat">
                    <span class="train-stat-label">worst episode</span>
                    <span class="train-stat-value">@Service.WorstReward.ToString("N2")</span>
                </div>
                <div class="train-stat">
                    <span class="train-stat-label">win rate</span>
                    <span class="train-stat-value">@WinRatePercent.ToString("N0")%</span>
                </div>
            </div>

            <div class="train-live-grid">
                <div class="train-live-panel">
                    <div class="train-panel-title">EPISODES</div>
                    <EpisodeGrid Episodes="Service.RecentEpisodes" IsRunning="Service.IsRunning" />
                </div>

                <div class="train-live-panel">
                    <div class="train-panel-title">REWARD</div>
                    <RewardChart Episodes="Service.RecentEpisodes" IsRunning="Service.IsRunning" />
                </div>

                <div class="train-live-panel">
                    <div class="train-panel-title">NETWORK ACTIVITY</div>
                    <NetworkEmulator IsRunning="Service.IsRunning" LayerShapes="CurrentNetworkShape" />
                </div>

                <div class="train-live-panel">
                    <div class="train-panel-title">ACTION DISTRIBUTION</div>
                    <div class="action-dist">
                        <div class="action-dist-row">
                            <span class="action-dist-label action-dist-hold">HOLD</span>
                            <div class="action-dist-track">
                                <div class="action-dist-fill action-dist-fill-hold" style="width: @(Pct(ActionPercents.Hold))%"></div>
                            </div>
                            <span class="action-dist-pct">@ActionPercents.Hold.ToString("N0")%</span>
                        </div>
                        <div class="action-dist-row">
                            <span class="action-dist-label action-dist-long">LONG</span>
                            <div class="action-dist-track">
                                <div class="action-dist-fill action-dist-fill-long" style="width: @(Pct(ActionPercents.EnterLong))%"></div>
                            </div>
                            <span class="action-dist-pct">@ActionPercents.EnterLong.ToString("N0")%</span>
                        </div>
                        <div class="action-dist-row">
                            <span class="action-dist-label action-dist-short">SHORT</span>
                            <div class="action-dist-track">
                                <div class="action-dist-fill action-dist-fill-short" style="width: @(Pct(ActionPercents.EnterShort))%"></div>
                            </div>
                            <span class="action-dist-pct">@ActionPercents.EnterShort.ToString("N0")%</span>
                        </div>
                        <div class="action-dist-row">
                            <span class="action-dist-label action-dist-close">CLOSE</span>
                            <div class="action-dist-track">
                                <div class="action-dist-fill action-dist-fill-close" style="width: @(Pct(ActionPercents.Close))%"></div>
                            </div>
                            <span class="action-dist-pct">@ActionPercents.Close.ToString("N0")%</span>
                        </div>
                    </div>
                </div>

                <div class="train-live-panel train-live-panel-wide">
                    <div class="train-panel-title">
                        INPUTS <span class="train-panel-subtitle">(what the network sees — last decision)</span>
                    </div>
                    @if (Service.LatestInputs is null)
                    {
                        <span class="reward-chart-empty">no data yet</span>
                    }
                    else
                    {
                        <div class="input-strip">
                            @foreach (var bar in PriceWindowBars)
                            {
                                <div class="input-bar" style="height: @(bar.HeightPct)%; background: @bar.ColorCss"
                                     title="@bar.Label — @bar.Value.ToString("N4")"></div>
                            }
                        </div>
                        <div class="input-scalars">
                            @foreach (var f in ScalarFeatures)
                            {
                                <div class="input-scalar">
                                    <span class="input-scalar-label">@f.Label</span>
                                    <span class="input-scalar-value @(f.Value switch { > 0 => "input-positive", < 0 => "input-negative", _ => "" })">
                                        @f.Value.ToString("N3")
                                    </span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="train-metrics-log">
                <ViewDatatable Items="MetricsRows" Title="EPISODE METRICS" EmptyMessage="no episodes yet" />
            </div>
        }
    }
</div>
