@using Poink.Sim.Components.Shared.Icon
@using Poink.Sim.Services.Activity
@implements IDisposable
@inject IActivityTracker ActivityTracker
@inject NavigationManager Navigation

@if (_openGroup is not null)
{
    <div class="nav-dropdown-backdrop" title="Close menu" @onclick="CloseGroup"></div>
}

@foreach (var entry in Entries)
{
    @if (entry is NavGroupItem group)
    {
        <div class="nav-group-item">
            <button type="button" class="@LinkClass nav-group-toggle @(IsOpen(group) ? "open" : "")"
                    title="@group.Label" @onclick="() => ToggleGroup(group)">
                @if (Collapsed)
                {
                    <span class="nav-icon">
                        <Icon Name="@group.Icon" Class="nav-icon-img" />
                    </span>
                }
                else
                {
                    <span>
                        <Icon Name="@group.Icon" Class="nav-icon-img" /> @group.Label
                    </span>
                    <Icon Name="chevron-down" Class="nav-caret" />
                }
            </button>
            @if (IsOpen(group))
            {
                <div class="nav-dropdown">
                    @foreach (var child in group.Children)
                    {
                        <NavTabLink Link="child" LinkClass="@LinkClass" ExtraClass="nav-dropdown-item" Collapsed="Collapsed"
                                    Activity="ActivityTracker.GetRoute(child.Route)" OnClick="CloseGroup" />
                    }
                </div>
            }
        </div>
    }
    else if (entry is NavClusterItem cluster)
    {
        <div class="nav-cluster @(Collapsed ? "collapsed" : "")" title="@cluster.Description">
            <span class="nav-cluster-label" title="@cluster.Description">
                @if (Collapsed)
                {
                    <Icon Name="@cluster.Icon" Class="nav-cluster-icon" />
                }
                else
                {
                    @cluster.Label
                }
            </span>
            @foreach (var child in cluster.Children)
            {
                <NavTabLink Link="child" LinkClass="@LinkClass" ExtraClass="nav-cluster-item" Collapsed="Collapsed"
                            Activity="ActivityTracker.GetRoute(child.Route)" />
            }
        </div>
    }
    else if (entry is NavLinkItem link)
    {
        <NavTabLink Link="link" LinkClass="@LinkClass" Collapsed="Collapsed" Activity="ActivityTracker.GetRoute(link.Route)" />
    }
}

@code {
    [Parameter] public string LinkClass { get; set; } = "nav-tab";
    [Parameter] public bool Collapsed { get; set; } = false;
    [Parameter] public EventCallback<bool> OnDropdownToggled { get; set; }

    private NavGroupItem? _openGroup;

    private static readonly NavLinkItem[] ReflectionChildren =
    [
        new("/code", "Code", "diagram-3-fill"),
        new("/arch", "Arch", "boxes"),
        new("/calls", "Calls", "arrow-left-right"),
        new("/trade-map", "tradeMap", "diagram-2-fill"),
    ];

    private static readonly NavLinkItem[] TestingChildren =
    [
        new("/", "Simulation", "play-circle-fill"),
        new("/train", "Train", "cpu-fill"),
        new("/train2", "Train 2.0", "grid-1x2-fill"),
        new("/profiler", "Profiler", "bar-chart-steps"),
        new("/signal-study", "Signal Study", "search"),
    ];

    private static readonly NavEntry[] Entries =
    [
        new NavGroupItem("Reflection", "diagram-3-fill", ReflectionChildren),
        new NavClusterItem("Test", "check2-square", "Testing: simulation, training and study tools", TestingChildren),
        new NavLinkItem("/trade", "Trade", "cash-stack"),
        new NavLinkItem("/data", "Data", "cloud-download"),
        new NavLinkItem("/analize", "Analize", "graph-up-arrow"),
        new NavLinkItem("/emulator", "Emulator", "box-seam-fill"),
    ];

    protected override void OnInitialized()
    {
        ActivityTracker.Changed += HandleActivityChanged;
        Navigation.LocationChanged += HandleLocationChanged;
        AcknowledgeCurrentRoute();
    }

    private void HandleActivityChanged() => _ = InvokeAsync(() =>
    {
        AcknowledgeCurrentRoute();
        StateHasChanged();
    });

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e) => AcknowledgeCurrentRoute();

    // A finished run's highlight stays until its tab is on screen, so whichever tab is current clears its own.
    private void AcknowledgeCurrentRoute() => ActivityTracker.Acknowledge(CurrentRoute());

    private string CurrentRoute()
    {
        var relative = Navigation.ToBaseRelativePath(Navigation.Uri);
        var end = relative.IndexOfAny(['?', '#']);
        return "/" + (end < 0 ? relative : relative[..end]).TrimEnd('/');
    }

    private bool IsOpen(NavGroupItem group) => ReferenceEquals(_openGroup, group);

    private Task ToggleGroup(NavGroupItem group)
    {
        var wasOpen = _openGroup is not null;
        _openGroup = IsOpen(group) ? null : group;
        return NotifyDropdownStateChanged(wasOpen);
    }

    private Task CloseGroup()
    {
        var wasOpen = _openGroup is not null;
        _openGroup = null;
        return NotifyDropdownStateChanged(wasOpen);
    }

    private Task NotifyDropdownStateChanged(bool wasOpen)
    {
        var isOpen = _openGroup is not null;
        return wasOpen != isOpen ? OnDropdownToggled.InvokeAsync(isOpen) : Task.CompletedTask;
    }

    public void Dispose()
    {
        ActivityTracker.Changed -= HandleActivityChanged;
        Navigation.LocationChanged -= HandleLocationChanged;
    }
}
