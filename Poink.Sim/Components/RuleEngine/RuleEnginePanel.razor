@namespace Poink.Sim.Components.RuleEngine
@using System.Linq
@using Poink.Sim.Helpers

<div class="rule-engine-panel" title="Above/In/Below mask over the rule-engine signals, their live state, and whether they match">
    <div class="rule-engine-toolbar">
        <button type="button" class="rule-engine-copy" @onclick="CopyLiveToSelector" disabled="@(Result is null)"
                title="Copy the live Above/In/Below state into the selector for every row">Copy Live</button>
        <label class="rule-engine-percent" title="Top-percent cutoff used by the XGrid Top %/Delta rows below">
            Top %
            <input type="number" min="0" max="100" step="1" value="@XGridPercent" @onchange="SetXGridPercent" />
        </label>
    </div>

    <table class="rule-engine-table">
        <thead>
            <tr>
                <th class="rule-engine-head-signal">Signal</th>
                <th title="Above">&#9650;</th>
                <th title="In">In</th>
                <th title="Below">&#9660;</th>
                <th class="@(IsMatching ? "matching" : "")" title="Whether the selected constraint currently matches the live value -- lights up when every selected row matches">Match</th>
            </tr>
        </thead>
        <tbody>
            @GroupHeader(RuleSignalGroup.Baseline, "BASELINE", "POC, VAH, VAL, VWAP, Median and Regression against the current price")
            @foreach (var row in BaselineRows)
            {
                @RowTemplate(row)
            }
            @GroupHeader(RuleSignalGroup.XGrid, "XGRID", "Signals that depend on XGrid's own row/column grid, separate from the baseline signals")
            @foreach (var row in XGridSignalRows)
            {
                @RowTemplate(row)
            }
            @GroupHeader(RuleSignalGroup.TxFold, "TXFOLD", "One row per selected TxFold timeframe -- Above/Below its mean +/- one-stddev band, In between them")
            @foreach (var row in TxFoldSignalRows)
            {
                @RowTemplate(row)
            }
        </tbody>
        <tfoot>
            <tr>
                <td colspan="5" class="rule-engine-foot-count" title="Rows currently matching their live value, out of rows with a selection">
                    @MatchedCount/@SelectedCount matching
                </td>
            </tr>
        </tfoot>
    </table>

    <div class="rule-engine-log" title="Timestamp each time every enabled signal matched at once">
        <div class="rule-engine-log-headrow">
            <span class="rule-engine-log-header">Match Log</span>
            <span class="rule-engine-log-total" title="Total number of times every enabled signal has matched at once">Total: @_totalMatches</span>
        </div>
        @if (_matchLog.Count == 0)
        {
            <span class="rule-engine-log-empty">No matches yet</span>
        }
        else
        {
            <ul class="rule-engine-log-list">
                @foreach (var timestamp in _matchLog)
                {
                    <li class="rule-engine-log-item">@timestamp.ToString("yyyy-MM-dd HH:mm:ss")</li>
                }
            </ul>
        }
    </div>
</div>

@code {
    private RenderFragment GroupHeader(RuleSignalGroup group, string label, string title) =>
        @<tr class="rule-engine-group-row" title="@title">
            <td colspan="5" class="rule-engine-group-label">
                <label class="rule-engine-group-toggle"
                       title="@(IsDisabled(group) ? $"{label} is off -- its signals are not calculated and any selections in it are ignored. Click to switch it on" : $"{label} is on. Click to switch it off so its signals are not calculated and its selections are ignored")">
                    <input type="checkbox" checked="@(!IsDisabled(group))" @onchange="() => ToggleGroup(group)" />
                    @label
                </label>
            </td>
        </tr>;

    private RenderFragment<RuleSignalRow> RowTemplate => row =>
        @<tr class="rule-engine-row" style="--sig-color: var(@row.ColorVar)">
            <td class="rule-engine-label">@row.RowLabel</td>
            @if (row.AboveKey is { } aboveKey)
            {
                <td class="rule-engine-cell" @onclick="() => Toggle(row, aboveKey)" title="@($"Select Above {row.RowLabel} for the rule mask")">
                    <span class="rule-engine-select @(SelectedKey(row) == aboveKey ? "selected" : "")">
                        <span class="rule-engine-arrow @(row.Above ? "on" : "")">&#9650;</span>
                    </span>
                </td>
            }
            else
            {
                <td class="rule-engine-cell"></td>
            }
            <td class="rule-engine-cell" @onclick="() => Toggle(row, row.InKey)" title="@($"Select {row.RowLabel} for the rule mask")">
                <span class="rule-engine-select @(SelectedKey(row) == row.InKey ? "selected" : "")">
                    <span class="rule-engine-dot @(row.In ? "on" : "")"></span>
                </span>
            </td>
            @if (row.BelowKey is { } belowKey)
            {
                <td class="rule-engine-cell" @onclick="() => Toggle(row, belowKey)" title="@($"Select Below {row.RowLabel} for the rule mask")">
                    <span class="rule-engine-select @(SelectedKey(row) == belowKey ? "selected" : "")">
                        <span class="rule-engine-arrow @(row.Below ? "on" : "")">&#9660;</span>
                    </span>
                </td>
            }
            else
            {
                <td class="rule-engine-cell"></td>
            }
            <td class="rule-engine-match-cell" title="Whether this row's selection currently matches its live value">
                <span class="rule-engine-match-dot @MatchStatus(row)"></span>
            </td>
        </tr>;
}
